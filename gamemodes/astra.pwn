stock sdados()
{
		new h, m, s; gettime(h, m, s);
    	for(new c; c < MAX_CASAS; c++)
	    {
	        format(String, sizeof(String), "Casas/%d.ini", c);
	        if(DOF2_FileExists(String))
	        {
		        if(!new_strcmp(cDono[c], "Ninguem"))
		        {
		            if(h == 6)
					{
						cLixo[c] ++; cImpostos[c] ++;
					}
		            if(cLixo[c] >= 2)
			        {
	          			new PastaDono[24];
						format(PastaDono, sizeof(PastaDono), "Contas/%s.ini", cDono[c]);
						if(DOF2_FileExists(PastaDono))
						{
						    DOF2_SetInt(PastaDono, "MultaCasa", DOF2_GetInt(PastaDono, "MultaCasa") + 1000);
						}
					}
					/////////////////////////////////////////////////////////////////////////////
		            if(cImpostos[c] >= 15)
		            {
		                cImpostos[c] = 0;
						cLixo[c] = 0;
						cAvenda[c] = 0;
						cModelPick[c] = 1273;
						cModelMapIcon[c] = 31;
		    			format(cDono[c], 23, "Ninguem");
		    			format(cMorador[c], 23, "Ninguem");
		    			format(cSenha[c], 30, "-1");
					    format(cMensagem[c], 31, "");
		    			//
		    			new ValorNaMsg[11]; format(ValorNaMsg, sizeof(ValorNaMsg), "%d", cValor[c]);
         				if(cCoins[c] > 0)
         				{
	            			format(cMensagemVenda[c], 80, "{FFFFFF}A venda por {00FF00}$%s {FFFFFF}e {FFFF00}%d {FFFFFF}coins", AttNumeroDecimal(ValorNaMsg), cCoins[c]);
	    		        }
   	         	 		else
	    	            {
	   		                format(cMensagemVenda[c], 80, "{FFFFFF}A venda por {00FF00}$%s", AttNumeroDecimal(ValorNaMsg));
	   		            }
		            }
				}
				DOF2_SetString(String, "Dono", cDono[c]);
    			DOF2_SetString(String, "Morador", cMorador[c]);
	            DOF2_SetInt(String, "Valor", cValor[c]);
	            DOF2_SetInt(String, "Impostos", cImpostos[c]);
	            DOF2_SetInt(String, "Lixo", cLixo[c]);
             	DOF2_SetInt(String, "Pick", cModelPick[c]);
	            DOF2_SetInt(String, "MapIcon", cModelMapIcon[c]);
	            DOF2_SetInt(String, "Avenda", cAvenda[c]);
	            DOF2_SetString(String, "Senha", cSenha[c]);
	            DOF2_SetString(String, "Mensagem", cMensagem[c]);
             	DOF2_SetFloat(String, "X", cX[c]);
              	DOF2_SetFloat(String, "Y", cY[c]);
	            DOF2_SetFloat(String, "Z", cZ[c]);
           		DOF2_SetFloat(String, "XX", cXX[c]);
	            DOF2_SetFloat(String, "YY", cYY[c]);
	            DOF2_SetFloat(String, "ZZ", cZZ[c]);
	            DOF2_SetFloat(String, "R", cR[c]);
	            DOF2_SetInt(String, "Interior", cInterior[c]);
	            DOF2_SetInt(String, "Upgrade", cUpgrade[c]);
	            DOF2_SetInt(String, "UPMAX", cUPMAX[c]);
	            DOF2_SetString(String, "msgvenda", cMensagemVenda[c]);
 			}
	    }
	    for(new e; e < MAX_EMPRESAS; e++)
	    {
	        format(String, sizeof(String), "Empresas/%d.ini", e);
	        if(DOF2_FileExists(String))
	        {
		        if(!new_strcmp(eDono[e], "Ninguem"))
		        {
		            if(h == 6)
					{
						eImpostos[e] ++;
					}
		            if(eImpostos[e] >= 15)
		            {
		                eLucro[e] = 0;
		            	eProducao[e] = 0;
		            	eImpostos[e] = 0;
		            	eAvenda[e] = 0;
		            	eContratando[e] = 0;
		    	        format(eDono[e], 23, "Ninguem");
		    			format(eFuncionario1[e], 23, "Ninguem");
		    			format(eFuncionario2[e], 23, "Ninguem");
		    			format(eFuncionario3[e], 23, "Ninguem");
		    			eEntregasFuncionario1[e] = 0;
		    			eEntregasFuncionario2[e] = 0;
		    			eEntregasFuncionario3[e] = 0;
	                    new ValorNaMsg[11]; format(ValorNaMsg, sizeof(ValorNaMsg), "%d", eValor[e]);
	            		format(eMensagemVenda[e], 50, "{FFFF00}A venda por {00FF00}$%s", AttNumeroDecimal(ValorNaMsg));
		            }
				}
	            DOF2_SetString(String, "Dono", eDono[e]);
				DOF2_SetInt(String, "Valor", eValor[e]);
				DOF2_SetInt(String, "Lucro", eLucro[e]);
				DOF2_SetInt(String, "Producao", eProducao[e]);
				DOF2_SetInt(String, "Impostos", eImpostos[e]);
				DOF2_SetInt(String, "Avenda", eAvenda[e]);
				DOF2_SetInt(String, "Contratando", eContratando[e]);
				DOF2_SetString(String, "Funcionario1", eFuncionario1[e]);
				DOF2_SetInt(String, "EntregasFuncionario1", eEntregasFuncionario1[e]);
				DOF2_SetString(String, "Funcionario2", eFuncionario2[e]);
				DOF2_SetInt(String, "EntregasFuncionario2", eEntregasFuncionario2[e]);
				DOF2_SetString(String, "Funcionario3", eFuncionario3[e]);
				DOF2_SetInt(String, "EntregasFuncionario3", eEntregasFuncionario3[e]);
				DOF2_SetString(String, "msgvenda", eMensagemVenda[e]);
			}
	    }
	    for(new p; p < MAX_POSTOS; p++)
	    {
	        format(String, sizeof(String), "Postos/%d.ini", p);
	        if(DOF2_FileExists(String))
	        {
		        if(!new_strcmp(pDono[p], "Ninguem"))
		        {
					if(h == 6)
					{
						pImpostos[p] ++;
					}
					if(pImpostos[p] >= 15)
					{
					    pImpostos[p] = 0;
					    pLucro[p] = 0;
					    pAvenda[p] = 0;
					    format(pDono[p], 25, "Ninguem");
					}
				}
				DOF2_SetString(String, "Dono", pDono[p]);
	         	DOF2_SetInt(String, "Impostos", pImpostos[p]);
		        DOF2_SetInt(String, "Lucro", pLucro[p]);
		        DOF2_SetInt(String, "Litros", pLitros[p]);
		        DOF2_SetInt(String, "AVenda", pAvenda[p]);
	        }
	    }
	    for(new i; i < MAX_FAZENDA; i++)
	    {
	    	format(String, sizeof(String), "Fazendas/%d.ini", i);
	        if(DOF2_FileExists(String))
	        {
	            if(!new_strcmp(f_info[i][f_dono], "Ninguem"))
		        {
		            if(h == 6)
					{
						 f_info[i][f_imposto] ++;
					}
					/////////////////////////////////////////////////////////////////////////////
		            if(f_info[i][f_imposto] >= 15)
		            {
		                format(f_info[i][f_dono], 25, "Ninguem");
			            format(f_info[i][f_funcionario0], 25, "Ninguem");
			            format(f_info[i][f_funcionario1], 25, "Ninguem");
			            format(f_info[i][f_funcionario2], 25, "Ninguem");
			            format(f_info[i][f_nome], 31, "N/A");
			            f_info[i][f_produtos] = 0;
			            f_info[i][f_imposto] = 0;
			            f_info[i][f_cofre] = 0;
			            f_info[i][f_contratando] = 0;
		            }
				}
	            DOF2_SetString(String, "Nome", f_info[i][f_nome]);
	            DOF2_SetString(String, "Dono", f_info[i][f_dono]);
	            DOF2_SetString(String, "Funcionario0", f_info[i][f_funcionario0]);
	            DOF2_SetString(String, "Funcionario1", f_info[i][f_funcionario1]);
	            DOF2_SetString(String, "Funcionario2", f_info[i][f_funcionario2]);
	            DOF2_SetInt(String, "Produtos", f_info[i][f_produtos]);
	            DOF2_SetInt(String, "Imposto", f_info[i][f_imposto]);
	            DOF2_SetInt(String, "Cofre", f_info[i][f_cofre]);
	            DOF2_SetInt(String, "Contratando", f_info[i][f_contratando]);
			}
	    }
	    for(new cx; cx < 40; cx++)
	    {
	        format(String, sizeof(String), "CaixasEletronicos/%d.ini", cx);
	        if(DOF2_FileExists(String))
	        {
