PVP_IsPlayerInZonaSafe(playerid)
{
    for(new i; i < sizeof(PVP_AreaSafe); i ++)
    {
        if(IsPlayerInDynamicArea(playerid, PVP_AreaSafe[i][0]))
            return true;
    }
    return false;
}

