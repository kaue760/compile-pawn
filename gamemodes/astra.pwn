public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
        uQBSWeaponAmmo[playerid][weaponid]--;
		if(SegundosPreso[playerid] > 0)
		{
		    return 0;
		}
	    else if(Porte[playerid] <= 0)
		{
		 	if(ArmaAlvo[playerid] > -1 && GetPlayerAmmo(playerid) <= 1)
			{
				ArmaAlvo[playerid] = -1;
			    GameTextForPlayer(playerid, "~r~~h~TESTE FRACASSADO", 3000, 0);
				SendClientMessage(playerid, COR_ERRO, "| ERRO | Sua municao acabou e voce falhou no teste");
		 	  	for(new m; m < 8; m++)
				{
					if(ObjetoAlvo[playerid][m] > 0)
					{
					    DestroyDynamicObject(ObjetoAlvo[playerid][m]);
					    ObjetoAlvo[playerid][m] = 0;
					}
				}
			}
			else if(ArmaAlvo[playerid] == -1 && PROF[playerid] != CACADOR)
			{
				MsgAviso(playerid, 3, "~r~VOCE NAO POSSUI PORTE DE ARMAS");
			}
		    return 0;
		}
		else
		{
		    for(new i; i < 9; i++)
		    {
		        if(IsPlayerInRangeOfPoint(playerid, PosAreaSafe[i][3], PosAreaSafe[i][0], PosAreaSafe[i][1], PosAreaSafe[i][2]))
		        {
					MsgAviso(playerid, 3, "~r~AREA PROTEGIDA / ZONA SAFE");
					return 0;
		        }
		    }
		}
		foreach(Player, i)
		{
	        if(PROF[i] == PM || PROF[i] == ROTA  || PROF[i] == CHOQUE || PROF[i] == ROTAM || PROF[i] == BOPE || PROF[i] == PC || PROF[i] == PF || PROF[i] == EXERCITO)
			{
			    if((gettime() - TimerColete[playerid]) >= 35)
			    {
			        new zone[MAX_ZONE_NAME]; GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
				    format(String, sizeof(String), "| DP | O(A) Mafioso(a) %s[%d] acaba de dar tiro em %s", PlayerName(playerid), playerid, zone);
				    SendClientMessage(i, GetPlayerColor(i), String);
				    TimerColete[playerid] = gettime();
				}
			}
		}
		return 1;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
	{
	    new Float:X, Float:Y, Float:Z;
	   	GetPlayerPos(playerid, X, Y, Z);
	   	SetPlayerPos(playerid, X, Y, Z);
	   	ApplyAnimation(playerid, "CRACK", "CRCKIDLE4", 4.1, 1, 0, 0, 0, 0, 1);
	}
	if(CheckGari[playerid] > -1)
	{
	    DestroyDynamicCP(CheckGari[playerid]);
	    CheckGari[playerid] = -1;
	    DisablePlayerCheckpoint(playerid);
	}
    if(vPreso[vehicleid] == true)
   	{
  		new Float:X, Float:Y, Float:Z;
	   	GetPlayerPos(playerid, X, Y, Z);
	   	SetPlayerPos(playerid, X, Y, Z);
	   	ClearAnimations(playerid, 1);
	   	if(!ispassenger)
	   	{
	    	if((gettime() - Flooder[playerid]) > 3)
	   		{
	   			SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse veiculo esta apreendido!");
    			Flooder[playerid] = gettime();
    			return 1;
			}
		}
   	}
    else if(vTrancado[vehicleid] == true)
   	{
    	if(!new_strcmp(PlayerName(playerid), vDono[vehicleid]))
     	{
      		new Float:X, Float:Y, Float:Z;
	    	GetPlayerPos(playerid, X, Y, Z);
	    	SetPlayerPos(playerid, X, Y, Z);
	    	ClearAnimations(playerid, 1);
	    	SetVehicleParamsForPlayer(vehicleid, playerid, 0, 1);
	    	if(!ispassenger)
	    	{
		    	if((gettime() - Flooder[playerid]) > 3)
	    		{
	    			SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse veiculo esta trancado!");
	     			Flooder[playerid] = gettime();
	     			return 1;
				}
			}
			return 1;
   		}
   	}
   	else
	{
	    SetVehicleParamsForPlayer(vehicleid, playerid, 0, 0);
	}
	if(!ispassenger)
	{
	 	if(vehicleid == vFazendeiro[0] ||
		vehicleid == vFazendeiro[1] ||
		vehicleid == vFazendeiro[2] ||
		vehicleid == vFazendeiro[3] ||
		vehicleid == vFazendeiro[4] ||
		vehicleid == vFazendeiro[5] ||
		vehicleid == vFazendeiro[6] ||
		vehicleid == vFazendeiro[7] ||
		vehicleid == vFazendeiro[8])
    	{
   			if(ORG[playerid] < 0 && PROF[playerid] != FAZENDEIRO)
   			{
		    	new Float:X, Float:Y, Float:Z;
		    	GetPlayerPos(playerid, X, Y, Z);
		    	SetPlayerPos(playerid, X, Y, Z);
		    	ClearAnimations(playerid, 1);
	   			if((gettime() - Flooder[playerid]) > 3)
	   			{
		     		SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse veiculo e exclusivo da mafia");
		     		Flooder[playerid] = gettime();
				}
	   			return 1;
	        }
		}
		else if(vehicleid == vPrefeito)
		{
		    if(PROF[playerid] != PREFEITO)
   			{
   			    new bool:pode;
   			    if((gettime() - Flooder[playerid]) > 3)
	   			{
					foreach(Player, i)
					{
					    if(IsPlayerConnected(i) && Spawnado[i] == true && PROF[i] == PREFEITO && IsPlayerInVehicle(i, vPrefeito) && GetPlayerState(i) == PLAYER_STATE_PASSENGER)
					    {
							pode = true;
							break;
						}
					}
				}
				if(pode == false)
				{
				    new Float:X, Float:Y, Float:Z;
				   	GetPlayerPos(playerid, X, Y, Z);
				   	SetPlayerPos(playerid, X, Y, Z);
				   	ClearAnimations(playerid, 1);
			   		if((gettime() - Flooder[playerid]) > 3)
			   		{
			     		SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse veiculo e exclusivo do Prefeito");
			     		Flooder[playerid] = gettime();
					}
					return 1;
				}
	        }
		}
   		else if(vehicleid == vMafia[0] ||
		vehicleid == vMafia[1])
