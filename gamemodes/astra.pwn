//VOIP
public SV_VOID:OnPlayerActivationKeyPress(SV_UINT:playerid, SV_UINT:keyid)
{
	if(keyid == 0x42 && gstream[playerid])
	{
	    SvAttachSpeakerToStream(gstream[playerid], playerid);
	}
	if(keyid == 0x42 && FrequenciaConectada[playerid] >= 1){
		ApplyAnimation(playerid, "ped", "phone_talk", 4.1, 1, 1, 1, 0, 0, 0);
		if(!IsPlayerAttachedObjectSlotUsed(playerid, 9)) SetPlayerAttachedObject(playerid, 9, 19942, 2, 0.0300, 0.1309, -0.1060, 118.8998, 19.0998, 164.2999);
		SvAttachSpeakerToStream(Frequencia[FrequenciaConectada[playerid]], playerid);
	}
	else if(keyid == 0x42 && lstream[playerid] && MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0 && MUV[playerid] <= 0)
	{
		SvAttachSpeakerToStream(lstream[playerid], playerid); //local
		if(!IsPlayerInAnyVehicle(playerid) && Algemado[playerid] == 0 && SegundosAmarrado[playerid] == -1 && SegundosMorte[playerid] <= 0) ApplyAnimation(playerid, "PED","IDLE_CHAT", 4.1, 1, 1, 1, 1, 1, 1);
	}
	else if(keyid == 0x42 && lstream[playerid] && MUV[playerid] > 0)
	{
		MsgAviso(playerid, 3, "~r~Seu voip foi mutado por um admin");
		format(String, sizeof(String), "| ERRO | Seu VOIP esta mutado por %d minutos", (MUV[playerid] / 60) + 1);
		SendClientMessage(playerid, COR_ERRO, String);
	}
}

public SV_VOID:OnPlayerActivationKeyRelease(SV_UINT:playerid,SV_UINT:keyid)
{
    if(keyid == 0x42 && FrequenciaConectada[playerid] >= 1){
		SvDetachSpeakerFromStream(Frequencia[FrequenciaConectada[playerid]], playerid);
		ClearAnimations(playerid);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) RemovePlayerAttachedObject(playerid, 9);
	}
    else if(keyid == 0x42 && gstream[playerid])
	{
	    SvDetachSpeakerFromStream(gstream[playerid], playerid);
	}
	else if(keyid == 0x42 && lstream[playerid] && MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0 && MUV[playerid] <= 0)
	{
		SvDetachSpeakerFromStream(lstream[playerid], playerid);
		if(!IsPlayerInAnyVehicle(playerid) && Algemado[playerid] == 0 && SegundosAmarrado[playerid] == -1 && SegundosMorte[playerid] <= 0) ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
	}
}

public OnPlayerConnect(playerid)
{
	AstraModo[playerid] = ASTRA_MODO_NENHUM;
    //textanuncio
    PlayAudioStreamForPlayer(playerid, "http://stream.zeno.fm/uc6aandpsfhvv");

    //maper favela001
    RemoveBuildingForPlayer(playerid, 706, 1132.619, 486.453, 22.210, 0.250);
    RemoveBuildingForPlayer(playerid, 705, 1195.819, 455.710, 21.546, 0.250);
    RemoveBuildingForPlayer(playerid, 709, 1149.839, 437.070, 29.007, 0.250);

	FrequenciaConectada[playerid] = -1;
	new path[50],xNome[32]; GetPlayerName(playerid,xNome,sizeof(xNome));
	format(path,sizeof(path),"%s/%s.ini",PATH,xNome);
	if(!DOF2_FileExists(path)) DOF2_CreateFile(path);
	BuyRadio[playerid] = DOF2_GetInt(path,"BuyRadio");

	AbrindoCarro[playerid] = 0;
    EstaDesmanchando[playerid] = 0;
    EstaLavando[playerid] = 0;
	targetID[playerid] = INVALID_PLAYER_ID;
    Cinto[playerid] = 0;
	Farol[playerid] = 0;
	LimparChat(playerid, 80);
	if(new_strcmp(PlayerName(playerid), "Ninguem"))
	{
	    return Kick(playerid);
	}
    if(CountIP(GetIP(playerid)) > 3 || IsPlayerNPC(playerid)) Kick(playerid);
	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    for(new t; t < 4; t++)
    {
        TextDrawShowForPlayer(playerid, TextConnect[t]);
    }
	SendClientMessage(playerid, 0x1E90FFFF, "| INFO | Carregando os dados da cidade, aguarde...");
