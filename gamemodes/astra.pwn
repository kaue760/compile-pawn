						{
						    if(GetPlayerScore(playerid) < 15)
	    				    {
	    				        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce so pode comprar uma empresa a partir do level 15");
	    				    }
						    new valor = eAvenda[e];
						    if(Money[playerid] >= eAvenda[e])
						    {
	      						Money[playerid] -= eAvenda[e];
								new lucro = eLucro[e];
								eValor[e] = eAvenda[e];
								eLucro[e] = 0;
								eProducao[e] = 0;
								eImpostos[e] = 0;
								eAvenda[e] = 0;
	  				       		eContratando[e] = 0;
								new dono[MAX_PLAYER_NAME]; format(dono, sizeof(dono), "%s", eDono[e]);
								format(eDono[e], 23, "%s", PlayerName(playerid));
