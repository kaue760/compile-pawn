		        {
		            if(SlotSelecionado[playerid] > -1)
		            {
                  		if(ModeloItem[playerid][t-20] == 0 || QuantidadeSlotMochila[playerid][ItemSelecionado[playerid]] <= 1)
						{
       						if(SlotMochila[playerid][ItemSelecionado[playerid]] == MAGICBOX) return 0;
						    new item;
          					if(ModeloItem[playerid][t-20] > 0)
						    {
						        item = ModeloItem[playerid][t-20];
						        if(IsPlayerAttachedObjectSlotUsed(playerid, t-20)) RemovePlayerAttachedObject(playerid, t-20);
						    }
						    //
			                ModeloItem[playerid][t-20] = SlotMochila[playerid][ItemSelecionado[playerid]];
			                ItemPreviewRot(playerid, ModeloItem[playerid][t-20], TextInvP[playerid][t]);
			                PlayerTextDrawShow(playerid, TextInvP[playerid][t]);
			                //
							QuantidadeSlotMochila[playerid][ItemSelecionado[playerid]] --;
							new strquantidade[4];
							format(strquantidade, sizeof(strquantidade), "%d", QuantidadeSlotMochila[playerid][ItemSelecionado[playerid]]);
							if(QuantidadeSlotMochila[playerid][ItemSelecionado[playerid]] == 0)
							{
							    if(item == 0)
							    {
								    SlotMochila[playerid][ItemSelecionado[playerid]] = 0;
								    strquantidade = "";
								}
								else
								{
								    SlotMochila[playerid][ItemSelecionado[playerid]] = item;
								    QuantidadeSlotMochila[playerid][ItemSelecionado[playerid]] = 1;
								    strquantidade = "1";
								}
							}
                            if(PaginaAtual[playerid] == PaginaSelecionada[playerid])
	                     	{
								PlayerTextDrawSetString(playerid, TextInvP[playerid][SlotSelecionado[playerid]+25], strquantidade);
								PlayerTextDrawBackgroundColor(playerid, TextInvP[playerid][SlotSelecionado[playerid]], -196);
								ItemPreviewRot(playerid, SlotMochila[playerid][ItemSelecionado[playerid]], TextInvP[playerid][SlotSelecionado[playerid]]);
				                PlayerTextDrawShow(playerid, TextInvP[playerid][SlotSelecionado[playerid]]);
	                     	}
		   					//
          					SlotSelecionado[playerid] = -1;
	                        ItemSelecionado[playerid] = -1;
	                        PaginaSelecionada[playerid] = -1;
	                        SendClientMessage(playerid, -1, "| INFO | Voce se vestiu com um item, clique duas vezes nele para edita-lo");
	                        MsgAviso(playerid, 3, "~w~Clique ~b~2 vezes ~w~para edita-lo");
			                return 1;
						}
		            }
		            else if(ModeloItem[playerid][t-20] > 0 && VisualSelecionado[playerid] == -1)
		            {
						VisualSelecionado[playerid] = ModeloItem[playerid][t-20];
						SlotVisualSelecionado[playerid] = t;
			            PlayerTextDrawBackgroundColor(playerid, TextInvP[playerid][SlotVisualSelecionado[playerid]], 0xFA585855);
			            PlayerTextDrawShow(playerid, TextInvP[playerid][SlotVisualSelecionado[playerid]]);
			            Flooder[playerid] = gettime();
			            return 1;
					}
					else if(ModeloItem[playerid][t-20] > 0 && VisualSelecionado[playerid] > -1 && SlotVisualSelecionado[playerid] == t)
		            {
			            PlayerTextDrawBackgroundColor(playerid, TextInvP[playerid][SlotVisualSelecionado[playerid]], -196);
			            ItemPreviewRot(playerid, ModeloItem[playerid][t-20], TextInvP[playerid][t]);
			            PlayerTextDrawShow(playerid, TextInvP[playerid][SlotVisualSelecionado[playerid]]);
			            VisualSelecionado[playerid] = -1;
						SlotVisualSelecionado[playerid] = -1;
						if((gettime() - Flooder[playerid]) <= 1)
						{
							IndexEscolhido[playerid] = t-20;
							CancelSelectTextDraw(playerid);
							ShowPlayerDialog(playerid, D_ITEM, DIALOG_STYLE_LIST, "{FFFFFF}Escolha onde deseja usar esse item", "{FFFFFF}Tronco\nBra�o Esquerdo\nBra�o direito\nPerna Esquerda\nPerna Direita\nCabe�a", "Selecionar", "Cancelar");
						}
						return 1;
					}
		        }
			}
            for(new t = 1; t < 10; t++)//pegouitem
     		{
       			if(playertextid == TextColetarItemP[playerid][t])
		        {
					if(SlotEncontrado[playerid][t-1] > -1 && IsValidDynamicObject(Item[SlotEncontrado[playerid][t-1]]))
					{
					    new Float:P[3]; GetDynamicObjectPos(Item[SlotEncontrado[playerid][t-1]], P[0], P[1], P[2]);
					    if(IsPlayerInRangeOfPoint(playerid, 2.0, P[0], P[1], P[2]))
					    {
							for(new m; m < GetPlayerVoltas(playerid); m++)
					  		{
						        if(SlotMochila[playerid][m] == 0)
						        {
						            switch(GetDynamicObjectModel(Item[SlotEncontrado[playerid][t-1]]))
						            {
						                case 339:
						                {
						                    SlotMochila[playerid][m] = 8;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 341:
						                {
						                    SlotMochila[playerid][m] = 9;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 346:
						                {
						                    SlotMochila[playerid][m] = 22;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 347:
						                {
						                    SlotMochila[playerid][m] = 23;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 348:
						                {
						                    SlotMochila[playerid][m] = 24;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 349:
						                {
						                    SlotMochila[playerid][m] = 25;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 350:
						                {
						                    SlotMochila[playerid][m] = 26;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 351:
						                {
						                    SlotMochila[playerid][m] = 27;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 352:
						                {
						                    SlotMochila[playerid][m] = 28;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 353:
						                {
						                    SlotMochila[playerid][m] = 29;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 355:
						                {
						                    SlotMochila[playerid][m] = 30;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 356:
						                {
						                    SlotMochila[playerid][m] = 31;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                case 358:
						                {
						                    SlotMochila[playerid][m] = 34;
								            QuantidadeSlotMochila[playerid][m] = QuantidadeItem[SlotEncontrado[playerid][t-1]];
						                }
						                default:
							            {
								            SlotMochila[playerid][m] = GetDynamicObjectModel(Item[SlotEncontrado[playerid][t-1]]);
								            QuantidadeSlotMochila[playerid][m] = 1;
										}
						            }
						            DestroyDynamicObject(Item[SlotEncontrado[playerid][t-1]]);
		        					DestroyDynamic3DTextLabel(TextoItemEcontrado[playerid][t-1]);
							        Item[SlotEncontrado[playerid][t-1]] = 0;
							        SlotEncontrado[playerid][t-1] = -1;
							        PlayerTextDrawHide(playerid, TextColetarItemP[playerid][t]);
							        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0, 1);
							        return 1;
								}
							}
   							MsgAviso(playerid, 3, "~r~Seu inventario esta cheio");
							return 1;
					    }
					}
		        }
			}
			for(new t; t < 15; t++)
			{
			    if(playertextid == TextMegaSena[playerid][t+8])
		        {
		            for(new s; s < 3; s++)
		            {
		                if(NumeroSelecionado[playerid][s] == 0)
		                {
		                    NumeroSelecionado[playerid][s] = t+1;
		                    new strt[5]; format(strt, sizeof(strt), "%02d", NumeroSelecionado[playerid][s]);
		                    PlayerTextDrawSetString(playerid, TextMegaSena[playerid][s+23], strt);
		                    return 1;
		                }
		                else if(NumeroSelecionado[playerid][s] > 0 && playertextid == TextMegaSena[playerid][NumeroSelecionado[playerid][s]+7])
		                {
		                    NumeroSelecionado[playerid][s] = 0;
		                    PlayerTextDrawSetString(playerid, TextMegaSena[playerid][s+23], "");
		                    return 1;
		                }
		            }
		            return 1;
		        }
			}
		}
    }
    return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerClickTextDraw(playerid, clickedid);
    if(clickedid != Text:INVALID_TEXT_DRAW)
    {
        if(clickedid == TextCell[9])
        {
		    for(new t; t < 54; t++)
		    {
      			TextDrawHideForPlayer(playerid, TextCell[t]);
		    }
		    //
		    for(new t; t < 6; t++)
      		{
        		TextDrawHideForPlayer(playerid, TextBTC[t]);
        	}
	        for(new t; t < 2; t++)
	        {
	            PlayerTextDrawHide(playerid, TextBTCP[playerid][t]);
	        }
		    CancelSelectTextDraw(playerid);
        }
        else if(clickedid == TextCell[38])//radio
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Radioo");
     	}
     	else if(clickedid == TextCell[16])//BTC
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Btcc");
     	}
     	else if(clickedid == TextCell[30])//Banco
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Bancoo");
     	}
     	else if(clickedid == TextCell[36])//Taxi
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Taxi");
     	}
     	else if(clickedid == TextCell[22])//Policia
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/190");
     	}
     	else if(clickedid == TextCell[24])//SAMU
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/192");
     	}
     	else if(clickedid == TextCell[26])//Mecanico
		{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Mecanico");
     	}
     	else if(clickedid == TextCell[28])//Bombeiro
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/193");
     	}
     	else if(clickedid == TextCell[32])//camera
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/selfie");
     	    ShowPlayerDialog(playerid, 555, DIALOG_STYLE_MSGBOX, "{FFFFFF}Info Camera", "\n{FFFFFF}Use /Selfie Para fechar A Camera e /HeadMove Para parar A Movimentacao Da Cabeca", "Fechar", "");
     	}
     	else if(clickedid == TextCell[40])//Maps
     	{
     	    ShowPlayerDialog(playerid, D_ENVIARLOCALIZACAO, DIALOG_STYLE_INPUT, "{FFFFFF}Enviar Localiza�ao", "\n{FFFFFF}Digite o id do jogador para quem voce deseja enviar sua localiza�ao", "Enviar", "Cancelar");
     	}
     	else if(clickedid == TextCell[19])//Discord
     	{
     	    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Discord");
     	}
     	else if(clickedid == TextCell[21])//CONTATOS
     	{
     	    new str[1000], str2[100];
     	    strcat(str, "{ffff00}Adicionar Contato\n");
     	    for(new i; i < 30; i++)
     	    {
     	        if(NumeroContatoPlayer[playerid][i] < 0) NumeroContatoPlayer[playerid][i] = 0;
                if(!new_strcmp(NumeroContatoPlayer[playerid][i], "")) format(str2, sizeof(str2), "{FFFFFF}%02d  %s - %06d\n", i+1, ContatoPlayer[playerid][i], NumeroContatoPlayer[playerid][i]);
                else format(str2, sizeof(str2), "{FFFFFF}%02d  Nenhum - %06d\n", i+1, ContatoPlayer[playerid][i], NumeroContatoPlayer[playerid][i]);

     	        strcat(str, str2);
     	    }
     	    ShowPlayerDialog(playerid, D_ADDCTT, DIALOG_STYLE_LIST, "{6C28BE}Contato", str, "Proximo", "Cancelar");
     	}
        else if(clickedid == TextBarraquinhaSpawn[1])//piza
        {
			PickupStatus[playerid] = 1;
			TextDrawShowForPlayer(playerid, TextBarraquinhaSpawn[1]);
        }
        else if(clickedid == TextBarraquinhaSpawn[2])//coca
        {
			PickupStatus[playerid] = 2;
			TextDrawShowForPlayer(playerid, TextBarraquinhaSpawn[2]);
        }
        else if(clickedid == TextBarraquinhaSpawn[7])//comprar
        {
            if(PickupStatus[playerid] == 1)
            {
                if(Money[playerid] >= 50)
                {
	                ApplyAnimation(playerid, "DEALER", "shop_pay", 4.1, 0, 0, 0, 0, 0, 1);
	                if(!IsPlayerAttachedObjectSlotUsed(playerid, 5))
	                {
                		Money[playerid] -= 50;
		               	GameTextForPlayer(playerid, "~b~Pressione ~w~F", 2500, 3);
				        SegurandoMao[playerid] = PIZZA;
			         	SetPlayerAttachedObject(playerid, 5, 19580, 6, 0.0850, 0.0819, 0.0170, 132.8000, -79.3999, 50.9000, 0.4570, 0.4510, 0.9290, 0xFFFFFFFF, 0xFFFFFFFF);
				        SendClientMessage(playerid, -1, "| INFO | Voce comprou uma Pizza, pressione F para comer ou digite /guardar para guarda-la no inventario");
					}
					else
					{
						for(new m; m < GetPlayerVoltas(playerid); m++)
				    	{
							if(SlotMochila[playerid][m] == 0)
						    {
	   							Money[playerid] -= 50;
	                   			SlotMochila[playerid][m] = PIZZA;
	                            QuantidadeSlotMochila[playerid][m] = 1;
			                   	SendClientMessage(playerid, -1, "| INFO | Voce comprou uma Pizza e guardou no inventario");
			                   	PickupStatus[playerid] = -8;
			                   	for(new t; t < 10; t++)
							    {
							        TextDrawHideForPlayer(playerid, TextBarraquinhaSpawn[t]);
							    }
								CancelSelectTextDraw(playerid);
								return 1;
							}
						}
						PickupStatus[playerid] = -8;
						for(new t; t < 10; t++)
		    			{
					        TextDrawHideForPlayer(playerid, TextBarraquinhaSpawn[t]);
				    	}
						CancelSelectTextDraw(playerid);
						return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu inventario esta cheio");
					}
				}
                else
				{
				    SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
				}
            }
            else if(PickupStatus[playerid] == 2)
            {
                if(Money[playerid] >= 30)
                {
	                ApplyAnimation(playerid, "DEALER", "shop_pay", 4.1, 0, 0, 0, 0, 0, 1);
	                if(!IsPlayerAttachedObjectSlotUsed(playerid, 5))
	                {
                		Money[playerid] -= 30;
                  		GameTextForPlayer(playerid, "~b~Pressione ~w~F", 2500, 3);
                    	SegurandoMao[playerid] = COCA;
	                    SetPlayerAttachedObject(playerid, 5, 19822, 5, 0.1480, 0.1519, 0.1319, 142.9002, -17.5999, 58.7000, 0.5250, 0.5659, 0.5980, 0xFFFFFFFF, 0xFFFFFFFF);
	                    SendClientMessage(playerid, -1, "| INFO | Voce comprou uma Coca-Cola, pressione F para beber ou digite /guardar para guarda-la no inventario");
					}
					else
					{
						for(new m; m < GetPlayerVoltas(playerid); m++)
				    	{
							if(SlotMochila[playerid][m] == 0)
						    {
	   							Money[playerid] -= 30;
	                   			SlotMochila[playerid][m] = COCA;
	                            QuantidadeSlotMochila[playerid][m] = 1;
			                   	SendClientMessage(playerid, -1, "| INFO | Voce comprou uma Coca-Cola e guardou no inventario");
			                   	PickupStatus[playerid] = -8;
                       			for(new t; t < 10; t++)
							    {
							        TextDrawHideForPlayer(playerid, TextBarraquinhaSpawn[t]);
							    }
								CancelSelectTextDraw(playerid);
								return 1;
							}
						}
						PickupStatus[playerid] = -8;
						for(new t; t < 10; t++)
		    			{
					        TextDrawHideForPlayer(playerid, TextBarraquinhaSpawn[t]);
				    	}
						CancelSelectTextDraw(playerid);
						return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu inventario esta cheio");
					}
				}
                else
				{
				    SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
				}
            }
            PickupStatus[playerid] = -8;
            for(new t; t < 10; t++)
    		{
      			TextDrawHideForPlayer(playerid, TextBarraquinhaSpawn[t]);
           	}
			CancelSelectTextDraw(playerid);
			return 1;
        }
  		else if(clickedid == TextInv[7])//fechar inventario
		{
		    PlayerPlaySound(playerid, 6400, 0, 0, 0);
		    for(new t; t < 21; t++)
			{
			    TextDrawHideForPlayer(playerid, TextInv[t]);
		    }
		    for(new t; t < 46; t++)
			{
			    PlayerTextDrawHide(playerid, TextInvP[playerid][t]);
		    }
		    CancelSelectTextDraw(playerid);
		}
		else if(clickedid == TextInv[18])//veiculos inv
		{
		    PlayerPlaySound(playerid, 6400, 0, 0, 0);
		    SlotSelecionado[playerid] = -1; MenuSelecionado[playerid] = 1;
		    PlayerTextDrawShow(playerid, TextInvP[playerid][0]);
		    PlayerTextDrawShow(playerid, TextInvP[playerid][1]);
		    PlayerTextDrawShow(playerid, TextInvP[playerid][2]);

		    for(new t; t < 3; t++)
		    {
		    	PlayerTextDrawSetSelectable(playerid, TextInvP[playerid][t], 0); PlayerTextDrawShow(playerid, TextInvP[playerid][t]);
	    	}
		    for(new t = 17; t > 7; t--)
			{
			    PlayerTextDrawHide(playerid, TextInvP[playerid][t]);
		    }
		    for(new t = 28; t < 43; t++)
			{
			    PlayerTextDrawHide(playerid, TextInvP[playerid][t]);
		    }
            for(new i; i < 5; i++)
			{
			    if(ModeloVeiculoInv[playerid][i] > 0)
			    {
           			PlayerTextDrawSetPreviewRot(playerid, TextInvP[playerid][i+3], -10.000000, 0.000000, -20.000000, 1.000000);
			    }
			    else if(ModeloVeiculoInv[playerid][i] <= 0)
			    {
			        PlayerTextDrawSetPreviewRot(playerid, TextInvP[playerid][i+3], -10.000000, 0.000000, -20.000000, 111.000000);
			    }
			    //
			    PlayerTextDrawBackgroundColor(playerid, TextInvP[playerid][i+3], -196);
			    PlayerTextDrawSetPreviewModel(playerid, TextInvP[playerid][i+3], ModeloVeiculoInv[playerid][i]);
			    PlayerTextDrawShow(playerid, TextInvP[playerid][i+3]);
		    }
		}
        else if(clickedid == TextInv[17])//itens inv
		{
		    PlayerPlaySound(playerid, 6400, 0, 0, 0);
		    SlotSelecionado[playerid] = -1; MenuSelecionado[playerid] = 0; PaginaAtual[playerid] = 0;
		    for(new t; t < 3; t++)
		    {
		    	PlayerTextDrawSetSelectable(playerid, TextInvP[playerid][t], 1); PlayerTextDrawShow(playerid, TextInvP[playerid][t]);
	    	}
		    for(new i; i < 15; i++)
			{
			    PlayerTextDrawBackgroundColor(playerid, TextInvP[playerid][i+3], -196);
			    if(SlotMochila[playerid][i] > 0)
			    {
			        ItemPreviewRot(playerid, SlotMochila[playerid][i], TextInvP[playerid][i+3]);
					if(QuantidadeSlotMochila[playerid][i] == 0)
					{
			        	QuantidadeSlotMochila[playerid][i] = 1;
					}
			    }
			    else if(SlotMochila[playerid][i] == 0)
			    {
			        QuantidadeSlotMochila[playerid][i] = 0;
			        PlayerTextDrawSetPreviewRot(playerid, TextInvP[playerid][i+3], -10.000000, 0.000000, -20.000000, 111.000000);
			    }
			    PlayerTextDrawShow(playerid, TextInvP[playerid][i+3]);
			    //
			    new strquantidade[4];
		   		if(QuantidadeSlotMochila[playerid][i] > 0) format(strquantidade, sizeof(strquantidade), "%d", QuantidadeSlotMochila[playerid][i]);
		   		else strquantidade = "";
		    	PlayerTextDrawSetString(playerid, TextInvP[playerid][i+28], strquantidade);
		    }
		    for(new t = 28; t < 43; t++)
			{
			    PlayerTextDrawShow(playerid, TextInvP[playerid][t]);
		    }
		}
		else if(clickedid == TextColetarItem[2])
		{
    		for(new t; t < 3; t++)
		    {
		        TextDrawHideForPlayer(playerid, TextColetarItem[t]);
		    }
		    for(new t; t < 10; t++)
	   		{
	   			PlayerTextDrawHide(playerid, TextColetarItemP[playerid][t]);
	   			if(t <= 8) SlotEncontrado[playerid][t] = -1;
			}
            CancelSelectTextDraw(playerid);
 		}
		/*else if(clickedid == TextInv[13])//AJUDA
		{
		    PlayerPlaySound(playerid, 6400, 0, 0, 0);
		    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Ajuda");
		}
		else if(clickedid == TextInv[10])//MAPPS
		{
		    PlayerPlaySound(playerid, 6400, 0, 0, 0);
		    DialogMaps(playerid);
		}
		else if(clickedid == TextInv[12])//LOJA
		{
		    PlayerPlaySound(playerid, 6400, 0, 0, 0);
		    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Loja");
		}
		else if(clickedid == TextInv[11])//RG
		{
		    PlayerPlaySound(playerid, 6400, 0, 0, 0);
		    CallLocalFunction("OnPlayerCommandText", "is", playerid, "/rg");
		}*/
		else if(clickedid == TextInv[9])//USAR
		{
		    if(MenuSelecionado[playerid] == 0 && ItemSelecionado[playerid] > -1)
		    {
		        PlayerPlaySound(playerid, 6400, 0, 0, 0);
		        UsarItem(playerid, ItemSelecionado[playerid]);
		    }
		}
		else if(clickedid == TextInv[10])//DROPAR
		{
		    if(MenuSelecionado[playerid] == 0 && ItemSelecionado[playerid] > -1)
		    {
		        if(!IsPlayerInRangeOfPoint(playerid, 100.0, 1129.4084,-1463.0726,15.7919))
		        {
					switch(SlotMochila[playerid][ItemSelecionado[playerid]])
					{
						case 22..34:
