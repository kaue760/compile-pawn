	    ShowPlayerDialog(playerid, D_DETRAN, DIALOG_STYLE_LIST, "{FFFFFF}Detran", "{FFFFFF}Pagar Multas\nPagar IPVA\nLiberacao de Veiculos em Patio", "Selecionar", "Cancelar");
	}
	else if(checkpointid == CheckCartorio)
	{
	    ShowPlayerDialog(playerid, D_CARTORIO, DIALOG_STYLE_LIST, "{FFFFFF}Cartorio", "{FFFFFF}Trocar de Nome\nLogs de Registros", "Selecionar", "Cancelar");
	}
	else if(checkpointid == CheckAutoEscola)
	{
	    new stringg[300]; format(stringg, sizeof(stringg), "{FFFFFF}Habilitacao\t{008000}Valor\n{FFFFFF}Moto\t{008000}$800\n{FFFFFF}Carro\t{008000}$1200\n{FFFFFF}Caminhao\t{008000}$1500\n{FFFFFF}Onibus\t{008000}$2000\n{FFFFFF}Barco\t{008000}$2500\n{FFFFFF}Helicoptero\t{008000}$10000\n{FFFFFF}Aviao\t{008000}$15000");
	    ShowPlayerDialog(playerid, D_AUTOESCOLA, DIALOG_STYLE_TABLIST_HEADERS, "{FFFFFF}Auto Escola", stringg, "Selecionar", "Cancelar");
	}
	else if(checkpointid == CheckBS)
	{
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
		SendClientMessage(playerid, 0xAF90D4FF, "~~~~~~~~~~~~~~~~~~[{8541D9} MERCADORIAS BS {AF90D4}]~~~~~~~~~~~~~~~~~~");
		SendClientMessage(playerid, 0xAF90D4FF, "~>{FFFFFF} Seja bem-vindo(a) a Bayside!");
		SendClientMessage(playerid, 0xAF90D4FF, "~>{FFFFFF} Para pegar uma mercadoria use ~> /PegarMercadoria");
		SendClientMessage(playerid, 0xAF90D4FF, "~~~~~~~~~~~~~~~~~~[{8541D9} MERCADORIAS BS {AF90D4}]~~~~~~~~~~~~~~~~~~");
	}
	else if(checkpointid == Check1DP || checkpointid == Check2DP || checkpointid == CheckPresidio)
	{
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
		SendClientMessage(playerid, 0x1E90FFFF, "~~~~~~~~~~~~~~~~~~ DP ~~~~~~~~~~~~~~~~~~");
		SendClientMessage(playerid, 0x1E90FFFF, "{FFFFFF}/Presos ~> para ver a lista dos jogadores presos");
		SendClientMessage(playerid, 0x1E90FFFF, "{FFFFFF}/PagarFianca [Id] ~> para pagar a fianca de um jogador");
		SendClientMessage(playerid, 0x1E90FFFF, "{FFFFFF}/Procurados ~> para ver a lista dos jogadores procurados");
		SendClientMessage(playerid, 0x1E90FFFF, "{FFFFFF}/Porte ~> para comprar o teste do Porte de Armas");
		SendClientMessage(playerid, 0x1E90FFFF, "~~~~~~~~~~~~~~~~~~ DP ~~~~~~~~~~~~~~~~~~");
	}
	else if(checkpointid == CheckFerramentas)
	{
	    if(PROF[playerid] == MECANICO)
	    {
	    	ShowPlayerDialog(playerid, D_PEGARFERRAMENTAS, DIALOG_STYLE_INPUT, "{FFFFFF}Caixa de Ferramentas", "\n{FFFFFF}Digite a quantidade de Ferramentas que deseja pegar:", "Pegar", "Cancelar");
		}
		else
		{
		    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem permissao");
		}
	}
	else if(checkpointid == CheckSAMU[playerid])
	{
	    if(PROF[playerid] == PARAMEDICO)
	    {
	        if(SegurandoMao[playerid] == KITMEDICO)
    		{
				if(!IsPlayerInAnyVehicle(playerid))
				{
			    	SetTimerEx("Socorrer", 6000, false, "i", playerid);
			    	GameTextForPlayer(playerid, "~r~Socorrendo ~w~Jogador...", 5500, 3);
			    	ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 0, 0, 0, 0, 0, 1);
				}
				else
				{
				    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Saia do veiculo para socorrer");
				}
			}
			else
			{
			    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce precisa esta segurando um Kit Medico para socorrer");
			}
		}
		else
		{
		    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem permissao");
		}
	}
	else if(checkpointid == CheckSup[0] || checkpointid == CheckSup[1] || checkpointid == CheckSup[2] || checkpointid == CheckSup[3] || checkpointid == CheckSup[4] || checkpointid == CheckSup[5])
	{
		ShowPlayerDialog(playerid, D_SUP, DIALOG_STYLE_TABLIST_HEADERS, "{5F04B4}Supermercado", "{FFFFFF}Produto\t{228B22}Valor\n{FFFFFF}Vender cacas\t{228B22}$150 un.\n{FFFFFF}Vender Peixes\t{228B22}$250 un.\n{FFFFFF}Celular\t{228B22}$1000\n{FFFFFF}Creditos p/ Celular\t{228B22}$2 un.\n{FFFFFF}Comprar Chip\t{228B22}$10000\n{FFFFFF}Sem Parar\t{228B22}$15000\n{FFFFFF}Kit Reparo\t{228B22}$1000\n{FFFFFF}Inventario 2\t{228B22}$25000\n{FFFFFF}Inventario 3\t{228B22}$50000\n{FFFFFF}Radio\t{228B22}$1000", "Selecionar", "Cancelar");
	}
	else if(checkpointid == CheckCardapio[0] || checkpointid == CheckCardapio[1] || checkpointid == CheckCardapio[2] || checkpointid == CheckCardapio[3] || checkpointid == CheckCardapio[4] || checkpointid == CheckCardapio[5] || checkpointid == CheckCardapio[6] || checkpointid == CheckCardapio[7] || checkpointid == CheckCardapio[8] || checkpointid == CheckCardapio[9] || checkpointid == CheckCardapio[10])
	{
        if(checkpointid == CheckCardapio[5])
	    {
	        EntrouEmpresa[playerid] = 98;
	        SetPlayerVirtualWorld(playerid, 0);
	    }
		ShowPlayerDialog(playerid, D_CARDAPIO, DIALOG_STYLE_TABLIST_HEADERS, "{FF8C00}Cardapio", "{FFFFFF}Produto\t{228B22}Valor\n{FFFF00}>>> LANCHES <<<\n{FFFFFF}X-Burger\t{228B22}$10\n{FFFFFF}X-Bacon\t{228B22}$40\n{FFFFFF}X-Tudo\t{228B22}$50\n{FFFFFF}Pizza\t{228B22}$100\n{FFFF00}>>> BEBIDAS <<<\n{FFFFFF}Coca-Cola\t{228B22}$100\n{FFFFFF}Fanta Uva\t{228B22}$50\n{FFFFFF}Guarana\t{228B22}$50\n{FFFFFF}Suco\t{228B22}$30\n", "Selecionar", "Cancelar");
	}
	else if(checkpointid == CheckBar[0] || checkpointid == CheckBar[1] || checkpointid == CheckBar[2] || checkpointid == CheckBar[3] || checkpointid == CheckBar[4] || checkpointid == CheckBar[5] || checkpointid == CheckBar[6] || checkpointid == CheckBar[7] || checkpointid == CheckBar[8])
	{
		if(checkpointid == CheckBar[6])
		{
		    EntrouEmpresa[playerid] = 100;
		}
		ShowPlayerDialog(playerid, D_CHECKBAR, DIALOG_STYLE_TABLIST_HEADERS, "{FF8C00}Cardapio", "{FFFFFF}Produto\t{228B22}Valor\n{FFFFFF}Heineken\t{228B22}$100\n{FFFFFF}Budweiser\t{228B22}$100\n{FFFFFF}Whisky\t{228B22}$80\n{FFFFFF}Vodka\t{228B22}$100\n{FFFFFF}Energetico\t{228B22}$100\n{FFFFFF}Vinho\t{228B22}$50\n{FFFFFF}Coca-Cola\t{228B22}$100\n{FFFFFF}Fanta Uva\t{228B22}$50\n{FFFFFF}Guarana\t{228B22}$50\n{FFFFFF}Suco\t{228B22}$30\n", "Selecionar", "Cancelar");
	}
	else if(checkpointid == CheckAreaVip)
	{
	    if(VIP[playerid] > 0 || NivelAdmin[playerid] > 0 || IsPlayerAdmin(playerid))
	    {
	        ShowPlayerDialog(playerid, D_AREAVIP, DIALOG_STYLE_LIST, "{FFFFFF}Area {00FF00}VIP", "{FFFFFF}Soco Ingles\nTaco de Golf\nTaco de Beisebol\nTaco de Sinuca\nFaca\nKatana\nPa\nMotosserra\nDildo Roxo\nDildo\nVibrador\nVibrador de Prata\nBuque de Flores\nBengala\nSpray\nCamera\nOculos de visao Noturna\nOculos Termico\nParaquedas\nPistola 9mm\nPistola Silenced\nDesert Eagle\n{58FA58}Kit Corrida", "Selecionar", "Fechar");
	    }
	    else
	    {
	        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao e um jogador(a) VIP");
	    }
	}
	else if(checkpointid == CheckSex)
	{
	    ShowPlayerDialog(playerid, D_CHECKSEX, DIALOG_STYLE_TABLIST_HEADERS, "{FF00BF}Sex Shop", "{FFFFFF}Produto\t{088A08}Valor\n{FFFFFF}Purple Dildo\t{088A08}1000\n{FFFFFF}Dildo\t{088A08}500\n{FFFFFF}Vibrador\t{088A08}1000\n{FFFFFF}Vibrador Prata\t{088A08}700\n{FFFFFF}Buque de Flores\t{088A08}1000", "Comprar", "Cancelar");
	}
	else if(checkpointid == CheckPesca[playerid])
	{
 		if(Pescando[playerid] == true)
   		{
	      	new Float:X, Float:Y, Float:Z; GetPlayerPos(playerid, X, Y, Z); SetPlayerPos(playerid, X, Y, Z);
		   	ApplyAnimation(playerid, "SAMP", "FISHINGIDLE", 4.1, 1, 0, 0, 0, 0, 1);
		   	GameTextForPlayer(playerid, "~b~~h~Pescando...", 2500, 5);
		   	if(!IsPlayerAttachedObjectSlotUsed(playerid, 6))
		   	{
		   		SetPlayerAttachedObject(playerid, 6, 18632, 5, 0.0980, 0.0359, -0.0410, 0.0000, -13.5999, 0.0000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF);
			}
		}
		else
		{
		    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao iniciou uma pescaria");
		}
	}
	else if(checkpointid == CheckArvore[playerid])
	{
	    if(PROF[playerid] == LENHADOR)
	    {
	        if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 478 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	        {
	            if(GetPlayerSpeed(playerid) <= 15)
	            {
	                GameTextForPlayer(playerid, "~g~Carregando ~w~Arvore", 3000, 3);
	                SetTimerEx("CarregarArvore", 2990, false, "i", playerid);
	                TogglePlayerControllable(playerid, 0);
	            }
	            else
	            {
	                return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu veiculo precisa esta parado");
	            }
	        }
	        else
	        {
	            return SendClientMessage(playerid, COR_ERRO, "| ERRO | Pegue o veiculo de lenhador para pegar essa arvore");
	        }
	    }
	}
	else if(checkpointid == CheckArmas[0] || checkpointid == CheckArmas[1])
	{
	    if(checkpointid == CheckArmas[0])
	    {
	        if(DonoFavela[0] != ORG[playerid] && DonoFavela[0] != PROF[playerid])
	        {
	            return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem permissao para acessar essa favela");
	        }
	    }
	    else if(checkpointid == CheckArmas[1])
	    {
	        if(DonoFavela[1] != ORG[playerid] && DonoFavela[1] != PROF[playerid])
	        {
	            return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem permissao para acessar essa favela");
	        }
	    }
	    if(PRODUZINDOARMA[playerid] == -1)
	    {
		    new gstring[400], pstring[60];
			format(pstring, sizeof(pstring), "{FFFFFF}Produzir Arma\t{FFFF00}Materiais Necessarios\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}Pistola 9mm\t{FFFF00}1\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}Pistola Silenced\t{FFFF00}2\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}Desert Eagle\t{FFFF00}3\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}ShotGun\t{FFFF00}5\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}Saw-noff Shotgun\t{FFFF00}8\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}Combat Shotgun\t{FFFF00}7\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}MP5\t{FFFF00}6\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}UZI\t{FFFF00}5\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}AK-47\t{FFFF00}10\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}M4\t{FFFF00}10\n");
			strcat(gstring, pstring);
			format(pstring, sizeof(pstring), "{FFFFFF}Sniper\t{FFFF00}20\n");
			strcat(gstring, pstring);
		    ShowPlayerDialog(playerid, D_BOTARMAS, DIALOG_STYLE_TABLIST_HEADERS, "{FF4040}Traficante Ze Pequeno", gstring, "Produzir", "Cancelar");
		}
	}
	else
	{
	    for(new c; c < 3; c++)
	    {
	        if(checkpointid == CheckC[playerid][c])
	        {
	            if(PROF[playerid] == MOTOBOY && CargaMoto[playerid] > -1)
	            {
	                if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 581 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	                {
			            if(GetPlayerSpeed(playerid) <= 15)
			            {
				            DestroyDynamicCP(CheckC[playerid][c]); DestroyDynamicMapIcon(MapC[playerid][c]);
				            CheckC[playerid][c] = -1; MapC[playerid][c] = -1;
							SetTimerEx("DescarregarMoto", 3000, false, "i", playerid);
							GameTextForPlayer(playerid, "~w~Entregando ~g~Mercadorias...", 2500, 4);
							TogglePlayerControllable(playerid, 0);
							return 1;
						}
						else
						{
						    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Sua moto precisa esta parada para descarregar");
						}
					}
					else
					{
					    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta dirigindo uma moto");
					}
				}
				else
				{
				    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem permissao");
				}
	        }
	    }
        for(new g; g < MAX_ORG; g++)
		{
		    if(checkpointid == gCheck[g])
			{
       			if(ORG[playerid] >= 0 && ORG[playerid] != g && InvasaoOrg[g] <= 0 && !IsPlayerInAnyVehicle(playerid))
			    {
       				if(!VerifyExpiredDays(gTimer[ORG[playerid]]))
			        {
				        if(!VerifyExpiredDays(gTimer[g]))
				        {
	        				PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], "Invasao");
			           		PlayerTextDrawShow(playerid, TextProduzirArma[playerid]);
			           		SetPlayerProgressBarMaxValue(playerid, barfabarmas[playerid], 100.0);
						    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], InvasaoOrg[g]);
						    ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
							SetTimerEx("Invasao", 100, false, "dd", playerid, g);
						    return 1;
						}
						else
						{
			  				MsgAviso(playerid, 5, "~w~ESSA ORGANIZACAO NAO PODE SER INVADIDA NO MOMENTO");
			  				SendClientMessage(playerid, COR_ERRO, "| ERRO | Essa Organizacao esta com o modo invasao desativado");
			  				return 1;
						}
					}
					else
					{
			  			MsgAviso(playerid, 5, "~w~SUA ORGANIZACAO NAO PODE INVADIR");
			  			SendClientMessage(playerid, COR_ERRO, "| ERRO | Sua Organizacao esta com o modo invasao desativado e nao pode invadir outras organizacoes");
			  			return 1;
					}
                }
				else if(ORG[playerid] == g && !IsPlayerInAnyVehicle(playerid))
				{
					new Titulo[60]; format(Titulo, sizeof(Titulo), "{FFFFFF}Organizacao: {%s}%s[%d]", gCor[g], gNome[g], g);
					ShowPlayerDialog(playerid, D_ORG, DIALOG_STYLE_LIST, Titulo, "INFORMACOES\nNome da Org\nCor da Org\nVeiculo da Org\nCor do Veiculo\nSkin\nPegar Skin\nValor das entregas\nComandos Org\nAtivar Invasao\nRenovar Org", "Selecionar", "Fechar");
				    return 1;
				}
				else
				{
				    MsgAviso(playerid, 3, "~w~VOCE NAO PERTENCE A NENHUMA ORGANIZACAO");
		  			SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao pertence a nenhuma Organizacao");
		  			return 1;
				}
			}
		}
	    //
		foreach(Player, i)
		{
		    if(checkpointid == CheckVendedor[i])
			{
			    new nomebarraca[40]; format(nomebarraca, sizeof(nomebarraca), "{FF8C00}Barraca de {FFFFFF}%s[%d]", PlayerName(i), i);
			    ShowPlayerDialog(playerid, D_CARDAPIO, DIALOG_STYLE_TABLIST_HEADERS, nomebarraca, "{FFFFFF}Produto\t{228B22}Valor\n{FFFF00}>>> LANCHES <<<\n{FFFFFF}X-Burger\t{228B22}$10\n{FFFFFF}X-Bacon\t{228B22}$40\n{FFFFFF}X-Tudo\t{228B22}$50\n{FFFFFF}Pizza\t{228B22}$100\n{FFFF00}>>> BEBIDAS <<<\n{FFFFFF}Coca-Cola\t{228B22}$100\n{FFFFFF}Fanta Uva\t{228B22}$50\n{FFFFFF}Guarana\t{228B22}$50\n{FFFFFF}Suco\t{228B22}$30\n", "Selecionar", "Cancelar");
				return 1;
			}
		}
	}
	return 1;
}

