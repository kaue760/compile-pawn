			        InPedagioSP[i] = 0;
			    }
			}
			else
			{
				for(new p; p < 20; p++)
				{
					if(IsPlayerInRangeOfPoint(i, PosPedagio[p][3], PosPedagio[p][0], PosPedagio[p][1], PosPedagio[p][2]) && GetPlayerState(i) == PLAYER_STATE_DRIVER)
					{
						if(SemParar[i] == 1)
						{
							new idpedagio = floatround(PosPedagio[p][4], floatround_round), Float:P[3];
							if(IsValidDynamicObject(pedagio[idpedagio]) && !IsDynamicObjectMoving(pedagio[idpedagio]))
							{
							    GetDynamicObjectRot(pedagio[idpedagio], P[0], P[1], P[2]);
							    if(P[1] == 90.0 || P[1] == -90.0)
							    {
	       							InPedagioSP[i] = 1;
									SendClientMessage(i, COR_BRANCO, "| PEDAGIO | Sem Parar ativado, passagem liberada! Boa Viagem!");
		       						MoveDynamicObject(pedagio[idpedagio], PosOriginalPedagio[idpedagio][0], PosOriginalPedagio[idpedagio][1], PosOriginalPedagio[idpedagio][2]-0.2, 0.1, PosOriginalPedagio[idpedagio][3], PosOriginalPedagio[idpedagio][4]+85.0, PosOriginalPedagio[idpedagio][5]);
								    SetTimerEx("FecharPedagio", 6000, false, "ii", pedagio[idpedagio], idpedagio);
								}
							}
						}
