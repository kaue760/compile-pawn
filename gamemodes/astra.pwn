stock GetId(id)
{
	foreach(Player, i)
	{
	    if(IsPlayerConnected(i) && id_fixo[i] == id) return i;
	}
	return 500;
}

stock AttTag(playerid)
{
	if(VIP[playerid] >= 1)
    {
        new TagV[7];
	   	for(new t; t < 6; t++)
	    {
	        TagV[t] = CORTAGVIP[playerid][t+2];
	    }
       	format(myid[playerid], 12, "{%s}VIP", TagV);
       	return 1;
	}
	return 1;
}

stock CreateStrip(Float:x,Float:y,Float:z,Float:Angle)
{
    for(new p = 0; p < sizeof(SpikeInfo); p++)
  	{
  	    if(SpikeInfo[p][sCreated] == 0)
  	    {
            SpikeInfo[p][sCreated]=1;
            SpikeInfo[p][sX]=x;
            SpikeInfo[p][sY]=y;
            SpikeInfo[p][sZ]=z-0.7;
            SpikeInfo[p][sObject] = CreateDynamicObject(2899, x, y, z-0.9, 0, 0, Angle-90);
	        return 1;
  	    }
  	}
  	return 0;
}

stock DeleteAllStrip()
{
    for(new i = 0; i < sizeof(SpikeInfo); i++)
  	{
  	    if(SpikeInfo[i][sCreated] == 1)
  	    {
  	        SpikeInfo[i][sCreated]=0;
            SpikeInfo[i][sX]=0.0;
            SpikeInfo[i][sY]=0.0;
            SpikeInfo[i][sZ]=0.0;
            DestroyDynamicObject(SpikeInfo[i][sObject]);
  	    }
	}
    return 0;
}

stock DeleteClosestStrip(Float:x,Float:y,Float:z)
{
    for(new i = 0; i < sizeof(SpikeInfo); i++)
  	{
  	    if(IsPointInRangeOfPoint(x, y, z, SpikeInfo[i][sX], SpikeInfo[i][sY], SpikeInfo[i][sZ], 2.0))
        {
  	        if(SpikeInfo[i][sCreated] == 1)
            {
                SpikeInfo[i][sCreated]=0;
                SpikeInfo[i][sX]=0.0;
                SpikeInfo[i][sY]=0.0;
                SpikeInfo[i][sZ]=0.0;
                DestroyDynamicObject(SpikeInfo[i][sObject]);
                //return 1;
  	        }
  	    }
  	}
    return 0;
}
stock uQ_ResetDrop(xArmaid){
	BSArmas[xArmaid] = 0;
	BSQntMunc[xArmaid] = 0;
	DestroyDynamicObject(BSDefObj[xArmaid]);
	BSPos[0][xArmaid] = 0.0;
	BSPos[1][xArmaid] = 0.0;
	BSPos[2][xArmaid] = 0.0;
	BSSenha[xArmaid] = 0;
	BS_TimeDrp[xArmaid] = 0;
    return 1;
}
encode_tires(tires1, tires2, tires3, tires4) {

	return tires1 | (tires2 << 1) | (tires3 << 2) | (tires4 << 3);

}

stock RemovePlayerWeapon(playerid, weaponid)
{
	new pWeaponData[13][2];
	for (new i = 0; i < 13; i++)
	{
	    GetPlayerWeaponData(playerid, i, pWeaponData[i][0], pWeaponData[i][1]);
	}

	ResetPlayerWeaponsExC(playerid);
	for(new i=0; i<13; i++)
	{
		if(pWeaponData[i][0] != 0 && pWeaponData[i][0] != weaponid)
		{
			GivePlayerWeaponExC(playerid, pWeaponData[i][0], pWeaponData[i][1]);
		}
	}
	return 0;
}

stock GerarCodigo(caracteres)
{
    		new Codigo[31];
		    for(new c; c < caracteres; c++)
		    {
		        new r = random(36);
		        if(r == 0){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "Q");}else{format(Codigo[c], 20, "a");}}
		        else if(r == 1){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "W");}else{format(Codigo[c], 20, "w");}}
		        else if(r == 2){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "E");}else{format(Codigo[c], 20, "e");}}
		        else if(r == 3){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "R");}else{format(Codigo[c], 20, "r");}}
		        else if(r == 4){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "T");}else{format(Codigo[c], 20, "t");}}
		        else if(r == 5){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "Y");}else{format(Codigo[c], 20, "y");}}
		        else if(r == 6){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "U");}else{format(Codigo[c], 20, "u");}}
		        else if(r == 7){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "I");}else{format(Codigo[c], 20, "i");}}
		        else if(r == 8){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "O");}else{format(Codigo[c], 20, "o");}}
		        else if(r == 9){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "P");}else{format(Codigo[c], 20, "p");}}
		        else if(r == 10){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "A");}else{format(Codigo[c], 20, "a");}}
		        else if(r == 11){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "S");}else{format(Codigo[c], 20, "s");}}
		        else if(r == 12){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "D");}else{format(Codigo[c], 20, "d");}}
		        else if(r == 13){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "F");}else{format(Codigo[c], 20, "f");}}
		        else if(r == 14){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "G");}else{format(Codigo[c], 20, "g");}}
		        else if(r == 15){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "H");}else{format(Codigo[c], 20, "h");}}
		        else if(r == 16){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "J");}else{format(Codigo[c], 20, "j");}}
		        else if(r == 17){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "K");}else{format(Codigo[c], 20, "k");}}
		        else if(r == 18){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "L");}else{format(Codigo[c], 20, "l");}}
		        else if(r == 19){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "Z");}else{format(Codigo[c], 20, "z");}}
		        else if(r == 20){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "X");}else{format(Codigo[c], 20, "x");}}
		        else if(r == 21){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "C");}else{format(Codigo[c], 20, "c");}}
		        else if(r == 22){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "V");}else{format(Codigo[c], 20, "v");}}
		        else if(r == 23){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "B");}else{format(Codigo[c], 20, "b");}}
		        else if(r == 24){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "N");}else{format(Codigo[c], 20, "n");}}
		        else if(r == 25){new rr = random(2);if(rr == 0){format(Codigo[c], 20, "M");}else{format(Codigo[c], 20, "m");}}
		        else if(r == 26){format(Codigo[c], 20, "0");}
		        else if(r == 27){format(Codigo[c], 20, "1");}
		        else if(r == 28){format(Codigo[c], 20, "2");}
		        else if(r == 29){format(Codigo[c], 20, "3");}
		        else if(r == 30){format(Codigo[c], 20, "4");}
