						    {
						        SlotMochila[i][m] = 0;
						        QuantidadeSlotMochila[i][m] = 0;
						    }
						}
				    }
				    PegouMercadoria[i] = 0;
				    RecebeuSalario[i] = 0;
				    //SalvarPlayer(i);
				}
		 		if(sUP[i] < 0)
		 		{
		 		    mUP[i] --;
		 		    sUP[i] = 59;
		 		    if(mUP[i] < 0)
		 		    {
		 		        if(VIP[i] > 0 && TIPOVIP[i] == 0)
		 		        {
		 		            mUP[i] = 49;
		 		        }
		 		        else if(VIP[i] > 0 && TIPOVIP[i] == 1)
		 		        {
		 		            mUP[i] = 39;
		 		        }
		 		        else if(VIP[i] > 0 && TIPOVIP[i] == 2)
		 		        {
		 		            mUP[i] = 29;
		 		        }
		 		        else
		 		        {
		 		            mUP[i] = 59;
		 		        }
		 		    }
		 		}
		 		new Str[23]; format(Str, sizeof(Str), "+~b~~h~~h~UP_~w~%02d:%02d", mUP[i], sUP[i]);
				PlayerTextDrawSetString(i, StatusP[i][0], Str);
			}
			else
			{
			    new Str[23]; format(Str, sizeof(Str), "+~b~~h~~h~UP_~w~PAUSADO");
