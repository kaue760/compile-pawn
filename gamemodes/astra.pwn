forward BlindandoVeiculo(playerid);
public BlindandoVeiculo(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		if(PRODUZINDOARMA[playerid] < 100)
		{
		    PRODUZINDOARMA[playerid] += 2;
			new StrT[35]; format(StrT, sizeof(StrT), "Blindando_%s:_%d%", NomeVeiculo(GetPlayerVehicleID(playerid)), PRODUZINDOARMA[playerid]);
	   		PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], StrT);
		    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], PRODUZINDOARMA[playerid]);
		   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
			TempoProducaoArma[playerid] = SetTimerEx("BlindandoVeiculo", 200, false, "i", playerid);
		}
		else
		{
		    PRODUZINDOARMA[playerid] = -1;
		    TogglePlayerControllable(playerid, 1);
		    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
	     	PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
			GameTextForPlayer(playerid, "~b~Veiculo Blindado!", 3000, 3);
			PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
			RepairVehicle(GetPlayerVehicleID(playerid));
			SetVehicleHealth(GetPlayerVehicleID(playerid), 100000);
