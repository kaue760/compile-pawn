stock CheckCaseSensitivity(nick[])
{
    for(new i; i < strlen(nick); i++)
	{
		if(nick[i] == 'Q'){nick[i] = 'q';}
		else if(nick[i] == 'W'){nick[i] = 'w';}
		else if(nick[i] == 'E'){nick[i] = 'e';}
		else if(nick[i] == 'R'){nick[i] = 'r';}
		else if(nick[i] == 'T'){nick[i] = 't';}
		else if(nick[i] == 'Y'){nick[i] = 'y';}
		else if(nick[i] == 'U'){nick[i] = 'u';}
		else if(nick[i] == 'I'){nick[i] = 'i';}
		else if(nick[i] == 'O'){nick[i] = 'o';}
		else if(nick[i] == 'P'){nick[i] = 'p';}
		else if(nick[i] == 'A'){nick[i] = 'a';}
		else if(nick[i] == 'S'){nick[i] = 's';}
		else if(nick[i] == 'D'){nick[i] = 'd';}
		else if(nick[i] == 'F'){nick[i] = 'f';}
		else if(nick[i] == 'G'){nick[i] = 'g';}
		else if(nick[i] == 'H'){nick[i] = 'h';}
		else if(nick[i] == 'J'){nick[i] = 'j';}
		else if(nick[i] == 'K'){nick[i] = 'k';}
		else if(nick[i] == 'L'){nick[i] = 'l';}
		/*else if(nick[i] == ''){nick[i] = ';}*/
		else if(nick[i] == 'Z'){nick[i] = 'z';}
		else if(nick[i] == 'X'){nick[i] = 'x';}
		else if(nick[i] == 'C'){nick[i] = 'c';}
		else if(nick[i] == 'V'){nick[i] = 'v';}
		else if(nick[i] == 'B'){nick[i] = 'b';}
		else if(nick[i] == 'N'){nick[i] = 'n';}
		else if(nick[i] == 'M'){nick[i] = 'm';}
		/*else if(nick[i] == '0'){nick[i] = '0';}
		else if(nick[i] == '1'){nick[i] = '1';}
		else if(nick[i] == '2'){nick[i] = '2';}
		else if(nick[i] == '3'){nick[i] = '3';}
		else if(nick[i] == '4'){nick[i] = '4';}
		else if(nick[i] == '5'){nick[i] = '5';}
		else if(nick[i] == '6'){nick[i] = '6';}
		else if(nick[i] == '0'){nick[i] = '7';}
		else if(nick[i] == '8'){nick[i] = '8';}
		else if(nick[i] == '9'){nick[i] = '9';}
		else if(nick[i] == '_'){nick[i] = '_';}
		else if(nick[i] == '['){nick[i] = '[';}
		else if(nick[i] == ']'){nick[i] = ']';}
		else if(nick[i] == '@'){nick[i] = '@';}
		else if(nick[i] == '.'){nick[i] = '.';}*/
	}
    new StringConta[50];
    format(StringConta, sizeof(StringConta), "ContasSensitivity/%s.ini", nick);
    if(!DOF2_FileExists(StringConta))
    {
        DOF2_CreateFile(StringConta);
        return 1;
    }
	return 0;
}

