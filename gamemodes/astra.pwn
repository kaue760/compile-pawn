						    }
                            GivePlayerWeaponExC(playerid, M4, MunicaoPortaMala[idv][p]);
						    PortaMalas[idv][p] = 0; MunicaoPortaMala[idv][p] = 0;
						    ApplyAnimation(playerid, "RIFLE", "RIFLE_LOAD", 4.1, 0, 0, 0, 0, 0, 1);
						}
						else if(PortaMalas[idv][p] == SNIPER)
						{
						    if(Porte[playerid] <= 0)
					    	{
						       /*return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao possui porte de armas");*/
						    }
                            GivePlayerWeaponExC(playerid, SNIPER, MunicaoPortaMala[idv][p]);
						    PortaMalas[idv][p] = 0; MunicaoPortaMala[idv][p] = 0;
						    ApplyAnimation(playerid, "RIFLE", "RIFLE_LOAD", 4.1, 0, 0, 0, 0, 0, 1);
						}
						else if(PortaMalas[idv][p] == CIGARRODEMACONHA)
						{
						    SendClientMessage(playerid, -1, "| INFO | Voce esta fumando 1 cigarro de maconha");
							if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_NONE)
							{
							    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_SMOKE_CIGGY);
							}
							PortaMalas[idv][p] = 0; MunicaoPortaMala[idv][p] = 0;
						   	ApplyAnimation(playerid,"SMOKING", "M_SMK_IN", 4.1, 0, 0, 0, 0, 0, 1);
						   	new Float:Colete; GetPlayerArmour(playerid, Colete);
					        if(Colete < 50.0)
					        {
					        	SetPlayerArmour(playerid, Colete + 25.0);
					        	new NivelBebado = GetPlayerDrunkLevel(playerid);
								SetPlayerDrunkLevel(playerid, NivelBebado + 5000 + random(5001));
							}
						}
						else
						{
						    PortaMalas[idv][p] = 0; MunicaoPortaMala[idv][p] = 0;
						}
						if(!new_strcmp(vDono[idv], "Ninguem"))
   						{
   						    new StrG[50]; format(StrG, sizeof(StrG), "Veiculos/%s.ini", vDono[idv]);
   						    foreach(Player, i)
   						    {
						      	for(new v; v < 5; v++)
						       	{
						       	    if(idv == pVeiculoInv[i][v])
						       	    {
						       			new KeyV[20]; format(KeyV, sizeof(KeyV), "VeiculoSlot%d%d", p, v);
						       			DOF2_SetInt(StrG, KeyV, PortaMalas[idv][p]);
						       			DOF2_SetInt(StrG, "VeiculoMunicao0", MunicaoPortaMala[idv][0]);
									    DOF2_SetInt(StrG, "VeiculoMunicao1", MunicaoPortaMala[idv][1]);
									    DOF2_SetInt(StrG, "VeiculoMunicao2", MunicaoPortaMala[idv][2]);
									    DOF2_SetInt(StrG, "VeiculoMunicao3", MunicaoPortaMala[idv][3]);
									    DOF2_SetInt(StrG, "VeiculoMunicao4", MunicaoPortaMala[idv][4]);
									    DOF2_SaveFile();
						       			break;
						       	    }
						       	}
							}
						}
		            }
		        }
			}
		}
