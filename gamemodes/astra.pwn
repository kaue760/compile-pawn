	return 1;
}forward Cr_RepCofre(xCofre);
public Cr_RepCofre(xCofre){
	new string[128];
    Cr_StCofres[xCofre] = 0;
    DestroyDynamicObject(Cr_pObjCofre[xCofre]);
    Cr_pObjCofre[xCofre] = CreateDynamicObject(2332, Cr_PosCofres[xCofre][0], Cr_PosCofres[xCofre][1], Cr_PosCofres[xCofre][2]-0.55, 0.0, 0.0, Cr_PosCofres[xCofre][3]-180.0);
	format(string, sizeof(string), "Cofre\n{FFFFFF}/cofre");
	UpdateDynamic3DTextLabelText(Cr_TxtLbcofre[xCofre], 0xFF0000FF, string);
	return 1;
}
public OnPlayerEditObject(playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	if(response == 1)
	{
		for(new i; i < 40; i++)
		{
	    	format(String, sizeof(String), "CaixasEletronicos/%d.ini", i);
	    	if(!DOF2_FileExists(String))
	    	{
	    	    DOF2_CreateFile(String);
	    	    DOF2_SetFloat(String, "X", fX);
	    	    DOF2_SetFloat(String, "Y", fY);
	    	    DOF2_SetFloat(String, "Z", fZ);
	    	    DOF2_SetFloat(String, "RX", fRotX);
	    	    DOF2_SetFloat(String, "RY", fRotY);
	    	    DOF2_SetFloat(String, "RZ", fRotZ);
	    	    DOF2_SetInt(String, "Valor", 1000);
	    	    DOF2_SaveFile();
	    	    SendClientMessage(playerid, -1, "| CAIXA | Caixa Eletronico criado com sucesso!");
				return 1;
	    	}
		}
	}
    return 1;
}
public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	if(IsPlayerAdmin(playerid) || NivelAdmin[playerid] > 0)
	{
		//new Float:mz;
		//MapAndreas_FindZ_For2DCoord(fX, fY, mz);
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
		    new veh = GetPlayerVehicleID(playerid);
			SetVehiclePos(veh, fX, fY, fZ);
		}
		else
		{
            SetPlayerPosFindZ(playerid, fX, fY, fZ);
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);
		}
	}
    return 1;
}
stock ResetPlayerWeaponsExC(playerid){
    for(new s=0; s<50; s++) uQBSWeaponID[playerid][s] = 0;
    ResetPlayerWeapons(playerid);
	return 1;
}
public OnPlayerShootDynamicObject(playerid, weaponid, objectid, Float:x, Float:y, Float:z)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	/*format(String, sizeof(String), "O(A) Jogador(a) %s atirou no objeto id %d Modelo %d", PlayerName(playerid), objectid, GetDynamicObjectModel(objectid));
	SendClientMessageToAll(-1, String);*/
	new bool:VerificationPorte;
	for(new m = 1; m < 8; m++)
	{
		if(ObjetoAlvo[playerid][m] > 0 && objectid == ObjetoAlvo[playerid][m])
		{
		    DestroyDynamicObject(ObjetoAlvo[playerid][m]);
		    ObjetoAlvo[playerid][m] = 0;
		    PlayerPlaySound(playerid,17802,0.0,0.0,0.0);
		    VerificationPorte = true;
			break;
		}
	}
	if(VerificationPorte == true)
	{
		new obj;
	 	for(new m; m < 8; m++)
		{
		    if(ObjetoAlvo[playerid][m] == 0)
		    {
		        obj ++;
		    }
		}
		if(obj >= 7)
		{
		    DestroyDynamicObject(ObjetoAlvo[playerid][0]);
		    ObjetoAlvo[playerid][0] = CreateDynamicObject(3025, 330.00000, -64.27800, 1004.34003,   0.00000, 0.00000, -90.00000);
			ObjetoAlvo[playerid][1] = CreateDynamicObject(3024, 330.00000, -64.24420, 1004.29999,   0.00000, 0.00000, -90.00000);
			ObjetoAlvo[playerid][2] = CreateDynamicObject(3023, 330.00000, -64.23360, 1004.29999,   0.00000, 0.00000, -90.00000);
			ObjetoAlvo[playerid][3] = CreateDynamicObject(3022, 330.00000, -64.25360, 1004.29999,   0.00000, 0.00000, -90.00000);
			ObjetoAlvo[playerid][4] = CreateDynamicObject(3021, 330.00000, -64.23730, 1004.29999,   0.00000, 0.00000, -90.00000);
			ObjetoAlvo[playerid][5] = CreateDynamicObject(3020, 330.00000, -64.23100, 1004.32001,   0.00000, 0.00000, -90.00000);
			ObjetoAlvo[playerid][6] = CreateDynamicObject(3019, 330.00000, -64.23000, 1004.32001,   0.00000, 0.00000, -90.00000);
			ObjetoAlvo[playerid][7] = CreateDynamicObject(3018, 330.00000, -64.24000, 1004.32001,   0.00000, 0.00000, -90.00000);
			new Float:X, Float:Y, Float:Z, xx = 15 + random(3), yy = random(5), lado = random(2);
			if(lado == 0)
			{
				for(new m; m < 8; m++)
				{
					GetDynamicObjectPos(ObjetoAlvo[playerid][m], X, Y, Z);
				    MoveDynamicObject(ObjetoAlvo[playerid][m], X - xx, Y + yy, Z, 1.5, 0.0, 0.0, -90.0);
				}
			}
			else if(lado == 1)
			{
			    for(new m; m < 8; m++)
				{
					GetDynamicObjectPos(ObjetoAlvo[playerid][m], X, Y, Z);
				    MoveDynamicObject(ObjetoAlvo[playerid][m], X - xx, Y - yy, Z, 1.5, 0.0, 0.0, -90.0);
				}
			}
			Streamer_Update(playerid);
			//ResetPlayerWeaponsExC(playerid);
			ArmaAlvo[playerid] ++;
			if(ArmaAlvo[playerid] == 1)
			{
			    //GivePlayerWeaponExC(playerid, 25, 999);
			    GameTextForPlayer(playerid, "~w~Acerte o Alvo!", 2000, 3);
			    SetTimerEx("CarregarInterior", 1500, false, "i", playerid);
				TogglePlayerControllable(playerid, 0);
			}
			else if(ArmaAlvo[playerid] == 2)
			{
			    //GivePlayerWeaponExC(playerid, 25, 999);
			    GameTextForPlayer(playerid, "~w~Acerte o Alvo!", 2000, 3);
			    SetTimerEx("CarregarInterior", 1500, false, "i", playerid);
				TogglePlayerControllable(playerid, 0);
			}
			else if(ArmaAlvo[playerid] == 3)
			{
			    //GivePlayerWeaponExC(playerid, 25, 999);
			    GameTextForPlayer(playerid, "~w~Acerte o Alvo!", 2000, 3);
			    SetTimerEx("CarregarInterior", 1500, false, "i", playerid);
				TogglePlayerControllable(playerid, 0);
			}
			else if(ArmaAlvo[playerid] >= 4)
			{
			    ResetPlayerWeaponsExC(playerid);
			    ArmaAlvo[playerid] = -1;
			    if(Money[playerid] >= 20000)
			    {
					Porte[playerid] = 10;
			        Money[playerid] -= 20000;
			        PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);
			        GameTextForPlayer(playerid, "~b~~h~TESTE CONCLUIDO", 3000, 0);
					SendClientMessage(playerid, -1, "| INFO | Voce passou no teste de tiro ao alvo e adquiriu seu porte de armas com sucesso!");
			    }
			    else
			    {
			        GameTextForPlayer(playerid, "~r~~h~TESTE FRACASSADO", 3000, 0);
					SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce passou no teste porem nao tem dinheiro suficiente para comprar o porte de armas");
			    }
			    for(new m; m < 8; m++)
				{
					if(ObjetoAlvo[playerid][m] > 0)
					{
					    DestroyDynamicObject(ObjetoAlvo[playerid][m]);
					    ObjetoAlvo[playerid][m] = 0;
					}
				}
				return 1;
			}
		}
	}
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    if(GetDynamicObjectModel(objectid) == 19315)
	{
	    if(StatusAnimal[objectid] == 0 && GetPlayerWeapon(playerid) == 25 && PROF[playerid] == CACADOR && !IsPlayerInAnyVehicle(playerid))
	    {
	        new Float:X, Float:Y, Float:Z;
		    GetDynamicObjectPos(objectid, X, Y, Z);
		    MoveDynamicObject(objectid, X, Y, Z-0.3, 0.7, 90.0000, 0.0000, 0.0000);
		    DestroyDynamic3DTextLabel(TextAniamal[objectid]);
		    TextAniamal[objectid] = CreateDynamic3DTextLabel("{58FA58}Veado\n{FFFFFF}Digite /PegarCaca", -1, X, Y, Z-0.1, 2.0);
		    StatusAnimal[objectid] = 1;
		    new som = random(3);
		    if(som == 0)
		    {
				foreach(Player, i)
				{
				   	if(IsPlayerInRangeOfPoint(i, 100.0, X, Y, Z))
				   	{
				   		PlayAudioStreamForPlayer(i, "https://bit.ly/SomVeado1", X, Y, Z, 100.0, 1);
				   	}
				}
		    }
		    else if(som == 1)
		    {
				foreach(Player, i)
				{
				   	if(IsPlayerInRangeOfPoint(i, 100.0, X, Y, Z))
				   	{
				   		PlayAudioStreamForPlayer(i, "https://bit.ly/SomVeado2", X, Y, Z, 100.0, 1);
				   	}
				}
		    }
		    else if(som == 2)
		    {
				foreach(Player, i)
				{
				   	if(IsPlayerInRangeOfPoint(i, 100.0, X, Y, Z))
				   	{
				   		PlayAudioStreamForPlayer(i, "https://bit.ly/SomVeado3", X, Y, Z, 100.0, 1);
				   	}
				}
		    }
	    }
	}
	return 1;
}

forward ChamadaUmSegundo();
public ChamadaUmSegundo()
{
	new mess[12], hora, minuto, segundo, dia, mes, ano; gettime(hora, minuto, segundo); getdate(ano, mes, dia);
	//
 	format(mess, sizeof(mess), "%d", JogadoresConectados);
	TextDrawSetString(TextLogin[0], mess);
	format(mess, sizeof(mess), "%d", AccRegistrada);
	TextDrawSetString(TextLogin[1], mess);
	format(mess, sizeof(mess), "%d", LoginsHoje);
	TextDrawSetString(TextLogin[2], mess);
	//
	if(hora == 5 && minuto == 59 && segundo == 0)
	{
	    SendClientMessageToAll(0x8FBC8FFF, "| SERVER | O servidor esta programado para reiniciar as 06:00");
	    GameTextForAll("~r~O SERVIDOR SERA REINICIADO", 5000, 3);
	}
	else if(hora == 6 && minuto == 0 && segundo == 0)
	{
	    for(new p; p < MAX_PLAYERS; p++)
     	{
      		Kick(p);
      	}
        SetTimer("ReiniciarServer", 1000, false);
	}
	else if(hora == 17 && minuto == 59 && segundo == 0)
	{
	    SendClientMessageToAll(0x8FBC8FFF, "| SERVER | O servidor esta programado para reiniciar as 18:00");
	    GameTextForAll("~r~O SERVIDOR SERA REINICIADO", 5000, 3);
	}
	else if(hora == 18 && minuto == 0 && segundo == 0)
	{
	    for(new p; p < MAX_PLAYERS; p++)
     	{
      		Kick(p);
      	}
        SetTimer("ReiniciarServer", 1000, false);
	}
	//
