stock MsgFrequencia(freq, color, msg[])
{
	for(new i=0;i<MAX_PLAYERS;i++)
		if(IsPlayerConnected(i))
			if(FrequenciaConectada[i] > 0 && FrequenciaConectada[i] == freq)
				SendClientMessage(i, color, msg);
	return 1;
}
