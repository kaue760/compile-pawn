forward Invasao(playerid, g);
public Invasao(playerid, g)
{
	if(IsPlayerInDynamicCP(playerid, gCheck[g]) && SegundosMorte[playerid] <= 0)
	{
	    if(InvasaoOrg[g] < 1500)
	    {
		    InvasaoOrg[g] ++;
		    new pct = 100 * InvasaoOrg[g] / 1499;
		    new Strg[40]; format(Strg, sizeof(Strg), "Invadindo ( %d/1500 - %d%s )", InvasaoOrg[g], pct, "%");
		    PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], Strg);
		    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], pct);
		   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
		   	SetTimerEx("Invasao", 200, false, "dd", playerid, g);
		}
		else
		{
			InvasaoOrg[g] = 0;
		    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
		    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
		    new Strcor[15];
		    new zone[MAX_ZONE_NAME]; GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
		    format(String, sizeof(String), "| INVASAO | O(A) Jogador(a) %s da Org %s invadiu a base da Org %s em %s", PlayerName(playerid), gNome[ORG[playerid]], gNome[g], zone);
			format(Strcor, sizeof(Strcor), "0x%sFF", gCor[ORG[playerid]]);
			SendClientMessageToAll(HexToInt(Strcor), String);
			format(String, sizeof(String), "| INFO | Sua Organizacao roubou {EE2C2C}%d materiais{FFFFFF}, {436EEE}%d drogas {FFFFFF}e {228B22}$%d {FFFFFF}na invasao", gMateriais[g], gMaconha[g], gCofre[g]);
			gMateriais[ORG[playerid]] += gMateriais[g]; gMateriais[g] = 0;
			gMaconha[ORG[playerid]] += gMaconha[g]; gMaconha[g] = 0;
			gCofre[ORG[playerid]] += gCofre[g]; gCofre[g] = 0;
			foreach(Player, i)
			{
			    if(ORG[i] == ORG[playerid])
			    {
			        GameTextForPlayer(i, "~g~Org Invadida!", 3000, 1);
					SendClientMessage(i, -1, String);
			    }
			    else if(ORG[i] == g)
			    {
			        GameTextForPlayer(i, "~r~Org Invadida!", 3000, 1);
			        SendClientMessage(i, -1, "| INFO | Sua Organizacao foi invadida e levaram todos os materiais dela");
			    }
			}
		}
	}
	else
	{
	    InvasaoOrg[g] = 0;
	    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
	    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
	}
	return 1;
}

public OnPlayerEnterCheckpoint(playerid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerEnterCheckpoint(playerid);
	return 1;
}

public OnPlayerLeaveCheckpoint(playerid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerEnterRaceCheckpoint(playerid);
	if(CargaTrem[playerid] > -1)
	{
	    if(GetPlayerSpeed(playerid) <= 20)
	    {
		    TogglePlayerControllable(playerid, 0);
			SetTimerEx("DescarregarTrem", 3000, false, "i", playerid);
			GameTextForPlayer(playerid, "~w~Descarregando ~g~Mercadorias...", 2500, 4);
			new Float:X, Float:Y, Float:Z; GetPlayerPos(playerid, X, Y, Z);
			foreach(Player, i)
			{
			   	if(IsPlayerInRangeOfPoint(i, 100.0, X, Y, Z))
			   	{
			   		PlayAudioStreamForPlayer(i, "https://bit.ly/buzinatrem", X, Y, Z, 100.0, 1);
			   	}
			}
		}
		else
		{
		    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu trem precisa esta parado para descarregar");
		}
	}
	else if(IndoRadar[playerid] > -1)
	{
	    if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 552 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
     	{
     	    if(GetPlayerSpeed(playerid) <= 10)
     	    {
	     	    TogglePlayerControllable(playerid, 0);
	     	    DisablePlayerRaceCheckpoint(playerid);
	     	    SetTimerEx("ReparandoRadar", 4000, false, "i", playerid);
	     	    GameTextForPlayer(playerid, "~r~Reparando ~w~Radar...", 3500, 4);
			}
			else
			{
			    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu veiculo precisa esta parado");
			}
		}
		else
		{
		    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta dirigindo um veiculo de Dnit");
		}
	}
	else if(TirandoCNH[playerid][0] == 1)
	{
	    TirandoCNH[playerid][0] ++;
	    SetPlayerRaceCheckpoint(playerid, 0, 1490.1787,-1157.9938,23.4784, 1483.8927,-1040.0515,23.2366, 5.0);
