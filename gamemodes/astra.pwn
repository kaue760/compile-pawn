		SetPlayerPos(playerid, PVP_SpawnsCombatS[r][0], PVP_SpawnsCombatS[r][1], PVP_SpawnsCombatS[r][2]);
		SetPlayerFacingAngle(playerid, PVP_SpawnsCombatS[r][3]);
		return 1;
    }
    if(PVP_ArenaPlayer[playerid] == 12) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 31, 500);
	
		new r = random(sizeof(PVP_SpawnsM4_Cidade));
		SetPlayerPos(playerid, PVP_SpawnsM4_Cidade[r][0], PVP_SpawnsM4_Cidade[r][1], PVP_SpawnsM4_Cidade[r][2]);
		SetPlayerFacingAngle(playerid, PVP_SpawnsM4_Cidade[r][3]);
		return 1;
    }
    if(PVP_ArenaPlayer[playerid] == 13) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 31, 500);
	
		new r = random(sizeof(PVP_SpawnsM4_Delegacia));
		SetPlayerPos(playerid, PVP_SpawnsM4_Delegacia[r][0], PVP_SpawnsM4_Delegacia[r][1], PVP_SpawnsM4_Delegacia[r][2]);
		SetPlayerFacingAngle(playerid, PVP_SpawnsM4_Delegacia[r][3]);
