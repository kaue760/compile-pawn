				    if(gstream[playerid] != dcstream[EntrandoCall[playerid]])
				    {
				        if(gstream[playerid]) SvDetachListenerFromStream(gstream[playerid], playerid);
					    format(strm[0], 128, "| WPP | O(A) Jogador(a) %s[%d] saiu do grupo ( Trocou de sala )", PlayerName(playerid), playerid);
                        format(strm[1], 128, "| WPP | O(A) Jogador(a) %s[%d] saiu do grupo", PlayerName(playerid), playerid);
						foreach(Player, i)
         				{
						   	if(gstream[i] && gstream[i] == dcstream[EntrandoCall[playerid]])
						   	{
						   	    if(NivelAdmin[playerid] < 3 && !IsPlayerAdmin(playerid))
						   	    {
						   	    	SendClientMessage(i, 0x01DF01FF, strm[1]);
						   	    	PlayerPlaySound(i, 1150, 0, 0, 0);
								}
								if(NivelAdmin[i] < 3 && !IsPlayerAdmin(i))
								{
									format(msg, sizeof(msg), "%s\n", PlayerName(i));
									strcat(msgd, msg);
								}
						   	}
						   	else if(gstream[playerid] && gstream[playerid] == gstream[i] && playerid != i)
					    	{
					    	    if(NivelAdmin[playerid] < 3 && !IsPlayerAdmin(playerid))
					    	    {
						    	    SendClientMessage(i, 0x01DF01FF, strm[0]);
						    	    PlayerPlaySound(i, 1084, 0, 0, 0);
								}
								incall ++;
						   	}
						}
						if(gstream[playerid] && incall == 0)
					    {
					        for(new d; d < MAX_CALL; d++)
					        {
					            if(gstream[playerid] == dcstream[d])
					            {
					                format(NomeSala[d], 30, "");
					                format(SenhaSala[d], 30, "");
					                SvDeleteStream(gstream[playerid]);
				      				gstream[playerid] = SV_NULL;
				      				dcstream[d] = SV_NULL;
									break;
					            }
					        }
					    }
					}
				    gstream[playerid] = dcstream[EntrandoCall[playerid]];
				    SvAttachListenerToStream(gstream[playerid], playerid);
                    format(msg, sizeof(msg), "\n- Use o VOIP para falar na chamada de voz\n- Use /wpp [Texto] para falar no chat do grupo\n- Para sair do grupo, use /sairgrupo");
				    strcat(msgd, msg);
					ShowPlayerDialog(playerid, 555, DIALOG_STYLE_MSGBOX, "{01DF01}Whatsapp {FFFFFF}- Grupo ON", msgd, "Ok", "Fechar");
					PlayerPlaySound(playerid, 1150, 0, 0, 0);
				}
				else
				{
				    new campo[188]; format(campo, sizeof(campo), "\n{FF0000}Senha Incorreta\n\n{FFFFFF}Voce esta entrando no grupo {0040FF}%s {FFFFFF}( {FF0000}Privado {FFFFFF})\n{FFFFFF}Digite a senha do grupo abaixo para entrar:", NomeSala[EntrandoCall[playerid]]);
	       			ShowPlayerDialog(playerid, D_ENTRARSALA, DIALOG_STYLE_INPUT, "{01DF01}Whatsapp {FFFFFF}- Entrar", campo, "Entrar", "Cancelar");
				}
			}
			else
			{
			    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Essa call nao existe mais");
			}
	    }
