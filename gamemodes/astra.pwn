	            return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu anuncio esta muito grande");
	        }
	        if(strlen(inputtext) <= 3)
	        {
	            return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu anuncio esta muito pequeno");
	        }
	        new Float:P[3], StrAnuncio[100];
	        for(new a; a < 3; a++)
	        {
	            GetDynamicObjectPos(PlacaAnuncio[a], P[0], P[1], P[2]);
				if(IsPlayerInRangeOfPoint(playerid, 30.0, P[0], P[1], P[2]))
				{
				    if((TempoAnuncioPlaca[a] - gettime()) > 0 && NivelAdmin[playerid] < 5 && !IsPlayerAdmin(playerid))
				    {
				        format(String, sizeof(String), "| ERRO | Ja existe um anuncio rolando nessa placa ( Tempo restante: %s )", ConvertToDays(TempoAnuncioPlaca[a]));
				        return SendClientMessage(playerid, COR_ERRO, String);
				    }
				    if(COINS[playerid] < 100)
				    {
				        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem coins suficiente");
				    }
				    format(StrAnuncio, sizeof(StrAnuncio), "{000000}-\n%s", inputtext);
				    new c;
				    for(new i = 12; i < strlen(StrAnuncio); i++)
				    {
				        c++;
				        if(c >= 25)
				        {
							c = 0;
							strins(StrAnuncio, "\n", i);
				        }
				    }
				    strcat(StrAnuncio, "\n-");
				    SetDynamicObjectMaterialText(PlacaAnuncio[a], 0, StrAnuncio, 130, "Ariel", 40, 1, 0xFFFFFFFF, 0, 1);
				    GameTextForPlayer(playerid, "~w~Anuncio Realizado!", 3000, 3);
					SendClientMessage(playerid, -1, "| INFO | Voce anunciou nessa placa com sucesso!");
