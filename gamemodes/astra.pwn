public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
    MudouInterior[playerid] = gettime();
	if(newinteriorid == 0)
	{
	    SetPlayerVirtualWorld(playerid, 0);
	}
    if(IsPlayerInRangeOfPoint(playerid, 30.0, 820.7500,9.5435,1004.1960))
    {
    	if(BancoAssalt == 0)
        {
        	PlayerPlaySound(playerid, 0, 820.7500,9.5435,1004.1960);
        }
        else
        {
        	PlayerPlaySound(playerid, 9200, 820.7500, 9.5435, 1004.1960);
       	}
    }
	return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
    if(newkeys == 16){
	    for(new i = 0; i < Qnt_Bolsas_Limt; i++)
	        if(IsPlayerInRangeOfPoint(playerid,2.0,BSPos[0][i],BSPos[1][i],BSPos[2][i])){
	            new string[128],SstrMG[2000],NomeArm[32];
	            format(string, sizeof(string),"{FFFFFF}Arma dropada pelo jogador {FF6600}%s\n",BSDeQuem[i]);
				strcat(SstrMG, string);
	       	    GetWeaponName(BSArmas[i], NomeArm, sizeof(NomeArm));
	       	    if(BSArmas[i] < 15) format(string, sizeof(string),"{FFFFFF}Arma: {FF6600}%s(%i)\n",NomeArm,BSArmas[i]);
				else format(string, sizeof(string),"{FFFFFF}Arma: {FF6600}%s(%i){FFFFFF} Com {FF6600}%i{FFFFFF} muni��es\n",NomeArm,BSArmas[i],BSQntMunc[i]);
				strcat(SstrMG, string);
				if(BSSenha[i] != 0){
				    strcat(SstrMG, "Digite a senha para pegar a arma! ***Digite apenas n�meros***");
					ShowPlayerDialog(playerid, DG_PegarBolsaP, DIALOG_STYLE_INPUT, "{FF6600}[Arma Dropada]", SstrMG, "Pegar", "Fechar");
				}else ShowPlayerDialog(playerid, DG_PegarBolsaP, DIALOG_STYLE_MSGBOX, "{FF6600}[Arma Dropada]", SstrMG, "Pegar", "Fechar");
				return 1;
			}
    }

    if(newkeys == KEY_YES)//Y
    {
        if(Spawnado[playerid] == true && !IsPlayerInAnyVehicle(playerid))
        {
        	if(IsPlayerInRangeOfPoint(playerid, 1.5, 1671.6659,-2311.8911,13.5436) || IsPlayerInRangeOfPoint(playerid, 1.5, -1987.4624,127.5222,27.5391))
           	{
            	if(pVeiculoInv[playerid][0] > 0)
	            {
	            	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Sua bmx ja esta conectada, abra seu inventaro com Y e puxe ela");
	            }
	            new PastaVeiculos[40]; format(PastaVeiculos, sizeof(PastaVeiculos), "Veiculos/%s.ini", PlayerName(playerid));
	            if(!IsPlayerInRangeOfPoint(playerid, 50.0, DOF2_GetFloat(PastaVeiculos, "XVeiculo0"), DOF2_GetFloat(PastaVeiculos, "YVeiculo0"), DOF2_GetFloat(PastaVeiculos, "ZVeiculo0")))
	            {
	                /*return SendClientMessage(playerid, COR_ERRO, "| ERRO | Essa funcao esta bloqueada para voce");*/
	            }
				if(DOF2_GetInt(PastaVeiculos, "Veiculo0") != 510 && DOF2_GetInt(PastaVeiculos, "Veiculo0") != 462) return SendClientMessage(playerid, COR_ERRO, "| ERRO | Nao foi possivel conectar sua bike");
	            pVeiculoInv[playerid][0] = CreateVehicleC(DOF2_GetInt(PastaVeiculos, "Veiculo0"), DOF2_GetFloat(PastaVeiculos, "XVeiculo0"), DOF2_GetFloat(PastaVeiculos, "YVeiculo0"), DOF2_GetFloat(PastaVeiculos, "ZVeiculo0"), DOF2_GetFloat(PastaVeiculos, "RVeiculo0"), DOF2_GetInt(PastaVeiculos, "VeiculoCor10"), DOF2_GetInt(PastaVeiculos, "VeiculoCor20"), -1);
				PutPlayerInVehicle(playerid, pVeiculoInv[playerid][0], 0);
				if(DOF2_GetInt(PastaVeiculos, "vPreso0") == 1)
				{
					vPreso[pVeiculoInv[playerid][0]] = true;
				}
				else
				{
					vPreso[pVeiculoInv[playerid][0]] = false;
				}
	            SetVehicleHealth(pVeiculoInv[playerid][0], DOF2_GetFloat(PastaVeiculos, "VeiculoVida0"));
	            format(String, sizeof(String), "| INFO | Veiculo %s[%d] conectado com sucesso!", NomeVeiculo(pVeiculoInv[playerid][0]), pVeiculoInv[playerid][0]);
				SendClientMessage(playerid, -1, String);
				format(vDono[pVeiculoInv[playerid][0]], 25, PlayerName(playerid));
    			vIPVA[pVeiculoInv[playerid][0]] = DOF2_GetInt(PastaVeiculos, "VeiculoIPVA0");
   				Combustivel[pVeiculoInv[playerid][0]] = DOF2_GetFloat(PastaVeiculos, "VeiculoCombustivel0");
       			VidaVehEx[pVeiculoInv[playerid][0]] = DOF2_GetFloat(PastaVeiculos, "VeiculoVida0");
          		SetVehicleNumberPlate(pVeiculoInv[playerid][0], DOF2_GetString(PastaVeiculos, "VeiculoPlaca0"));
		        if(GetVehicleModel(pVeiculoInv[playerid][0]) == 509 || GetVehicleModel(pVeiculoInv[playerid][0]) == 510 || GetVehicleModel(pVeiculoInv[playerid][0]) == 481)
				{
					SetVehicleParamsEx(pVeiculoInv[playerid][0], VEHICLE_PARAMS_ON, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF);
				}
				else
				{
					SetVehicleParamsEx(pVeiculoInv[playerid][0], VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF);
				}
		        PortaMalas[pVeiculoInv[playerid][0]][0] = DOF2_GetInt(PastaVeiculos, "VeiculoSlot00");
		        PortaMalas[pVeiculoInv[playerid][0]][1] = DOF2_GetInt(PastaVeiculos, "VeiculoSlot10");
		        PortaMalas[pVeiculoInv[playerid][0]][2] = DOF2_GetInt(PastaVeiculos, "VeiculoSlot20");
		        PortaMalas[pVeiculoInv[playerid][0]][3] = DOF2_GetInt(PastaVeiculos, "VeiculoSlot30");
		        PortaMalas[pVeiculoInv[playerid][0]][4] = DOF2_GetInt(PastaVeiculos, "VeiculoSlot40");
		        //
		        MunicaoPortaMala[pVeiculoInv[playerid][0]][0] = DOF2_GetInt(PastaVeiculos, "VeiculoMunicao0");
		        MunicaoPortaMala[pVeiculoInv[playerid][0]][1] = DOF2_GetInt(PastaVeiculos, "VeiculoMunicao1");
		        MunicaoPortaMala[pVeiculoInv[playerid][0]][2] = DOF2_GetInt(PastaVeiculos, "VeiculoMunicao2");
		        MunicaoPortaMala[pVeiculoInv[playerid][0]][3] = DOF2_GetInt(PastaVeiculos, "VeiculoMunicao3");
		        MunicaoPortaMala[pVeiculoInv[playerid][0]][4] = DOF2_GetInt(PastaVeiculos, "VeiculoMunicao4");
		        return 1;
			}
			CallLocalFunction("OnPlayerCommandText", "is", playerid, "/Inv");
        }
	}
	else if(newkeys == KEY_WALK)
	{
	    if(IsPlayerInRangeOfPoint(playerid, 1.5, 1150.4269,-1420.4800,16.0686) || IsPlayerInRangeOfPoint(playerid, 1.5, 1106.4999,-1420.1045,15.7978))
	    {
	        return ShowPlayerDialog(playerid, 555, DIALOG_STYLE_MSGBOX, "{FFFF00}OLX Roleplay", "\n{FFFFFF}Para anunciar no OLX RP digite /Olx [Texto] (Valor: {00FF00}$1.000{FFFFFF})", "Ok", "Fechar");
	    }
	    new b = BarracaProxima(playerid);
	    if(b > -1)
	    {
	        if(!new_strcmp(DonoBarraquinha[b], "Ninguem") && (gettime() - TempoBarraquinha[b]) >= 10800)
	        {
	            format(DonoBarraquinha[b], 25, "Ninguem");
	            LucroBarraquinha[b] = 0;
	            for(new i; i < 5; i++)
	    		{
			        if(ItemBarraquinha[b][i] > 0)
				    {
				        DestroyDynamicObject(ItemBarraquinha[b][i]); ItemBarraquinha[b][i] = 0;
				    }
				    ValorItemBarraquinha[b][i] = 0; CoinsItemBarraquinha[b][i] = 0;
				}
	            SetDynamicObjectMaterialText(Barraquinha[b], 0, "{000000}BARRAQUINHA", 50, "Calibri", 20, 1, 0x00000000, 0x00000000, 1);
	        }
	        new Titulo[50], Texto[100]; format(Titulo, sizeof(Titulo), "{FFFFFF}Barraquinha de %s", DonoBarraquinha[b]);
	        format(Texto, sizeof(Texto), "{FFFFFF}Comprar Itens\nAlugar Barraquinha");
			if(new_strcmp(DonoBarraquinha[b], PlayerName(playerid)))
			{
			    strcat(Texto, "\nNome da barraquinha\n");
			    new NomeB[30]; format(NomeB, sizeof(NomeB), "Sacar Lucro: {00FF00}$%d", LucroBarraquinha[b]);
			    strcat(Texto, NomeB);
			}
			return ShowPlayerDialog(playerid, D_BARRAQUINHA, DIALOG_STYLE_LIST, Titulo, Texto, "Selecionar", "Fechar");
		}
	    //
     	new Float:P[3], itensq;
	    for(new i; i < MAX_ITEM; i++)
		{
			if(Item[i] > 0)
			{
				GetDynamicObjectPos(Item[i], P[0], P[1], P[2]);
				if(IsPlayerInRangeOfPoint(playerid, 2.0, P[0], P[1], P[2]))
				{
				    SlotEncontrado[playerid][itensq] = i;
				    TextoItemEcontrado[playerid][itensq] = TextoItem[i];
				    ItemPreviewRot(playerid, GetDynamicObjectModel(Item[SlotEncontrado[playerid][itensq]]), TextColetarItemP[playerid][itensq+1]);
        			PlayerTextDrawShow(playerid, TextColetarItemP[playerid][itensq+1]);
				    itensq ++;
				    if(itensq >= 9)
				    {
				        break;
				    }
				}
			}
		}
		if(itensq > 0)
		{
		    new Strm[30]; format(Strm, sizeof(Strm), "Itens_encontrados_(~g~%d~w~)", itensq);
		    PlayerTextDrawSetString(playerid, TextColetarItemP[playerid][0], Strm);
		    PlayerTextDrawShow(playerid, TextColetarItemP[playerid][0]);
		    for(new t; t < 3; t++)
		    {
		        TextDrawShowForPlayer(playerid, TextColetarItem[t]);
		    }
		    SelectTextDraw(playerid, 0xFFFFFF55);
		    return 1;
		}
	    new Float:X, Float:Y, Float:Z;
  		for(new ba; ba < 13; ba++)
		{
		    if(IsValidDynamicObject(Bancoss[ba]))
		    {
	   			GetDynamicObjectPos(Bancoss[ba], X, Y, Z);
		    	if(IsPlayerInRangeOfPoint(playerid, 1.3, X, Y, Z))
		    	{
	 		   		if((gettime() - Flooder[playerid]) >= 0)
	   			 	{
				        GetDynamicObjectRot(Bancoss[ba], X, Y, Z);
				        SetPlayerFacingAngle(playerid, Z+90);
				        SetCameraBehindPlayer(playerid);
				        ApplyAnimation(playerid,"PED","SEAT_idle", 4.0, 1, 0, 0, 0, 0, 1);
				        Flooder[playerid] = gettime() + 10000;
				        return 1;
					}
					else
					{
					    ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
					    Flooder[playerid] = gettime();
					    return 1;
				 	}
			    }
			}
		}
   		GetDynamicObjectPos(Cadeirass[0], X, Y, Z);
	    if(IsPlayerInRangeOfPoint(playerid, 1.2, X, Y, Z))
	    {
     		if((gettime() - Flooder[playerid]) > 10000)
   			{
		        SetPlayerPos(playerid, 1929.7780,-1781.6992,13.5469);
		        SetPlayerFacingAngle(playerid, 356.6041);
		        SetCameraBehindPlayer(playerid);
		        ApplyAnimation(playerid,"PED","SEAT_idle", 4.0, 1, 0, 0, 0, 0, 1);
		        Flooder[playerid] = gettime();
		        return 1;
			}
			else
			{
			    ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
			    Flooder[playerid] = gettime() - 10000;
			    return 1;
		    }
		}
