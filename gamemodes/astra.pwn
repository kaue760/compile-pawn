public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if(dialogid == ASTRA_DIALOG_MODO) return Astra_RespostaModo(playerid, response, listitem);
	if(dialogid >= 32000 && dialogid < 32100) return PVP_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
	if(dialogid == D_LOCKPICK)
	{
	    if(response)
	    {
			if(strval(inputtext) < 1 || strval(inputtext) > 10)
			{
			    SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce so poder pegar ate 10 lock pick!!");
			    return 1;
			}
            for(new m; m < GetPlayerVoltas(playerid); m++)
			{
			    if(SlotMochila[playerid][m] == 0)
			    {
			        SlotMochila[playerid][m] = 2680; QuantidadeSlotMochila[playerid][m] = strval(inputtext);
			        return 1;
			    }
			}
			return SendClientMessage(playerid, COR_ERRO, "O seu inventario esta cheio");
		}
	}
	if(dialogid == D_BOXMAGIC)
	{
		if(response)
		{
				    if(COINS[playerid] < 1000) {MsgAviso(playerid, 3, "~r~Voce nao tem coins suficiente"); return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem coins suficiente");}
				    new produto = random(100);
			        while(produto <= 4 && VIP[playerid] > 0)
			        {
			            produto = random(100);
			        }
			        switch(produto)
			        {
			            case 0..4://VIP
			            {
			        		new viptype = random(100), diasvip = 1 + random(15);
					        VIP[playerid] = ConvertDays(diasvip);
					        new str[128]; format(str, sizeof(str), "| MAGICBOX | Parabens %s, voce acaba de ganhar %d dias de VIP ", PlayerName(playerid), diasvip);
					        switch(viptype)
					        {
		           				case 0: TIPOVIP[playerid] = 2, GameTextForPlayer(playerid, "~b~VIP DIAMANTE", 3000, 0), strcat(str, "DIAMANTE"); //VIP DIMA
						        case 1,2: TIPOVIP[playerid] = 1, GameTextForPlayer(playerid, "~y~VIP OURO", 3000, 0), strcat(str, "OURO"); //VIP OURO
						        default: TIPOVIP[playerid] = 0, GameTextForPlayer(playerid, "~w~VIP COMUM", 3000, 0), strcat(str, "COMUM"); //VIP COMUM
						   	}
						    SendClientMessage(playerid, 0xA901DBFF, str);
						    PlayerPlaySound(playerid, 1137, 0.0,0.0,0.0);
						    COINS[playerid] -= 1000;
						}
						case 5..45://LEVEL
						{
							new pct = random(100), levelmagic, str[128];
							switch(pct)
							{
							    case 0..19: levelmagic = 1; //20%
							    case 20..34: levelmagic = 2; //15%
							    case 35..47: levelmagic = 3; //13%
							    case 48..59: levelmagic = 4; //12%
							    case 60..69: levelmagic = 5; //10%
							    case 70..79: levelmagic = 6; //10%
							    case 80..88: levelmagic = 7; //9%
							    case 89..93: levelmagic = 8; //5%
							    case 94..97: levelmagic = 9; //4%
							    default: levelmagic = 10; //2%
							}
							Level[playerid] += levelmagic;
							SetPlayerScore(playerid, Level[playerid]);
							format(str, sizeof(str), "| MAGICBOX | Parabens %s, voce acaba de ganhar %d leveis", PlayerName(playerid), levelmagic);
							SendClientMessage(playerid, 0xA901DBFF, str);
							GameTextForPlayer(playerid, "~w~LEVEL!", 3000, 0);
							PlayerPlaySound(playerid, 1137, 0.0,0.0,0.0);
							COINS[playerid] -= 1000;
						}
						case 46..76://DINHEIRO
						{
						    new pct = random(100), dinheiromagic, str[128];
							switch(pct)
							{
							    case 0..19: dinheiromagic = 3000; //20%
							    case 20..34: dinheiromagic = 5000; //15%
							    case 35..47: dinheiromagic = 8000; //13%
							    case 48..59: dinheiromagic = 10000; //12%
							    case 60..69: dinheiromagic = 15000; //10%
							    case 70..79: dinheiromagic = 15000; //10%
							    case 80..88: dinheiromagic = 20000; //9%
							    case 89..93: dinheiromagic = 25000; //5%
							    case 94..97: dinheiromagic = 30000; //4%
							    default: dinheiromagic = 100000; //2%
							}
							Money[playerid] += dinheiromagic;
							format(str, sizeof(str), "| MAGICBOX | Parabens %s, voce acaba de ganhar $%d", PlayerName(playerid), dinheiromagic);
							SendClientMessage(playerid, 0xA901DBFF, str);
							GameTextForPlayer(playerid, "~g~DINHEIRO!", 3000, 0);
							PlayerPlaySound(playerid, 1137, 0.0,0.0,0.0);
							COINS[playerid] -= 1000;
						}
						case 77..87://SKIN
						{
							new SkinsList1[] = {39,38,39,43,69,158,159,160,161}; //70
							new SkinsList2[] = {10,46,53,51,83}; //20
							new SkinsList3[] = {36,37,45,44,56,59,62,66,67,73,97,134,136,141}; //10

							new pct = random(100), rand, temespaco;
							switch(pct)
							{
							    case 0..69:
							    {
							        rand = random(sizeof(SkinsList1));
							        rand = SkinsList1[rand];
							    }
							    case 70..89:
							    {
							        rand = random(sizeof(SkinsList2));
							        rand = SkinsList2[rand];
							    }
						    	default:
							    {
							        rand = random(sizeof(SkinsList3));
							        rand = SkinsList3[rand];
							    }
							}
						 	for(new m; m < GetPlayerVoltas(playerid); m++)
							{
								if(SlotMochila[playerid][m] == 0)
								{
									QuantidadeSlotMochila[playerid][m] ++;
		       						SlotMochila[playerid][m] = rand;

		       						temespaco = 1;
		             				break;
								}
							}
							if(temespaco)
							{
							    new str[128]; format(str, sizeof(str), "| MAGICBOX | Parabens %s, voce acaba de ganhar uma skin id %d", PlayerName(playerid), rand);
								SendClientMessage(playerid, 0xA901DBFF, str);
								GameTextForPlayer(playerid, "~p~SKIN!", 3000, 0);
								PlayerPlaySound(playerid, 1137, 0.0,0.0,0.0);
								COINS[playerid] -= 1000;
							}
							else
							{
							    SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu inventario esta cheio");
							}
						}
						default://ITENS
						{
						    new temespaco, numero = random(sizeof(ItensGeral));
						    for(new m; m < GetPlayerVoltas(playerid); m++)
