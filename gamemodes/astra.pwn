        {
            foreach(Player, i)
            {
                if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
                {
                    new idv2 = GetPlayerVehicleID(i);
                    if(idv == idv2)
                    {
                        if(Money[playerid] >= 50)
                        {
                            Money[playerid] -= 50;
                            Money[i] += 50;
                            format(String, sizeof(String), "| PASSAGEM | Voce entrou no onibus do motorista %s[%d] e pagou $50 na passagem", PlayerName(i), i);
