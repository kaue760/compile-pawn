				            {
				                new Float:X, Float:Y, Float:Z;
				                GetDynamicObjectPos(PlantaMaconha[c], X, Y, Z);
				                if(!IsPlayerInRangeOfPoint(playerid, 4.0, X, Y, Z))
				                {
				                    if(IsPlayerAttachedObjectSlotUsed(playerid, 6))
			        				{
			        				    SetDynamicObjectPos(PlantaMaconha[c], X, Y, Z+3);
	               						GetDynamicObjectPos(PlantaMaconha[c], X, Y, Z);
										MoveDynamicObject(PlantaMaconha[c], X, Y, Z+2, 0.02);
										ApplyAnimation(playerid, "CARRY", "PUTDWN", 4.1, 0, 0, 0, 0, 0, 1);
										RemovePlayerAttachedObject(playerid, 6);
										format(String, sizeof(String), "{FFFFFF}Plantacao de {9ACD32}Maconha\n{FFFFFF}Jogador(a) Trabalhando: {FFF68F}%s[%d]", PlayerName(playerid), playerid);
										UpdateDynamic3DTextLabelText(TextoMaconha[c], -1, String);
										SendClientMessage(playerid, COR_FAZENDEIRO, "| INFO | Voce plantou uma muda de maconha nesse lugar, aguarde ela crescer para colher");
										return 1;
									}
									else
									{
									    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao pegou a muda de maconha");
									}
				                }
				            	return SendClientMessage(playerid, COR_ERRO, "| ERRO | ja existe um(a) jogador(a) plantando nesse lugar");
							}
							return SendClientMessage(playerid, COR_ERRO, "| ERRO | ja existe um(a) jogador(a) plantando nesse lugar");
