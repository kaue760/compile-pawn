public OnPlayerExitVehicle(playerid, vehicleid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
     	for(new i = 0; i < 7; i++)
		{
		    TextDrawHideForPlayer(playerid, cintoTD[i]);
		}
		Cinto[playerid] = 0;
	    if(GetVehicleModel(vehicleid) != 481 && GetVehicleModel(vehicleid) != 509 && GetVehicleModel(vehicleid) != 510)
	    {
		    new motor, farol, alarme, portas, capo, portamalas, objetivo;
		    GetVehicleParamsEx(vehicleid, motor, farol, alarme, portas, capo, portamalas, objetivo);
		    SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_OFF, 0, alarme, portas, capo, portamalas, objetivo);
		}
		if(VAdmin[playerid] > 0)
     	{
      		DestroyVehicleC(VAdmin[playerid]);
      		VAdmin[playerid] = 0;
	    }
	    if(Balao[playerid] > 0)
		{
			DestroyDynamicObject(Balao[playerid]);
			Balao[playerid] = 0;
			DestroyDynamicObject(BalaoMadeira[playerid]);
			BalaoMadeira[playerid] = 0;
			DestroyDynamicObject(BalaoFogo[playerid]);
			BalaoFogo[playerid] = 0;
			Delete3DTextLabel(TextBalao[playerid]);
		}
	    if(NoEvento[playerid] == 1)
	    {
			for(new v; v < 33; v++)
			{
			    if(vehicleid == VeiculoEventoCart[v])
			    {
			        DestroyVehicleC(VeiculoEventoCart[v]);
			        VeiculoEventoCart[v] = 0;
			        break;
			    }
			}
			NoEvento[playerid] = 0;
	    }
	    else if(NoEvento[playerid] == 2)
	    {
			for(new v; v < 30; v++)
			{
			    if(vehicleid == VeiculoEventoMonster[v])
			    {
			        DestroyVehicleC(VeiculoEventoMonster[v]);
			        VeiculoEventoMonster[v] = 0;
			        break;
			    }
			}
			NoEvento[playerid] = 0;
	    }
		new bool:EstaTirandoCNH;
		for(new v; v < 7; v++)
		{
		    if(TirandoCNH[playerid][v] > 0)
		    {
		        TirandoCNH[playerid][v] = 0;
		        EstaTirandoCNH = true;
		    }
		}
		if(EstaTirandoCNH == true)
		{
		    DisablePlayerRaceCheckpoint(playerid);
		    if(VeiculoCNH[playerid] > 0)
		    {
		        DestroyVehicleC(VeiculoCNH[playerid]);
	            VeiculoCNH[playerid] = 0;
		    }
		    SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce saiu do veiculo enquanto tirava Habilitacao e sua prova foi cancelada");
		}
	}
	return 1;
}

public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
    if(Carregado[playerid] == true)
    {
        if(PROF[playerid] == PETROLEIRO || PROF[playerid] == CAMINHONEIRO || PROF[playerid] == MINERADOR || PROF[playerid] == CARROFORTE)
        {
			if(GetVehicleModel(vehicleid) == 514 || GetVehicleModel(vehicleid) == 456 || GetVehicleModel(vehicleid) == 515 || GetVehicleModel(vehicleid) == 428)
			{
			    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			    {
			        if(BonusFrete[playerid] > 0)
			        {
			            new v = Frete[playerid] * 10 / 100;
                    	BonusFrete[playerid] -= v;
					}
					if(BonusFrete[playerid] < 0)
					{
					    BonusFrete[playerid] = 0;
					}
			    }
			}
        }
    }
    // -- CINTO -- //
	if(Cinto[playerid] == 0)
	{
	    if(VelocidadeDoVeiculo(vehicleid) > 79)
	    {
	        new Float:vida;
			GetPlayerHealth(playerid, vida);
			SetPlayerHealth(playerid, (vida - 10.0));
			GameTextForPlayer(playerid, "~r~COLOQUE O CINTO" , 3000,3);
		}
		else
		{
		    GameTextForPlayer(playerid, "~r~COLOQUE O CINTO" , 3000,3);
		}
    }
    else
    {
        SendClientMessage(playerid,0x00FF00FF,"| INFO | Voce foi salvo pelo into de seguranca");
    }
    return 1;
}

public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerGiveDamage(playerid, damagedid, amount, weaponid, bodypart);
	return 1;
}

public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)//Sofreu dano
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
    if(issuerid != INVALID_PLAYER_ID)
    {
		if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
		{
		    SetPlayerHealth(playerid, 1000000.0);
		}
		else if(bodypart == 9 && HorasPreso[playerid] <= 0 && MinutosPreso[playerid] <= 0 && SegundosPreso[playerid] <= 0 && NivelAdmin[playerid] <= 0)
		{
		    for(new m; m < 6; m++)
			{
				if(ModeloItem[playerid][m] == PANELA && OssoItem[playerid][m] == 2 && IsPlayerAttachedObjectSlotUsed(playerid, m))
				{
    				ModeloItem[playerid][m] = 0; RemovePlayerAttachedObject(playerid, m); return 1;
	  			}
			}
			if(IsPlayerInAnyVehicle(playerid))
			{
			    new Float:Vida; GetVehicleHealth(GetPlayerVehicleID(playerid), Vida);
			    if(Vida > 1000.0) return 1;
			}
			GameTextForPlayer(issuerid, "~r~Head ~w~Shot!", 4000, 3);
	   		PlayerPlaySound(issuerid,17802,0.0,0.0,0.0);
		    new Hora, Minuto, Segundo; gettime(Hora, Minuto, Segundo);
		    format(String, sizeof(String), "| HEADSHOT | Voce acertou um tiro na {FF0000}cabeca {FFFFFF}do(a) jogador(a) {FF0000}%s[%d]", PlayerName(playerid), playerid);
		    SendClientMessage(issuerid, -1, String);
		    format(String, sizeof(String), "| HEADSHOT | O(A) Jogador(a) {FF0000}%s[%d] {FFFFFF}matou voce ( %02d:%02d:%02d ) ", PlayerName(issuerid), issuerid, Hora, Minuto, Segundo);
		    if(ORG[issuerid] >= 0)
		    {
		        new StrOrg[32]; format(StrOrg, sizeof(StrOrg), "( ORG: %s )", gNome[ORG[issuerid]]);
		        strcat(String, StrOrg);
		    }
		    SendClientMessage(playerid, -1, String);
		    SetPlayerHealth(playerid, 0.0);
		}
        else
		{
		    if((gettime() - Flooder[playerid]) >= 5)
	   		{
	   		    new Hora, Minuto, Segundo; gettime(Hora, Minuto, Segundo);
			    format(String, sizeof(String), "| DANO | O(A) Jogador(a) {FF0000}%s[%d] {FFFFFF}atingiu voce ( %02d:%02d:%02d ) ", PlayerName(issuerid), issuerid, Hora, Minuto, Segundo);
                if(ORG[issuerid] >= 0)
			    {
			        new StrOrg[32]; format(StrOrg, sizeof(StrOrg), "( ORG: %s )", gNome[ORG[issuerid]]);
			        strcat(String, StrOrg);
			    }
				SendClientMessage(playerid, -1, String);
				if(bodypart == 7 || bodypart == 8)
				{
				    ApplyAnimation(playerid, "PED", "KO_SKID_BACK", 4.1, 0, 1, 1, 1, 0, 1);
				    MsgAviso(playerid, 5, "~w~VOCE LEVOU UM TIRO NA PERNA, USE ~r~/LEVANTAR");
				}
    			Flooder[playerid] = gettime();
			}
		}
	}
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerStateChange(playerid, newstate, oldstate);
    if(newstate == PLAYER_STATE_DRIVER)
    {
        if((GetTickCount() - GetPVarInt(playerid, "cartime")) < 1000)
	    {
			SetPVarInt(playerid, "carspam", GetPVarInt(playerid, "carspam")+1);
			if(GetPVarInt(playerid, "carspam") >= 2)
	        {
	        	if(IsPlayerConnected(playerid))
		        {
					SetVehicleToRespawn(GetPlayerVehicleID(playerid));
					new Stringg[128];
			        format(Stringg, sizeof(Stringg), "| CARP-Admin | O(A) Administrador(a) Malvadao kickou o(a) jogador(a) %s ( Motivo: Car Spawn )", PlayerName(playerid));
		    		SendClientMessageToAll(0xFF0000FF, Stringg);
			        GameTextForPlayer(playerid, "~r~KICKADO", 3000, 0);
			        SetTimerEx("Kickar" , 150 , false, "i" , playerid ) ;
			        SetPVarInt(playerid, "carspam", 0);
		        }
	        }
	  	}
	  	else
	  	{
	  	    SetPVarInt(playerid, "carspam", 0);
	  	}
	  	SetPVarInt(playerid, "cartime", GetTickCount());
        ///////////////////////////////////////
        new idv = GetPlayerVehicleID(playerid);
        if(GetVehicleModel(idv) == 521 || GetVehicleModel(idv) == 522 || GetVehicleModel(idv) == 523 || GetVehicleModel(idv) == 461 || GetVehicleModel(idv) == 462 || GetVehicleModel(idv) == 463 || GetVehicleModel(idv) == 468)
        {
            for(new m; m < 6; m++)
			{
				if(ModeloItem[playerid][m] == CAPACETE1 || ModeloItem[playerid][m] == CAPACETE2 || ModeloItem[playerid][m] == CAPACETE3 || ModeloItem[playerid][m] == CAPACETE4 || ModeloItem[playerid][m] == CAPACETE5)
				{
					SetPlayerAttachedObject(playerid, m, ModeloItem[playerid][m], OssoItem[playerid][m], PosItem[playerid][m][0], PosItem[playerid][m][1], PosItem[playerid][m][2], PosItem[playerid][m][3], PosItem[playerid][m][4], PosItem[playerid][m][5], PosItem[playerid][m][6], PosItem[playerid][m][7], PosItem[playerid][m][8], -1);
					break;
				}
			}
        }
        //tune
        pvehicleid[playerid] = GetPlayerVehicleID(playerid);
	    pmodelid[playerid] = GetVehicleModel(pvehicleid[playerid]);
	    //
        if(SegundosVoltarVeiculo[playerid] > 0)
        {
            if(PROF[playerid] == PETROLEIRO)
            {
                if(GetVehicleModel(idv) == 514)
                {
                    SegundosVoltarVeiculo[playerid] = 0;
                }
            }
            else if(PROF[playerid] == CAMINHONEIRO)
            {
                if(GetVehicleModel(idv) == 456)
                {
                    SegundosVoltarVeiculo[playerid] = 0;
                }
            }
            else if(PROF[playerid] == MINERADOR)
            {
                if(GetVehicleModel(idv) == 515)
                {
                    SegundosVoltarVeiculo[playerid] = 0;
                }
            }
            else if(PROF[playerid] == MOTORISTABUS)
            {
                if(GetVehicleModel(idv) == 437)
                {
                    SegundosVoltarVeiculo[playerid] = 0;
                }
            }
            else if(PROF[playerid] == FERROVIARIA)
            {
                if(GetVehicleModel(idv) == 537 || GetVehicleModel(idv) == 538)
                {
                    SegundosVoltarVeiculo[playerid] = 0;
                }
            }
            else if(PROF[playerid] == MOTOBOY)
            {
                if(GetVehicleModel(idv) == 581)
                {
                    SegundosVoltarVeiculo[playerid] = 0;
                }
            }
            else if(PROF[playerid] == CARROFORTE)
            {
                if(GetVehicleModel(idv) == 428)
                {
                    SegundosVoltarVeiculo[playerid] = 0;
                }
            }
        }
        if(!new_strcmp(vDono[idv], "Ninguem"))
        {
            if(!new_strcmp(vDono[idv], PlayerName(playerid)))
        	{
        	    new motor, farol, alarme, portas, capo, portamalas, objetivo;
      			GetVehicleParamsEx(idv, motor, farol, alarme, portas, capo, portamalas, objetivo);
      			SetVehicleParamsEx(idv, motor, farol, 1, portas, capo, portamalas, objetivo);
      			SendClientMessage(playerid, -1, "| AVISO | Voce entrou em um veiculo de outra pessoa e pode ser preso pelos policiais");
        	}
        	else
			{
			    new motor, farol, alarme, portas, capo, portamalas, objetivo;
      			GetVehicleParamsEx(idv, motor, farol, alarme, portas, capo, portamalas, objetivo);
      			SetVehicleParamsEx(idv, motor, farol, 0, portas, capo, portamalas, objetivo);
