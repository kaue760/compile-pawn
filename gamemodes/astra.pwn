					new Strm[11]; format(Strm, sizeof(Strm), "~g~$%d", Money[i] - GetPlayerMoney(i)); GameTextForPlayer(i, Strm, 3000, 1);
				}
		        ResetPlayerMoney(i);
		        GivePlayerMoney(i, Money[i]);
