forward uQ_LpFixArm();
public uQ_LpFixArm(){
	for(new i=0; i<MAX_PLAYERS; i++)
		if(IsPlayerConnected(i) && AstraModo[i] != ASTRA_MODO_PVP)
		    if(GetPlayerWeapon(i) > 1)
		        if(uQBSWeaponID[i][GetPlayerWeapon(i)] != 1)
		            ResetPlayerWeaponsExC(i),SendClientMessage(i, 0xFF0000FF, "Voc� perdeu todas as armas com suspeita de Armas Ilegal no Servidor!");
	return 1;
}

forward GetPlayerHospital(playerid);
public GetPlayerHospital(playerid)
{
    if(!IsPlayerConnected(playerid))
    {
		return -1;
    }
    new Float:distancia = 100000.000, Float:dist, prevhosp;
	for(new hospid = 0; hospid < 8; hospid++)
	{
	    if(hospid == 0) {dist = GetPlayerDistanceToPoint(playerid, 1176.5480,-1323.2540);} // HOSP LS P
        else if(hospid == 1) {dist = GetPlayerDistanceToPoint(playerid, 2035.9244, -1413.1837);} // HOSP LS G
        else if(hospid == 2) {dist = GetPlayerDistanceToPoint(playerid, 1579.1146, 1769.1814);} // HOSP LV
        else if(hospid == 3) {dist = GetPlayerDistanceToPoint(playerid, -316.0515, 1055.0485);} // HOSP FC
        else if(hospid == 4) {dist = GetPlayerDistanceToPoint(playerid, -1514.7839, 2523.5173);} // HOSP EL QUEBRADOS
        else if(hospid == 5) {dist = GetPlayerDistanceToPoint(playerid, -2660.3928, 633.1524);} // HOSP SF
        else if(hospid == 6) {dist = GetPlayerDistanceToPoint(playerid, -2207.5203, -2285.8203);} // HOSP ANGELPINE
        else if(hospid == 7) {dist = GetPlayerDistanceToPoint(playerid, 1245.3052, 333.9335);} // HOSP MONTGOMERY
        if((dist < distancia))
		{
            distancia = dist;
		    prevhosp = hospid;
		}
	}
	return prevhosp;
}

forward GetPlayerDP(playerid);
public GetPlayerDP(playerid)
{
    if(!IsPlayerConnected(playerid))
    {
		return -1;
