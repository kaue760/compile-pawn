stock SalvarPlayer(playerid)
{
    GetPlayerPos(playerid, PosX[playerid], PosY[playerid], PosZ[playerid]);
    GetPlayerFacingAngle(playerid, PosR[playerid]);
	format(String, sizeof(String), "Contas/%s.ini", PlayerName(playerid));
	if(DOF2_FileExists(String))
	{
	    new ARMAA[13], MUNICAOO[13], Arma_[10], Bala_[10];
	    for(new i = 0; i < 13; i++)
	    {
	        GetPlayerWeaponData(playerid,i,ARMAA[i],MUNICAOO[i]);
	        if(!ArmaProibida(ARMAA[i]))
	        {
		        format(Arma_,10,"Arma%d",i);
		        format(Bala_,10,"Municao%d",i);
		        DOF2_SetInt(String, Arma_, ARMAA[i]);
		        DOF2_SetInt(String, Bala_, MUNICAOO[i]);
			}
	    }
		new strjbl[30];
	    for(new j; j < 10; j++)
		{
		    format(strjbl, sizeof(strjbl), "NomeMusica%d", j);
		    DOF2_SetString(String, strjbl, NomePlaylist[playerid][j]);
		    format(strjbl, sizeof(strjbl), "LinkMusica%d", j);
		    DOF2_SetString(String, strjbl, Playlist[playerid][j]);
		}
        
	    GetPlayerHealth(playerid, Vidap[playerid]); GetPlayerArmour(playerid, Coletep[playerid]);
	    DOF2_SetInt(String, "Skin", SkinPlayer[playerid]);
	    DOF2_SetInt(String, "Rg", RgPlayer[playerid]);
	    DOF2_SetInt(String, "Level", Level[playerid]);
	    DOF2_SetInt(String, "mUP", mUP[playerid]);
	    DOF2_SetInt(String, "sUP", sUP[playerid]);
	    DOF2_SetInt(String, "Fome", FOME[playerid]);
	    DOF2_SetInt(String, "Sede", SEDE[playerid]);
	    DOF2_SetInt(String, "Sono", SONO[playerid]);
	    DOF2_SetInt(String, "Money", Money[playerid]);
	    DOF2_SetInt(String, "DinheiroSujo", DinheiroSujo[playerid]);
	    DOF2_SetInt(String, "SaldoBancario", SaldoBancario[playerid]);
     	DOF2_SetInt(String, "Celular", Celular[playerid]);
     	DOF2_SetInt(String, "CreditosCelular", CreditosCelular[playerid]);
     	DOF2_SetInt(String, "SemParar", SemParar[playerid]);
     	DOF2_SetInt(String, "UsouCMDBNF300", UsouCMDBNF[playerid]);
	    DOF2_SetInt(String, "Multa", Multa[playerid]);
	    DOF2_SetInt(String, "ValorMulta", ValorMulta[playerid]);
	    DOF2_SetInt(String, "BlockAssaltouCaixa", BlockAssaltouCaixa[playerid]);
	    DOF2_SetInt(String, "BlockAssaltouBanco", BlockAssaltouBanco[playerid]);
	    DOF2_SetInt(String, "BlockAssaltoCX", BlockAssaltoCX[playerid]);
	    DOF2_SetInt(String, "BlockPlayerAssalto", BlockPlayerAssalto[playerid]);
	    DOF2_SetInt(String, "RecebeuSalario", RecebeuSalario[playerid]);
	    DOF2_SetInt(String, "Prof", PROF[playerid]);
	    DOF2_SetInt(String, "Org", ORG[playerid]);
	    DOF2_SetInt(String, "VIP", VIP[playerid]);
	    DOF2_SetInt(String, "TIPOVIP", TIPOVIP[playerid]);
	    DOF2_SetInt(String, "KitCorrida", KitCorrida[playerid]);
	    DOF2_SetInt(String, "KitFesta", KitFesta[playerid]);
	    DOF2_SetInt(String, "Coins", COINS[playerid]);
	    DOF2_SetInt(String, "PlanoSaude", PlanoSaude[playerid]);
	    DOF2_SetInt(String, "Estagiario", Estagiario[playerid]);
	    DOF2_SetInt(String, "Avisos", Avisos[playerid]);
	    DOF2_SetInt(String, "MUV", MUV[playerid]);
	    DOF2_SetInt(String, "Votou", Votou[playerid]);
	    DOF2_SetFloat(String, "GasolinaBalao", GasolinaBalao[playerid]);
	    DOF2_SetInt(String, "Porte", Porte[playerid]);
	    DOF2_SetInt(String, "Notas", Notas[playerid]);
	    DOF2_SetInt(String, "HabilitacaoA", HabilitacaoA[playerid]);
	    DOF2_SetInt(String, "HabilitacaoB", HabilitacaoB[playerid]);
	    DOF2_SetInt(String, "HabilitacaoC", HabilitacaoC[playerid]);
	    DOF2_SetInt(String, "HabilitacaoD", HabilitacaoD[playerid]);
	    DOF2_SetInt(String, "HabilitacaoE", HabilitacaoE[playerid]);
	    DOF2_SetInt(String, "HabilitacaoF", HabilitacaoF[playerid]);
	    DOF2_SetInt(String, "HabilitacaoG", HabilitacaoG[playerid]);
	    DOF2_SetInt(String, "SegundosSalarioAdmin", SegundosSalarioAdmin[playerid]);
	    DOF2_SetInt(String, "Procurado", NivelProcurado[playerid]);
	    DOF2_SetInt(String, "HorasPreso", HorasPreso[playerid]);
		DOF2_SetInt(String, "MinutosPreso", MinutosPreso[playerid]);
		DOF2_SetInt(String, "SegundosPreso", SegundosPreso[playerid]);
		DOF2_SetString(String, "MotivoPrisaoAdmin", MotivoPrisaoAdmin[playerid]);
		DOF2_SetInt(String, "MinutosMorte", MinutosMorte[playerid]);
		DOF2_SetInt(String, "SegundosMorte", SegundosMorte[playerid]);
		DOF2_SetInt(String, "EntrouEmpresa", EntrouEmpresa[playerid]);
		DOF2_SetInt(String, "EntrouCasa", EntrouCasa[playerid]);
		DOF2_SetInt(String, "EntrouAreaVip", EntrouAreaVip[playerid]);
	    DOF2_SetInt(String, "EmContrato", EmContrato[playerid]);
	    DOF2_SetString(String, "CORTAGVIP", CORTAGVIP[playerid]);
	    DOF2_SetInt(String, "Alvara", Alvara[playerid]);
	    DOF2_SetFloat(String, "Vida", Vidap[playerid]);
		DOF2_SetFloat(String, "Colete", Coletep[playerid]);
		DOF2_SetFloat(String, "BTC", BTC[playerid]);
	    DOF2_SetInt(String, "Mochila", Mochila[playerid]);
	    new MT[26];
		for(new m; m < GetPlayerVoltas(playerid); m++)
		{
			format(MT, sizeof(MT), "SlotMochila%d", m);
  			DOF2_SetInt(String, MT, SlotMochila[playerid][m]);
  			format(MT, sizeof(MT), "QuantidadeSlotMochila%d", m);
  			DOF2_SetInt(String, MT, QuantidadeSlotMochila[playerid][m]);
		}
		DOF2_SetInt(String, "PegouMercadoria", PegouMercadoria[playerid]);
	    DOF2_SetInt(String, "EntrouHosp", EntrouHosp[playerid]);
	    DOF2_SetInt(String, "EntrouDP", EntrouDP[playerid]);
	    DOF2_SetInt(String, "EntrouBanco", EntrouBanco[playerid]);
	    DOF2_SetInt(String, "EntrouPref", EntrouPref[playerid]);
	    DOF2_SetInt(String, "EntrouAutoEscola", EntrouAutoEscola[playerid]);
	    DOF2_SetInt(String, "EntrouDetran", EntrouDetran[playerid]);
	    DOF2_SetInt(String, "EntrouAgencia", EntrouAgencia[playerid]);
	    DOF2_SetInt(String, "DiaPresente", DiaPresente[playerid]);
	    DOF2_SetFloat(String, "PosX", PosX[playerid]);
	    DOF2_SetFloat(String, "PosY", PosY[playerid]);
	    DOF2_SetFloat(String, "PosZ", PosZ[playerid]);
	    DOF2_SetFloat(String, "PosR", PosR[playerid]);
	    DOF2_SetInt(String, "UltimoLogin1", gettime());
	    DOF2_SetInt(String, "UltimoInterior", GetPlayerInterior(playerid));
	    DOF2_SetInt(String, "idfixo", id_fixo[playerid]);
	    DOF2_SetInt(String, "LevelImpostoCasa", LevelImpostoCasa[playerid]);
	    DOF2_SetInt(String, "LevelImpostoEmpresa", LevelImpostoEmpresa[playerid]);
	    DOF2_SetInt(String, "LevelImpostoPosto", LevelImpostoPosto[playerid]);
	    if(GetPlayerVirtualWorld(playerid) >= 0)
	    {
	    	DOF2_SetInt(String, "UltimoMundo", GetPlayerVirtualWorld(playerid));
		}
		else
		{
		    DOF2_SetInt(String, "UltimoMundo", 0);
		}
		format(String, sizeof(String), "Acessorios/%s.ini", PlayerName(playerid));
		if(DOF2_FileExists(String))
		{
			for(new m; m < 6; m++)
			{
	  			format(MT, sizeof(MT), "ModeloItem%d", m);
				DOF2_SetInt(String, MT, ModeloItem[playerid][m]);

				format(MT, sizeof(MT), "OssoItem%d", m);
				DOF2_SetInt(String, MT, OssoItem[playerid][m]);

				for(new o; o < 9; o++)
				{
					format(MT, sizeof(MT), "PosItem%d%d", m, o);
					DOF2_SetFloat(String, MT, PosItem[playerid][m][o]);
				}
			}
			for(new m; m < 30; m++)
			{
				format(strjbl, sizeof(strjbl), "contatoplayer%d", m);
				DOF2_SetString(String, strjbl, ContatoPlayer[playerid][m]);

				format(strjbl, sizeof(strjbl), "numerocontatoplayer%d", m);
				DOF2_SetInt(String, strjbl, NumeroContatoPlayer[playerid][m]);
			}
		}
		if(NivelAdmin[playerid] > 0)
		{
			format(String, sizeof(String), "Admins/%s.ini", PlayerName(playerid));
			if(!DOF2_FileExists(String))
			{
			    DOF2_CreateFile(String);
			}
			DOF2_SetInt(String, "Nivel", NivelAdmin[playerid]);
		}
		else if(Estagiario[playerid] > 0)
		{
			format(String, sizeof(String), "Admins/%s.ini", PlayerName(playerid));
			if(!DOF2_FileExists(String))
			{
			    DOF2_CreateFile(String);
			}
			DOF2_SetInt(String, "Nivel", 0);
		}
	    DOF2_SaveFile();
	}
}

stock ArmaProibida(arma)
{
	new result;
	switch(arma)
	{
	    case 16, 17, 18, 35, 36, 37, 38, 39, 40: result = 1;
