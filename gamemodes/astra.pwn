forward AbrirPresente(playerid);
public AbrirPresente(playerid)
{
	if(IsPlayerConnected(playerid) && Spawnado[playerid] == true)
	{
		if(PRODUZINDOARMA[playerid] < 100)
		{
		    PRODUZINDOARMA[playerid] += 2;
		    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], PRODUZINDOARMA[playerid]);
		   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
			TempoProducaoArma[playerid] = SetTimerEx("AbrirPresente", 100, false, "i", playerid);
		}
		else
		{
       		PRODUZINDOARMA[playerid] = -1;
		    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
	     	PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
			for(new m; m < GetPlayerVoltas(playerid); m++)
			{
				if(SlotMochila[playerid][m] == 0)
				{
				    new Year, Month, Day, Days; Days = getdate(Year, Month, Day);
				    DiaPresente[playerid] = Days;
				    new numero = random(sizeof(ItensGeral));
				    if(ItensGeral[numero] == DINDIN)
				    {
						new dimtexto[31], dim = 1000 + random(10000);
						format(dimtexto, sizeof(dimtexto), "~n~Voce ganhou ~g~$%d~w~!", dim);
						MsgAviso(playerid, 5, dimtexto);
						Money[playerid] += dim;
				    }
				    else
				    {
				        SlotMochila[playerid][m] = ItensGeral[numero];
						QuantidadeSlotMochila[playerid][m] = 1;
				    }
					PlayerTextDrawSetPreviewModel(playerid, TextPresente[playerid][2], ItensGeral[numero]);
					ItemPreviewRot(playerid, ItensGeral[numero], TextPresente[playerid][2]);
					for(new t; t < 5; t++)
				    {
					    PlayerTextDrawShow(playerid, TextPresente[playerid][t]);
				    }
					SelectTextDraw(playerid, 0xFFFFFF55);
					return 1;
	  			}
	   		}
	   		SetCameraBehindPlayer(playerid);
	   		ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
			return SendClientMessage(playerid, COR_ERRO, "| ERRO | Nao foi possivel abrir o presente pois seu inventario nao tem espaco");
		}
	}
	return 1;
}

forward Abordou(id);
public Abordou(id)
{
	if(NivelProcurado[id] > 0)
	{
	 	format(String, sizeof(String), "| perseguicao | O(A) Policial %s[%d] iniciou uma perseguicao no(a) jogador(a) %s[%d] por ele(a) nao se render", PlayerName(PolicialQueAbordou[id]), PolicialQueAbordou[id], PlayerName(id), id);
		SendClientMessageToAll(0x1E90FFFF, String);
		SegundosPerseguidoCorp[id] = 300;
	}
	TimerAbordo[id] = -1;
	TextDrawHideForPlayer(id, TextAbordagem[0]); TextDrawHideForPlayer(id, TextAbordagem[1]);
	return 1;
}

forward AbordouAb(id);
public AbordouAb(id)
{
    TimerAbordoAb[id] = -1;
	TextDrawHideForPlayer(id, TextAbordagem[0]); TextDrawHideForPlayer(id, TextAbordagemAb);
	return 1;
}
stock pMala_SalvarArmas(playerid,vehid,tipo,xPlayer){
	if(tipo == 1){
		PlayerNoVeiculo[vehid] = playerid+1;
		TogglePlayerSpectating(playerid, 1);
		PlayerSpectateVehicle(playerid, vehid);
		Na_Mala[playerid] = vehid+1;
	    for(new i = 0; i < 13; i++) GetPlayerWeaponData(playerid,i,ArmasPlayer[0][i][playerid],ArmasPlayer[1][i][playerid]);
    }else if(tipo == 2){
		TogglePlayerSpectating(playerid, 0);
		SetTimerEx("Mala_Car", 100, false,"ii",playerid,xPlayer);
		ResetPlayerWeapons(playerid);
		for(new i = 0; i < 13; i++) GivePlayerWeaponExC(playerid,ArmasPlayer[0][i][playerid],ArmasPlayer[1][i][playerid]);
    }
	return 1;
}

forward Localizador(playerid);
public Localizador(playerid)
{
	if(IsPlayerConnected(playerid) && Spawnado[playerid] == true && IsPlayerConnected(Localizando[playerid]) && Spawnado[Localizando[playerid]] == true)
	{
		if(PROF[playerid] == PM || PROF[playerid] == ROTA  || PROF[playerid] == CHOQUE || PROF[playerid] == ROTAM || PROF[playerid] == BOPE || PROF[playerid] == PC || PROF[playerid] == PF || PROF[playerid] == EXERCITO)
		{
		    if(SegundosPreso[Localizando[playerid]] <= 0 && MinutosPreso[Localizando[playerid]] <= 0 && HorasPreso[Localizando[playerid]] <= 0)
   			{
       			new zone[MAX_ZONE_NAME], MsgLocalize[128], Float:X, Float:Y, Float:Z;
		    	GetPlayerPos(Localizando[playerid], X, Y, Z); GetPlayer2DZone(Localizando[playerid], zone, MAX_ZONE_NAME);
		    	new Float:fDistance = GetPlayerDistanceFromPoint(playerid, X, Y, Z);
				format(MsgLocalize, sizeof(MsgLocalize), "~w~Jogador: ~b~~h~%s~w~, Local: ~g~~h~%s~w~, Distancia: ~r~~h~%0.1fm", PlayerName(Localizando[playerid]), zone, fDistance);
				if(MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0) PlayerTextDrawSetString(playerid, MsgText[playerid], MsgLocalize);
				//SetPlayerCheckpoint(playerid, X, Y, Z, 0.0);
				SetTimerEx("Localizador", 2000, false, "i", playerid);
			}
			else
			{
			    SendClientMessage(playerid, 0x228B22FF, "| GPS | O(A) Jogador(a) localizado foi preso");
				Localizando[playerid] = -1;
				DisablePlayerCheckpoint(playerid);
			}
		}
  		else if(PROF[playerid] == TAXISTA || PROF[playerid] == MECANICO)
		{
  			new zone[MAX_ZONE_NAME], MsgLocalize[128], Float:X, Float:Y, Float:Z;
    		GetPlayerPos(Localizando[playerid], X, Y, Z); GetPlayer2DZone(Localizando[playerid], zone, MAX_ZONE_NAME);
	    	new Float:fDistance = GetPlayerDistanceFromPoint(playerid, X, Y, Z);
			format(MsgLocalize, sizeof(MsgLocalize), "~w~Jogador: ~b~~h~%s~w~, Local: ~g~~h~%s~w~, Distancia: ~r~~h~%0.1fm", PlayerName(Localizando[playerid]), zone, fDistance);
			if(MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0) PlayerTextDrawSetString(playerid, MsgText[playerid], MsgLocalize);
			SetPlayerCheckpoint(playerid, X, Y, Z, 0.0);
			SetTimerEx("Localizador", 2000, false, "i", playerid);
		}
		else if(ORG[playerid] >= 0)
	    {
			if(EmContrato[Localizando[playerid]] > 0)
   			{
       			new zone[MAX_ZONE_NAME], MsgLocalize[128]; GetPlayer2DZone(Localizando[playerid], zone, MAX_ZONE_NAME);
				format(MsgLocalize, sizeof(MsgLocalize), "~w~Jogador: ~b~~h~%s~w~, Local: ~g~~h~%s", PlayerName(Localizando[playerid]), zone);
				if(MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0) PlayerTextDrawSetString(playerid, MsgText[playerid], MsgLocalize);
				//SetPlayerCheckpoint(playerid, X, Y, Z, 0.0);
				SetTimerEx("Localizador", 2000, false, "i", playerid);
			}
			else
			{
			    SendClientMessage(playerid, 0x228B22FF, "| GPS | O(A) Jogador(a) localizado nao esta mais em contrato de morte");
				Localizando[playerid] = -1;
				DisablePlayerCheckpoint(playerid);
			}
		}
		else if(PROF[playerid] == PARAMEDICO)
		{
		    if(IsPlayerConnected(Localizando[playerid]) && SegundosPreso[Localizando[playerid]] <= 0 && MinutosPreso[Localizando[playerid]] <= 0 && HorasPreso[Localizando[playerid]] <= 0 && SegundosMorte[Localizando[playerid]] > 0 || MinutosMorte[Localizando[playerid]] > 0)
		    {
			    new MsgLocalize[128], Float:X, Float:Y, Float:Z; GetPlayerPos(Localizando[playerid], X, Y, Z);
		    	new Float:fDistance = GetPlayerDistanceFromPoint(playerid, X, Y, Z);
				format(MsgLocalize, sizeof(MsgLocalize), "~w~O Jogador: ~b~~h~%s~w~ esta morrendo, ~r~CORRA~w~!~n~~g~~h~Resistencia: ~w~%02d:%02d ~g~~h~Distancia: ~w~%0.1fm", PlayerName(Localizando[playerid]), MinutosMorte[Localizando[playerid]], SegundosMorte[Localizando[playerid]], fDistance);
				if(MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0) PlayerTextDrawSetString(playerid, MsgText[playerid], MsgLocalize);
				if(CheckSAMU[playerid] > -1)
				{
				    DestroyDynamicCP(CheckSAMU[playerid]);
				}
				CheckSAMU[playerid] = CreateDynamicCP(X, Y, Z, 1.2, -1, -1, playerid, 10000.0);
				SetTimerEx("Localizador", 2000, false, "i", playerid);
			}
			else
			{
			    if(CheckSAMU[playerid] > -1)
				{
				    DestroyDynamicCP(CheckSAMU[playerid]);
				    CheckSAMU[playerid] = -1;
				}
				if(SangueObjeto[Localizando[playerid]] > -1)
				{
					DestroyObject(SangueObjeto[Localizando[playerid]]);
					SangueObjeto[Localizando[playerid]] = -1;
				}
                Localizando[playerid] = -1;
				SendClientMessage(playerid, GetPlayerColor(playerid), "| SAMU | O(A) Jogador(a) localizado(a) nao precisa mais de socorro");
			}
		}
	}
	else
	{
	    //SendClientMessage(playerid, 0x228B22FF, "| GPS | O(A) Jogador(a) localizado saiu do servidor");
		Localizando[playerid] = -1;
		DisablePlayerCheckpoint(playerid);
		if(CheckSAMU[playerid] > -1)
		{
  			DestroyDynamicCP(CheckSAMU[playerid]);
  			CheckSAMU[playerid] = -1;
		}
	}
	return 1;
}
stock VoipNomer(playerid){
	new name[MAX_PLAYER_NAME+1];
	GetPlayerName(playerid, name, MAX_PLAYER_NAME+1);
	return name;
}
forward Localizadorr(playerid);
public Localizadorr(playerid)
{
	if(IsPlayerConnected(playerid) && Spawnado[playerid] == true && IsPlayerConnected(InviteLocalizacao[playerid]) && Spawnado[InviteLocalizacao[playerid]] == true && Localizando[playerid] == -1)
	{
	    new zone[MAX_ZONE_NAME], MsgLocalize[128], Float:X, Float:Y, Float:Z;
   		GetPlayerPos(InviteLocalizacao[playerid], X, Y, Z); GetPlayer2DZone(InviteLocalizacao[playerid], zone, MAX_ZONE_NAME);
	   	new Float:fDistance = GetPlayerDistanceFromPoint(playerid, X, Y, Z);
		format(MsgLocalize, sizeof(MsgLocalize), "~w~LOCALIZANDO: ~b~~h~%s~w~, Local: ~g~~h~%s~w~, Distancia: ~r~~h~%0.1fm", PlayerName(InviteLocalizacao[playerid]), zone, fDistance);
		if(MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0) PlayerTextDrawSetString(playerid, MsgText[playerid], MsgLocalize);
		SetPlayerCheckpoint(playerid, X, Y, Z, 0.0);
		SetTimerEx("Localizadorr", 2000, false, "i", playerid);
	}
	else
	{
		InviteLocalizacao[playerid] = -1;
		DisablePlayerCheckpoint(playerid);
	}
	return 1;
}

forward ChamadaTrintaMin();
public ChamadaTrintaMin()
{
	for(new i = 0; i < sizeof(ClimaCidades); i++)
    {
	 	ClimaCidades[i] = random(20) + 1;
	 	if(ClimaCidades[i] == 8 || ClimaCidades[i] == 9 || ClimaCidades[i] == 16 || ClimaCidades[i] == 19)
	 	{
	 	    ClimaCidades[i] = 18;
	 	}
	}
	SetTimer("AutoMessage", 30000+random(31000), false);
	new Float:C[3];
 	for(new a; a < 5; a++)
	{
	    if(ValorCofre[a] == -1)
	    {
			ValorCofre[a] = 0;
			UpdateDynamic3DTextLabelText(TextoCofre[a], -1, "{FFFFFF}Cofre");
			GetDynamicObjectPos(ObjetoCofre[a], C[0], C[1], C[2]);
	  		DestroyDynamicObject(ObjetoCofre[a]);
		  	ObjetoCofre[a] = CreateDynamicObject(2332, C[0], C[1], C[2], 0.000000, 0.000000, 180.000000, -1, -1, -1, 300.00, 300.00);
		}
	}
	
	Sorteio ++;
	
	if(Sorteio == 3)//1hr e 30min
	{
	    sdados();
	    new NomeNaMsg[15]; format(NomeNaMsg, sizeof(NomeNaMsg), "%d", AcumuladosLotofacil);
	    format(String, sizeof(String), "| LOTOFACIL | O premio %s esta acumulado em $%s, va ate a loterica e faca sua aposta!", GetDia(), AttNumeroDecimal(NomeNaMsg));
	    SendClientMessageToAll(0x088A08FF, String);
	}
	else if(Sorteio == 4)//sorteio LOTOFACIL ( 2 hrs )
	{
     	new hh, mm, ss; gettime(hh, mm, ss);
		TempoSorteio[0][0] = hh+4; TempoSorteio[0][1] = mm;
		if(TempoSorteio[0][0] >= 24)
	    {
	        TempoSorteio[0][0] -= 24;
	    }
		TextDrawSetString(TextSorteio[1], "Lotofacil");
	    new n = 1 + random(100);
		if(!new_strcmp(Lotofacil[n-1], "Ninguem"))
		{
			new bool:passou;
		    for(new t; t < 30; t++)
		    {
		        if(new_strcmp(GanhadoresLoteria[t], ""))
		        {
		            new dia, mes, ano, hora, minuto, segundo; getdate(ano, mes, dia); gettime(hora, minuto, segundo);
		            format(GanhadoresLoteria[t], 150, "O(A) Jogador(a) %s ganhou na Lotofacil dia %02d/%02d/%02d as %02d:%02d, premio: $%d, numero: %02d", Lotofacil[n-1], dia, mes, ano, hora, minuto, AcumuladosLotofacil, n);
                    passou = true;
					break;
		        }
		    }
		    if(passou == false)
		    {
		        for(new t; t < 29; t++)
			    {
			        format(GanhadoresLoteria[t], 150, "%s", GanhadoresLoteria[t+1]);
			    }
			    new dia, mes, ano, hora, minuto, segundo; getdate(ano, mes, dia); gettime(hora, minuto, segundo);
       			format(GanhadoresLoteria[29], 150, "O(A) Jogador(a) %s ganhou na Lotofacil dia %02d/%02d/%02d as %02d:%02d, premio: $%d, numero: %02d", Lotofacil[n-1], dia, mes, ano, hora, minuto, AcumuladosLotofacil, n);
		    }
		    foreach(Player, i)
		    {
		        if(new_strcmp(Lotofacil[n-1], PlayerName(i)) && Spawnado[i] == true)
		        {
		            format(String, sizeof(String), "| INFO | Voce foi o(a) ganhador(a) da Lotofacil e recebeu $%d em sua conta bancaria!", AcumuladosLotofacil);
					SendClientMessage(i, 0x00FF00FF, String);
					GameTextForPlayer(i, "~g~Voce ganhou!", 5000, 0);
					SaldoBancario[i] += AcumuladosLotofacil;
					new NomeNaMsg[15]; format(NomeNaMsg, sizeof(NomeNaMsg), "%d", AcumuladosLotofacil);
					format(String, sizeof(String), "Premio: ~g~$%s~n~~w~Numero Sorteado: ~y~%02d~n~~w~Ganhador: ~b~%s", AttNumeroDecimal(NomeNaMsg), n, Lotofacil[n-1]);
                    TextDrawSetString(TextSorteio[2], String);
                    //
                    AcumuladosLotofacil = 2501 + random(2500);
					SetTimer("LimparSorteio", 6000, false);
					for(new l; l < 100; l++)
					{
						format(Lotofacil[l], 25, "Ninguem");
					}
					//
					for(new t; t < 4; t++)
					{
					    TextDrawShowForAll(TextSorteio[t]);
					}
					return 1;
		        }
		    }
		    format(String, sizeof(String), "Contas/%s.ini", Lotofacil[n-1]);
		    if(DOF2_FileExists(String))
		    {
			    DOF2_SetInt(String, "SaldoBancario", DOF2_GetInt(String, "SaldoBancario") + AcumuladosLotofacil);
				DOF2_SaveFile();
			}
			new NomeNaMsg[15]; format(NomeNaMsg, sizeof(NomeNaMsg), "%d", AcumuladosLotofacil);
			format(String, sizeof(String), "Premio: ~g~$%s~n~~w~Numero Sorteado: ~y~%02d~n~~w~Ganhador: ~b~%s", AttNumeroDecimal(NomeNaMsg), n, Lotofacil[n-1]);
            TextDrawSetString(TextSorteio[2], String);
            //
            AcumuladosLotofacil = 2501 + random(2500);
            SetTimer("LimparSorteio", 6000, false);
			for(new l; l < 100; l++)
			{
				format(Lotofacil[l], 25, "Ninguem");
			}
            //
			for(new t; t < 4; t++)
			{
			    TextDrawShowForAll(TextSorteio[t]);
			}
		}
		else
		{
		    new NomeNaMsg[15]; format(NomeNaMsg, sizeof(NomeNaMsg), "%d", AcumuladosLotofacil);
			format(String, sizeof(String), "Premio: ~g~$%s~n~~w~Numero Sorteado: ~y~%02d~n~~w~Ganhador: ~r~%s", AttNumeroDecimal(NomeNaMsg), n, Lotofacil[n-1]);
            TextDrawSetString(TextSorteio[2], String);
            //
            AcumuladosLotofacil += 8000+random(5001);
            SetTimer("LimparSorteio", 6000, false);
			for(new l; l < 100; l++)
			{
				format(Lotofacil[l], 25, "Ninguem");
			}
            //
			for(new t; t < 4; t++)
			{
		    	TextDrawShowForAll(TextSorteio[t]);
			}
		}
	}
	else if(Sorteio == 7)//3hrs e 30min
	{
	    sdados();
	    new NomeNaMsg[15]; format(NomeNaMsg, sizeof(NomeNaMsg), "%d", AcumuladosMegasena);
	    format(String, sizeof(String), "| MEGA-SENA | O premio %s esta acumulado em $%s, va ate a loterica e faca sua aposta!", GetDia(), AttNumeroDecimal(NomeNaMsg));
	    SendClientMessageToAll(0x088A08FF, String);
	}
	else if(Sorteio == 8)//sorteio MEGA-SENA ( 4 hrs )
	{
	    Sorteio = 0;
	    new hh, mm, ss; gettime(hh, mm, ss);
		TempoSorteio[1][0] = hh+4; TempoSorteio[1][1] = mm;
		if(TempoSorteio[1][0] >= 24)
	    {
	        TempoSorteio[1][0] -= 24;
	    }
	    TextDrawSetString(TextSorteio[1], "Mega-Sena");
	    new a = 1 + random(15), b = 1 + random(15), c = 1 + random(15);
	    while(a == b)
	    {
     		a = 1 + random(15);
	    }
     	while(c == b || c == a)
	    {
	        c = 1 + random(15);
	    }
        //
        new acertou;
	    for(new m; m < MAX_PLAYERS; m++)
		{
		    if(!new_strcmp(NomeMegaSena[m], "Ninguem"))
		    {
				for(new n; n < 3; n++)
				{
				    if(NumeroMegaSena[m][n] == a || NumeroMegaSena[m][n] == b || NumeroMegaSena[m][n] == c)
				    {
				        acertou ++;
				    }
				}
				if(acertou >= 3)
				{
				    new bool:passou;
				    for(new t; t < 30; t++)
				    {
				        if(new_strcmp(GanhadoresLoteria[t], ""))
				        {
				            new dia, mes, ano, hora, minuto, segundo; getdate(ano, mes, dia); gettime(hora, minuto, segundo);
				            format(GanhadoresLoteria[t], 150, "O(A) Jogador(a) %s ganhou na Mega-Sena dia %02d/%02d/%02d as %02d:%02d, premio: $%d, numeros: %02d-%02d-%02d", NomeMegaSena[m], dia, mes, ano, hora, minuto, AcumuladosMegasena, a, b, c);
		                    passou = true;
							break;
				        }
				    }
				    if(passou == false)
				    {
				        for(new t; t < 29; t++)
					    {
					        format(GanhadoresLoteria[t], 150, "%s", GanhadoresLoteria[t+1]);
					    }
					    new dia, mes, ano, hora, minuto, segundo; getdate(ano, mes, dia); gettime(hora, minuto, segundo);
		       			format(GanhadoresLoteria[29], 150, "O(A) Jogador(a) %s ganhou na Mega-Sena dia %02d/%02d/%02d as %02d:%02d, premio: $%d, numeros: %02d-%02d-%02d", NomeMegaSena[m], dia, mes, ano, hora, minuto, AcumuladosMegasena, a, b, c);
				    }
				    //
			        foreach(Player, i)
			        {
			            if(new_strcmp(PlayerName(i), NomeMegaSena[m]) && Spawnado[i] == true)
			            {
			                format(String, sizeof(String), "| INFO | Voce foi o(a) ganhador(a) da Mega-Sena e recebeu $%d em sua conta bancaria!", AcumuladosMegasena);
							SendClientMessage(i, 0x00FF00FF, String);
							GameTextForPlayer(i, "~g~Voce ganhou!", 5000, 0);
							SaldoBancario[i] += AcumuladosMegasena;
							new NomeNaMsg[15]; format(NomeNaMsg, sizeof(NomeNaMsg), "%d", AcumuladosMegasena);
							format(String, sizeof(String), "Premio: ~g~$%s~n~~w~Numero Sorteado: ~y~%02d-%02d-%02d~n~~w~Ganhador: ~b~%s", AttNumeroDecimal(NomeNaMsg), a, b, c, NomeMegaSena[m]);
					        TextDrawSetString(TextSorteio[2], String);
		                    //
		                    AcumuladosMegasena = 1000 + random(1001);
							SetTimer("LimparSorteio", 6000, false);
							for(new l; l < MAX_PLAYERS; l++)
							{
								format(NomeMegaSena[l], 25, "Ninguem");
								NumeroMegaSena[l][0] = 0; NumeroMegaSena[l][1] = 0; NumeroMegaSena[l][2] = 0;
							}
							//
							for(new t; t < 4; t++)
							{
							    TextDrawShowForAll(TextSorteio[t]);
							}
			                return 1;
			            }
			        }
			        format(String, sizeof(String), "Contas/%s.ini", NomeMegaSena[m]);
			        if(DOF2_FileExists(String))
			        {
			            DOF2_SetInt(String, "SaldoBancario", DOF2_GetInt(String, "SaldoBancario") + AcumuladosMegasena);
						DOF2_SaveFile();
			        }
				    //
					new NomeNaMsg[15]; format(NomeNaMsg, sizeof(NomeNaMsg), "%d", AcumuladosMegasena);
					format(String, sizeof(String), "Premio: ~g~$%s~n~~w~Numero Sorteado: ~y~%02d-%02d-%02d~n~~w~Ganhador: ~b~%s", AttNumeroDecimal(NomeNaMsg), a, b, c, NomeMegaSena[m]);
			        TextDrawSetString(TextSorteio[2], String);
           			//
              		AcumuladosMegasena = 1000 + random(1001);
					SetTimer("LimparSorteio", 6000, false);
					for(new l; l < MAX_PLAYERS; l++)
					{
						format(NomeMegaSena[l], 25, "Ninguem");
						NumeroMegaSena[l][0] = 0; NumeroMegaSena[l][1] = 0; NumeroMegaSena[l][2] = 0;
					}
					//
					for(new t; t < 4; t++)
					{
	    				TextDrawShowForAll(TextSorteio[t]);
					}
				    return 1;
				}
				else
				{
					acertou = 0;
					format(NomeMegaSena[m], 25, "Ninguem");
					NumeroMegaSena[m][0] = 0; NumeroMegaSena[m][1] = 0; NumeroMegaSena[m][2] = 0;
				}
		    }
		}
	    new NomeNaMsg[15]; format(NomeNaMsg, sizeof(NomeNaMsg), "%d", AcumuladosMegasena);
		format(String, sizeof(String), "Premio: ~g~$%s~n~~w~Numero Sorteado: ~y~%02d-%02d-%02d~n~~w~Ganhador: ~r~Ninguem", AttNumeroDecimal(NomeNaMsg), a, b, c);
  		TextDrawSetString(TextSorteio[2], String);
	    AcumuladosMegasena += 8000+random(5001);
        SetTimer("LimparSorteio", 6000, false);
	    //
		for(new t; t < 4; t++)
		{
	    	TextDrawShowForAll(TextSorteio[t]);
		}
	}
	return 1;
}

forward AutoMessage();
public AutoMessage()
{
    new randMSG = random(sizeof(RandomMSG));
   	SendClientMessageToAll(0x00FF00FF, RandomMSG[randMSG]);
	return 1;
}

forward LimparSorteio();
public LimparSorteio()
{
    for(new t; t < 4; t++)
	{
 		TextDrawHideForAll(TextSorteio[t]);
	}
	return 1;
}

forward CarregarHospital(playerid);
public CarregarHospital(playerid)
{
    TogglePlayerControllable(playerid, 1);
	MsgAviso(playerid, 5, "~w~Hospital");
	return 1;
}
forward CarregarInterior(playerid);
public CarregarInterior(playerid)
{
    TogglePlayerControllable(playerid, 1);
	return 1;
}

forward ExplodirDinamite(playerid);
public ExplodirDinamite(playerid)
{
    TimerAssalto[playerid][1] = -1;
   	CreateExplosion(XDinamite[playerid], YDinamite[playerid], ZDinamite[playerid], 0, 10.0);
   	DestroyDynamicObject(Explosivos[playerid][1]);
   	Explosivos[playerid][1] = -1;
   	if(ORG[playerid] >= 0 || NivelAdmin[playerid] > 0 || IsPlayerAdmin(playerid))
   	{
		new Float:C[6];
		GetDynamicObjectPos(PortaBanco, C[0], C[1], C[2]); GetDynamicObjectRot(PortaBanco, C[3], C[4], C[5]);
		if(IsPointInRangeOfPoint(C[0], C[1], C[2], XDinamite[playerid], YDinamite[playerid], ZDinamite[playerid], 1.6) && !IsDynamicObjectMoving(PortaBanco))
		{
		    if(PortaBancoAberta == false)
		    {
		        MoveDynamicObject(PortaBanco, C[0], C[1], C[2]+0.01, 0.01, C[3], C[4], C[5]+80);
		        PortaBancoAberta = true;
		    }
		    new NomeBanco[20];
		    if(PlayerIdBanco[playerid] == 0) NomeBanco = "Sao Paulo";
		    else if(PlayerIdBanco[playerid] == 1) NomeBanco = "Montgomery";
		    else if(PlayerIdBanco[playerid] == 2) NomeBanco = "Palomino Creek";
		    else if(PlayerIdBanco[playerid] == 3) NomeBanco = "Bahia";
		    else if(PlayerIdBanco[playerid] == 4) NomeBanco = "Fort Carson";
		    else if(PlayerIdBanco[playerid] == 5) NomeBanco = "El Quebrados";
		    else if(PlayerIdBanco[playerid] == 6) NomeBanco = "Las Barrancas";
		    else if(PlayerIdBanco[playerid] == 7) NomeBanco = "Rio De Janeiro";
		    else if(PlayerIdBanco[playerid] >= 8) NomeBanco = "Algel Pine";
		    format(String, sizeof(String), "| DP | O(A) Mafioso(a) %s[%d] esta assaltando o Banco de %s!", PlayerName(playerid), playerid, NomeBanco);
		    foreach(Player, ii)
			{
				if(IsPlayerConnected(ii) && Spawnado[ii] == true)
				{
					PlayerPlaySound(ii, 9200, C[0], C[1], C[2]);
					if(PROF[ii] == PM || PROF[ii] == ROTA  || PROF[ii] == CHOQUE || PROF[ii] == ROTAM || PROF[ii] == BOPE || PROF[ii] == PC || PROF[ii] == PF || PROF[ii] == EXERCITO)
					{
						SendClientMessage(ii, GetPlayerColor(ii), String);
					}
				}
			}
		    return 1;
		}
		else if(IsPlayerInRangeOfPoint(playerid, 30.0, -31.381217, -26.194713, 1261.542236))
		{
			new i = GetPlayerVirtualWorld(playerid);
			if(f_info[i][f_cofre] > 0)
			{
			    format(String, sizeof(String), "| INFO | Voce explodiu o cofre dessa fazenda e roubou {00FF00}$%d{FFFFFF}, fuja com o dinheiro!", f_info[i][f_cofre]);
				SendClientMessage(playerid, -1, String);
				SendClientMessage(playerid, -1, "| INFO | O dinheiro vira para sua mao apos 2 minutos");
				TimerFuga[playerid] = SetTimerEx("EntregarDinFazenda", 120000, false, "dd", playerid, f_info[i][f_cofre]);
				f_info[i][f_cofre] = -1;
				
				new str[400]; format(str, sizeof(str), "{FFFFFF}Fazenda {6441A5}%s {FFFFFF}ID %d\n{FFFFFF}Dono: %s\n{FFFFFF}Funcionario 1: %s\n{FFFFFF}Funcionario 2: %s\n{FFFFFF}Funcionario 3: %s\n{FFFFFF}Valor: {00FF00}$500.000 {FFFFFF}e {FFFF00}50.000 Coins\n{FFFFFF}Fundos: {00FF00}$%d\n{FFFFFF}Produtos: {DF7401}%d und", f_info[i][f_nome], i, f_info[i][f_dono], f_info[i][f_funcionario0], f_info[i][f_funcionario1], f_info[i][f_funcionario2], f_info[i][f_cofre], f_info[i][f_produtos]);
				UpdateDynamic3DTextLabelText( f_info[i][f_texto], -1, str);
				return 1;
			}
		}
		else
		{
			new abrir = random(2);
	 		for(new a; a < 5; a++)
			{
				GetDynamicObjectPos(ObjetoCofre[a], C[0], C[1], C[2]);
				if(IsPointInRangeOfPoint(C[0], C[1], C[2], XDinamite[playerid], YDinamite[playerid], ZDinamite[playerid], 1.0) && ValorCofre[a] == 0)
				{
				    if(abrir == 1)
					{
					    ValorCofre[a] = 10000 + random(10001);
					    new StrCofre[35]; format(StrCofre, sizeof(StrCofre), "{FFFFFF}Cofre\n{00FF00}%d", ValorCofre[a]);
					    UpdateDynamic3DTextLabelText(TextoCofre[a], -1, StrCofre);
					    DestroyDynamicObject(ObjetoCofre[a]);
					    ObjetoCofre[a] = CreateDynamicObject(1829, C[0], C[1]+0.5, C[2], 0.000000, 0.000000, 180.000000, -1, -1, -1, 300.00, 300.00);
					    return 1;
					}
					else
					{
					    MsgAviso(playerid, 4, "~r~Nao foi possivel abrir o cofre, tente novamente");
					    return 1;
					}
				}
			}
		}
	}
	return 1;
}

forward AssaltarCaixa(playerid);
public AssaltarCaixa(playerid)
{
	new Float:P[3];
    for(new cx; cx < 40; cx++)
    {
        GetDynamicObjectPos(Caixa[cx], P[0], P[1], P[2]);
  		if(IsPlayerInRangeOfPoint(playerid, 50.0, P[0], P[1], P[2]))
       	{
       		new valorassalto;
       		if(CaixaMoney[cx] >= 50000)
           	{
	       	    valorassalto = CaixaMoney[cx] * 10 / 100;
	           	CaixaMoney[cx] -= valorassalto;
           	}
           	else if(CaixaMoney[cx] >= 25000)
           	{
           	    valorassalto = CaixaMoney[cx] * 11 / 100;
	           	CaixaMoney[cx] -= valorassalto;
           	}
           	else if(CaixaMoney[cx] >= 10000)
           	{
           	    valorassalto = CaixaMoney[cx] * 12 / 100;
	           	CaixaMoney[cx] -= valorassalto;
           	}
           	else if(CaixaMoney[cx] >= 17)
           	{
	       	    valorassalto = CaixaMoney[cx] * 15 / 100;
	          	CaixaMoney[cx] -= valorassalto;
           	}
           	else
           	{
            	return SendClientMessage(playerid, COR_ERRO, "| ERRO | O Caixa Eletronico que voce tentou assaltar ficou sem dinheiro");
          	}
           	TimerAssalto[playerid][0] = -1;
           	CreateExplosion(XAssalto[playerid], YAssalto[playerid], ZAssalto[playerid], 11, 5.0);
          	DestroyDynamicObject(Explosivos[playerid][0]);
           	Explosivos[playerid][0] = -1;
           	format(String, sizeof(String), "{00FF00}Caixa Eletronico {FFFFFF}[{00FF00}$%d{FFFFFF}]\n{FFFFFF}Pressione a tecla '{00FF00}F{FFFFFF}' para utilizar", CaixaMoney[cx]);
			UpdateDynamic3DTextLabelText(TextCX[cx], -1, String);
			new zone[MAX_ZONE_NAME]; GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
			format(String, sizeof(String), "| ASSALTO | Voce explodiu o caixa Eletronico de {FFFF00}%s {FFFFFF}e {00CD00}$%d {FFFFFF}foram espalhados", zone, valorassalto);
			SendClientMessage(playerid, -1, String);
			GameTextForPlayer(playerid, "~r~~h~Assalto Efetuado!", 3000, 3);
			ValorAssaltoReceber[playerid] = valorassalto / 10;
			PegouDinheiro[playerid] = 10;
			for(new p; p < 10; p++)
			{
			    if(PickAssalto[playerid][p] > -1)
			    {
			        DestroyDynamicPickup(PickAssalto[playerid][p]);
			    }
			}
			
			CofreFavela += valorassalto * 30 / 100;
			new ValorNaMsg[11]; format(ValorNaMsg, sizeof(ValorNaMsg), "%d", CofreFavela);
			format(String, sizeof(String), "{FFFFFF}Dinheiro Sujo\n{00FF00}$%s\nUse /Sacar", AttNumeroDecimal(ValorNaMsg));
	 		UpdateDynamic3DTextLabelText(TextFavela, -1, String);

			new rand[10];
			for (new r; r < 10; r++)
			{
			    rand[r] = random(sizeof(RandI));
			}
			PickAssalto[playerid][0] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] + RandI[rand[0]][0], FrenteCaixa[cx][1] + RandI[rand[1]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][1] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] - RandI[rand[0]][0], FrenteCaixa[cx][1] - RandI[rand[1]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][2] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] + RandI[rand[2]][0], FrenteCaixa[cx][1] - RandI[rand[3]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][3] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] - RandI[rand[2]][0], FrenteCaixa[cx][1] + RandI[rand[3]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][4] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] + RandI[rand[4]][0], FrenteCaixa[cx][1] - RandI[rand[5]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][5] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] - RandI[rand[4]][0], FrenteCaixa[cx][1] + RandI[rand[5]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][6] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] + RandI[rand[6]][0], FrenteCaixa[cx][1] - RandI[rand[7]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][7] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] - RandI[rand[6]][0], FrenteCaixa[cx][1] + RandI[rand[7]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][8] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] + RandI[rand[8]][0], FrenteCaixa[cx][1] - RandI[rand[9]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			PickAssalto[playerid][9] = CreateDynamicPickup(1212, 23, FrenteCaixa[cx][0] - RandI[rand[8]][0], FrenteCaixa[cx][1] + RandI[rand[9]][0], FrenteCaixa[cx][2]-0.5);//Pickup;
			Streamer_Update(playerid);
			return 1;
		}
	}
	TimerAssalto[playerid][0] = -1;
	DestroyDynamicObject(Explosivos[playerid][0]);
	Explosivos[playerid][0] = -1;
	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu assalto a caixa Eletronico falhou pois voce se afastou demais");
}

