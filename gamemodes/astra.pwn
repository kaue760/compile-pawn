new RandomMSG[][] =
{
	{"[{FF0000}SERVER{00FF00}] Esta perdido pelo mapa ou esta precisando de uma carona? Chame um taxi ate voce ~> /Taxi"},
	{"[{FF0000}SERVER{00FF00}] Seu veiculo quebrou? Compre um kit reparo no supermercado ou chame um mecanico ~> /Mecanico"},
	{"[{FF0000}SERVER{00FF00}] Seu veiculo acabou o combustivel? Va ate um posto de gasolina e compre um Galao de 10L para abastece-lo"},
	{"[{FF0000}SERVER{00FF00}] Sempre ande com alimentos, galao de combustivel e kit reparo no inventario para se previnir de incidentes"},
	{"[{FF0000}SERVER{00FF00}] Jogar em nosso servidor e um previlegio e nao um direito"},
	{"[{FF0000}SERVER{00FF00}] Para localizar os principais locais do servidor use /Celular e acesse o app Maps"},
	{"[{FF0000}SERVER{00FF00}] Sua casa esta com incendio? Chame um bombeiro ~> /193"},
	{"[{FF0000}SERVER{00FF00}] Precisa de ajuda? ~> /Ajuda"},
	{"[{FF0000}SERVER{00FF00}] Para fazer uma denuncia para os policiais use ~> /190"},
	{"[{FF0000}SERVER{00FF00}] Esta precisando de socorro? Chame o SAMU pelo comando ~> /192"},
	{"[{FF0000}SERVER{00FF00}] Para ver as vantagens Vip digite /VantagensVip"},
	{"[{FF0000}SERVER{00FF00}] Para ver os jogadores Vips online digite /Vips"},
	{"[{FF0000}SERVER{00FF00}] Para ver os Admins online digite /Admins"},
	{"[{FF0000}SERVER{00FF00}] Pague seus impostos na prefeitura antes de que seus bens sejam perdidos"},
	{"[{FF0000}SERVER{00FF00}] Nos sigam no instagram, fique por dentro das novidades e concorra a varios sorteios exclusivos: @Santa Group "},
	{"[{FF0000}SERVER{00FF00}] Para comprar coins acesse a loja oficial do servidor: www.Santa Group .com"},
	{"[{FF0000}SERVER{00FF00}] Esta com alguma duvida sobre o servidor? Digite /Duvida e pergunte para os admins online"},
	{"[{FF0000}SERVER{00FF00}] Viu algum caso de Anti-RP no servidor? Digite /Relatorio e reporte o(a) jogador(a) para os admins online"},
	{"[{FF0000}SERVER{00FF00}] Para comprar coins acesse a loja oficial do servidor: www.Santa Group .com"},
	{"[{FF0000}SERVER{00FF00}] Acesse o nosso forum e fique por dentro de todas as novidades do servidor: forum.Santa Group .com"},
	{"[{FF0000}SERVER{00FF00}] Para comprar Vip, Orgs, Corps e Itens digite ~> /Loja"}
};
