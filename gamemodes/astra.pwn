		{
		    SendClientMessage(playerid, -1, "| INFO | Para entrar no Detran digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
		else if(pickupid == PickEntrada[35])
		{
		    SendClientMessage(playerid, -1, "| INFO | Para entrar no Cartorio digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
		else if(pickupid == PickEntrada[6] || pickupid == PickEntrada[7] || pickupid == PickEntrada[14] || pickupid == PickEntrada[15] || pickupid == PickEntrada[16] || pickupid == PickEntrada[17] || pickupid == PickEntrada[18])
		{
		    SendClientMessage(playerid, -1, "| INFO | Para entrar no Hospital digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
		else if(pickupid == PickEntradaAreaVip[0] || pickupid == PickEntradaAreaVip[1] || pickupid == PickEntradaAreaVip[2])
		{
		    SendClientMessage(playerid, -1, "| INFO | Para entrar na Area Vip digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
		else if(pickupid == pFardamarinha)
		{
		    if(PROF[playerid] == PC)
		    {
		        if(GetPlayerSkin(playerid) == 285)
		        {
		            SetPlayerSkin(playerid, SkinPlayer[playerid]);
		            return 1;
		        }
		        else
				{
				    SetPlayerSkin(playerid, 285);
				    return 1;
		        }
		    }
		}
		else if(pickupid == pFardaexercito)
		{
		    if(PROF[playerid] == EXERCITO)
		    {
		        if(GetPlayerSkin(playerid) == 287)
		        {
		            SetPlayerSkin(playerid, SkinPlayer[playerid]);
		            return 1;
		        }
		        else
				{
				    SetPlayerSkin(playerid, 287);
				    return 1;
		        }
		    }
		    else if(PROF[playerid] == PF)
		    {
		        if(GetPlayerSkin(playerid) == 285)
		        {
		            SetPlayerSkin(playerid, SkinPlayer[playerid]);
		            return 1;
		        }
		        else
				{
				    SetPlayerSkin(playerid, 285);
				    return 1;
		        }
		    }
		}
		else if(pickupid == pEquiparmarinha)
		{
		    if(PROF[playerid] == PC)
		    {
		        if(Porte[playerid] <= 0)
		    	{
			       /*return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao possui porte de armas");*/
			    }
			    new equipado;
			    for(new m; m < GetPlayerVoltas(playerid); m++)
				{
					switch(SlotMochila[playerid][m])
					{
						case PISTOLA9MM, PISTOLASILENCED, DESERTEAGLE, SHOTGUN, SAWNOFF, COMBATSHOTGUN, MP5, UZI, AK, M4, SNIPER:
						{
							equipado ++;
						    if(equipado >= 3)
						    {
						    	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce ja possui muitas armas no inventario");
						    }
					 	}
					}
				}
		        ResetPlayerWeaponsExC(playerid);
				GivePlayerWeaponExC(playerid, Arma1PC, Municao1PC);
				GivePlayerWeaponExC(playerid, Arma2PC, Municao2PC);
				GivePlayerWeaponExC(playerid, Arma3PC, Municao3PC);
				SetPlayerArmour(playerid, 100.0);
				return 1;
		    }
		}
		else if(pickupid == pEquiparexercito)
		{
		    if(PROF[playerid] == EXERCITO)
		    {
		        if(Porte[playerid] <= 0)
		    	{
			       /*return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao possui porte de armas");*/
			    }
			    new equipado;
			    for(new m; m < GetPlayerVoltas(playerid); m++)
				{
					switch(SlotMochila[playerid][m])
					{
						case PISTOLA9MM, PISTOLASILENCED, DESERTEAGLE, SHOTGUN, SAWNOFF, COMBATSHOTGUN, MP5, UZI, AK, M4, SNIPER:
						{
							equipado ++;
						    if(equipado >= 3)
						    {
						    	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce ja possui muitas armas no inventario");
						    }
					 	}
					}
				}
          		ResetPlayerWeaponsExC(playerid);
				GivePlayerWeaponExC(playerid, Arma1EXERCITO, Municao1EXERCITO);
				GivePlayerWeaponExC(playerid, Arma2EXERCITO, Municao2EXERCITO);
				GivePlayerWeaponExC(playerid, Arma3EXERCITO, Municao3EXERCITO);
				SetPlayerArmour(playerid, 100.0);
				return 1;
		    }
		}
		else if(pickupid == PickupCaca)
		{
		    if(PROF[playerid] == CACADOR)
		    {
				GivePlayerWeaponExC(playerid, 25, 30);
				SetPlayerAmmo(playerid, 25, 100);
				return 1;
		    }
		}
		else if(pickupid == PickMotoSerra)
		{
		    if(PROF[playerid] == LENHADOR)
		    {
				GivePlayerWeaponExC(playerid, 9, 1);
				return 1;
		    }
		}
		else if(pickupid == PrivatePick)
		{
		    new str[250];
		    format(str, sizeof(str), " \t \n{FFFFFF}Entrar\t[{0040FF}Homem: $0 {FFFFFF}- {FE2E9A}Mulher: $0{FFFFFF}]\nComprar\t[{088A08}$0 {FFFFFF}- {FFFF00}100000C{FFFFFF}]\nVender\t[{088A08}$0{FFFFFF}]\nSacar Lucro\t[{088A08}$%d{FFFFFF}]\nDono(a)\t%s", PrivateLucro, PrivateDono);
		    ShowPlayerDialog(playerid, D_PRIVATE, DIALOG_STYLE_TABLIST_HEADERS, "{FFFFFF}Private Club", str, "Selecionar", "Fechar");
		    Flooder[playerid] = gettime() + 10000;
		}
		else
		{
		    for(new e; e < MAX_EMPRESAS; e++)
			{
			    if(pickupid == ePick[e])
			    {
			        SendClientMessage(playerid, -1, "| INFO | Para entrar na Empresa digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
                    Flooder[playerid] = gettime();
					return 1;
			    }
			}
		    if(!IsPlayerInAnyVehicle(playerid))
		    {
			    for(new p; p < MAX_POSTOS; p++)
			    {
			        if(pickupid == PickPosto[p])
			        {
						if(IsPlayerInRangeOfPoint(playerid, 40.0, pX[p], pY[p], pZ[p]))
						{
				            new gstring[400], pstring[100];
							format(pstring, sizeof(pstring), "{FFFFFF}Funcao\t{00FF00}Valor\n");
							strcat(gstring, pstring);
							format(pstring, sizeof(pstring), "{FFFFFF}Pegar Galao (10L)\t{00FF00}$100\n");
							strcat(gstring, pstring);
							if(new_strcmp(pDono[p], "Ninguem"))//sem dono
							{
								format(pstring, sizeof(pstring), "{FFFFFF}Comprar Posto\t{00FF00}$%d\n", pValor[p]);
								strcat(gstring, pstring);
								format(pstring, sizeof(pstring), "{FFFFFF}Vender Posto p/ Servidor\t-\n");
								strcat(gstring, pstring);
								format(pstring, sizeof(pstring), "{FFFFFF}Vender Posto p/ Jogador\t-\n");
								strcat(gstring, pstring);
								format(pstring, sizeof(pstring), "{FFFFFF}Sacar Lucro\t-\n");
								strcat(gstring, pstring);
							}
							else//com dono
							{
							    if(pAvenda[p] > 0)//sem dono
								{
									format(pstring, sizeof(pstring), "{FFFFFF}Comprar Posto\t{00FF00}$%d\n", pAvenda[p]);
									strcat(gstring, pstring);
								}
								else
								{
								    format(pstring, sizeof(pstring), "{FFFFFF}Comprar Posto\t-\n");
									strcat(gstring, pstring);
								}
								format(pstring, sizeof(pstring), "{FFFFFF}Vender Posto p/ Servidor\t{00FF00}$%d\n", pValor[p] * 70 / 100);
								strcat(gstring, pstring);
								format(pstring, sizeof(pstring), "{FFFFFF}Vender Posto p/ Jogador\t{00FF00}$%d {FFFFFF}a {00FF00}$%d\n", pValor[p] * 70 / 100, pValor[p] * 120 / 100);
								strcat(gstring, pstring);
								format(pstring, sizeof(pstring), "{FFFFFF}Sacar Lucro\t{00FF00}$%d\n", pLucro[p]);
								strcat(gstring, pstring);
								format(pstring, sizeof(pstring), "{FFFFFF}Impostos\t{FFFFFF}%d / 15", pImpostos[p]);
								strcat(gstring, pstring);
							}
							ShowPlayerDialog(playerid, D_POSTO, DIALOG_STYLE_TABLIST_HEADERS, "{708090}Posto", gstring, "Selecionar", "Cancelar");
	                        Flooder[playerid] = gettime() + 10000;
							return 1;
						}
			    	}
				}
			}
		    if(PegouDinheiro[playerid] > 0)
		    {
				for(new p; p < 10; p++)
			    {
			        if(pickupid == PickAssalto[playerid][p])
			        {
			            DestroyDynamicPickup(PickAssalto[playerid][p]);
			            PickAssalto[playerid][p] = -1;
			            DinheiroSujo[playerid] += ValorAssaltoReceber[playerid];
			            PegouDinheiro[playerid] --;
			            new StrA[15];
			            format(StrA, sizeof(StrA), "~w~DINHEIRO SUJO+ ~g~$%d", ValorAssaltoReceber[playerid]);
						GameTextForPlayer(playerid, StrA, 3000, 3);
						PlayerPlaySound(playerid, 1150, 0.0, 0.0, 10.0);
						return 1;
			        }
				}
			}
		}
  		Flooder[playerid] = gettime();
	}
	return 1;
}

public OnPlayerLeaveDynamicCP(playerid, checkpointid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
    for(new g; g < MAX_ORG; g++)
	{
	    if(checkpointid == gCheck[g])
		{
		    if(ORG[playerid] >= 0 && ORG[playerid] != g)
		    {
			    InvasaoOrg[g] = 0;
			    return 1;
			}
		}
	}
	return 1;
}

public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	if(AttAfk[playerid] >= 1001 || MinerandoBTC[playerid] > 0)
	{
	    return 0;
	}
	else if(checkpointid == CheckFavela[0])
	{
		if(ORG[playerid] >= 0 && DonoFavela[0] != ORG[playerid])
		{
			if(SegundosInvadindo[0] <= 0)
			{
			    new Strg[40]; format(Strg, sizeof(Strg), "Invadindo Favela ( %d%s )", SegundosInvadindo[0], "%");
			    PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], Strg);
			    PlayerTextDrawShow(playerid, TextProduzirArma[playerid]);
			    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], 0);
			   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
			   	SetTimerEx("InvasaoFavela0", 750, false, "d", playerid);
			   	
    			new cor[11];
			   	switch(DonoFavela[0])
				{
				    case 0..11: format(cor, sizeof(cor), "0x%sFF", gCor[DonoFavela[0]]), GangZoneFlashForAll(GZ_Favela[0], HexToInt(cor));
				    case ROTA,CHOQUE,ROTAM,BOPE,EXERCITO: GangZoneFlashForAll(GZ_Favela[0], 0x0040FFFF);
				}
			   	return 1;
			}
		}
