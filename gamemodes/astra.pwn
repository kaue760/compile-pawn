			        strcat(StrMsg, "{FF0000}2 - CORPORACOES:\n");
			        strcat(StrMsg, "{FFFFFF}- Um jogador de Corporacao so podera usar uma arma em caso de perseguicao contra um jogador procurado, no intuito de captura-lo.\nA policia nao deve usar uma arma para se defender, ela tem comandos pra isso e deve optar por eles.\nComandos a serem usados para a defesa policial: /PrenderArmas /Procurar /B /Algemar /Prender.\n\n");
