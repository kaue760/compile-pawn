forward TirarRouboDoVeiculo(vehicleid);
public TirarRouboDoVeiculo(vehicleid)
{
    VeiculoRoubado[vehicleid] = 0;
	KillTimer(TimerVeiculoRoubado[vehicleid]);
	TimerVeiculoRoubado[vehicleid] = 0;
	return 1;
}

public OnPlayerPickUpPickup(playerid, pickupid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	return 1;
}

public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	if(pickupid == PickPlacaAnuncio[0] || pickupid == PickPlacaAnuncio[1] || pickupid == PickPlacaAnuncio[2])
	{
	    if(PickupStatus[playerid] == 0)
        {
            PickupStatus[playerid] = -60;
            ShowPlayerDialog(playerid, D_ANUNCIOPLACA, DIALOG_STYLE_INPUT, "{FF0000}Anuncio {FFFFFF}em Placa", "\n{FFFFFF}Aqui voce pode anunciar algo relacionado ao servidor.\nEx: Venda de bens, Recrumento, Recados, etc...\nCaso anuncie algo que va contra as regras voce sera punido(a)\n\nApos anunciar na placa o anuncio ficara ativo por 3 horas\n\nValor para anunciar: {FFFF00}100 coins{FFFFFF}\n\nDigite seu anuncio abaixo:", "Anunciar", "Cancelar");
        }
        else if(PickupStatus[playerid] < 0)
        {
            PickupStatus[playerid] ++;
        }
	}
    else if(pickupid == PickBarraquinhaSpawn[0] || pickupid == PickBarraquinhaSpawn[1] || pickupid == PickBarraquinhaSpawn[2] || pickupid == PickBarraquinhaSpawn[3] || pickupid == PickBarraquinhaSpawn[4])
    {
        if(PickupStatus[playerid] == 0)
        {
            for(new t; t < 10; t++)
		    {
		        TextDrawShowForPlayer(playerid, TextBarraquinhaSpawn[t]);
		    }
		    SelectTextDraw(playerid, 0xFFFFFF99);
		    PickupStatus[playerid] = -60;
        }
        else if(PickupStatus[playerid] < 0)
        {
            PickupStatus[playerid] ++;
        }
    }
	else if(pickupid == ds_pick[0])//Teleport Player Outside
	{
	    SetPlayerPos(playerid,553.6948,-1290.7292,17.2483);
	    SetPlayerFacingAngle(playerid,357.9434);
	    SetPlayerInterior(playerid, 0);
	    SetPlayerVirtualWorld(playerid, 0);
	    SetCameraBehindPlayer(playerid);
	}
	else if(pickupid == ds_pick[1])//Teleport Player Inside
	{
	    SetTimerEx("CarregarInterior", 3000, false, "i", playerid);
		TogglePlayerControllable(playerid, 0);
		GameTextForPlayer(playerid, "~r~Carregando Interior", 3000, 3);
	    SetPlayerPos(playerid,1401.1182,-23.4513,1000.8630);
	    SetPlayerFacingAngle(playerid,176.6814);
	    SetPlayerInterior(playerid, 1);
	    SetPlayerVirtualWorld(playerid, 333);
	    SetCameraBehindPlayer(playerid);
	}
    if((gettime() - Flooder[playerid]) > 10)
	{
	    if(pickupid == PickMuda)
		{
		    if(PROF[playerid] == FAZENDEIRO || PROF[playerid] == CHEFAO || ORG[playerid] >= 0)
		    {
				/*return SendClientMessage(playerid, COR_ERRO, "| ERRO | Essa fazenda foi interditada pela forca nacional");*/
		        if(!IsPlayerAttachedObjectSlotUsed(playerid, 6))
		        {
		            ApplyAnimation(playerid, "CARRY", "CRRY_PRTIAL", 4.1, 0, 0, 0, 1, 1, 1);
			        SetPlayerAttachedObject(playerid, 6, 19473, 1, -0.2150, 0.4070, -0.0310, 0.0000, 88.2000, 0.0000, 0.4759, 0.4450, 0.4060, 0xFFFFFFFF, 0xFFFFFFFF); //mudinha
				}
		    }
		}
		else if(pickupid == PickMudaFazenda)
		{
		    new i = GetPlayerVirtualWorld(playerid);
		    if(new_strcmp(f_info[i][f_dono], PlayerName(playerid)) || new_strcmp(f_info[i][f_funcionario0], PlayerName(playerid)) || new_strcmp(f_info[i][f_funcionario1], PlayerName(playerid)) || new_strcmp(f_info[i][f_funcionario2], PlayerName(playerid)))
		    {
			    if(!IsPlayerAttachedObjectSlotUsed(playerid, 6))
	      		{
	        		ApplyAnimation(playerid, "CARRY", "CRRY_PRTIAL", 4.1, 0, 0, 0, 1, 1, 1);
				    SetPlayerAttachedObject(playerid, 6, 2060, 1, 0.0160, 0.4260, 0.0000, 0.0000, 88.7000, 0.0000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF); //mudinha
				}
			}
		}
		else if(pickupid == PickFire[0] || pickupid == PickFire[1])
		{
		    if(PROF[playerid] == BOMBEIRO)
		    {
				GivePlayerWeaponExC(playerid, 42, 999);
		    }
		}
		else if(pickupid == PickArvoreMuda)
		{
		    if(PROF[playerid] == LENHADOR)
		    {
		        if(!IsPlayerAttachedObjectSlotUsed(playerid, 6))
		        {
		            ApplyAnimation(playerid, "CARRY", "CRRY_PRTIAL", 4.1, 0, 0, 0, 1, 1, 1);
			        SetPlayerAttachedObject(playerid, 6, 630, 1, 0.8330, 0.3329, -0.1190, 0.0000, 90.0000, 0.0000, 1.0000, 1.0000, 1.0000, 0xFFFFFFFF, 0xFFFFFFFF);
				}
		    }
		}
		else if(pickupid == PickEntradaPresidio)
		{
		    SendClientMessage(playerid, -1, "| INFO | Para entrar no Presidio digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
		else if(pickupid == PickImobiliaria)
		{
		    SendClientMessage(playerid, -1, "| INFO | Para entrar na Imobiliaria digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
		else if(pickupid == PickLoteria)
