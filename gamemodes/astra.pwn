stock VenderItem(playerid, item, b, i)
{
	new result;
	switch(SlotMochila[playerid][item])
	{
	    case FOGO, LUZVERMELHA, LUZAZUL:
	    {
	        result = 1;
		    ItemBarraquinha[b][i] = CreateDynamicObject(SlotMochila[playerid][item], PosBarraquinhas[b][i][0], PosBarraquinhas[b][i][1], PosBarraquinhas[b][i][2]-1.8, 0, 0, -90);
