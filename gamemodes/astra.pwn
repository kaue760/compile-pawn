		    }
		   	if(strcmp(cmd,"/MenuVeiculo", true) == 0 || strcmp(cmd,"/InfoVeiculo", true) == 0)
		    {
    			new idv = VeiculoProximo(playerid);
				if(idv > -1)
				{
				    new InfoVenda[50]; InfoVenda = "{FFFFFF}A venda: {FF0000}Nao";
	               	foreach(Player, i)
		   			{
		   	    		for(new v; v < 5; v++)
		    		    {
				   			if(pVeiculoInv[i][v] == idv)
					    	{
								new PastaVeiculos[50]; format(PastaVeiculos, sizeof(PastaVeiculos), "Veiculos/%s.ini", PlayerName(i));
					       		new KeyV[25]; format(KeyV, sizeof(KeyV), "VeiculoAvenda%d", v);
								if(DOF2_GetInt(PastaVeiculos, KeyV) > 0)
								{
								    format(InfoVenda, sizeof(InfoVenda), "{FFFFFF}Comprar veiculo por {008B00}$%d", DOF2_GetInt(PastaVeiculos, KeyV));
								}
								break;
							}
						}
					}
				    new nomev[100], textos[256]; format(nomev, sizeof(nomev), "{FFFFFF}Veiculo: {FFFF00}%s {FFFFFF}ID: {6495ED}%d {FFFFFF}Dono(a): {00CD66}%s", NomeVeiculo(idv), idv, vDono[idv]);
				    format(textos, sizeof(textos), "{FFFFFF}Abastecer com Galao\nTrancar/Destrancar Veiculo\nAbrir Porta-Malas\nFechar Porta-Malas\nAbrir/Fechar Capo\nEstacionar\nAlterar Placa\nPintar\nVender\n%s\nIVPA Atrasado [ {088A08}%d {FFFFFF}]", InfoVenda, vIPVA[idv]);
				    ShowPlayerDialog(playerid, D_MENUVEICULO, DIALOG_STYLE_LIST, nomev, textos, "Selecionar", "Cancelar");
				}
				else
				{
	    			SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta proximo de nenhum veiculo");
				}
				return 1;
		    }
		    if(strcmp(cmd,"/Hospital", true) == 0)
		    {
		        if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
		        {
		            if(MinutosMorte[playerid] <= 1)
			        {
				        SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
					  	SendClientMessage(playerid, 0x3CB371FF, "{FFFFFF}~> Voce decidiu nao esperar pelo SAMU e foi levado para um hospital mais proximo");
					  	if(PlanoSaude[playerid] <= 0)
					  	{
				            format(String, sizeof(String), "{FFFFFF}~> Suas despesas teve um custo de {088A08}$%d{FFFFFF}, o valor foi descontado da conta bancaria", GetPlayerScore(playerid) * 50);
				            SendClientMessage(playerid, 0x3CB371FF, String);
							SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
						  	if(SaldoBancario[playerid] > -999999)
						  	{
						  		SaldoBancario[playerid] -= GetPlayerScore(playerid) * 50;
							}
						}
						else
						{
						    PlanoSaude[playerid] --;
						    format(String, sizeof(String), "{FFFFFF}~> Seu plano de saude pagou todas suas {088A08}despesas{FFFFFF}, seu contrato agora esta em %d / 10", PlanoSaude[playerid]);
				            SendClientMessage(playerid, 0x3CB371FF, String);
							SendClientMessage(playerid, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
						}
						TogglePlayerControllable(playerid, 0);
					  	XMorte[playerid] = -1; YMorte[playerid] = -1; ZMorte[playerid] = -1;
					  	MinutosMorte[playerid] = 0; SegundosMorte[playerid] = 0;
					  	PlayerTextDrawHide(playerid, MsgText[playerid]);
					  	//
					  	new Random = random(sizeof(RandomHosp));
						SetPlayerPos(playerid, RandomHosp[Random][0], RandomHosp[Random][1], RandomHosp[Random][2]);
						SetPlayerFacingAngle(playerid, RandomHosp[Random][3]);
						SetPlayerInterior(playerid, 2);
						SetCameraBehindPlayer(playerid);
						SetTimerEx("CarregarInterior", 7000, false, "i", playerid);
						TogglePlayerControllable(playerid, 0);
						GameTextForPlayer(playerid, "~r~Carregando...", 6000, 3);
						if(SEDE[playerid] <= 0)
						{
							SEDE[playerid] = 759;
						}
						if(FOME[playerid] <= 0)
						{
							FOME[playerid] = 831;
						}
						SetPlayerHealth(playerid, 100.0);
					}
					else
					{
						SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce precisa esperar a chegada do SAMU por 4 minutos");
					    ApplyAnimation(playerid, "CRACK", "CRCKIDLE4", 4.1, 1, 0, 0, 0, 0, 1);
					}
		        }
		        else
		        {
		            return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta ferido");
		        }
		        return 1;
		    }
		    if(strcmp(cmd,"/Motor", true) == 0)
		    {
		        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		        {
		            new veh = GetPlayerVehicleID(playerid); new Float:Vida; GetVehicleHealth(veh, Vida);
		            if(GetVehicleModel(veh) == 509 || GetVehicleModel(veh) == 510 || GetVehicleModel(veh) == 481 || GetVehicleModel(veh) == 501)
		            {
		                return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse veiculo nao tem motor");
		            }
		            if(Combustivel[veh] > 0.0)
		            {
		            	new motor, farol, alarme, portas, capo, portamalas, objetivo;
			            GetVehicleParamsEx(veh, motor, farol, alarme, portas, capo, portamalas, objetivo);
			            if(motor == VEHICLE_PARAMS_OFF)
			            {
		                 	if(Vida >= 300.2)
					        {
								if(vQuebrado[veh] == true)
								{
								    vQuebrado[veh] = false;
								}
					        }
			                if(vQuebrado[veh] == true)
			                {
			                    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse veiculo esta quebrado, chame um mecanico! ~> /Mecanico");
			                }
		      			    SetVehicleParamsEx(veh, VEHICLE_PARAMS_ON, farol, alarme, portas, capo, portamalas, objetivo);
				           	SendClientMessage(playerid, 0x60D660AA, "| INFO | Veiculo Ligado!");
				           	new string[256];
				  			format(string, sizeof(string), "* %s Ligou o motor do seu veiculo", PlayerName(playerid));
				  			SendClientMessageInRange(30.0, playerid, string, COR_ROXO,COR_ROXO,COR_ROXO,COR_ROXO,COR_ROXO);
		              		if(!new_strcmp(vDono[veh], "Ninguem"))
						    {
						        if(!new_strcmp(vDono[veh], PlayerName(playerid)))
						       	{
						       	    //GiveProcurado(playerid, 1);
						       	    GameTextForPlayer(playerid, "~r~Veiculo Roubado", 2500, 3);
						       	}
							}
				           	return 1;
						}
						else if(motor == VEHICLE_PARAMS_ON)
		   	         	{
		     		       	SetVehicleParamsEx(veh, VEHICLE_PARAMS_OFF, farol, alarme, portas, capo, portamalas, objetivo);
		   					SendClientMessage(playerid, 0x60D660AA, "| INFO | Veiculo Desligado!");
		   					new string[256];
				  			format(string, sizeof(string), "* %s Desligou o motor do seu veiculo", PlayerName(playerid));
				  			SendClientMessageInRange(30.0, playerid, string, COR_ROXO,COR_ROXO,COR_ROXO,COR_ROXO,COR_ROXO);
			            	return 1;
						}
		   			}
		   			else
					{
					    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse veiculo esta sem Combustivel");
					}
		        }
		        else
				{
				    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta dirigindo");
				}
