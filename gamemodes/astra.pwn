stock GetValorItem(item)
{
	new valor[7];
	switch(item)
	{
	    case ARARA,MOCHILA:{valor = "20000";}
	    case CIRCULOCHAMATIVO,LUZAZUL:{valor = "40000";}
		default: valor = "15000";
	}
	return valor;
}

stock IsVehicleOccupied(vehicleid)
{
    foreach(Player, i) if(IsPlayerInVehicle( i, vehicleid) && GetPlayerState(i) == PLAYER_STATE_DRIVER)
    return 1; return 0;
}

stock NotTrailerAtached(vehicle)
{
    foreach(Player, i)
    {
        if(IsPlayerInAnyVehicle(i) && vehicle == GetVehicleTrailer(GetPlayerVehicleID(i)))
        {
            return 0;
        }
    }
    return 1;
}
stock CarMaisProximo(playerid){
	new pVeiculo = -1,Float:vPos[4];
	for(new V = 0; V < MAX_VEHICLES; V++){
		GetVehiclePos(V,vPos[0], vPos[1], vPos[2]);
		if(GetVehicleModel(V) >= 400)
			if(IsPlayerInRangeOfPoint(playerid, 10.0, vPos[0], vPos[1], vPos[2])){
		    	GetVehicleZAngle(V, vPos[3]);
			    vPos[0] = vPos[0] -C_GetInfCarros(GetVehicleModel(V)) * floatsin(-vPos[3], degrees);
			    vPos[1] = vPos[1] -C_GetInfCarros(GetVehicleModel(V)) * floatcos(-vPos[3], degrees);
				if(IsPlayerInRangeOfPoint(playerid, 2.0, vPos[0], vPos[1], vPos[2])){
				    if(VehPermPortaMal[C_GetTipoCar(GetVehicleModel(V))] == 0) return pVeiculo = -2;
					pVeiculo = V; break;
				}
			}
	}
	return pVeiculo;
}
stock AttVelocimetro(playerid)
{
    	new veh = GetPlayerVehicleID(playerid); new modelo = GetVehicleModel(veh);
        new zone[MAX_ZONE_NAME]; GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
        new Velocidade[4]; format(Velocidade, sizeof(Velocidade), "%d", VelocidadeDoVeiculo(veh));
        new idv[40]; format(idv, sizeof(idv), "~y~~h~KM/H    ~b~~h~~h~ID ~w~%d", veh);
        new nome[23]; format(nome, sizeof(nome), "~b~~h~~h~%s", NomeVeiculo(veh));
        new combustivel[23];
        GetVehicleHealth(veh, VidaVehEx[veh]);
        GetVehicleDamageStatus(veh, Paineis[veh], Portas[veh], Luzes[veh], Pneus[veh]);
        if(VidaVehEx[veh] >= 200.0 && VidaVehEx[veh] <= 300.0)
        {
            SetVehicleHealth(veh, 300.1);
            if(vQuebrado[veh] == false)
            {
                vQuebrado[veh] = true;
				SendClientMessage(playerid, -1, "| INFO | Seu veiculo quebrou, chame um mecanico para conserta-lo! ~> /Mecanico");
				GameTextForPlayer(playerid, "~r~Veiculo Quebrado", 3000, 3);
				new motor, farol, alarme, portas, capo, portamalas, objetivo;
	            GetVehicleParamsEx(veh, motor, farol, alarme, portas, capo, portamalas, objetivo);
				SetVehicleParamsEx(veh, VEHICLE_PARAMS_OFF, 0, alarme, portas, capo, portamalas, objetivo);
				RemovePlayerFromVehicle(playerid);
            }
        }
        else if(VidaVehEx[veh] >= 999.0)
        {
			if(vQuebrado[veh] == true)
			{
			    vQuebrado[veh] = false;
			}
        }
        //RADAR1
		if(modelo != 417 && modelo != 425 && modelo != 430 && modelo != 446 && modelo != 447 && modelo != 449 && modelo != 452 && modelo != 453 && modelo != 454 &&
		modelo != 460 && modelo != 469 && modelo != 472 && modelo != 473 && modelo != 476 && modelo != 481 && modelo != 484 && modelo != 487 && modelo != 488 && modelo != 493 &&
		modelo != 497 && modelo != 509 && modelo != 510 && modelo != 511 && modelo != 512 && modelo != 513 && modelo != 519 && modelo != 520 && modelo != 537 && modelo != 538 &&
		modelo != 548 && modelo != 553 && modelo != 563 && modelo != 577 && modelo != 592 && modelo != 593 && modelo != 595)
		{
			if(IsPlayerInRangeOfPoint(playerid, 20.0, -2681.60303, 1765.79773, 67.49690) && RadarQuebrado[0] == false)
			{
			    new velocidade = VelocidadeDoVeiculo(GetPlayerVehicleID(playerid));
			    if(velocidade <= 120)
			    {
			        if(PassouRadar[playerid] == 0)
			        {
				        format(String, sizeof(String), "| RADAR | Velocidade registrada: %dKm/h", velocidade);
				        SendClientMessage(playerid, COR_AMARELO, String);
				        PassouRadar[playerid] = 5;
				        GameTextForPlayer(playerid, "~g~RADAR", 2000, 3);
					}
			    }
			    else
			    {
			        new bool:fardado = false;
	          		for(new s; s < 16; s++)
				   	{
	       				if(GetPlayerSkin(playerid) == FardaSkin[s] || GetPlayerSkin(playerid) == 287)
				        {
	           				fardado = true;
				            break;
				        }
				    }
	                if(IsPlayerAdmin(playerid) || NivelAdmin[playerid] > 0)
			        {
			            if(PassouRadar[playerid] == 0)
			        	{
				            format(String, sizeof(String), "| RADAR | Velocidade registrada: %dKm/h voce nao levou multa por ser da Administracao", velocidade);
					        SendClientMessage(playerid, COR_AMARELO, String);
					        PassouRadar[playerid] = 5;
					        GameTextForPlayer(playerid, "~y~RADAR LIBERADO", 2000, 3);
						}
			        }
			        else if(fardado == true)
			        {
			            if(PassouRadar[playerid] == 0)
			        	{
				            format(String, sizeof(String), "| RADAR | Velocidade registrada: %dKm/h voce nao levou multa por estar Fardado", velocidade);
					        SendClientMessage(playerid, COR_AMARELO, String);
					        PassouRadar[playerid] = 5;
					        GameTextForPlayer(playerid, "~y~RADAR LIBERADO", 2000, 3);
						}
			        }
			        else if(PROF[playerid] == PARAMEDICO && GetVehicleModel(GetPlayerVehicleID(playerid)) == 416)
			        {
						if(PassouRadar[playerid] == 0)
		   				{
		       				format(String, sizeof(String), "| RADAR | Velocidade registrada: %dKm/h voce nao levou multa por esta conduzindo uma Ambulancia", velocidade);
					        SendClientMessage(playerid, COR_AMARELO, String);
					        PassouRadar[playerid] = 5;
					        GameTextForPlayer(playerid, "~y~RADAR LIBERADO", 2000, 3);
						}
			        }
			        else
			        {
			            if(PassouRadar[playerid] == 0)
			        	{
				        	if(velocidade >= 180)
				        	{
				        	    GiveProcurado(playerid, 1);
				        	}
							if(Multa[playerid] < 5)
							{
				        	    Multa[playerid] ++;
				        	    ValorMulta[playerid] = ValorMulta[playerid] + velocidade*3;
				        	    PassouRadar[playerid] = 5;
				        	    TextDrawShowForPlayer(playerid, Flash);
						        GameTextForPlayer(playerid, "~r~MULTA", 2500, 3);
						        PlayerPlaySound(playerid, 1132, 0.0, 0.0, 0.0);
						        SetTimerEx("FlashFotoSair", 2000, false, "d", playerid);
					            SendClientMessage(playerid, COR_VERDE, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ RADAR ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
					            format(String, sizeof(String), "| RADAR | Velocidade registrada: %dKm/h", velocidade);
						        SendClientMessage(playerid, COR_AMARELO, String);
						        format(String, sizeof(String), "| MULTA | Voce foi pego com a velocidade acima do limite permitido nessa rodovia '120Km/h'");
						        SendClientMessage(playerid, -1, String);
						        format(String, sizeof(String), "| MULTA | Portanto, voce foi multado por esse excesso de velocidade em $%d", velocidade*3);
						        SendClientMessage(playerid, -1, String);
						        format(String, sizeof(String), "| MULTA | No momento voce tem %d multas e precisa paga-las no Detran", Multa[playerid]);
						        SendClientMessage(playerid, -1, String);
						        format(String, sizeof(String), "| MULTA | Caso complete 6 multas acumuladas voce pagara uma taxa de $6000");
						        SendClientMessage(playerid, -1, String);
						        SendClientMessage(playerid, COR_VERDE, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ RADAR ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
							}
							else if(Multa[playerid] == 5)
							{
							    Multa[playerid] = 0;
							    ValorMulta[playerid] = 0;
							    if(SaldoBancario[playerid] > -999999)
							    {
							    	SaldoBancario[playerid] -= 6000;
								}
				        	    PassouRadar[playerid] = 5;
				        	    TextDrawShowForPlayer(playerid, Flash);
						        GameTextForPlayer(playerid, "~r~MULTA", 2500, 3);
						        PlayerPlaySound(playerid, 1132, 0.0, 0.0, 0.0);
						        SetTimerEx("FlashFotoSair", 2000, false, "d", playerid);
					            SendClientMessage(playerid, COR_VERDE, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ RADAR ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
