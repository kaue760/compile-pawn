		        strcat(StrR, "{DF3A01}RK (Revenge Kill ): {FFFFFF}Na vida real, quando voce morre, voce nao revive para poder matar quem te matou. Quando voce morre em uma acao RP\ndo tipo, um assalto ou uma trocade tiros, voce 'toma' um PK.\n\n");
