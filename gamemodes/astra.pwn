					if(PontoCorrida[playerid] > 0)
			        {
						SendClientMessage(playerid, -1, "| CORRIDA | Voce removeu o ultimo ponto adicionado no percurso da sua corrida");
						PontoCorrida[playerid] --;
						CordCorrida[playerid][PontoCorrida[playerid]][0] = 0.0; CordCorrida[playerid][PontoCorrida[playerid]][1] = 0.0; CordCorrida[playerid][PontoCorrida[playerid]][2] = 0.0;
					}
					else
					{
					    SendClientMessage(playerid, COR_ERRO, "| CORRIDA | Voce nao adicionou nenhum ponto ainda no percurso da sua corrida");
					}
			    }
			    case 6:
			    {
			        new bool:tem;
			        foreach(Player, i)
			        {
			            if(IsPlayerConnected(i) && Spawnado[i] == true && NaCorrida[i] == NaCorrida[playerid] && PlayerPontoCorrida[i] >= 0)
			            {
			                tem = true;
			                break;
			            }
			        }
			        if(tem == false)
			        {
				        for(new c; c < 50; c++)
				        {
				            CordCorrida[playerid][c][0] = 0.0;
				            CordCorrida[playerid][c][1] = 0.0;
				            CordCorrida[playerid][c][2] = 0.0;
				        }
				        PontoCorrida[playerid] = 0;
				        new StrInfo1[50], StrInfo2[350];
				        format(StrInfo1, sizeof(StrInfo1), "{FFFFFF}Taxa de participacao: {00FF00}$%d\n", TaxaCorrida[playerid]);
						strcat(StrInfo2, StrInfo1);
						format(StrInfo1, sizeof(StrInfo1), "{FFFFFF}Level minimo: {BDBDBD}%d\n", LevelMinimoCorrida[playerid]);
						strcat(StrInfo2, StrInfo1);
						format(StrInfo1, sizeof(StrInfo1), "{FFFFFF}Level maximo: {BDBDBD}%d\n", LevelMaximoCorrida[playerid]);
						strcat(StrInfo2, StrInfo1);
						format(StrInfo1, sizeof(StrInfo1), "{FFFFFF}Contagem da largada: {BDBDBD}%d segundos\n", ContagemCorrida[playerid]);
						strcat(StrInfo2, StrInfo1);
						format(StrInfo1, sizeof(StrInfo1), "{FFFFFF}Adicionar Ponto: {BDBDBD}%d / 50\n", PontoCorrida[playerid]);
						strcat(StrInfo2, StrInfo1);
						format(StrInfo1, sizeof(StrInfo1), "{FFFFFF}Remover Ponto: {BDBDBD}%d / 50\n", PontoCorrida[playerid]);
						strcat(StrInfo2, StrInfo1);
						strcat(StrInfo2, "{FF0000}Limpar Percurso\n");
						strcat(StrInfo2, "{058AFF}Criar Corrida\n");
						if(PontoCorrida[playerid] >= 2)
						{
							strcat(StrInfo2, "{058AFF}Iniciar Corrida");
						}
						new TituloCorrida[35]; format(TituloCorrida, sizeof(TituloCorrida), "{FFFFFF}Corrida - {00FF00}$%d", PremiacaoCorrida[playerid]);
						ShowPlayerDialog(playerid, D_CORRIDA, DIALOG_STYLE_LIST, TituloCorrida, StrInfo2, "Selecionar", "Fechar");
					}
					else
					{
					    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Sua corrida esta em andamento e nao pode ser resetada!");
					}
			        return 1;
			    }
			    case 7:
			    {
			        if(PontoCorrida[playerid] >= 2)
			        {
						new zone[MAX_ZONE_NAME]; GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
						format(String, sizeof(String), "| CORRIDA | O(A) Jogador(a) %s esta criando uma corrida em %s, use /pCorrida no local para participar", PlayerName(playerid), zone);
						SendClientMessageToAll(0x8904B1FF, String);
						SendClientMessage(playerid, 0x8904B1FF, "| CORRIDA | Corrida criada com sucesso, prepare os participantes para a largada!");
                        NaCorrida[playerid] = playerid;
                        PlayerPontoCorrida[playerid] = -1;
                        SetPlayerRaceCheckpoint(playerid, 0, CordCorrida[NaCorrida[playerid]][0][0], CordCorrida[NaCorrida[playerid]][0][1], CordCorrida[NaCorrida[playerid]][0][2], CordCorrida[NaCorrida[playerid]][1][0], CordCorrida[NaCorrida[playerid]][1][1], CordCorrida[NaCorrida[playerid]][1][2], 5.0);
                        if(IsValidDynamicMapIcon(MapIconCorrida[playerid]))
	           			{
	           			    DestroyDynamicMapIcon(MapIconCorrida[playerid]);
	           			}
                        MapIconCorrida[playerid] = CreateDynamicMapIcon(CordCorrida[NaCorrida[playerid]][1][0], CordCorrida[NaCorrida[playerid]][1][1], CordCorrida[NaCorrida[playerid]][1][2], 0, 0xFF0000FF, -1, -1, playerid, 1000.0);
					}
					else
					{
					    SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce precisa pelomenos adicionar a largada e a chegada da sua corrida");
					}
			    }
			    case 8:
			    {
			        if(ContagemCorrida[playerid] >= 1)
			        {
				        foreach(Player, i)
						{
						    if(IsPlayerConnected(i) && Spawnado[i] == true && NaCorrida[i] == playerid)
						    {
						        TogglePlayerControllable(i, 0);
						        PlayerPontoCorrida[i] = -1;
						        PlayerContagemCorrida[i] = ContagemCorrida[NaCorrida[i]]+1;
								SendClientMessage(i, 0x8904B1FF, "| INFO | Prepare-se, a corrida ja vai comecar!");
						    }
						}
					}
					else
					{
					    SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce ainda nao colocou contagem na largada da corrida");
					}
				}
			}
		}
