    {
    	MoveDynamicObject(gateid, PosOriginalPedagio[idpedagio][0], PosOriginalPedagio[idpedagio][1], PosOriginalPedagio[idpedagio][2], 0.1, PosOriginalPedagio[idpedagio][3], PosOriginalPedagio[idpedagio][4], PosOriginalPedagio[idpedagio][5]);
	}
	return 1;
}

