    new Float:distancia = 100000.000, Float:dist, prevhosp;
	for(new hospid = 0; hospid < 8; hospid++)
	{
	    if(hospid == 0) {dist = GetPlayerDistanceToPoint(playerid, 1554.9657,-1675.6466);}
        else if(hospid == 1) {dist = GetPlayerDistanceToPoint(playerid, 627.2767,-571.7728);}
        else if(hospid == 2) {dist = GetPlayerDistanceToPoint(playerid, -217.4765,979.2430);}
        else if(hospid == 3) {dist = GetPlayerDistanceToPoint(playerid, 2287.1208,2431.3518);}
        else if(hospid == 4) {dist = GetPlayerDistanceToPoint(playerid, -1390.0145,2637.9114);}
        else if(hospid == 5) {dist = GetPlayerDistanceToPoint(playerid, -1605.5885,711.4365);}
        else if(hospid == 6) {dist = GetPlayerDistanceToPoint(playerid, -2162.0771,-2385);}
        else if(hospid == 7) {dist = GetPlayerDistanceToPoint(playerid, 2895.5820,-848.7189);}
        if((dist < distancia))
