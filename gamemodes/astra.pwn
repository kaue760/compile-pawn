				            format(String, sizeof(String), "{FFFFFF}~> Suas despesas teve um custo de {088A08}$%d{FFFFFF}, o valor foi descontado da conta bancaria", GetPlayerScore(i) * 50);
				            SendClientMessage(i, 0x3CB371FF, String);
							SendClientMessage(i, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
