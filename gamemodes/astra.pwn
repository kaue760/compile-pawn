stock GetXYInFrontOfPlayer(playerid, &Float:x, &Float:y, Float:distance)
{
    new Float:a;
    GetPlayerPos(playerid, x, y, a);
    GetPlayerFacingAngle(playerid, a);
    if (GetPlayerVehicleID(playerid)) {
        GetVehicleZAngle(GetPlayerVehicleID(playerid), a);
    }
    x += (distance * floatsin(-a, degrees));
    y += (distance * floatcos(-a, degrees));
}

stock GetXYBehindOfVehicle(vehicleid, &Float:x, &Float:y, Float:distance)
{
    new Float: a;
    GetVehiclePos( vehicleid, x, y, a );
    GetVehicleZAngle( vehicleid, a );
    x += ( distance * floatsin( -a+180, degrees ));
    y += ( distance * floatcos( -a+180, degrees ));
}

stock GetXYInFrontOfObject(objectid, &Float:x2, &Float:y2, &Float:z2, Float:distance)
{ //modified from GetXYInFrontOfPlayer
    new Float:a2;
    GetObjectPos(objectid, x2, y2, z2);
    GetObjectRot(objectid, a2, a2, a2);
    x2 += (distance * floatsin(-a2, degrees));
    y2 += (distance * floatcos(-a2, degrees));
}

stock GetXYInFrontOfPoint(&Float:x, &Float:y, Float:angle, Float:dist) {
    x += (dist * floatsin(-angle, degrees));
    y += (dist * floatcos(-angle, degrees));
}

stock CriarFazendas()
{
	new str[400];
    for(new i; i < MAX_FAZENDA; i++)
    {
        format(String, sizeof(String), "Fazendas/%d.ini", i);
        if(DOF2_FileExists(String))
        {
            format(f_info[i][f_dono], 25, DOF2_GetString(String, "Dono"));
            format(f_info[i][f_funcionario0], 25, DOF2_GetString(String, "Funcionario0"));
            format(f_info[i][f_funcionario1], 25, DOF2_GetString(String, "Funcionario1"));
            format(f_info[i][f_funcionario2], 25, DOF2_GetString(String, "Funcionario2"));
            format(f_info[i][f_nome], 31, DOF2_GetString(String, "Nome"));
            f_info[i][f_produtos] = DOF2_GetInt(String, "Produtos");
            f_info[i][f_imposto] = DOF2_GetInt(String, "Imposto");
            f_info[i][f_cofre] = DOF2_GetInt(String, "Cofre");
            f_info[i][f_contratando] = DOF2_GetInt(String, "Contratando");
        }
        else
        {
            format(f_info[i][f_dono], 25, "Ninguem");
            format(f_info[i][f_funcionario0], 25, "Ninguem");
            format(f_info[i][f_funcionario1], 25, "Ninguem");
            format(f_info[i][f_funcionario2], 25, "Ninguem");
            format(f_info[i][f_nome], 31, "N/A");
            f_info[i][f_produtos] = 0;
            f_info[i][f_imposto] = 0;
            f_info[i][f_cofre] = 0;
            f_info[i][f_contratando] = 0;

            DOF2_CreateFile(String);
            DOF2_SetString(String, "Dono", f_info[i][f_dono]);
            DOF2_SetString(String, "Funcionario0", f_info[i][f_funcionario0]);
            DOF2_SetString(String, "Funcionario1", f_info[i][f_funcionario1]);
            DOF2_SetString(String, "Funcionario2", f_info[i][f_funcionario2]);
            DOF2_SetString(String, "Nome", f_info[i][f_nome]);
            DOF2_SetInt(String, "Produtos", f_info[i][f_produtos]);
            DOF2_SetInt(String, "Imposto", f_info[i][f_imposto]);
            DOF2_SetInt(String, "Cofre", f_info[i][f_cofre]);
            DOF2_SetInt(String, "Contratando", f_info[i][f_contratando]);
            DOF2_SaveFile();
        }
        CreateDynamicObject(floatround(PosFazenda[i][0], floatround_round), PosFazenda[i][1], PosFazenda[i][2], PosFazenda[i][3], PosFazenda[i][4], PosFazenda[i][5], PosFazenda[i][6]);
        f_info[i][f_pick] = CreateDynamicPickup(19132, 23, PickFazenda[i][0], PickFazenda[i][1], PickFazenda[i][2]);
        
        format(str, sizeof(str), "{FFFFFF}Fazenda {6441A5}%s {FFFFFF}ID %d\n{FFFFFF}Dono: %s\n{FFFFFF}Funcionario 1: %s\n{FFFFFF}Funcionario 2: %s\n{FFFFFF}Funcionario 3: %s\n{FFFFFF}Valor: {00FF00}$500.000 {FFFFFF}e {FFFF00}50.000 Coins\n{FFFFFF}Fundos: {00FF00}$%d\n{FFFFFF}Produtos: {DF7401}%d und", f_info[i][f_nome], i, f_info[i][f_dono], f_info[i][f_funcionario0], f_info[i][f_funcionario1], f_info[i][f_funcionario2], f_info[i][f_cofre], f_info[i][f_produtos]);
        f_info[i][f_texto] = CreateDynamic3DTextLabel(str, -1, PickFazenda[i][0], PickFazenda[i][1], PickFazenda[i][2], 8.0);
        
        for(new c; c < 9; c++)
        {
            f_info[i][f_check][c] = CreateDynamicCP(CheckFazenda[i][c][0], CheckFazenda[i][c][1], CheckFazenda[i][c][2], 1.1, -1, -1, -1, 10.0);
			f_info[i][f_textoplantas][c] = CreateDynamic3DTextLabel("{FFFFFF}Plantacao\n{FFFFFF}Jogador(a) Trabalhando: {FFF68F}Ninguem", -1, CheckFazenda[i][c][0], CheckFazenda[i][c][1], CheckFazenda[i][c][2], 30.0);
        }
        
        for(new v; v < 3; v++)
        {
            f_info[i][f_veiculo][v] = CreateVehicleC(468, VehFazenda[i][v][0], VehFazenda[i][v][1], VehFazenda[i][v][2], VehFazenda[i][v][3], -1, -1, 600);
        }
    }
