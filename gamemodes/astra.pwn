		}
		else if(pickupid == PickEntrada[1] || pickupid == PickEntrada[33] || pickupid == PickEntrada[34])
		{
	      	if(CheckPrimeiroPasso[playerid] == 0)
			{
   				SendClientMessage(playerid, -1, "| INFO | Para entrar na Agencia de Empregos digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
			}
