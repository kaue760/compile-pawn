				            if(IsPlayerInRangeOfPoint(playerid, 4.5, X, Y, Z))
	               			{
				                if(!IsDynamicObjectMoving(PlantaMaconha[c]))
				            	{
									for(new m; m < GetPlayerVoltas(playerid); m++)
							  		{
								        if(SlotMochila[playerid][m] == 0)
								        {
						            	    SetDynamicObjectPos(PlantaMaconha[c], X, Y, Z-5);
											SendClientMessage(playerid, COR_FAZENDEIRO, "| INFO | Voce colheu +1 planta de maconha!");
             								UpdateDynamic3DTextLabelText(TextoMaconha[c], -1, "{FFFFFF}Plantacao de {9ACD32}Maconha\n{FFFFFF}Jogador(a) Trabalhando: {FFF68F}Ninguem");
											ApplyAnimation(playerid, "CARRY", "LIFTUP", 4.1, 0, 0, 0, 0, 0, 1);
