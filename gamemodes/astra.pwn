	            if(IsPointInRangeOfPoint(Xe, Ye, Ze,  Xp1[pe], Yp1[pe], Zp1[pe], 5.0))
	            {
	                if(Xp1[pe] == XPE[pe] && Yp1[pe] == YPE[pe] && Zp1[pe] == ZPE[pe])//fechado
	                {
	                    MoveDynamicObject(PortaElevador[pe], Xp1[pe]-1.5, Yp1[pe]+0.40, Zp1[pe], 1.0, 0.0, 0.0, -100.0); MoveDynamicObject(PortaElevador[pe+1], Xp2[pe+1]+1.5, Yp2[pe+1]-0.20, Zp2[pe+1], 1.0, 0.0, 0.0, -100.0);//abre
	                }
					new nandar[4];
					if(pe == 0) {nandar = "T";}
					else if(pe == 2) {nandar = "1";}
					else if(pe == 4) {nandar = "2";}
					else if(pe == 6) {nandar = "3";}
					else if(pe == 8) {nandar = "4";}
					else if(pe == 10) {nandar = "5";}
					else if(pe == 12) {nandar = "6";}
