						    format(String, sizeof(String), "~> {FFFFFF}Parabens {1E90FF}%s[%d]{FFFFFF}, voce atingiu o level 20 e recebeu 5 dias de VIP!", PlayerName(i), i);
						    SendClientMessage(i, 0x00FF00FF, String);
						    SendClientMessage(i, 0x00FF00FF, "~> {FFFFFF}Para ver seus comandos digite /ComandosVip. Aproveite!");
						    SendClientMessage(i, 0x00FF00FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Recompensa ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
