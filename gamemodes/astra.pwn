forward ProduzirPistola9mm(playerid);
public ProduzirPistola9mm(playerid)
{
	if(PRODUZINDOARMA[playerid] < 100)
	{
	    PRODUZINDOARMA[playerid] ++;
		new StrT[25]; format(StrT, sizeof(StrT), "PRODUZINDO_ARMA:_%d%", PRODUZINDOARMA[playerid]);
	 	PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], StrT);
	    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], PRODUZINDOARMA[playerid]);
	   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
		TempoProducaoArma[playerid] = SetTimerEx("ProduzirPistola9mm", 100, false, "i", playerid);
	}
	else
	{
	    PRODUZINDOARMA[playerid] = -1;
	    TogglePlayerControllable(playerid, 1);
    	ClearAnimations(playerid, 1);
	    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
	    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
		for(new m; m < GetPlayerVoltas(playerid); m++)
		{
			if(SlotMochila[playerid][m] == 0)
			{
   			    SlotMochila[playerid][m] = PISTOLA9MM;
				QuantidadeSlotMochila[playerid][m] = 500;
				SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Arma produzida com sucesso");
				return 1;
  			}
   		}
		return SendClientMessage(playerid, COR_ERRO, "| ERRO | Nao foi possivel produzir a arma pois seu inventario nao tem espaco");
	}
	return 1;
}

