			    if(PROF[playerid] == FAZENDEIRO || PROF[playerid] == CHEFAO || ORG[playerid] >= 0)
			    {
			        if(IsPlayerInRangeOfPoint(playerid, 5.0, 2200.4958,-983.1757,62.5795))
			        {
						new MaconhasVendidas;
						for(new m; m < GetPlayerVoltas(playerid); m++)
				  		{
		       				if(SlotMochila[playerid][m] == PLANTADEMACONHA)
					        {
					            MaconhasVendidas += QuantidadeSlotMochila[playerid][m];
					            SlotMochila[playerid][m] = 0;
					            QuantidadeSlotMochila[playerid][m] = 0;
					        }
						}
						if(MaconhasVendidas > 0)
						{
						    new Valor = MaconhasVendidas * 500;
						    Money[playerid] += Valor;
						    format(String, sizeof(String), "| INFO | Voce entregou {FFFF00}%d {FFFFFF}plantas de maconha na favela {FFFFFF}e recebeu {228B22}$%d", MaconhasVendidas, Valor);
						    SendClientMessage(playerid, -1, String);
						    DOF2_SetInt("Cigarros.ini", "Quantidade", DOF2_GetInt("Cigarros.ini", "Quantidade") + MaconhasVendidas);
							DOF2_SaveFile();
							GiveProcurado(playerid, 1);
							return 1;
						}
						else
						{
						    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem maconha para entregar");
						}
					}
					else
					{
					    for(new g; g < MAX_ORG; g++)
					    {
					        if(IsPlayerInDynamicCP(playerid, gCheck[g]) || IsPlayerInRangeOfPoint(playerid, 1.5, xxOrg[g], yyOrg[g], zzOrg[g]))
					        {
					            if(!VerifyExpiredDays(gTimer[g]))
					            {
					                new MaconhasVendidas;
									for(new m; m < GetPlayerVoltas(playerid); m++)
							  		{
					       				if(SlotMochila[playerid][m] == PLANTADEMACONHA)
								        {
								            MaconhasVendidas += QuantidadeSlotMochila[playerid][m];
								            break;
								        }
									}
									if(MaconhasVendidas > 0)
									{
								    	new strr[200];
								        format(strr, sizeof(strr), "\n{FFFFFF}Organizacao: {%s}%s\n\n{FFFFFF}Valor por entrega de produtos: {228B22}$%d\n\n{FFFFFF}Deseja entregar suas plantas de maconhas nessa org por {228B22}$%d{FFFFFF}?", gCor[g], gNome[g], gValorEntrega[g], MaconhasVendidas * gValorEntrega[g]);
								        ShowPlayerDialog(playerid, D_ENTREGARMACONHAORG, DIALOG_STYLE_MSGBOX, "{FFFFFF}Entregar Maconha Org", strr, "Sim", "Nao");
								        return 1;
									}
									else
									{
									    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem maconha para entregar");
									}
               					}
								else
								{
								    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Essa Organizacao esta com o modo invasao desativado e nao pode receber maconha");
								}
					        }
					    }
					    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta na favela ou em uma Organizacao");
					}
			    }
			    else
			    {
			        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem permissao");
			    }
			}
