		}
	}
	if(edit == 1 && plataforma == 0)
	{
		EditAttachedObject(playerid, idx);
	}
	if(edit == 1 && plataforma == 1)
	{
	    new Float:Pos[2][3], Float:R;
		GetPlayerPos(playerid, Pos[0][0], Pos[0][1], Pos[0][2]); GetPlayerPos(playerid, Pos[1][0], Pos[1][1], Pos[1][2]);
		GetXYInFrontOfPlayer(playerid, Pos[0][0], Pos[0][1], 3.0);
		GetPlayerFacingAngle(playerid, R);

		SetPlayerCameraPos(playerid, Pos[0][0], Pos[0][1], Pos[0][2]+0.5);
		SetPlayerCameraLookAt(playerid, Pos[1][0], Pos[1][1], Pos[1][2]+0.5, CAMERA_MOVE);
		SetPlayerFacingAngle(playerid, R);
		for(new t; t < 30; t++)
		{
		    TextDrawShowForPlayer(playerid, TextCam[t]);
		}
		SelectTextDraw(playerid, 0xFFFFFF22);
	}
}forward ConectarNaFrequencia(playerid, freq);
public ConectarNaFrequencia(playerid, freq){
	FrequenciaConectada[playerid] = freq;
	SvAttachListenerToStream(Frequencia[freq], playerid);
	return 1;
}


