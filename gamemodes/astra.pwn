	        case 1:
	        {
	            format(SEXOR[playerid], 35, "Feminino");
	            CampoRegistro(playerid);
	        }
		}
	}
	return 1;
}

public OnPlayerClickPlayer(playerid, clickedplayerid, source)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerClickPlayerTextDraw(playerid, playertextid);
    if(playertextid != PlayerText:INVALID_TEXT_DRAW)
    {
        if(playertextid == TextLoginP[playerid][6])//logou 4
        {
            /* Astra: spawn so apos a escolha PVP/RP */
            CancelSelectTextDraw(playerid);
	  		for(new t; t < 22; t++)
			{
				PlayerTextDrawHide(playerid, TextLoginP[playerid][t]);
			}
			for(new t; t < 3; t++)
			{
				TextDrawHideForPlayer(playerid, TextLogin[t]);
			}
            Astra_EscolherModo(playerid);
            PlayerTextDrawSetSelectable(playerid, TextLoginP[playerid][6], 0);//4
        }
        else if(playertextid == TextLoginP[playerid][7])//5
        {
            if(AcertouAsenha[playerid] == false)
            {
            	ShowPlayerDialog(playerid, D_RECUPERAR, DIALOG_STYLE_INPUT, "{058AFF}Recupere sua conta", "\n{FFFFFF}Digite seu {04B404}nick {FFFFFF}abaixo para recuperar sua conta\n\nEnviaremos um {04B404}email {FFFFFF}para voce com as instru�oes", "Recuperar", "Logar");
        	}
        	else
        	{
				SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce ja fez o login, clique no botao 'ENTRAR' para jogar");
        	}
		}
		else if(playertextid == TextCellP[playerid][6])
		{
		    //TextDrawHideForPlayer(playerid, TextCell[11]);
		    //TextDrawHideForPlayer(playerid, TextCell[13]);
		    for(new t; t < 7; t++)
		    {
      			PlayerTextDrawHide(playerid, TextCellP[playerid][t]);
		    }
		    new hh, mm, ss, dater[10]; gettime(hh, mm, ss); format(dater, sizeof(dater), "%02d:%02d", hh, mm);
		    TextDrawSetString(TextCell[12], dater);
		    TextDrawShowForPlayer(playerid, TextCell[12]);
		    for(new t = 14; t < 54; t++)
		    {
      			TextDrawShowForPlayer(playerid, TextCell[t]);
		    }
		}
		else if(playertextid == TextMegaSena[playerid][26])
		{
		    CancelSelectTextDraw(playerid);
		    for(new t; t < 43; t++)
			{
			    PlayerTextDrawHide(playerid, TextMegaSena[playerid][t]);
			}
			if(NumeroSelecionado[playerid][0] > 0 && NumeroSelecionado[playerid][1] > 0 && NumeroSelecionado[playerid][2] > 0)
   			{
   			    if(Money[playerid] >= 500)
   			    {
	   			    if(NumeroSelecionado[playerid][0] != NumeroSelecionado[playerid][1] && NumeroSelecionado[playerid][1] != NumeroSelecionado[playerid][2] && NumeroSelecionado[playerid][0] != NumeroSelecionado[playerid][2])
	   			    {
	   			        new a;
	   			        for(new m; m < MAX_PLAYERS; m++)
						{
						    for(new mm; mm < 3; mm++)
						    {
						        if(NumeroMegaSena[m][mm] == NumeroSelecionado[playerid][0] || NumeroMegaSena[m][mm] == NumeroSelecionado[playerid][1] || NumeroMegaSena[m][mm] == NumeroSelecionado[playerid][2])
						        {
						            a ++;
						        }
						    }
						    if(a >= 3)
						    {
						        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esses numeros ja foram escolhidos");
						    }
						    a = 0;
						}
	   			        for(new m; m < MAX_PLAYERS; m++)
						{
						    if(new_strcmp(NomeMegaSena[m], "Ninguem"))
							{
							    format(NomeMegaSena[m], 25, "%s", PlayerName(playerid));
							    NumeroMegaSena[m][0] = NumeroSelecionado[playerid][0]; NumeroMegaSena[m][1] = NumeroSelecionado[playerid][1]; NumeroMegaSena[m][2] = NumeroSelecionado[playerid][2];
								format(String, sizeof(String), "| MEGA-SENA | Voce jogou na Mega-Sena com sucesso, seus numeros: {00FF00}%02d-%02d-%02d{FFFFFF}, boa sorte!", NumeroSelecionado[playerid][0], NumeroSelecionado[playerid][1], NumeroSelecionado[playerid][2]);
								SendClientMessage(playerid, -1, String);
								Money[playerid] -= 500;
								AcumuladosMegasena += 500;
								return 1;
							}
						}
						return SendClientMessage(playerid, COR_ERRO, "| ERRO | A Mega-Sena ja chegou no limite de apostadores");
	   			    }
	   			    else
	   			    {
	   			        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce marcou numeros repetidos");
	   			    }
				}
				else
    			{
	   		        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
	   		    }
		    }
		}
	    else if(playertextid == TextSkinP[playerid][0])//ESCOLHER FARDA
	    {
		   	CancelSelectTextDraw(playerid);
		   	SetPlayerVirtualWorld(playerid, 0);
	    }
