forward Mala_Car(playerid,xplayerid);
public Mala_Car(playerid,xplayerid){
	new Float:PosP[3];
	if(xplayerid == -1){
	    GetVehiclePos(Na_Mala[playerid]-1,PosP[0],PosP[1],PosP[2]);
	    SetPlayerPos(playerid,PosP[0],PosP[1],PosP[2]+3.0);
	}else{
		GetPlayerPos(xplayerid,PosP[0],PosP[1],PosP[2]);
	    SetPlayerPos(playerid,PosP[0]+0.1,PosP[1]+0.1,PosP[2]);
	}
	PlayerNoVeiculo[Na_Mala[playerid]-1] = 0;
	Na_Mala[playerid] = 0;
	return 1;
}
