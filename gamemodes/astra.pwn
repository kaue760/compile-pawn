					    pLucro[p] += ValorGasto[playerid];
					}
	    			format(String, sizeof(String), "{708090}Posto ID %d\n{FF6347}Dono(a): {FFFFFF}%s\n{FF6347}Combustivel: {FFFFFF}%dL\n{FF6347}Lucro: {00FF00}$%d", p, pDono[p], pLitros[p], pLucro[p]);
	    			UpdateDynamic3DTextLabelText(TextoPosto[p], -1, String);
				}
			}
			//
			TextDrawHideForPlayer(playerid, TextAbastecer[0]); TextDrawHideForPlayer(playerid, TextAbastecer[1]);
			for(new t; t < 3; t++)
			{
				PlayerTextDrawHide(playerid, TextAbastecerP[playerid][t]);
			}
		}
		if(RotaBus[playerid] > -1)
		{
		    if(PROF[playerid] == MOTORISTABUS)
		    {
				SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Volte para seu onibus em ate 30 segundos ou sua viagem sera cancelada");
				SegundosVoltarVeiculo[playerid] = 30;
				GameTextForPlayer(playerid, "30", 2000, 6);
		    }
		}
		if(CargaTrem[playerid] > -1)
		{
		    if(PROF[playerid] == FERROVIARIA)
		    {
				SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Volte para o trem em ate 30 segundos ou seu carregamento sera cancelado");
				SegundosVoltarVeiculo[playerid] = 30;
				GameTextForPlayer(playerid, "30", 2000, 6);
		    }
		}
		if(CargaPiloto[playerid] > 0)
		{
		    if(PROF[playerid] == PILOTO)
		    {
				SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Volte para o aviao em ate 30 segundos ou seu carregamento sera cancelado");
				SegundosVoltarVeiculo[playerid] = 30;
				GameTextForPlayer(playerid, "30", 2000, 6);
		    }
		}
		if(CargaMoto[playerid] > -1)
		{
		    if(PROF[playerid] == MOTOBOY)
		    {
				SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Volte para a moto em ate 30 segundos ou seu carregamento sera cancelado");
				SegundosVoltarVeiculo[playerid] = 30;
				GameTextForPlayer(playerid, "30", 2000, 6);
		    }
		}
		if(Carregado[playerid] == true)
		{
		    if(PROF[playerid] == PETROLEIRO || PROF[playerid] == CAMINHONEIRO || PROF[playerid] == MINERADOR)
		    {
				SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Volte para seu veiculo em ate 30 segundos ou sua carga sera cancelada");
				SegundosVoltarVeiculo[playerid] = 30;
				GameTextForPlayer(playerid, "30", 2000, 6);
		    }
			else if(PROF[playerid] == CARROFORTE)
			{
			    SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Volte para seu carro forte em ate 30 segundos ou seu carregamento sera cancelado");
				SegundosVoltarVeiculo[playerid] = 30;
				GameTextForPlayer(playerid, "30", 2000, 6);
			}
		}
		else
		{
		    if(PROF[playerid] ==  PETROLEIRO)
		    {
			    if(ComboioPetroleiro[playerid] > -1)
		 		{
					ComboioPetroleiroList[ComboioPetroleiro[playerid]] --;
		       		ComboioPetroleiro[playerid] = -1;
			    }
			}
			else if(PROF[playerid] == CAMINHONEIRO)
		    {
			    if(ComboioCaminhoneiro[playerid] > -1)
		 		{
					ComboioCaminhoneiroList[ComboioCaminhoneiro[playerid]] --;
		       		ComboioCaminhoneiro[playerid] = -1;
			    }
			}
			else if(PROF[playerid] == MINERADOR)
		    {
			    if(ComboioMinerador[playerid] > -1)
		 		{
					ComboioMineradorList[ComboioMinerador[playerid]] --;
		       		ComboioMinerador[playerid] = -1;
			    }
			}
			else if(PROF[playerid] == CARROFORTE)
		    {
			    if(ComboioCF[playerid] > -1)
		 		{
					ComboioCFList[ComboioCF[playerid]] --;
		       		ComboioCF[playerid] = -1;
			    }
			}
		}
	}
	new vehicleid = GetPlayerVehicleID(playerid);
	if(newstate == PLAYER_STATE_DRIVER)
    {
	    if(VeiculoRoubado[vehicleid] == 1)
		{
		    new motor, farol, alarme, portas, capo, portamalas, objetivo;
	     	GetVehicleParamsEx(vehicleid, motor, farol, alarme, portas, capo, portamalas, objetivo);
	     	SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_ON, farol, 1, portas, capo, portamalas, objetivo);
	     	GameTextForPlayer(playerid, "~r~VEICULO ROUBADO", 5000,3);
	     	if(TimerVeiculoRoubado[vehicleid] < 1) TimerVeiculoRoubado[vehicleid] = SetTimerEx("TirarRouboDoVeiculo", 15000, false, "i", vehicleid);
		}
	}
	return 1;
}

