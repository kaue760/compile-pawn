		            else
		            {
		                SendClientMessage(i, 0x3CB371FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Hospital ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
					  	SendClientMessage(i, 0x3CB371FF, "{FFFFFF}~> Voce nao resistiu ao ferimento e foi levado para um hospital mais proximo");
					  	if(PlanoSaude[i] <= 0)
