		{
		    new Float:P[3][3]; GetPlayerCameraPos(playerid, P[0][0], P[0][1], P[0][2]); GetPlayerCameraFrontVector(playerid, P[1][0], P[1][1], P[1][2]);
	  		P[2][0] = P[0][0] + floatmul(P[1][0], -0.5);
		    P[2][1] = P[0][1] + floatmul(P[1][1], -0.5);
	        P[2][2] = P[0][2] + floatmul(P[1][2], -0.5);
	        if(IsPlayerInRangeOfPoint(playerid, 5.0, P[2][0], P[2][1], P[2][2])) InterpolateCameraPos(playerid, P[0][0], P[0][1], P[0][2], P[2][0], P[2][1], P[2][2], 500, CAMERA_MOVE);
