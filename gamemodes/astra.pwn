			    format(StringG, sizeof(StringG), "{FFFFFF}Casa ID %d\n{9370DB}Dono(a): {FF0000}%s\n{9370DB}Morador(a): {FFFFFF}%s\n{9370DB}Upgrade: {FFFFFF}%d / %d\n%s\n{FFFFFF}%s\n{FFFFFF}Use /Info Casa", c, cDono[c], cMorador[c], cUpgrade[c], cUPMAX[c], cMensagemVenda[c], cMensagem[c]);
