		    SendClientMessage(playerid, -1, "| INFO | Para entrar na Auto Escola digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
		else if(pickupid == PickEntrada[4] || pickupid == PickEntrada[19] || pickupid == PickEntrada[20] || pickupid == PickEntrada[21] || pickupid == PickEntrada[22] || pickupid == PickEntrada[23] || pickupid == PickEntrada[24] || pickupid == PickEntrada[25] || pickupid == PickEntrada[26])
		{
		    SendClientMessage(playerid, -1, "| INFO | Para entrar no Banco digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
