			    SendClientMessage(i, 0x528B8BFF, "~> {FFFFFF}Seu personagem esta com muita sede, va ate um restaurante e beba algo!");
				SendClientMessage(i, 0x528B8BFF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
				MsgAviso(i, 5, "~w~SEU PERSONAGEM ESTA COM MUITA SEDE");
			}
			else if(SEDE[i] < 0 && MinutosMorte[i] <= 0 && SegundosMorte[i] <= 0  && SegundosPreso[i] <= 0 && MinutosPreso[i] <= 0 && HorasPreso[i] <= 0)
			{
			    new Float:Health; GetPlayerHealth(i, Health);
       			SetPlayerHealth(i, Health-1);
			    //morrendo de sede
			}
			//////////////////////
   			if(sUP[i] > -1 && AttAfk[i] < 1001 && SegundosPreso[i] <= 0 && MinutosPreso[i] <= 0 && HorasPreso[i] <= 0)
			{
				if(NivelAdmin[i] > 0 || Estagiario[i] > 0)
				{
				    SegundosSalarioAdmin[i] ++;
				    if(SegundosSalarioAdmin[i] >= 126000)
				    {
				        new sadmin;
				        if(NivelAdmin[i] > 0)
				        {
				            switch(NivelAdmin[i])
					        {
					            case 1: sadmin = 120000;
					            case 2: sadmin = 150000;
					            case 3: sadmin = 250000;
					            case 4: sadmin = 350000;
					        }
				        }
						else if(Estagiario[i] > 0)
						{
						    sadmin = 100000;
						}
                        SegundosSalarioAdmin[i] = 0;
                        SendClientMessage(i, GetPlayerColor(i), "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Salario ADM ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
						format(String, sizeof(String), "~> {FFFFFF}Voce recebeu um salario ADM de $%d", sadmin);
						SendClientMessage(i, GetPlayerColor(i), String);
					    SendClientMessage(i, GetPlayerColor(i), "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Salario ADM ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
						SaldoBancario[i] += sadmin;
				    }
				}
			    sUP[i] --;
			    if(sUP[i] == 0 && mUP[i] == 0)
				{
				   	Level[i] ++;
				    SetPlayerScore(i, GetPlayerScore(i) + 1);
					format(String, sizeof(String), "| UP | Parabens %s voce conquistou +1 level ( %d )", PlayerName(i), GetPlayerScore(i));
				    SendClientMessage(i, 0x00FF00FF, String);
				    if(VIP[i] > 0)
				    {
				        if(SaldoBancario[i] > -999999 && TIPOVIP[i] == 0)
				        {
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Salario VIP ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~> {FFFFFF}Voce recebeu um salario VIP COMUM de $3000 e foi adicionado na sua conta bancaria");
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Salario VIP ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
							SaldoBancario[i] += 3000;
						}
						else if(SaldoBancario[i] > -999999 && TIPOVIP[i] == 1)
				        {
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Salario VIP ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~> {FFFFFF}Voce recebeu um salario VIP GOLD de $5000 e foi adicionado na sua conta bancaria");
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Salario VIP ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
							SaldoBancario[i] += 5000;
						}
						else if(SaldoBancario[i] > -999999 && TIPOVIP[i] == 2)
				        {
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Salario VIP ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~> {FFFFFF}Voce recebeu um salario VIP DIAMANTE de $10000 e foi adicionado na sua conta bancaria");
						    SendClientMessage(i, HexToInt(CORTAGVIP[i]), "~~~~~~~~~~~~~~~~~~~~~~~~~~~ Salario VIP ~~~~~~~~~~~~~~~~~~~~~~~~~~~");
							SaldoBancario[i] += 10000;
						}
					}
					if(GetPlayerScore(i) == 20)
					{
					    if(NivelAdmin[i] == 0 && VIP[i] == 0)
