		            {
		                if(!IsPlayerConnected(IdAdminEvento) && NivelAdmin[IdAdminEvento] < 1) return SendClientMessage(playerid, COR_ERRO, "| ERRO | O evento nao tem mais um criador");
						new Float:P[4];
						GetPlayerFacingAngle(IdAdminEvento, P[3]);
						SetPlayerFacingAngle(playerid, P[3]+180);
						GetPlayerPos(IdAdminEvento, P[0], P[1], P[2]);
