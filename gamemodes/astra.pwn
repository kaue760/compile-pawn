stock Astra_EscolherModo(playerid)
{
	ShowPlayerDialog(playerid, ASTRA_DIALOG_MODO, DIALOG_STYLE_LIST, "{FFFFFF}Astra {FF4040}RP{FFFFFF}/{40A0FF}PVP", "{40A0FF}PVP {FFFFFF}- Arenas, combate e ranking\n{FF4040}RP {FFFFFF}- Cidade, empregos e roleplay", "Entrar", "");
	return 1;
}

stock Astra_IniciarRP(playerid)
{
	AstraModo[playerid] = ASTRA_MODO_RP;
	TogglePlayerSpectating(playerid, 0);
	SpawnPlayer(playerid);
	return 1;
}

stock Astra_IniciarPVP(playerid)
{
	AstraModo[playerid] = ASTRA_MODO_PVP;
	StopAudioStreamForPlayer(playerid);
	Astra_DestruirTextdrawsRP(playerid);
	PVP_OnPlayerConnect(playerid);
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(i != playerid && IsPlayerConnected(i) && AstraModo[i] == ASTRA_MODO_PVP)
		{
			ShowPlayerNameTagForPlayer(playerid, i, 0);
			ShowPlayerNameTagForPlayer(i, playerid, 0);
		}
	}
	format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(playerid));
	if(!dini_Exists(PVP_arquivo))
	{
		PVP_VSenha[playerid] = "astra";
		PVP_VGenero[playerid] = 1;
		PVP_CriarDadosPlayer(playerid);
	}
	else
	{
		PVP_VerificarLogin[playerid] = false;
		for(new i; i < sizeof(PVP_Public_EscolherSpawn); i++) TextDrawShowForPlayer(playerid, PVP_Public_EscolherSpawn[i]);
		SelectTextDraw(playerid, -1);
	}
	return 1;
}

stock Astra_RespostaModo(playerid, response, listitem)
{
	if(!response) return Astra_EscolherModo(playerid);
	if(listitem == 0) Astra_IniciarPVP(playerid);
	else Astra_IniciarRP(playerid);
	return 1;
}
