stock PVP_MensagemText(playerid, const text[])
{
	PlayerTextDrawSetString(playerid, PVP_Player_LoginArcade[playerid][3], text);
	PlayerTextDrawShow(playerid, PVP_Player_LoginArcade[playerid][3]);
	PlayerPlaySound(playerid,1085,0.0,0.0,0.0);
	SelectTextDraw(playerid, 0xFFFFFFAA);
	return SetTimerEx("PVP_QuebrarText", 8000, false, "i", playerid);
}

stock PVP_LimparChat(playerid, linhas)
{
	for(new a = 0; a <= linhas; a++) PVP_SCM(playerid, -1, "");
}

stock PVP_PlayerName(playerid)
{
    new Nick[MAX_PLAYER_NAME];
    GetPlayerName(playerid, Nick, sizeof(Nick));
    return Nick;
}

stock PVP_OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
    if(PVP_IsPlayerInZonaSafe(playerid) || PVP_IsPlayerInZonaSafe(damagedid))
    {
	    new maxstr[500];
	    format(maxstr, sizeof(maxstr), "{FFFFFF} %s, voce nao pode ferir alguem dentro de uma safe zone\n\n{FFFFFF}Agora voce tem {FF0000}1/3{FFFFFF} avisos. Ao atingir 5, sera preso automaticamente.", PVP_PlayerName(playerid));
        ShowPlayerDialog(playerid, PVP_DIALOG_NULL, DIALOG_STYLE_MSGBOX, "{FFFFFF}Arcade: {00FF00}Area Safe", maxstr, "OK","");
        ApplyAnimation(playerid,"PED","handscower",4.1,0,1,1,0,0);
        return 0;
    }
    
    new DamageString[1500], gunname = weaponid, bodyname[128];
    
    if(bodypart == 3) bodyname = "Coluna";
    if(bodypart == 4) bodyname = "Virilha";
    if(bodypart == 5) bodyname = "Braco Esquerdo";
    if(bodypart == 6) bodyname = "Braco Direito";
    if(bodypart == 7) bodyname = "Perna Esquerda";
    if(bodypart == 8) bodyname = "Perna Direita";
    if(bodypart == 9) bodyname = "Cabeca";
    
    if(bodypart == 9) amount = 200.0;
    
    format(DamageString, sizeof(DamageString), "DAMAGE: {FFFFFF}%s[%d] | ID: %d | RG: %d | Arma: %s | Parte do Corpo: %s | Dano: %.0f", PVP_PlayerName(damagedid), damagedid, damagedid, PVP_info[damagedid][PVP_IDF], PVP_Nomesdasarmas[gunname], bodyname, amount);
    SendClientMessage(playerid, 0x179900FF, DamageString);

    format(DamageString, sizeof(DamageString), "DAMAGE: {FFFFFF}%s[%d] | ID: %d | RG: %d | Arma: %s | Parte do Corpo: %s | Dano: %.0f", PVP_PlayerName(playerid), playerid, playerid, PVP_info[playerid][PVP_IDF], PVP_Nomesdasarmas[gunname], bodyname, amount);
    SendClientMessage(damagedid, 0xFF8080FF, DamageString);
    
    if(bodypart == 9) {
	    if(PVP_ArenaPlayer[damagedid] == PVP_ArenaPlayer[playerid]) {
			SetPlayerArmour(playerid, 100.0);
			SetPlayerHealth(playerid, 100.0);
			
			SetPlayerArmour(damagedid, 0.0);
			SetPlayerHealth(damagedid, 0.0);
			
			for(new i = 0; i < sizeof(PVP_Public_MatouHS); i++) TextDrawShowForPlayer(playerid, PVP_Public_MatouHS[i]);
			PlayerTextDrawSetString(playerid, PVP_Player_MatouHS[playerid][0], PVP_PlayerName(damagedid));
			PlayerTextDrawShow(playerid, PVP_Player_MatouHS[playerid][0]);
			PlayerTextDrawShow(playerid, PVP_Player_MatouHS[playerid][1]);
			SetTimerEx("PVP_SumirMatou", 3000, false, "i", playerid);
			GivePlayerMoney(playerid, 300);
			GameTextForPlayer(playerid,"~w~HEAD~g~~h~SHOT",3000,4);
			
			for(new i = 0; i < sizeof(PVP_Public_MorreuHS); i++) TextDrawShowForPlayer(damagedid, PVP_Public_MorreuHS[i]);
			PlayerTextDrawShow(damagedid, PVP_Player_MorreuHS[damagedid][0]);
			SetTimerEx("PVP_SumirMorreu", 3000, false, "i", damagedid);
			GivePlayerMoney(damagedid, -300);
			GameTextForPlayer(damagedid,"~w~HEAD~r~~h~SHOT",3000,4);
		}
	}
	
    return 1;
}
forward PVP_SumirMatou(playerid);
forward PVP_SumirMorreu(damagedid);
public PVP_SumirMatou(playerid) {
	for(new i = 0; i < sizeof(PVP_Public_MatouHS); i++) TextDrawHideForPlayer(playerid, PVP_Public_MatouHS[i]);
	PlayerTextDrawHide(playerid, PVP_Player_MatouHS[playerid][0]);
	PlayerTextDrawHide(playerid, PVP_Player_MatouHS[playerid][1]);
}
public PVP_SumirMorreu(damagedid) {
	for(new i = 0; i < sizeof(PVP_Public_MorreuHS); i++) TextDrawHideForPlayer(damagedid, PVP_Public_MorreuHS[i]);
	PlayerTextDrawHide(damagedid, PVP_Player_MorreuHS[damagedid][0]);
}
stock PVP_CriarID() {
	new IDfff;

	IDfff = 100000+random(899999);
	format(PVP_arquivo, sizeof(PVP_arquivo), "ID/%i.ID", IDfff);
	if(dini_Exists(PVP_arquivo)) {
		for(new i = 0; i < 999; i++) {
			IDfff = 100000+random(899999);
			format(PVP_arquivo, sizeof(PVP_arquivo), "ID/%i.ID", IDfff);
			if(!dini_Exists(PVP_arquivo)) {
				break;
			}
		}
	}
	return IDfff;
}
astracmd_save(playerid, params[]) {
	new Float:pos[4], namepos[256], UniverStrinG[512];
	if(sscanf(params, "s", namepos)) return 1;
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	GetPlayerFacingAngle(playerid, pos[3]);
	if(!dini_Exists("savedpos_pvp.ini")) dini_Create("savedpos_pvp.ini");
	format(UniverStrinG, 512, "%f, %f, %f, %f", pos[0], pos[1], pos[2], pos[3]);
	dini_Set("savedpos_pvp.ini", namepos, UniverStrinG);
	SendClientMessage(playerid, -1, "Posicao salva.");
	return 1;
}
astracmd_a(playerid, params[]) return SetPlayerPos(playerid, 1914.050049, 2757.390625, 10.812517);
astracmd_sair(playerid, params[]) {
	if(PVP_MundoPlayer[playerid] == 1) {
		PVP_Players_MundoFuga -= 1;
		PVP_MundoPlayer[playerid] = 0;
		SetPlayerArmour(playerid, 0.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
		SetPlayerPos(playerid, 379.057586, -2083.854980, 7.945453);
		SetPlayerFacingAngle(playerid, 2.450962);
		SetPlayerInterior(playerid, 0);
		PVP_SetVW(playerid, 0);
		RemovePlayerMapIcon(playerid, 1);
		return 1;
	}
	if(PVP_MundoPlayer[playerid] == 2) {
		PVP_Players_MundoMataMata -= 1;
		PVP_MundoPlayer[playerid] = 0;
		SetPlayerArmour(playerid, 0.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
		SetPlayerPos(playerid, 379.057586, -2083.854980, 7.945453);
		SetPlayerFacingAngle(playerid, 2.450962);
		SetPlayerInterior(playerid, 0);
		PVP_SetVW(playerid, 0);
		return 1;
	}
	
	if(PVP_ArenaPlayer[playerid] == -1)
		return SendClientMessage(playerid, 0xFF0000FF, "| ERRO | Voce nao esta em uma ARENA na cidade.");
	
	if(PVP_ArenaPlayer[playerid] == 3) PVP_PlayersAK -= 1;
    if(PVP_ArenaPlayer[playerid] == 4) PVP_PlayersDesert -= 1;
    if(PVP_ArenaPlayer[playerid] == 5) PVP_PlayersPT2 -= 1;
    if(PVP_ArenaPlayer[playerid] == 6) PVP_PlayersPredio -= 1;
    if(PVP_ArenaPlayer[playerid] == 7) PVP_PlayersAmmu -= 1; 
    if(PVP_ArenaPlayer[playerid] == 8) PVP_PlayersSniper -= 1;
    if(PVP_ArenaPlayer[playerid] == 9) PVP_PlayersCombatS -= 1;
    if(PVP_ArenaPlayer[playerid] == 12) PVP_PlayersM4_Cidade -= 1;
    if(PVP_ArenaPlayer[playerid] == 13) PVP_PlayersM4_Delegacia -= 1;
    
	PVP_ArenaPlayer[playerid] = -1;
	SetPlayerArmour(playerid, 0.0);
	SetPlayerHealth(playerid, 100.0);
	ResetPlayerWeapons(playerid);
	SetPlayerPos(playerid, 379.057586, -2083.854980, 7.945453);
	SetPlayerFacingAngle(playerid, 2.450962);
	SetPlayerInterior(playerid, 0);
	
	PVP_ArenaKills[playerid] = 0;
	PVP_ArenaKillsS[playerid] = 0;
	PVP_ArenaMortes[playerid] = 0;
	
	return 1;
}

PVP_AtualizarRank() {
	if(!dini_Exists("rank.cfg")) dini_Create("rank.cfg");
	
	if(dini_Int("rank.cfg", "kills1") > 0) {
		new arq[128], ztr[500];
		format(arq, sizeof(arq), PVP_PASTA_CONTAS, PVP_GetNickByID(dini_Int("rank.cfg", "pkills1")));
		if(IsValidActor(PVP_ActorRanking[0])) {
			DestroyActor(PVP_ActorRanking[0]);
			PVP_ActorRanking[0] = PVP_CriarActor(dini_Int(arq, "Skin"), 365.078826, -2075.728759, 9.372514, 264.133209);
		} else if(!IsValidActor(PVP_ActorRanking[0])) PVP_ActorRanking[0] = PVP_CriarActor(dini_Int(arq, "Skin"), 365.078826, -2075.728759, 9.372514, 264.133209);
		format(ztr, sizeof(ztr), "{ffffff}[ {9800ff}%s {ffffff}] Kills: {c0c0c0}%d", PVP_GetNickByID(dini_Int("rank.cfg", "pkills1")), dini_Int("rank.cfg", "kills1"));
		Update3DTextLabelText(TextoRanking[0], -1, ztr);
		PVP_SetActorVW(PVP_ActorRanking[0], 0);
	}
	 
	if(dini_Int("rank.cfg", "kills2") > 0) {
		new arq[128], ztr[500];
		format(arq, sizeof(arq), PVP_PASTA_CONTAS, PVP_GetNickByID(dini_Int("rank.cfg", "pkills2")));
		if(IsValidActor(PVP_ActorRanking[1])) {
			DestroyActor(PVP_ActorRanking[1]);
			PVP_ActorRanking[1] = PVP_CriarActor(dini_Int(arq, "Skin"), 365.077117, -2077.135986, 8.552524, 264.133209);
		} else if(!IsValidActor(PVP_ActorRanking[1])) PVP_ActorRanking[1] = PVP_CriarActor(dini_Int(arq, "Skin"), 365.077117, -2077.135986, 8.552524, 264.133209);
		format(ztr, sizeof(ztr), "{ffffff}[ {9800ff}%s {ffffff}] Kills: {c0c0c0}%d", PVP_GetNickByID(dini_Int("rank.cfg", "pkills2")), dini_Int("rank.cfg", "kills2"));
		Update3DTextLabelText(TextoRanking[1], -1, ztr);
		PVP_SetActorVW(PVP_ActorRanking[1], 0);
	}
	
	if(dini_Int("rank.cfg", "kills3") > 0) {
		new arq[128], ztr[500];
		format(arq, sizeof(arq), PVP_PASTA_CONTAS, PVP_GetNickByID(dini_Int("rank.cfg", "pkills3")));
		if(IsValidActor(PVP_ActorRanking[2])) {
			DestroyActor(PVP_ActorRanking[2]);
			PVP_ActorRanking[2] = PVP_CriarActor(dini_Int(arq, "Skin"), 365.075134, -2074.468505, 8.182550, 264.133209);
		} else if(!IsValidActor(PVP_ActorRanking[2])) PVP_ActorRanking[2] = PVP_CriarActor(dini_Int(arq, "Skin"), 365.075134, -2074.468505, 8.182550, 264.133209);
		format(ztr, sizeof(ztr), "{ffffff}[ {9800ff}%s {ffffff}] Kills: {c0c0c0}%d", PVP_GetNickByID(dini_Int("rank.cfg", "pkills3")), dini_Int("rank.cfg", "kills3"));
		Update3DTextLabelText(TextoRanking[2], -1, ztr);
		PVP_SetActorVW(PVP_ActorRanking[2], 0);
	}
	
}
astracmd_zrank(playerid, params[])
{
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            dini_Remove("rank.cfg");
            DestroyActor(PVP_ActorRanking[0]);
            DestroyActor(PVP_ActorRanking[1]);
            DestroyActor(PVP_ActorRanking[2]);
            
            Update3DTextLabelText(TextoRanking[0], -1, "");
            Update3DTextLabelText(TextoRanking[1], -1, "");
            Update3DTextLabelText(TextoRanking[2], -1, "");
            
            for(new conta = 0; conta < dini_Int("conta.cfg", "contascriadas"); conta++) {
	            new arq[128], ztr[500];
				format(ztr, sizeof(ztr), "Conta%i", conta);
				format(arq, sizeof(arq), PVP_PASTA_CONTAS, dini_Get("conta.cfg", ztr));
				dini_IntSet(arq, "Matou", 0); 
				conta++;
            }
            
            PVP_zerouRank = 1;
            SetTimer("PVP_dezerar", 1000, false);
        }
    }
    return 1;
}

forward PVP_dezerar();
public PVP_dezerar() return PVP_zerouRank = 0;

stock PVP_GetNickByID(id) {
	new nick[128];
	format(PVP_arquivo, sizeof(PVP_arquivo), "ID/%i.ID", id);
    format(nick, 128, dini_Get(PVP_arquivo, "Conta"));
    return nick;
}
astracmd_car(playerid, params[])
{
    static
        model,
        color1, color2,
        Float:x, Float:y, Float:z, Float:a;

    if(sscanf(params, "k<vehicle>D(-1)D(-1)", model, color1, color2))
        return 1;

    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);
    
    if(PVP_CriouVeiculo[playerid] != -1) DestroyVehicle(PVP_CriouVeiculo[playerid]);
    
    PVP_CriouVeiculo[playerid] = Astra_CriarVeiculo(model, x, y, z, a, color1, color2, -1);
    SetVehicleVirtualWorld(PVP_CriouVeiculo[playerid], GetPlayerVirtualWorld(playerid));
    PutPlayerInVehicle(playerid, PVP_CriouVeiculo[playerid], 0);
    return 1;
} 
stock PVP_ConvertTime(number)
{
    new hours = 0, mins = 0, secs = 0, string[100];
    hours = floatround(number / 3600);
    mins = floatround((number / 60) - (hours * 60));
    secs = floatround(number - ((hours * 3600) + (mins * 60)));
    new days = 0;
    if(hours >= 24)
    {
        days = floatround((hours/24), floatround_floor);
        hours = hours % 24;
    }
    if(days > 0)
    {
        format(string, 100, "%d dias, %02d:%02d:%02d", days, hours, mins, secs);
    }
    else if(hours > 0)
    {
        format(string, 100, "%02d:%02d:%02d", hours, mins, secs);
    }
    else
    {
        format(string, 100, "%02d:%02d:%02d", hours, mins, secs);
    }
    return string;
}
stock PVP_OrganizarInventario(playerid) {
	new MochilaInfoEx[75][2], totalItens = 0, armazenando = 0;
	for(new i = 0; i < 75; i++) {
		if(PVP_InventarioInfo[playerid][i][PVP_I_Slot] > 0) {
			MochilaInfoEx[armazenando][0] = PVP_InventarioInfo[playerid][i][PVP_I_Slot];
			MochilaInfoEx[armazenando][1] = PVP_InventarioInfo[playerid][i][PVP_I_Unidades];
			armazenando++;
			totalItens++;
		}
	}
	
	if(totalItens > 0) {
		for(new i = 0; i < 75; i++) {
			if(i < totalItens+1) {
				PVP_InventarioInfo[playerid][i][PVP_I_Slot] = MochilaInfoEx[i][0];
				PVP_InventarioInfo[playerid][i][PVP_I_Unidades] = MochilaInfoEx[i][1];
			} else {
				PVP_InventarioInfo[playerid][i][PVP_I_Slot] = 0;
				PVP_InventarioInfo[playerid][i][PVP_I_Unidades] = 0;
				totalItens = 0;
			}
		}
	}
	
	PVP_AtualizarInventario(playerid);
	return 1;
}
stock PVP_AtualizarInventario(playerid) {
	for(new idi = 0; idi < 25; idi++) {
		new item;
		if(PVP_PaginaInventario[playerid] == 1) item = idi;
		if(PVP_PaginaInventario[playerid] == 2) item = idi+25;
		if(PVP_PaginaInventario[playerid] == 3) item = idi+50;
		
		if(PVP_InventarioInfo[playerid][item][PVP_I_Slot] <= 0) {
			PlayerTextDrawSetPreviewModel(playerid, PVP_Player_Inventario[playerid][idi], PVP_InventarioInfo[playerid][item][PVP_I_Slot]);
			PlayerTextDrawSetPreviewRot(playerid, PVP_Player_Inventario[playerid][idi], -10.000000, 0.000000, -20.000000, 99.0);
		} else {
			PlayerTextDrawSetPreviewModel(playerid, PVP_Player_Inventario[playerid][idi], PVP_InventarioInfo[playerid][item][PVP_I_Slot]);
			PlayerTextDrawSetPreviewRot(playerid, PVP_Player_Inventario[playerid][idi], -10.000000, 0.000000, -20.000000, 1.000000);
		}
		PlayerTextDrawShow(playerid, PVP_Player_Inventario[playerid][idi]);
	}
	
	PlayerTextDrawSetString(playerid, PVP_Player_InvText[playerid][0], PVP_PlayerName(playerid));
	PlayerTextDrawShow(playerid, PVP_Player_InvText[playerid][0]);
	 
	new ztr[50];
	format(ztr, 50, "%d/3", PVP_PaginaInventario[playerid]);
	PlayerTextDrawSetString(playerid, PVP_Player_InvText[playerid][1], ztr);
	PlayerTextDrawShow(playerid, PVP_Player_InvText[playerid][1]);
	
	new count = 0;
	for(new idi = 0; idi < 75; idi++) {
		if(PVP_InventarioInfo[playerid][idi][PVP_I_Slot] > 0) {
			count++;
			continue;
		}
	}
	format(ztr, 50, "%d/75", count);
	PlayerTextDrawSetString(playerid, PVP_Player_InvText[playerid][2], ztr);
	PlayerTextDrawShow(playerid, PVP_Player_InvText[playerid][2]);
	
	PlayerTextDrawColor(playerid, PVP_Player_InvText[playerid][3], -1);
	PlayerTextDrawColor(playerid, PVP_Player_InvText[playerid][4], -1);
	PlayerTextDrawColor(playerid, PVP_Player_InvText[playerid][5], -1);
	
	if(PVP_PaginaInventario[playerid] == 1) PlayerTextDrawColor(playerid, PVP_Player_InvText[playerid][3], 0x9800FFFF);
	if(PVP_PaginaInventario[playerid] == 2) PlayerTextDrawColor(playerid, PVP_Player_InvText[playerid][4], 0x9800FFFF);
	if(PVP_PaginaInventario[playerid] == 3) PlayerTextDrawColor(playerid, PVP_Player_InvText[playerid][5], 0x9800FFFF);
	
	PlayerTextDrawShow(playerid, PVP_Player_InvText[playerid][3]);
	PlayerTextDrawShow(playerid, PVP_Player_InvText[playerid][4]);
	PlayerTextDrawShow(playerid, PVP_Player_InvText[playerid][5]);
	
	SelectTextDraw(playerid, -1);
	return 1;
}

//==================== Dispatcher de comandos do modo PVP ====================//
stock Astra_PVPComando(playerid, cmdtext[])
{
	new cmd[32], params[144], i = 1, j = 0;
	while(cmdtext[i] != EOS && cmdtext[i] != ' ' && j < sizeof(cmd) - 1) { cmd[j] = cmdtext[i]; j++; i++; }
	cmd[j] = EOS;
	while(cmdtext[i] == ' ') i++;
	strmid(params, cmdtext, i, strlen(cmdtext), sizeof(params));
	if(!strcmp(cmd, "skins", true)) { astracmd_skins(playerid, params); return 1; }
	if(!strcmp(cmd, "abelhagostoso", true)) { astracmd_abelhagostoso(playerid, params); return 1; }
	if(!strcmp(cmd, "comandosadm", true)) { astracmd_comandosadm(playerid, params); return 1; }
	if(!strcmp(cmd, "setadm", true)) { astracmd_setadm(playerid, params); return 1; }
	if(!strcmp(cmd, "limparchat", true)) { astracmd_limparchat(playerid, params); return 1; }
	if(!strcmp(cmd, "sethora", true)) { astracmd_sethora(playerid, params); return 1; }
	if(!strcmp(cmd, "setclima", true)) { astracmd_setclima(playerid, params); return 1; }
	if(!strcmp(cmd, "cv", true)) { astracmd_cv(playerid, params); return 1; }
	if(!strcmp(cmd, "trabalhar", true)) { astracmd_trabalhar(playerid, params); return 1; }
	if(!strcmp(cmd, "setskin", true)) { astracmd_setskin(playerid, params); return 1; }
	if(!strcmp(cmd, "dv", true)) { astracmd_dv(playerid, params); return 1; }
	if(!strcmp(cmd, "rcar", true)) { astracmd_rcar(playerid, params); return 1; }
	if(!strcmp(cmd, "aviso", true)) { astracmd_aviso(playerid, params); return 1; }
	if(!strcmp(cmd, "tv", true)) { astracmd_tv(playerid, params); return 1; }
	if(!strcmp(cmd, "tvoff", true)) { astracmd_tvoff(playerid, params); return 1; }
	if(!strcmp(cmd, "ir", true)) { astracmd_ir(playerid, params); return 1; }
	if(!strcmp(cmd, "trazer", true)) { astracmd_trazer(playerid, params); return 1; }
	if(!strcmp(cmd, "save", true)) { astracmd_save(playerid, params); return 1; }
	if(!strcmp(cmd, "a", true)) { astracmd_a(playerid, params); return 1; }
	if(!strcmp(cmd, "sair", true)) { astracmd_sair(playerid, params); return 1; }
	if(!strcmp(cmd, "zrank", true)) { astracmd_zrank(playerid, params); return 1; }
	if(!strcmp(cmd, "car", true)) { astracmd_car(playerid, params); return 1; }
	return 0;
}

