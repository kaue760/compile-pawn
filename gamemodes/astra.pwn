//==========================================================================//
//                 ASTRA RP/PVP - nucleo de integracao (RP + PVP)           //
//==========================================================================//
#define ASTRA_MODO_NENHUM 0
#define ASTRA_MODO_PVP 1
#define ASTRA_MODO_RP 2
#define ASTRA_VW_PVP 30000
#define ASTRA_DIALOG_MODO 32100
new AstraModo[MAX_PLAYERS];

stock Astra_CriarVeiculo(modelid, Float:x, Float:y, Float:z, Float:angle, color1, color2, respawn_delay)
{
	new v = CreateVehicle(modelid, x, y, z, angle, color1, color2, respawn_delay);
	if(v != INVALID_VEHICLE_ID && v < rC_MaxVehcl)
	{
		rC_AntiCar[v] = modelid;
		SetVehicleVirtualWorld(v, ASTRA_VW_PVP);
	}
	return v;
}
stock PVP_SCMAll(color, const message[])
{
	for(new i = 0; i < MAX_PLAYERS; i++) if(IsPlayerConnected(i) && AstraModo[i] == ASTRA_MODO_PVP) SendClientMessage(i, color, message);
	return 1;
}
stock PVP_SetWeather(weatherid)
{
	for(new i = 0; i < MAX_PLAYERS; i++) if(IsPlayerConnected(i) && AstraModo[i] == ASTRA_MODO_PVP) SetPlayerWeather(i, weatherid);
	return 1;
}
stock PVP_SetWorldTime(hour)
{
	for(new i = 0; i < MAX_PLAYERS; i++) if(IsPlayerConnected(i) && AstraModo[i] == ASTRA_MODO_PVP) SetPlayerTime(i, hour, 0);
	return 1;
}
stock PVP_SetVW(playerid, vw) return SetPlayerVirtualWorld(playerid, vw + ASTRA_VW_PVP);
stock PVP_SetActorVW(actorid, vw) return SetActorVirtualWorld(actorid, vw + ASTRA_VW_PVP);
stock PVP_CriarActor(skin, Float:x, Float:y, Float:z, Float:a)
{
	new id = CreateActor(skin, x, y, z, a);
	if(id != INVALID_ACTOR_ID) SetActorVirtualWorld(id, ASTRA_VW_PVP);
	return id;
}
stock Text3D:PVP_Criar3D(const text[], color, Float:X, Float:Y, Float:Z, Float:DrawDistance, virtualworld, testLOS = 0)
	return Create3DTextLabel(text, color, X, Y, Z, DrawDistance, virtualworld + ASTRA_VW_PVP, testLOS);
stock PVP_CriarPickup(model, type, Float:X, Float:Y, Float:Z, virtualworld = 0)
	return CreatePickup(model, type, X, Y, Z, virtualworld + ASTRA_VW_PVP);

