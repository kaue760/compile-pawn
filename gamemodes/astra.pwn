  						MsgAviso(playerid, 2, strt);
			        }
			        else if(VidaArvore[playerid] != -1)
			        {
			            VidaArvore[playerid] = -1;
			            GameTextForPlayer(playerid, "~g~Arvore ~w~Derrubada", 2500, 3);
			            SendClientMessage(playerid, GetPlayerColor(playerid), "| LENHADOR | Pegue um Veiculo 'Walton' para carregar essa arvore ate a lenhadeira");
				        new lado = random(2);
					  	if(lado == 0)
					    {
				        	MoveDynamicObject(Arvore[playerid], X, Y, Z+0.2, 0.2, 0.0, -88.0, 0.0);
							if(CheckArvore[playerid] == -1)
							{
							    CheckArvore[playerid] = CreateDynamicCP(X+2+random(2), Y-2-random(2), Z+2, 2.0, -1, -1, playerid, 20.0);
							}
						}
						else
						{
						    MoveDynamicObject(Arvore[playerid], X, Y, Z+0.2, 0.2, 0.0, 88.0, 0.0);
						    if(CheckArvore[playerid] == -1)
							{
							    CheckArvore[playerid] = CreateDynamicCP(X-2-random(2), Y+2+random(2), Z+2, 2.0, -1, -1, playerid, 20.0);
							}
						}
						DOF2_SetInt("Arvores.ini", "Quantidade", DOF2_GetInt("Arvores.ini", "Quantidade") + 1);
						DOF2_SaveFile();
					}
			    }
			}
		}
	}
	if(newkeys & KEY_FIRE)
	{
 		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
		    if(VIP[playerid] > 0 && SegundosPerseguidoCorp[playerid] == 0 && NoEvento[playerid] == 0 && vQuebrado[GetPlayerVehicleID(playerid)] == false || NivelAdmin[playerid] > 0)
		    {
			    AddVehicleComponent(GetPlayerVehicleID(playerid), 1010);
			    new Float:VidaV; GetVehicleHealth(GetPlayerVehicleID(playerid), VidaV);
			    if(VidaV < 1000.0 && vQuebrado[GetPlayerVehicleID(playerid)] == false)
			    {
					SetVehicleHealth(GetPlayerVehicleID(playerid), 1000.0);
			    }
			}
		}
		else
		{
			for(new a; a < 9; a++)
			{
			    if(IsPlayerInRangeOfPoint(playerid, PosAreaSafe[a][3], PosAreaSafe[a][0], PosAreaSafe[a][1], PosAreaSafe[a][2]))
			    {
			        if(GetPlayerWeapon(playerid) != 42) return ApplyAnimation(playerid, "FAT", "IDLE_TIRED", 4.1, 0, 0, 0, 0, 3000, 1);
			    }
			}
		}
	}
	else if(oldkeys & KEY_FIRE)
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	    {
	        if(VIP[playerid] > 0 || NivelAdmin[playerid] > 0)
	        {
				RemoveVehicleComponent(GetPlayerVehicleID(playerid), 1010);
			}
		}
	}
	//reboque
	else if(newkeys == KEY_SUBMISSION)//2
	{
		if (GetVehicleModel(GetPlayerVehicleID(playerid)) == 525 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
  		{
            new VehicleId = GetPlayerVehicleID(playerid);
			if(!IsTrailerAttachedToVehicle(VehicleId))
			{
    			new TrailerId = VeiculoProximo8m(playerid);
				if(TrailerId > -1)
				{
				    if(vPreso[TrailerId] == false)
				    {
						AttachTrailerToVehicle(TrailerId, VehicleId);
						PlayerPlaySound(playerid, 3016, 0, 0, 0);
						if(PROF[playerid] == AGENTEDETRAN)
						{
                            format(String, sizeof(String), "| INFO | Voce rebocou o veiculo {FFFF00}%s[%d] com {1E90FF}%d dias {FFFFFF}de IPVA atrasado", NomeVeiculo(TrailerId), TrailerId, vIPVA[TrailerId]);
							SendClientMessage(playerid, -1, String);
							DisablePlayerCheckpoint(playerid);
						}
					}
					else
					{
					    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse veiculo ja esta apreendido e nao pode ser rebocado");
					}
				}
			}
			else
			{
			    DetachTrailerFromVehicle(VehicleId);
			}
  		}
 	}
 	//
	else if(newkeys == KEY_CTRL_BACK || newkeys == KEY_CROUCH)//H //C 275
	{
	    if(IsPlayerInRangeOfPoint(playerid, 10.0, 321.376129, -1188.250732, 78.099266))//portao casa zeus
	    {
	        if(new_strcmp(PlayerName(playerid), cDono[275]) || new_strcmp(PlayerName(playerid), cMorador[275]))
	        {
	            if((gettime() - antifloodportao[0]) >= 3)
	            {
	                if(statusportao[0] == 0)
	                {
	                    statusportao[0] = 1;
	                    MoveDynamicObject(portao[0], 321.325531, -1188.293457, 82.228897, 1.0, 0.000000, -0.899999, 38.300067);
	                }
	                else
	                {
	                    statusportao[0] = 0;
	                    MoveDynamicObject(portao[0], 321.376129, -1188.250732, 78.099266, 1.0, 0.000000, -0.899999, 38.300067);
	                }
	                antifloodportao[0] = gettime();
	            }
	        }
	    }
	    else if(IsPlayerInRangeOfPoint(playerid, 10.0, 1544.0922,-1630.6761,13.3828))
		{
		    if(PROF[playerid] == PM)
		    {
		        if(!IsDynamicObjectMoving(PortaoDP))
     			{
			    	MoveDynamicObject(PortaoDP, 1547.3000000, -1627.7000000, 20.5, 2.0, 0.00000, 0.00000, 90.2500000);
			    	SetTimerEx("FecharPortaoDP", 5000, false, "i", PortaoDP);
			    	SendClientMessage(playerid, 0x00CD66FF, "| INFO | Portao do DP aberto, ele fechara em 5 segundos");
				}
		    }
		}
  		else if(IsPlayerInRangeOfPoint(playerid, 10.0, 1811.45654, -1893.04224, 13.43060))
  		{
  		    if(!IsDynamicObjectMoving(CancelaTaxi))
  		    {
  		        MoveDynamicObject(CancelaTaxi, 1811.45654, -1893.04224, 13.2306, 0.1, 0.00000, 0.00000, 90.00000);
				SetTimer("FecharCancelaTaxi", 5000, false);
  		    }
  		}
  		else if(IsPlayerInRangeOfPoint(playerid, 10.0, 2874.810791, -1963.312133, 12.929430))
  		{
  		    if(!IsDynamicObjectMoving(PortaoPresidio))
  		    {
  		        MoveDynamicObject(PortaoPresidio, 2874.810791, -1963.312133, 18.5, 2.0, 0.000000, 0.000000, 450.000000);
				SetTimerEx("FecharPortaoPresidio", 5000, false, "i", PortaoPresidio);
  		    }
  		}
		else if(IsPlayerInRangeOfPoint(playerid, 2.0, 1945.2566,-1810.6073,14.3581))
       	{
			if(VIP[playerid] > 0)
			{
   				if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	           	{
             		ShowPlayerDialog(playerid, D_TUNAR, DIALOG_STYLE_LIST, "{FFFFFF}Tunagem", "{FFFFFF}Rodas\nCores\nNitro\nSuspensao\nPaintjobs\nAutotuning", "Selecionar", "Cancelar");
	            }
	            else
	            {
	            	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta dirigindo um veiculo");
	            }
			}
			else
			{
				return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao e um jogador VIP");
			}
   		}
		else
		{
		    for(new p; p < MAX_ORG; p++)
		    {
				if(IsPlayerInRangeOfPoint(playerid, 10.0, MovePortaoBase[p][0], MovePortaoBase[p][1], MovePortaoBase[p][2]) && !IsDynamicObjectMoving(PortaoBase[p]))
				{
				    if(ORG[playerid] == p || !VerifyExpiredDays(gTimer[p]))
					{
					    MoveDynamicObject(PortaoBase[p], MovePortaoBase[p][6], MovePortaoBase[p][7], MovePortaoBase[p][8], 2.0, MovePortaoBase[p][9], MovePortaoBase[p][10], MovePortaoBase[p][11]);
					    SetTimerEx("FecharPortaoBase", 5000, false, "d", p);
					    ApplyDynamicActorAnimation(gActor[p], "PED", "IDLE_CHAT", 4.1, 1, 0, 0, 0, 1);
					    return 1;
					}
					else
					{
						MsgAviso(playerid, 5, "~r~~h~ESSA ORGANIZACAO ESTA FECHADA");
					}
				}
		    }
		    for(new t; t < 4; t++)
            {
                if(IsPlayerInRangeOfPoint(playerid, 2.0, PosTunagem[t][0], PosTunagem[t][1], PosTunagem[t][2]))
                {
                    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                    {
                        ShowPlayerDialog(playerid, D_TUNAR, DIALOG_STYLE_LIST, "{FFFFFF}Tunagem", "{FFFFFF}Rodas\nCores\nNitro\nSuspensao", "Selecionar", "Cancelar");
                    }
                    else
                    {
                        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta dirigindo um veiculo");
                    }
                }
            }
			if(!IsPlayerInAnyVehicle(playerid))
			{
			    new idv = VeiculoProximo(playerid);
				if(idv > -1)
				{
				    new InfoVenda[50]; InfoVenda = "{FFFFFF}A venda: {FF0000}Nao";
                    foreach(Player, i)
    				{
    				    for(new v; v < 5; v++)
    				    {
			      			if(pVeiculoInv[i][v] == idv)
					    	{
        						new PastaVeiculos[50]; format(PastaVeiculos, sizeof(PastaVeiculos), "Veiculos/%s.ini", PlayerName(i));
					       		new KeyV[25]; format(KeyV, sizeof(KeyV), "VeiculoAvenda%d", v);
								if(DOF2_GetInt(PastaVeiculos, KeyV) > 0)
								{
								    format(InfoVenda, sizeof(InfoVenda), "{FFFFFF}Comprar veiculo por {008B00}$%d", DOF2_GetInt(PastaVeiculos, KeyV));
								}
								break;
							}
						}
					}
				    new nomev[100], textos[256]; format(nomev, sizeof(nomev), "{FFFFFF}Veiculo: {FFFF00}%s {FFFFFF}ID: {6495ED}%d {FFFFFF}Dono(a): {00CD66}%s", NomeVeiculo(idv), idv, vDono[idv]);
				    format(textos, sizeof(textos), "{FFFFFF}Abastecer com Galao\nTrancar/Destrancar Veiculo\nAbrir Porta-Malas\nFechar Porta-Malas\nAbrir/Fechar Capo\nEstacionar\nAlterar Placa\nPintar\nVender\n%s\nIVPA Atrasado [ {088A08}%d {FFFFFF}]", InfoVenda, vIPVA[idv]);
				    ShowPlayerDialog(playerid, D_MENUVEICULO, DIALOG_STYLE_LIST, nomev, textos, "Selecionar", "Cancelar");
				}
			}
		}
	}
	return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
    if(!success)
    {
        new pip[16];
        foreach(Player, i)
        {
            GetPlayerIp(i, pip, sizeof(pip));
            if(new_strcmp(pip, ip))
            {
                if(!new_strcmp(PlayerName(i), "Dodo_Mobile"))
        		{
	                format(String, sizeof(String), "| CARP-Admin | O(A) Administrador(a) Malvadao kickou o(a) jogador(a) %s ( Motivo: Tentativa de Login RCON )", PlayerName(i));
					SendClientMessageToAll(0xFF0000FF, String);
					SetTimerEx("Kickar" , 150 , false, "i" , i );
					GameTextForPlayer(i, "~r~Kickado!", 3000, 0);
					format(String, sizeof(String), "O(A) Jogador(a) %s tentou logar na rcon, senha: %s", PlayerName(i), password);
					FileLog("RconErro", String);
				}
				return 1;
            }
        }
    }
    else
    {
        new pip[16];
        foreach(Player, i)
        {
            GetPlayerIp(i, pip, sizeof(pip));
            if(new_strcmp(pip, ip) && !new_strcmp(PlayerName(i), "Guilherme") && !new_strcmp(PlayerName(i), "Malvadao"))
            {
				format(String, sizeof(String), "%s logou na rcon", PlayerName(i));
				FileLog("RconSucesso", String);
				return 1;
            }
        }
    }
    return 1;
}

public OnPlayerUpdate(playerid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerUpdate(playerid);
    /*if(GetPlayerAnimationIndex(playerid))
    {
        new animlib[32];
        new animname[32];
        new msg[128];
        GetAnimationName(GetPlayerAnimationIndex(playerid),animlib,32,animname,32);
        format(msg, 128, "Running anim: %s %s", animlib, animname);
        SendClientMessage(playerid, 0xFFFFFFFF, msg);
    }*/
    if(Spawnado[playerid] == true)
	{
	    if(ArmaProibida(GetPlayerWeapon(playerid)) && NivelAdmin[playerid] <= 0 && !IsPlayerAdmin(playerid))
		{
		    Kick(playerid);
		}
		else if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK && NivelAdmin[playerid] == 0 && Estagiario[playerid] == 0 && !IsPlayerAdmin(playerid) && VIP[playerid] == 0)
		{
		    format(String, sizeof(String), "| CARP-Admin | O(A) Administrador(a) Malvadao kickou o(a) jogador(a) %s ( Motivo: Jetpack )", PlayerName(playerid));
    		SendClientMessageToAll(0xFF0000FF, String);
            Kick(playerid);
		}
		//
		if(!IsPlayerInAnyVehicle(playerid))
		{
	    	new Armas[MAX_PLAYERS],Balas[MAX_PLAYERS];
	    	GetPlayerWeaponData(playerid, 5, Armas[playerid], Balas[playerid]);
			if(Armas[playerid] == 30 && Balas[playerid] >= 1)//Ak-47
			{
	            if(GetPlayerWeapon(playerid) == 30) RemovePlayerAttachedObject(playerid,SlotAKeFUZIL);
	            else SetPlayerAttachedObject(playerid, SlotAKeFUZIL, 355, 1, -0.060921, -0.141673, 0.000000, 0.000000, 35.362735, 0.000000);
			}
			else if(Armas[playerid] == 31 && Balas[playerid] >= 1) //FUZIL
			{
				if(GetPlayerWeapon(playerid) == 31) RemovePlayerAttachedObject(playerid,SlotAKeFUZIL);
	            else SetPlayerAttachedObject(playerid, SlotAKeFUZIL, 356, 1, -0.099681, -0.133408, 0.000000, 1.027592, 19.667785, 0.000000);
			}
			else
			{
			    RemovePlayerAttachedObject(playerid,SlotAKeFUZIL);
			}
	        GetPlayerWeaponData(playerid, 3, Armas[playerid], Balas[playerid]);
			if(Armas[playerid] == 25 && Balas[playerid] >= 1)//escopeta
			{
			    if(GetPlayerWeapon(playerid) == 25) RemovePlayerAttachedObject(playerid,SlotEscopeta);
	             else SetPlayerAttachedObject(playerid, SlotEscopeta, 349, 1, -0.109260, -0.059651, -0.066210, 186.310729, 42.375362, 6.716565);
			}
			else if(Armas[playerid] == 27 && Balas[playerid] >= 1) //escopeta de combate
			{
	  			if(GetPlayerWeapon(playerid) == 27) RemovePlayerAttachedObject(playerid,SlotEscopeta);
				else SetPlayerAttachedObject(playerid, SlotEscopeta, 351, 1, -0.181073, -0.056285, -0.081242, 181.269729, 39.399085, 12.246994);
			}
			else
			{
			    RemovePlayerAttachedObject(playerid,SlotEscopeta);
			}
		}
		//
	    new Keys, ud, lr; GetPlayerKeys(playerid, Keys, ud, lr);
	  	if(Keys == KEY_FIRE)
		{
			if(PROF[playerid] == BOMBEIRO)
			{
       			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetVehicleModel(GetPlayerVehicleID(playerid)) == 407)
    			{
				    for(new i; i < 40; i++)
				    {
				        if(Incendio[i] > -1 && IsValidDynamicObject(Incendio[i]))
				        {
				            new Float:X, Float:Y, Float:Z; GetDynamicObjectPos(Incendio[i], X, Y, Z);
							if(IsPlayerInRangeOfPoint(playerid, 20.0, X, Y, Z))
							{
							    new quantidade = 4 + random(3);
							    if(FogoIncendio[i] > 0)
							    {
							        FogoIncendio[i] -= quantidade;
							        if(FogoIncendio[i] < 0)
								    {
								        FogoIncendio[i] = 0;
								    }
								    new strp[70]; format(strp, sizeof(strp), "{FF0000}Incendio {FFFFFF}ID %d\nFogo [%d/1000]", i, FogoIncendio[i]);
	  								UpdateDynamic3DTextLabelText(TextoIncendio[i], -1, strp);
	  								GameTextForPlayer(playerid, "~g~~h~Continue apagando...", 1000, 3);
							    }
							    else
							    {
							        FogoIncendio[i] = 0;
							        DestroyDynamicObject(Incendio[i]);
							        Incendio[i] = -1;
							        DestroyDynamic3DTextLabel(TextoIncendio[i]);
							        TextoIncendio[i] = CreateDynamic3DTextLabel("{FFFFFF}Incendio[OFF]", -1, -999.0, -98383.3, -9292.0, 10.0);
							        //
							        new Float:valorf = floatsqroot(floatpower(X - 1731.7147, 2) + floatpower(Y - -1762.3159, 2) + floatpower(Z - 15.0946, 2));
									new valor = floatround(valorf, floatround_round);
         							ValorIncendio[playerid] = valor;
                					if(ValorIncendio[playerid] > 10000)
         							{
         							    ValorIncendio[playerid] = 10000;
         							}
         							SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Volte para sua HQ e finalize o Incendio para receber a recompensa");
									GameTextForPlayer(playerid, "~g~Incendio Apagado!", 2500, 3);
									DisablePlayerCheckpoint(playerid);
							    }
							    break;
							}
				        }
				    }
				}
				else if(GetPlayerWeapon(playerid) == 42)
				{
				    for(new i; i < 40; i++)
				    {
				        if(Incendio[i] > -1 && IsValidDynamicObject(Incendio[i]))
				        {
				            new Float:X, Float:Y, Float:Z; GetDynamicObjectPos(Incendio[i], X, Y, Z);
							if(IsPlayerInRangeOfPoint(playerid, 10.0, X, Y, Z))
							{
							    new quantidade = 4 + random(3);
							    if(FogoIncendio[i] > 0)
							    {
							        FogoIncendio[i] -= quantidade;
							        if(FogoIncendio[i] < 0)
								    {
								        FogoIncendio[i] = 0;
								    }
								    new strp[70]; format(strp, sizeof(strp), "{FF0000}Incendio {FFFFFF}ID %d\nFogo [%d/1000]", i, FogoIncendio[i]);
	  								UpdateDynamic3DTextLabelText(TextoIncendio[i], -1, strp);
	  								GameTextForPlayer(playerid, "~g~~h~Continue apagando...", 1000, 3);
							    }
							    else
							    {
							        FogoIncendio[i] = 0;
							        DestroyDynamicObject(Incendio[i]);
							        Incendio[i] = -1;
							        DestroyDynamic3DTextLabel(TextoIncendio[i]);
							        TextoIncendio[i] = CreateDynamic3DTextLabel("{FFFFFF}Incendio[OFF]", -1, -999.0, -98383.3, -9292.0, 10.0);
							        //
							        new Float:valorf = floatsqroot(floatpower(X - 1731.7147, 2) + floatpower(Y - -1762.3159, 2) + floatpower(Z - 15.0946, 2));
									new valor = floatround(valorf, floatround_round);
				   					ValorIncendio[playerid] = valor;
         							if(ValorIncendio[playerid] > 3000)
         							{
         							    ValorIncendio[playerid] = 3000;
         							}
         							SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Volte para sua HQ e finalize o Incendio para receber a recompensa");
									GameTextForPlayer(playerid, "~g~Incendio Apagado!", 2500, 3);
									DisablePlayerCheckpoint(playerid);
							    }
							    break;
							}
				        }
				    }
				}
			}
		}
		else if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	    {
	        for(new i = 0; i < sizeof(SpikeInfo); i++)
	  	    {
	  	        if(IsPlayerInRangeOfPoint(playerid, 3.0, SpikeInfo[i][sX], SpikeInfo[i][sY], SpikeInfo[i][sZ]))
	            {
	  	            if(SpikeInfo[i][sCreated] == 1)
	  	            {
	  	                new panels, doors, lights, tires;
	  	                new carid = GetPlayerVehicleID(playerid);
			            GetVehicleDamageStatus(carid, panels, doors, lights, tires);
			            tires = encode_tires(1, 1, 1, 1);
			            UpdateVehicleDamageStatus(carid, panels, doors, lights, tires);
			            GameTextForPlayer(playerid, "~r~pneus ~w~furados", 1500, 1);
	  	            }
	  	        }
	  	    }
	  	}
	}
	return 1;
}

