	return 1;
}

forward FecharPortaoBase(p);
public FecharPortaoBase(p)
{
	MoveDynamicObject(PortaoBase[p], MovePortaoBase[p][0], MovePortaoBase[p][1], MovePortaoBase[p][2], 2.0, MovePortaoBase[p][3], MovePortaoBase[p][4], MovePortaoBase[p][5]);
	return 1;
}

forward InvasaoFavela0(playerid);
public InvasaoFavela0(playerid)
{
    if(IsPlayerInDynamicCP(playerid, CheckFavela[0]) && SegundosMorte[playerid] <= 0)
	{
	    if(SegundosInvadindo[0] < 100)
	    {
		    SegundosInvadindo[0] ++;
		    new Strg[40]; format(Strg, sizeof(Strg), "Invadindo Favela ( %d%s )", SegundosInvadindo[0], "%");
		    PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], Strg);
		    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], SegundosInvadindo[0]);
		   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
		   	SetTimerEx("InvasaoFavela0", 750, false, "d", playerid);
		}
		else
		{
		    SegundosInvadindo[0] = 0;
		    GangZoneStopFlashForAll(GZ_Favela[0]);
			if(ORG[playerid] >= 0)
			{
			    DonoFavela[0] = ORG[playerid];
			    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
		    	PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
		    	
			    format(String, sizeof(String), "| INVASAO | O(A) Mafioso %s da Org %s dominou a Favela de Sao Paulo", PlayerName(playerid), gNome[ORG[playerid]]);
				new Strcor[15]; format(Strcor, sizeof(Strcor), "0x%s99", gCor[ORG[playerid]]);
				SendClientMessageToAll(HexToInt(Strcor), String);
				MinMateriaisFav[0] = 30; SegMateriaisFav[0] = 0;
				
				GangZoneShowForAll(GZ_Favela[0], HexToInt(Strcor));
			    return 1;
			}
			
			new nomecorp[20];
			switch(PROF[playerid])
			{
			    case ROTA: nomecorp = "Rota";
			    case CHOQUE: nomecorp = "Choque";
			    case ROTAM: nomecorp = "Rotam";
			    case BOPE: nomecorp = "Bope";
			    case EXERCITO: nomecorp = "Exercito";
			}
			switch(PROF[playerid])
			{
   				case ROTA,CHOQUE,ROTAM,BOPE,EXERCITO:
			    {
			        DonoFavela[0] = PROF[playerid];
			        HidePlayerProgressBar(playerid, barfabarmas[playerid]);
			   		PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
			   		
			   		format(String, sizeof(String), "| INVASAO | O(A) Policial %s CORP: %s pacificou a Favela de Sao Paulo", PlayerName(playerid), nomecorp);
					SendClientMessageToAll(GetPlayerColor(playerid), String);
					MinMateriaisFav[0] = -1; SegMateriaisFav[0] = -1;
					
					GangZoneShowForAll(GZ_Favela[0], 0x0040FF99);
			        return 1;
			    }
			}
		}
	}
	else
	{
	    SegundosInvadindo[0] = 0;
	    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
	    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
	    GangZoneStopFlashForAll(GZ_Favela[0]);
	}
	return 1;
}

forward InvasaoFavela1(playerid);
public InvasaoFavela1(playerid)
{
    if(IsPlayerInDynamicCP(playerid, CheckFavela[1]) && SegundosMorte[playerid] <= 0)
	{
	    if(SegundosInvadindo[1] < 100)
	    {
		    SegundosInvadindo[1] ++;
		    new Strg[40]; format(Strg, sizeof(Strg), "Invadindo Favela ( %d%s )", SegundosInvadindo[1], "%");
		    PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], Strg);
		    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], SegundosInvadindo[1]);
		   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
		   	SetTimerEx("InvasaoFavela1", 750, false, "d", playerid);
		}
		else
		{
		    SegundosInvadindo[1] = 0;
		    GangZoneStopFlashForAll(GZ_Favela[1]);
