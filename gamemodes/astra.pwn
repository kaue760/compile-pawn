stock PVP_OnPlayerDisconnect(playerid, reason)
{
	PVP_SetVW(playerid, 0);
	
    if(PVP_VerificarLogin[playerid] == true)
    {
        PVP_SalvarDados(playerid);
    }
    KillTimer( PVP_TimerCirrida[playerid] );
    
    for(new i; i < sizeof(PVP_Public_LogoArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_LogoArcade[i]);
    
    for(new i; i < sizeof(PVP_Public_Rodape); i++) TextDrawHideForPlayer(playerid, PVP_Public_Rodape[i]);
    for(new i; i < sizeof(PVP_Player_Rodape[]); i++) PlayerTextDrawHide(playerid, PVP_Player_Rodape[playerid][i]);
    for(new i; i < sizeof(PVP_Player_Rodape[]); i++) PlayerTextDrawDestroy(playerid, PVP_Player_Rodape[playerid][i]);
     
    for(new i; i < sizeof(PVP_Public_VeloArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_VeloArcade[i]);
    for(new i; i < sizeof(PVP_Player_VeloArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_VeloArcade[playerid][i]);
    for(new i; i < sizeof(PVP_Player_VeloArcade[]); i++) PlayerTextDrawDestroy(playerid, PVP_Player_VeloArcade[playerid][i]);
     
    for(new i; i < sizeof(PVP_Public_HudKill); i++) TextDrawHideForPlayer(playerid, PVP_Public_HudKill[i]);
    for(new i; i < sizeof(PVP_Player_HudKill[]); i++) PlayerTextDrawHide(playerid, PVP_Player_HudKill[playerid][i]);
    for(new i; i < sizeof(PVP_Player_HudKill[]); i++) PlayerTextDrawDestroy(playerid, PVP_Player_HudKill[playerid][i]);
     
    for(new i; i < sizeof(PVP_Public_Inventario); i++) TextDrawHideForPlayer(playerid, PVP_Public_Inventario[i]);
    for(new i; i < sizeof(PVP_Player_Inventario[]); i++) PlayerTextDrawHide(playerid, PVP_Player_Inventario[playerid][i]);
    for(new i; i < sizeof(PVP_Player_Inventario[]); i++) PlayerTextDrawDestroy(playerid, PVP_Player_Inventario[playerid][i]);
    for(new i; i < sizeof(PVP_Player_InvText[]); i++) PlayerTextDrawHide(playerid, PVP_Player_InvText[playerid][i]);
    for(new i; i < sizeof(PVP_Player_InvText[]); i++) PlayerTextDrawDestroy(playerid, PVP_Player_InvText[playerid][i]);
    
    for(new i; i < sizeof(PVP_Public_SkinsArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_SkinsArcade[i]);
    for(new i; i < sizeof(PVP_Player_SkinsArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_SkinsArcade[playerid][i]);
    for(new i; i < sizeof(PVP_Player_SkinsArcade[]); i++) PlayerTextDrawDestroy(playerid, PVP_Player_SkinsArcade[playerid][i]);
    
    for(new i; i < sizeof(PVP_Public_LojaArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_LojaArcade[i]);
    for(new i; i < sizeof(PVP_Player_LojaArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_LojaArcade[playerid][i]);
    for(new i; i < sizeof(PVP_Player_LojaArcade[]); i++) PlayerTextDrawDestroy(playerid, PVP_Player_LojaArcade[playerid][i]);
    
    DestroyDynamic3DTextLabel(textTAG[playerid]);
    
    if(PVP_MundoPlayer[playerid] == 1) PVP_Players_MundoFuga -= 1;
    if(PVP_MundoPlayer[playerid] == 2) PVP_Players_MundoMataMata -= 1;
    RemovePlayerMapIcon(playerid, 1);
    
    if(PVP_ArenaPlayer[playerid] == 3) PVP_PlayersAK -= 1;
    if(PVP_ArenaPlayer[playerid] == 4) PVP_PlayersDesert -= 1;
    if(PVP_ArenaPlayer[playerid] == 5) PVP_PlayersPT2 -= 1;
    if(PVP_ArenaPlayer[playerid] == 6) PVP_PlayersPredio -= 1;
    if(PVP_ArenaPlayer[playerid] == 7) PVP_PlayersAmmu -= 1; 
    if(PVP_ArenaPlayer[playerid] == 8) PVP_PlayersSniper -= 1;
    if(PVP_ArenaPlayer[playerid] == 9) PVP_PlayersCombatS -= 1;
    if(PVP_ArenaPlayer[playerid] == 12) PVP_PlayersM4_Cidade -= 1;
    if(PVP_ArenaPlayer[playerid] == 13) PVP_PlayersM4_Delegacia -= 1;
    
    PVP_ArenaPlayer[playerid] = -1;

	PVP_ArenaKills[playerid] = 0;
	PVP_ArenaKillsS[playerid] = 0;
	PVP_ArenaMortes[playerid] = 0;
	PVP_MundoPlayer[playerid] = 0;
	
	PVP_Corrida_Player_Checkpoint[playerid] = 0;
	PVP_Corrida_Player[playerid] = 0;
	PVP_Corrida_Escolheu[playerid] = 0;
	DisablePlayerRaceCheckpoint(playerid);
	PVP_TempoCorrida[playerid] = 0;
	
	if(PVP_CriouVeiculo[playerid] != -1) DestroyVehicle(PVP_CriouVeiculo[playerid]);
	PVP_CriouVeiculo[playerid] = -1;
	
	return 1;
}






PVP_ProxDetector(Float:radi, playerid, string[], color) {
	new Float:posx, Float:posy, Float:posz;
	new Float:oldposx, Float:oldposy, Float:oldposz;
	new Float:tempposx, Float:tempposy, Float:tempposz;
	GetPlayerPos(playerid, oldposx, oldposy, oldposz);
	for(new i = 0; i < MAX_PLAYERS;  i++) {
		if(!IsPlayerConnected(i) || AstraModo[i] != ASTRA_MODO_PVP) continue;
		GetPlayerPos(i, posx, posy, posz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		tempposz = (oldposz -posz);
		if (((tempposx < radi/16) && (tempposx > -radi/16)) && ((tempposy < radi/16) && (tempposy > -radi/16)) && ((tempposz < radi/16) && (tempposz > -radi/16))) {
			SendClientMessage(i, color, string);
		}
		else if (((tempposx < radi/8) && (tempposx > -radi/8)) && ((tempposy < radi/8) && (tempposy > -radi/8)) && ((tempposz < radi/8) && (tempposz > -radi/8))) {
			SendClientMessage(i, color, string);
		}
		else if (((tempposx < radi/4) && (tempposx > -radi/4)) && ((tempposy < radi/4) && (tempposy > -radi/4)) && ((tempposz < radi/4) && (tempposz > -radi/4))) {
			SendClientMessage(i, color, string);
		}
		else if (((tempposx < radi/2) && (tempposx > -radi/2)) && ((tempposy < radi/2) && (tempposy > -radi/2)) && ((tempposz < radi/2) && (tempposz > -radi/2))) {
			SendClientMessage(i, color, string);
		}
		else if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) {
			SendClientMessage(i, color, string);
		}
	}
	return 1;
}

stock PVP_OnPlayerText(playerid, text[])
{
    if(PVP_VerificarLogin[playerid] == false)
	{
		PVP_MensagemText(playerid, "~r~ERRO: ~w~Voce nao pode falar no chat.");
		return 0;
	}
	
	new MEGAString[1024];
	format(MEGAString, 1024, "%s(%i): %s", PVP_PlayerName(playerid), playerid, text);
	PVP_ProxDetector(15.0, playerid, MEGAString, 0xC0C0C0AA);
	return 0;
}







stock PVP_OnPlayerStateChange(playerid, newstate, oldstate)
{
	if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER) {
		PlayerTextDrawSetPreviewModel(playerid, PVP_Player_VeloArcade[playerid][15], GetVehicleModel(GetPlayerVehicleID(playerid)));
		for(new i; i < sizeof(PVP_Public_VeloArcade); i++) TextDrawShowForPlayer(playerid, PVP_Public_VeloArcade[i]);
	    for(new i; i < sizeof(PVP_Player_VeloArcade[]); i++) PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][i]);
	} else if(newstate == PLAYER_STATE_ONFOOT) {
		for(new i; i < sizeof(PVP_Public_VeloArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_VeloArcade[i]);
	    for(new i; i < sizeof(PVP_Player_VeloArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_VeloArcade[playerid][i]);
	}
	
	if(newstate == PLAYER_STATE_DRIVER) {
		SendClientMessage(playerid, -1, "INFO: Comandos veiculos, Farol: {C0C0C0}/Farol{FFFFFF}, Blindagem: {C0C0C0}/Blindar");
		SendClientMessage(playerid, -1, "INFO: Comandos veiculos, Salva posicao: {C0C0C0}/Sp{FFFFFF}, Trancar veiculo: {C0C0C0}/trancar");
		SendClientMessage(playerid, -1, "INFO: Comandos veiculos, Ativar neon: {C0C0C0}/Tunar{FFFFFF}");
		
		new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(GetPlayerVehicleID(playerid), engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(GetPlayerVehicleID(playerid), VEHICLE_PARAMS_ON, VEHICLE_PARAMS_ON, alarm, doors, bonnet, boot, objective);
	}
	return 1;
}

stock PVP_OnPlayerEnterCheckpoint(playerid)
{
    DisablePlayerCheckpoint(playerid);
	return 1;
}






















forward PVP_QuebrarText(playerid);
forward PVP_UmSegundo();







stock PVP_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	if(newkeys & KEY_YES) {
		if(!IsPlayerInAnyVehicle(playerid)) {
			PVP_PaginaInventario[playerid] = 1;
			for(new td = 0; td < sizeof(PVP_Public_Inventario); td++) TextDrawShowForPlayer(playerid, PVP_Public_Inventario[td]);
			PVP_AtualizarInventario(playerid);
			return 1;
		}
	}
    if(newkeys & KEY_WALK) {
		if(IsPlayerInRangeOfPoint(playerid, 3.0, 376.769409, -2073.585205, 7.851479)) {
			new MEGAString[9999], string[512];
			MEGAString[0] = EOS;
			
			strcat(MEGAString, "{ffffff}Arenas\t\t\t\tTipo\t\t\t\tPlayers:\n");
			
			format(string, sizeof(string), "{ffffff}[1] Arena AK (Mobile)\t{FF3937}Exclusivo\t{ffffff}0\n");
			strcat(MEGAString, string);
			 
			format(string, sizeof(string), "{ffffff}[2] Arenas M4\tLivre\t%i\n", PVP_PlayersM4_Cidade+PVP_PlayersM4_Delegacia);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{ffffff}[3] Arena AK\tLivre\t%i\n", PVP_PlayersAK);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{ffffff}[4] Arena Pistola\tLivre\t%i\n", PVP_PlayersDesert);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{ffffff}[5] Arena Pistola 2\tLivre\t%i\n", PVP_PlayersPT2);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{ffffff}[6] Arena Predio\tLivre\t%i\n", PVP_PlayersPredio);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{ffffff}[7] Arena Ammu\tLivre\t%i\n", PVP_PlayersAmmu);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{ffffff}[8] Arena Sniper\tLivre\t%i\n", PVP_PlayersSniper);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{ffffff}[9] Arena Combat Shot\tLivre\t%i\n", PVP_PlayersCombatS);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{ffffff}[10] Arena C-Bug (PC)\t{FF3937}Exclusiva\t{ffffff}0\n");
			strcat(MEGAString, string);
			
			ShowPlayerDialog(playerid, PVP_DIALOG_ARENAS, DIALOG_STYLE_TABLIST_HEADERS, "{ffffff}Arcade: Arenas do servidor: {84FF59}11", MEGAString, #Selecionar, #Voltar);
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid, 3.0, 381.341522, -2074.084472, 7.835937)) {
			for(new i = 0; i < sizeof(PVP_Public_LojaArcade); i++) TextDrawShowForPlayer(playerid, PVP_Public_LojaArcade[i]);
			
			new ztr[256];
			format(ztr, 256, "%d", PVP_info[playerid][PVP_Coins]);
			PlayerTextDrawSetString(playerid, PVP_Player_LojaArcade[playerid][0], ztr);
			PlayerTextDrawShow(playerid, PVP_Player_LojaArcade[playerid][0]);
			
			PlayerTextDrawShow(playerid, PVP_Player_LojaArcade[playerid][1]);
			SelectTextDraw(playerid, -1);
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid, 3.0, 387.041809, -2073.399902, 8.351479)) {
			new MEGAString[9999], string[512];
			MEGAString[0] = EOS;
			
			strcat(MEGAString, "{ffffff}Mundo\t\t\t\t\t\t\t\t\t\tPlayers\n");
			
			format(string, sizeof(string), "{00ff00}[1] {ffffff}Fugas:\t\t\t\t{ffffff}%i\n", PVP_Players_MundoFuga);
			strcat(MEGAString, string);
			 
			format(string, sizeof(string), "{ff0000}[2] {ffffff}MataMata:\t\t\t%i\n", PVP_Players_MundoMataMata);
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{0098ff}[3] {ffffff}Policia e Ladrao:\t\t\t\t0\n");
			strcat(MEGAString, string);
			
			format(string, sizeof(string), "{9800ff}[4] {ffffff}Mundo Particular\n");
			strcat(MEGAString, string);
			
			ShowPlayerDialog(playerid, PVP_DIALOG_MUNDOS, DIALOG_STYLE_TABLIST_HEADERS, "{ffffff}Arcade: Mundos", MEGAString, #Selecionar, #Cancelar);
			return 1;
		}
		
		if(IsPlayerInRangeOfPoint(playerid, 3.0, 326.061920, -1783.760620, 4.397773)) {
			if(PVP_MundoPlayer[playerid] == 1) {
				PVP_Corrida_Escolheu[playerid] = 1;
				
				new MEGAString[4000]; MEGAString[0] = EOS;
				strcat(MEGAString, "{ffffff}Coloque o nome do veiculo que voce deseja iniciar essa corrida\n"); 
				strcat(MEGAString, "{ffffff}Lembrando, para terminar essa corrida, voce devera\n");
				strcat(MEGAString, "{ffffff}pegar todos os checkpoints. No final da corrida iremos\n");
				strcat(MEGAString, "{ffffff}divulgar quanto tempo voce demorou para terminar essa corrida.");
				ShowPlayerDialog(playerid, PVP_DIALOG_PEGAR_CARRO_ILEGAL, DIALOG_STYLE_INPUT, "{050072}Corridas Ilegais:", MEGAString, "Iniciar", "Cancelar");
				return 1;
			}
		}
    }
	return 1;
}

stock PVP_OnPlayerSpawn(playerid)
{
    if(PVP_VerificarLogin[playerid] == false)
    {
        Kick(playerid);
    }
    
    format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(playerid));
    SetPlayerSkin(playerid, dini_Int(PVP_arquivo, "Skin"));
    
    for(new i; i < sizeof(PVP_Public_LogoArcade); i++) TextDrawShowForPlayer(playerid, PVP_Public_LogoArcade[i]);
    
    for(new i; i < sizeof(PVP_Public_Rodape); i++) TextDrawShowForPlayer(playerid, PVP_Public_Rodape[i]);
    for(new i; i < sizeof(PVP_Player_Rodape[]); i++) PlayerTextDrawShow(playerid, PVP_Player_Rodape[playerid][i]);
    
    if(PVP_MundoPlayer[playerid] == 1) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
		PVP_SetVW(playerid, 1);
		SetPlayerPos(playerid, 1221.010864, -1413.564453, 13.322548);
		SetPlayerFacingAngle(playerid, 359.798248);
		return 1;
    }
    if(PVP_MundoPlayer[playerid] == 2) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 31, 500);
		PVP_SetVW(playerid, 2);
		new r = random(sizeof(PVP_Spawns_MataMata));
		SetPlayerPos(playerid, PVP_Spawns_MataMata[r][0], PVP_Spawns_MataMata[r][1], PVP_Spawns_MataMata[r][2]);
		SetPlayerFacingAngle(playerid, PVP_Spawns_MataMata[r][3]);
		return 1;
    }
    
    PVP_SetVW(playerid, 0);
    if(PVP_ArenaPlayer[playerid] == 3) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 30, 500);
	
		new r = random(sizeof(PVP_SpawnsM4_Delegacia));
		SetPlayerPos(playerid, PVP_SpawnsM4_Delegacia[r][0], PVP_SpawnsM4_Delegacia[r][1], PVP_SpawnsM4_Delegacia[r][2]);
		SetPlayerFacingAngle(playerid, PVP_SpawnsM4_Delegacia[r][3]);
		SetPlayerInterior(playerid, 3);
		PVP_SetVW(playerid, 98);
		return 1;
    }
    if(PVP_ArenaPlayer[playerid] == 4) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 24, 500);

		SetPlayerPos(playerid, -2074.236816, -2526.435302, 31.066806);
		SetPlayerFacingAngle(playerid, 163.257797);
		return 1;
    }
    if(PVP_ArenaPlayer[playerid] == 5) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 24, 500);
	
		new r = random(sizeof(PVP_SpawnsPT2));
		SetPlayerPos(playerid, PVP_SpawnsPT2[r][0], PVP_SpawnsPT2[r][1], PVP_SpawnsPT2[r][2]);
		SetPlayerFacingAngle(playerid, PVP_SpawnsPT2[r][3]);
		return 1;
    }
    if(PVP_ArenaPlayer[playerid] == 6) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 24, 500);
	
		new r = random(sizeof(PVP_SpawnsPredio));
		SetPlayerPos(playerid, PVP_SpawnsPredio[r][0], PVP_SpawnsPredio[r][1], PVP_SpawnsPredio[r][2]);
		SetPlayerFacingAngle(playerid, PVP_SpawnsPredio[r][3]);
		return 1;
    } 
    if(PVP_ArenaPlayer[playerid] == 7) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 24, 500);
	
		new r = random(sizeof(PVP_SpawnsAmmu));
		SetPlayerPos(playerid, PVP_SpawnsAmmu[r][0], PVP_SpawnsAmmu[r][1], PVP_SpawnsAmmu[r][2]);
		SetPlayerFacingAngle(playerid, PVP_SpawnsAmmu[r][3]);
		return 1;
    } 
    if(PVP_ArenaPlayer[playerid] == 8) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 34, 500);
	
		new r = random(sizeof(PVP_SpawnsSniper));
		SetPlayerPos(playerid, PVP_SpawnsSniper[r][0], PVP_SpawnsSniper[r][1], PVP_SpawnsSniper[r][2]);
		SetPlayerFacingAngle(playerid, PVP_SpawnsSniper[r][3]);
		return 1;
    } 
    if(PVP_ArenaPlayer[playerid] == 9) {
	    SetPlayerArmour(playerid, 100.0);
		SetPlayerHealth(playerid, 100.0);
		ResetPlayerWeapons(playerid);
	    GivePlayerWeapon(playerid, 27, 500);
	
