			    if(PROF[i] > -1)
			    {
				    PlayerTextDrawSetString(i, MsgText[i], "~y~PATIO ~w~DO DETRAN");
				    PlayerTextDrawShow(i, MsgText[i]);
				}
			}
			else if(IsPlayerInRangeOfPoint(i, 50.0, -154.6521,141.0004,3.9754))
			{
			    if(PROF[i] == LENHADOR)
			    {
				    new StringArv[70]; format(StringArv, sizeof(StringArv), "~g~Florestamento ~w~Ja foram derrubadas ~g~%d ~w~arvores", DOF2_GetInt("Arvores.ini", "Quantidade"));
    				PlayerTextDrawSetString(i, MsgText[i], StringArv);
				    PlayerTextDrawShow(i, MsgText[i]);
				}
			}
			else
			{
				new bool:HideText;
				for(new po; po < 38; po++)
				{
				    if(IsPlayerInRangeOfPoint(i, AreasPosto[po][3], AreasPosto[po][0], AreasPosto[po][1], AreasPosto[po][2]))
				    {
					    new zone[MAX_ZONE_NAME], nomeposto[70]; GetPlayer2DZone(i, zone, MAX_ZONE_NAME);
						format(nomeposto, sizeof(nomeposto), "~b~POSTO ~w~DE ~y~%s ~w~- ~g~~h~/ABASTECER", zone);
      					PlayerTextDrawSetString(i, MsgText[i], nomeposto);
		    			PlayerTextDrawShow(i, MsgText[i]);
		    			HideText = true;
		    			break;
					}
				}
    			if(HideText == false)
				{
  		    		PlayerTextDrawHide(i, MsgText[i]);
				    /*if(!IsPlayerInRangeOfPoint(i, 150.0, -154.6521,141.0004,3.9754))
				    {
					    if(IsPlayerAttachedObjectSlotUsed(i, 6))
		   				{
							RemovePlayerAttachedObject(i, 6);
							ClearAnimations(i, 6);
						}
					}*/
				}
			}
		}
		if(SegundosComecar[i] > 0)
		{
            SegundosComecar[i] --;
			if(SegundosComecar[i] <= 0)
			{
		    	MsgAviso(i, 120, "~w~Siga_o_ponto_vermelho_marcado_no_mapa_para_comecar");
		    	SetCameraBehindPlayer(i);
		    	CheckPrimeiroPasso[i] = CreateDynamicCP(481.0389,-1771.5531,18.7958, 1.5, -1, -1, i, 1000.0);//AGENCIA
			}
		}
	}
	//
 	new HoraRoYal, MinutoRoYal, SegundoRoYal;
	gettime(HoraRoYal, MinutoRoYal, SegundoRoYal);
 	switch(HoraRoYal)
	{
		case 0: SetWorldTime(0);
	 	case 1: SetWorldTime(0);
	  	case 2: SetWorldTime(1);
	   	case 3: SetWorldTime(2);
	    case 4: SetWorldTime(4);
	    case 5: SetWorldTime(5);
	    case 6: SetWorldTime(6);
	    case 7: SetWorldTime(7);
	    case 8: SetWorldTime(8);
	    case 9: SetWorldTime(9);
	    case 10: SetWorldTime(10);
	    case 11: SetWorldTime(11);
	    case 12: SetWorldTime(12);
	    case 13: SetWorldTime(13);
	    case 14: SetWorldTime(14);
	    case 15: SetWorldTime(15);
	    case 16: SetWorldTime(16);
	    case 17: SetWorldTime(20);
	    case 18: SetWorldTime(21);
	    case 19: SetWorldTime(22);
	    case 20: SetWorldTime(22);
	    case 21: SetWorldTime(23);
	    case 22: SetWorldTime(23);
	    case 23: SetWorldTime(23);
    }
	return 1;
}

forward CarregarArvore(playerid);
public CarregarArvore(playerid)
{
	if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 478 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
        DestroyDynamicCP(CheckArvore[playerid]);
        DestroyDynamicObject(Arvore[playerid]);
        CheckArvore[playerid] = -1;
        TogglePlayerControllable(playerid, 1);
        Arvore[playerid] = CreateDynamicObject(837, -999.0, -826.0, -739.0, 0.0, 0.0, 0.0);
        AttachDynamicObjectToVehicle(Arvore[playerid], GetPlayerVehicleID(playerid), 0.0000, -0.5000, 0.8500, -101.0000, 60.0000, 150.0000);
        Streamer_Update(playerid);
        SetPlayerRaceCheckpoint(playerid, 2, -510.9023,-84.5538,62.1558, -510.9023,-84.5538,62.1558, 5.0);
        SendClientMessage(playerid, GetPlayerColor(playerid), "| LENHADOR | Um checkpoint vermelho foi marcado no seu mapa, siga-o para entregar essa lenha");
	}
	else
	{
	    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao estava no veiculo de lenhador e seu carregamento foi cancelado");
	}
	return 1;
}

forward Socorrer(playerid);
public Socorrer(playerid)
{
    if(SegurandoMao[playerid] == KITMEDICO)
	{
	    SegurandoMao[playerid] = 0; RemovePlayerAttachedObject(playerid, 5);
		if(CheckSAMU[playerid] > -1)
		{
			DestroyDynamicCP(CheckSAMU[playerid]);
		    CheckSAMU[playerid] = -1;
		}
		new valor1 = MinutosMorte[Localizando[playerid]] * 600;
		new valor2 = SegundosMorte[Localizando[playerid]] * 10;
		new valortotal = valor1 + valor2;
		if(valortotal > 4000)
		{
		    valortotal = 4000;
		}
		if(MatouPlayer[playerid] == Localizando[playerid] || (gettime() - FoiSocorrido[Localizando[playerid]]) <= 600)
		{
		    valortotal = 0;
		}
		Money[playerid] += valortotal;
		format(String, sizeof(String), "| SAMU | Voce socorreu o(a) jogador(a) {FF69B4}%s[%d] {FFFFFF}e recebeu {228B22}$%d", PlayerName(Localizando[playerid]), Localizando[playerid], valortotal);
		SendClientMessage(playerid, -1, String);
		SegundosMorte[Localizando[playerid]] = 0; MinutosMorte[Localizando[playerid]] = 0;
		if(SangueObjeto[Localizando[playerid]] > -1)
		{
			DestroyObject(SangueObjeto[Localizando[playerid]]);
			SangueObjeto[Localizando[playerid]] = -1;
		}
	    ApplyAnimation(Localizando[playerid], "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
		format(String, sizeof(String), "| SAMU | O(A) Socorrista do SAMU %s[%d] te socorreu a tempo e voce ja esta bem!", PlayerName(playerid), playerid);
		SendClientMessage(Localizando[playerid], GetPlayerColor(playerid), String);
		if(SEDE[Localizando[playerid]] <= 0)
		{
			SEDE[Localizando[playerid]] = 759;
		}
		if(FOME[Localizando[playerid]] <= 0)
		{
			FOME[Localizando[playerid]] = 831;
		}
		TextDrawHideForPlayer(Localizando[playerid], TextConnect[2]);
		SetPlayerHealth(Localizando[playerid], 10.0);
		FoiSocorrido[Localizando[playerid]] = gettime();
		Localizando[playerid] = -1;
	}
	else
	{
	    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta segurando um Kit Medico");
	}
	return 1;
}

forward ReparandoRadar(playerid);
public ReparandoRadar(playerid)
{
    PassouRadar[playerid] = 5;
    if(RadarQuebrado[IndoRadar[playerid]] == true)
    {
		format(String, sizeof(String), "{FF0000}RADAR\n{FFFFFF}Velocidade maxima permitida: \n{FFFF00}%dKm/h", VelocidadeRadar[IndoRadar[playerid]]);
		UpdateDynamic3DTextLabelText(InfoRadar[IndoRadar[playerid]], -1, String);
		RadarQuebrado[IndoRadar[playerid]] = false;
		new Valor = 800 + random(801); Money[playerid] += Valor;
		format(String, sizeof(String), "| RADAR | Voce reparou esse radar e recebeu {228B22}$%d", Valor);
		SendClientMessage(playerid, -1, String);
		GameTextForPlayer(playerid, "~g~RADAR REPARADO!", 2500, 4);
	}
	else
	{
	    SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse radar ja foi reparado, siga para o proximo");
	}
	TogglePlayerControllable(playerid, 1);
    new r = random(20);
	if(RadarQuebrado[r] == false)
	{
 		RadarQuebrado[r] = true;
	}
	IndoRadar[playerid] = r;
	format(String, sizeof(String), "{FF0000}RADAR QUEBRADO\n{FFFFFF}Aguardando manutencao...");
	UpdateDynamic3DTextLabelText(InfoRadar[IndoRadar[playerid]], -1, String);
	SendClientMessage(playerid, GetPlayerColor(playerid), "| DNIT | Siga o proximo checkpoint para reparar o radar");
	new Float:X, Float:Y, Float:Z; GetDynamicObjectPos(Radar[IndoRadar[playerid]], X, Y, Z);
	SetPlayerRaceCheckpoint(playerid, 2, X, Y, Z, X, Y, Z, 3.0);
	return 1;
}

forward Consertando(playerid);
public Consertando(playerid)
{
	if(ConsertandoVeiculo[playerid] < 100)
	{
	    ConsertandoVeiculo[playerid] ++;
	    new Float:Vida, Float:X, Float:Y, Float:Z; GetVehicleHealth(ConsertandoV[playerid], Vida); GetVehiclePos(ConsertandoV[playerid], X, Y, Z);
	    if(IsPlayerInRangeOfPoint(playerid, 10.0, X, Y, Z))
		{
			if(Vida < 1000.0)
			{
				Vida += Sub[playerid];
				SetVehicleHealth(ConsertandoV[playerid], Vida);
			}
			new StrT[70]; format(StrT, sizeof(StrT), "~w~Consertando ~y~%s_~w~( %d%s )", NomeVeiculo(ConsertandoV[playerid]), ConsertandoVeiculo[playerid], "%");
		 	PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], StrT);
		    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], ConsertandoVeiculo[playerid]);
		   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
			TempoConserto[playerid] = SetTimerEx("Consertando", random(100)+random(300), false, "i", playerid);
		}
		else
		{
      		ConsertandoVeiculo[playerid] = -1;
		   	ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
		   	TogglePlayerControllable(playerid, 1);
		    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
		    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
		    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta proximo do veiculo que estava consertando");
		}
	}
	else
	{
     	ConsertandoVeiculo[playerid] = -1;
	    ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
	    TogglePlayerControllable(playerid, 1);
	    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
	    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
      	new Float:X, Float:Y, Float:Z; GetVehiclePos(ConsertandoV[playerid], X, Y, Z);
		if(IsPlayerInRangeOfPoint(playerid, 10.0, X, Y, Z))
		{
	     	RepairVehicle(ConsertandoV[playerid]);
	     	foreach(Player, i)
	     	{
	     		if(OfereceuReparo[i] == playerid && PROF[playerid] == MECANICO)
	     		{
	     			Money[playerid] += ValorReparo[i];
	     			format(String, sizeof(String), "| MECANICO | Voce terminou o reparo e recebeu {228B22}$%d", ValorReparo[i]);
	     			OfereceuReparo[i] = -1;
					ValorReparo[i] = 0;
	     			return SendClientMessage(playerid, -1, String);
	     		}
   			}
   			if(PROF[playerid] == MECANICO)
   			{
		     	new ReceberMoney = 500 + random(501);
		     	Money[playerid] += ReceberMoney;
		     	format(String, sizeof(String), "| MECANICO | Voce recebeu {228B22}$%d {FFFFFF}por reparar esse veiculo", ReceberMoney);
		     	return SendClientMessage(playerid, -1, String);
			}
		}
		else
		{
			return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta proximo do veiculo que estava consertando");
		}
	}
	return 1;
}

forward FinalizarAssalto(playerid);
public FinalizarAssalto(playerid)
{
	if(PRODUZINDOARMA[playerid] < 100)
	{
	    PRODUZINDOARMA[playerid] ++;
		new StrT[25]; format(StrT, sizeof(StrT), "Roubando_dinheiro:_%d%", PRODUZINDOARMA[playerid]);
	 	PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], StrT);
	    SetPlayerProgressBarValue(playerid, barfabarmas[playerid], PRODUZINDOARMA[playerid]);
	   	ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
		TempoProducaoArma[playerid] = SetTimerEx("FinalizarAssalto", 100, false, "i", playerid);
	}
	else
	{
	    PRODUZINDOARMA[playerid] = -1;
	    ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0, 1);
	    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
	    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
		//
		new Float:C[3];
	 	for(new a; a < 5; a++)
		{
			GetDynamicObjectPos(ObjetoCofre[a], C[0], C[1], C[2]);
			if(IsPlayerInRangeOfPoint(playerid, 1.0, C[0], C[1], C[2]))
			{
	  			if(ValorCofre[a] > 0)
				{
				    DinheiroSujo[playerid] += ValorCofre[a];
				    new StrA[15];
		            format(StrA, sizeof(StrA), "~w~DINHEIRO SUJO+ ~g~$%d", ValorCofre[a]);
					GameTextForPlayer(playerid, StrA, 3000, 3);
					format(String, sizeof(String), "| ASSALTO | Voce levou todo o dinheiro que tinha nesse cofre ( {088A08}$%d {FFFFFF})", ValorCofre[a]);
					SendClientMessage(playerid, -1, String);
				    GameTextForPlayer(playerid, "~r~Assalto Efetuado!", 4000, 4);
				    //
				    CofreFavela += ValorCofre[a] * 10 / 100;
					new ValorNaMsg[11]; format(ValorNaMsg, sizeof(ValorNaMsg), "%d", CofreFavela);
					format(String, sizeof(String), "{FFFFFF}Dinheiro Sujo\n{00FF00}$%s\nUse /Sacar", AttNumeroDecimal(ValorNaMsg));
				 	UpdateDynamic3DTextLabelText(TextFavela, -1, String);
					//
					ValorCofre[a] = -1;
	    			UpdateDynamic3DTextLabelText(TextoCofre[a], -1, "{FFFFFF}Cofre");
				    DestroyDynamicObject(ObjetoCofre[a]);
				    ObjetoCofre[a] = CreateDynamicObject(2003, C[0], C[1]-0.5, C[2], 0.000000, 0.000000, 180.000000, -1, -1, -1, 300.00, 300.00);
					Streamer_Update(playerid);
					return 1;
				}
				else
				{
				    SendClientMessage(playerid, COR_ERRO, "| ASSALTO | Esse cofre nao tem mais dinheiro");
				 	GameTextForPlayer(playerid, "~r~Assalto Fracassado!", 4000, 4);
				 	return 1;
				}
			}
		}
		SendClientMessage(playerid, COR_ERRO, "| ASSALTO | Voce ficou muito longe do cofre");
	 	GameTextForPlayer(playerid, "~r~Assalto Fracassado!", 4000, 4);
	 	return 1;
	}
	return 1;
}

forward FlashFotoSair(playerid);
