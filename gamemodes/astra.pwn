	else if(TirandoCNH[playerid][5] == 9)
	{
	    TirandoCNH[playerid][5] = 0;
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	    SetPlayerPos(playerid, -2030.6437,-117.3409,1035.1719);
	    SetPlayerInterior(playerid, 3);
	    SetCameraBehindPlayer(playerid);
	    DisablePlayerRaceCheckpoint(playerid);
	    new Float:Vida; GetVehicleHealth(VeiculoCNH[playerid], Vida);
	    if(VeiculoCNH[playerid] > 0)
	    {
	        DestroyVehicleC(VeiculoCNH[playerid]);
            VeiculoCNH[playerid] = 0;
	    }
	    if(Vida >= 900.0)
	    {
	        HabilitacaoF[playerid] = 0;
	        GameTextForPlayer(playerid, "~b~~h~Aprovado!", 3000, 1);
	        SendClientMessage(playerid, 0x2F4F4FFF, "| AUTO ESCOLA | Voce conquistou sua Habilitacao de Helicoptero com sucesso!");
	    }
	    else
	    {
			SendClientMessage(playerid, 0x2F4F4FFF, "| AUTO ESCOLA | Voce danificou seu veiculo na prova pratica e foi reprovado(a)!");
			GameTextForPlayer(playerid, "~r~~h~Reprovado!", 3000, 1);
	    }
	}
	else if(TirandoCNH[playerid][6] == 1)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 892.0067,-2270.8499,107.5031, 392.6049,-1948.4039,92.6422, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 2)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 392.6049,-1948.4039,92.6422, 187.0630,-1575.5107,94.2727, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 3)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 187.0630,-1575.5107,94.2727, 715.0618,-1166.3618,109.7842, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 4)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 715.0618,-1166.3618,109.7842, 1128.5504,-1125.8087,115.1214, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 5)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 1128.5504,-1125.8087,115.1214, 1525.9651,-1172.8975,104.5368, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 6)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 1525.9651,-1172.8975,104.5368, 2398.0063,-1269.6531,117.0654, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 7)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 2398.0063,-1269.6531,117.0654, 2831.7195,-2059.7483,78.8078, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 8)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 2831.7195,-2059.7483,78.8078, 1971.2841,-2594.9583,56.6678, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 9)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 3, 1971.2841,-2594.9583,56.6678, 1453.7853,-2593.3152,14.0062, 5.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 10)
	{
	    TirandoCNH[playerid][6] ++;
	    SetPlayerRaceCheckpoint(playerid, 4, 1453.7853,-2593.3152,14.0062, 1453.7853,-2593.3152,14.0062, 8.0);
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	}
	else if(TirandoCNH[playerid][6] == 11)
	{
        TirandoCNH[playerid][6] = 0;
	    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
	    SetPlayerPos(playerid, -2030.6437,-117.3409,1035.1719);
	    SetPlayerInterior(playerid, 3);
	    SetCameraBehindPlayer(playerid);
	    DisablePlayerRaceCheckpoint(playerid);
	    new Float:Vida; GetVehicleHealth(VeiculoCNH[playerid], Vida);
	    if(VeiculoCNH[playerid] > 0)
	    {
	        DestroyVehicleC(VeiculoCNH[playerid]);
            VeiculoCNH[playerid] = 0;
	    }
	    if(Vida >= 900.0)
	    {
	        HabilitacaoG[playerid] = 0;
	        GameTextForPlayer(playerid, "~b~~h~Aprovado!", 3000, 1);
	        SendClientMessage(playerid, 0x2F4F4FFF, "| AUTO ESCOLA | Voce conquistou sua Habilitacao de Aviao com sucesso!");
	    }
	    else
	    {
			SendClientMessage(playerid, 0x2F4F4FFF, "| AUTO ESCOLA | Voce danificou seu veiculo na prova pratica e foi reprovado(a)!");
			GameTextForPlayer(playerid, "~r~~h~Reprovado!", 3000, 1);
	    }
	}
	else if(PlayerPontoCorrida[playerid] >= 0)
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
		    if((PlayerPontoCorrida[playerid] + 1) < PontoCorrida[NaCorrida[playerid]])
		    {
			    PlayerPontoCorrida[playerid] ++;
			    DestroyDynamicMapIcon(MapIconCorrida[playerid]);
			    PlayerPlaySound(playerid, 1057, 0.0, 0.0, 10.0);
			    if((PlayerPontoCorrida[playerid] + 1) < PontoCorrida[NaCorrida[playerid]])
			    {
					SetPlayerRaceCheckpoint(playerid, 0, CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][0], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][1], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][2], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]+1][0], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]+1][1], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]+1][2], 5.0);
					MapIconCorrida[playerid] = CreateDynamicMapIcon(CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]+1][0], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]+1][1], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]+1][2], 0, 0xFF0000FF, -1, -1, playerid, 1000.0);
				}
				else
				{
				    SetPlayerRaceCheckpoint(playerid, 1, CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][0], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][1], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][2], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][0], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][1], CordCorrida[NaCorrida[playerid]][PlayerPontoCorrida[playerid]][2], 5.0);
				}
			}
			else
			{
			    new StrC[128];
			    format(StrC, sizeof(StrC), "| CORRIDA | O(A) Jogador(a) %s[%d] venceu a corrida!", PlayerName(playerid), playerid);
				foreach(Player, i)
				{
				    if(IsPlayerConnected(i) && Spawnado[i] == true && NaCorrida[i] == NaCorrida[playerid])
				    {
				        if(playerid != i)
				        {
				            GameTextForPlayer(i, "~r~Corrida Fracassada", 3000, 1);
				            DisablePlayerRaceCheckpoint(i);
				            if(IsValidDynamicMapIcon(MapIconCorrida[i]))
				            {
	               				DestroyDynamicMapIcon(MapIconCorrida[i]);
							}
							NaCorrida[i] = -1;
				        	PlayerPontoCorrida[i] = -1;
				        }
				        SendClientMessage(i, 0x8904B1FF, StrC);
				    }
				}
				format(String, sizeof(String), "| INFO | Voce venceu a corrida e recebeu {088A08}$%d", PremiacaoCorrida[NaCorrida[playerid]]);
				SendClientMessage(playerid, -1, String);
				Money[playerid] += PremiacaoCorrida[NaCorrida[playerid]];
				PremiacaoCorrida[NaCorrida[playerid]] = 0;
				NaCorrida[playerid] = -1;
				GameTextForPlayer(playerid, "~B~CAMPEAO", 3000, 0);
				DisablePlayerRaceCheckpoint(playerid);
				PlayerPontoCorrida[playerid] = -1;
				NaCorrida[playerid] = -1;
			}
		}
	}
	return 1;
}

