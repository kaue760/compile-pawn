forward xTLoopRoubo(playerid,xCofre,xTipo);
public xTLoopRoubo(playerid,xCofre,xTipo){
	new xTstring[128];
	if(xTipo == 0){
		if(cT_AddRoubCofre[playerid] >= 30){
		    cT_AddRoubCofre[playerid] = 0;
		    KillTimer(cT_xTKillROUBcOF[playerid]);
	        ClearAnimations(playerid,1);
	        cT_xTKillROUBcOF[playerid] = SetTimerEx("xTLoopRoubo", 1000, true,"iii",playerid,xCofre,1);
	        return SendClientMessage(playerid, 0xFFFFFFFF, "Dinamite foi plantada!");
		}
		if(!IsPlayerInRangeOfPoint(playerid,3.0,Cr_PosCofres[xCofre][0],Cr_PosCofres[xCofre][1],Cr_PosCofres[xCofre][2])){
			cT_AddRoubCofre[playerid] = 0;
		    KillTimer(cT_xTKillROUBcOF[playerid]);
		    ClearAnimations(playerid,1);
		    return SendClientMessage(playerid, 0xFF0000FF, "Voc� afastou de perto do Cofre!");
		}
		format(xTstring, sizeof (xTstring), "~n~~n~~n~~n~~n~Dinamite~n~~r~%i~w~/~g~30",cT_AddRoubCofre[playerid]);
	}else if(xTipo == 1){
		if(cT_AddRoubCofre[playerid] >= 50){
		    cT_AddRoubCofre[playerid] = 0;
		    KillTimer(cT_xTKillROUBcOF[playerid]);
	        ClearAnimations(playerid,1);
	        Cr_StCofres[xCofre] = 1;
	        SetTimerEx("Cr_RepCofre", 1000*60*5, false,"i",xCofre);
			DestroyDynamicObject(Cr_pObjCofre[xCofre]);
			Cr_pObjCofre[xCofre] = CreateDynamicObject(1829, Cr_PosCofres[xCofre][0], Cr_PosCofres[xCofre][1], Cr_PosCofres[xCofre][2]-0.55, 0.0, 0.0, Cr_PosCofres[xCofre][3]-180.0);
			CreateExplosion(Cr_PosCofres[xCofre][0], Cr_PosCofres[xCofre][1], Cr_PosCofres[xCofre][2]-0.55, 4, 10.0); //1
			format(xTstring, sizeof(xTstring), "Cofre\n{FFFFFF}/cofre\n{FF0000}Explodido");
			UpdateDynamic3DTextLabelText(Cr_TxtLbcofre[xCofre], 0xFF0000FF, xTstring);
	        return SendClientMessage(playerid, 0xFFFFFFFF, "Cofre foi explodido!");
		}
		format(xTstring, sizeof (xTstring), "~n~~n~~n~~n~~n~Explosao~n~~r~%i~w~/~g~50",cT_AddRoubCofre[playerid]);
	}else if(xTipo == 2){
		if(cT_AddRoubCofre[playerid] >= 50){
		    cT_AddRoubCofre[playerid] = 0;
		    KillTimer(cT_xTKillROUBcOF[playerid]);
	        ClearAnimations(playerid,1);
	        Cr_RepCofre(xCofre);
	        return SendClientMessage(playerid, 0xFFFFFFFF, "Cofre foi Reparado!");
		}
		format(xTstring, sizeof (xTstring), "~n~~n~~n~~n~~n~Reparando~n~~r~%i~w~/~g~50",cT_AddRoubCofre[playerid]);
	}
	GameTextForPlayer(playerid,xTstring,1000,5);
    cT_AddRoubCofre[playerid]++;
	return 1;
}
