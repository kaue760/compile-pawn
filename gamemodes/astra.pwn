stock VerifyExpiredDays(days)
	return (days) < gettime();

stock ConvertToDays(n)
{
	new t[5];
 	t[4] = n-gettime();
	t[0] = t[4] / 3600;
	t[1] = ((t[4] / 60) - (t[0] * 60));
	t[2] = (t[4] - ((t[0] * 3600) + (t[1] * 60)));
	t[3] = (t[0]/24);

	if(t[3] > 0)
	t[0] = t[0] % 24,
	format(String, sizeof(String), "%d dia(s) %dh %dm %ds", t[3], t[0], t[1], t[2]);
	else if(t[0] > 0)
	format(String, sizeof(String), "%dh %dm %ds", t[0], t[1], t[2]);
	else
	format(String, sizeof(String), "%dm %ds", t[1], t[2]);
	return String;
}

stock UltimoLogin(n)
{
    new t[5], msg[30];
 	t[4] = gettime()-n;
	t[0] = t[4] / 3600;
	t[1] = ((t[4] / 60) - (t[0] * 60));
	t[2] = (t[4] - ((t[0] * 3600) + (t[1] * 60)));
	t[3] = (t[0]/24);

	if(t[3] > 0)
	t[0] = t[0] % 24,
	format(msg, sizeof(msg), "%d dia(s) e %d hora(s)", t[3], t[0]);
	else if(t[0] > 0)
	format(msg, sizeof(msg), "%d hora(s) e %d minuto(s)", t[0], t[1]);
	else
	format(msg, sizeof(msg), "%d minuto(s)", t[1]);
	return msg;
}forward tQ_AntiCar();
public tQ_AntiCar(){
    for (new i = 0; i < rC_MaxVehcl; i++)
        if(rC_AntiCar[i] == 0 && GetVehicleModel(i) != 0)
            DestroyVehicle(i);
	return 1;
}

stock ConvertTimeAdm(playerid)
{
    new t[5], msg[30];
 	t[4] = 126000-SegundosSalarioAdmin[playerid];
	t[0] = t[4] / 3600;
	t[1] = ((t[4] / 60) - (t[0] * 60));
	t[2] = (t[4] - ((t[0] * 3600) + (t[1] * 60)));
	t[3] = (t[0]/24);

	if(t[3] > 0)
	t[0] = t[0] % 24,
	format(msg, sizeof(msg), "%d dia(s) e %d hora(s)", t[3], t[0]);
	else if(t[0] > 0)
	format(msg, sizeof(msg), "%d hora(s) e %d minuto(s)", t[0], t[1]);
	else
	format(msg, sizeof(msg), "%d minuto(s)", t[1]);
	return msg;
}

stock FileLog(const file[], const string[])
{
    new Hora, Minuto; gettime(Hora, Minuto);
	new Dia, Mes, Ano; getdate(Dia, Mes, Ano);
    new timestr[32], data[180], File:hFile, thefile[32];
    format(timestr,32,"%02d/%02d/%02d - %02d:%02d ",Ano, Mes, Dia, Hora, Minuto);
    format(data, sizeof(data), "%s%s\r\n",timestr,string);
    format(thefile, sizeof(thefile), "Logs/%s.log", file);
    hFile = fopen(thefile, io_append);
    fwrite(hFile, data);
    fclose(hFile);
    return 1;
}

