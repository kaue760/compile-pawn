				TextoCasa[c] = CreateDynamic3DTextLabel(StringG, -1, cX[c], cY[c], cZ[c], 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0);
			}
