public OnGameModeExit()
{
    for(new i = 0; i < Cof_MaxCofres; i++){
    	DestroyDynamicObject(Cr_pObjCofre[i]);
    	DestroyDynamic3DTextLabel(Cr_TxtLbcofre[i]);
    	Cr_Save_Cofre(i);
    }
    DOF2_Exit();
	sdados();
    DOF2_Exit();
	return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
    TogglePlayerSpectating(playerid, 1);
    SetPlayerVirtualWorld(playerid, -555);
    InterpolateCameraPos(playerid, -259.148712, 2673.008056, 67.044456, -314.974761, 2735.550048, 66.667938, 60000);
	InterpolateCameraLookAt(playerid, -263.189605, 2675.919433, 66.602264, -317.987152, 2739.540771, 66.664260, 60000);
    for(new t = 1; t < 4; t++)
   	{
        TextDrawHideForPlayer(playerid, TextConnect[t]);
    }
	format(String, sizeof(String), "BansPermanentes/%s.ini", PlayerName(playerid));
	if(DOF2_FileExists(String))
	{
		new StrInfo[350];
		SendClientMessage(playerid, -1, "| INFO | Sua conta esta banida!");
		format(StrInfo, sizeof(StrInfo), "\n{FFFFFF}Sua conta esta banida do servidor!\n\n{FF7256}Conta: {FFFFFF}%s\n{FF7256}Admin Responsavel: {FFFFFF}%s\n{FF7256}Data: {FFFFFF}%s\n{FF7256}IP: {FFFFFF}%s\n{FF7256}Motivo: {FFFFFF}%s\n\n{FFFFFF}Em caso de revisao, acesse nosso forum:\n{4682B4}forum.Santa Group .com", PlayerName(playerid), DOF2_GetString(String, "AdminResponsavel"), DOF2_GetString(String, "Data"), DOF2_GetString(String, "IP"), DOF2_GetString(String, "Motivo"));
		ShowPlayerDialog(playerid, 555, DIALOG_STYLE_MSGBOX, "{FF0000}Banido", StrInfo, "Fechar", "");
		SetTimerEx("Kickar" , 150 , false, "i" , playerid);
		return 1;
	}
	
	format(String, sizeof(String), "IpsBanidos/%s.ini", GetIP(playerid));
    if(DOF2_FileExists(String))
    {
        new StrInfo[350];
		SendClientMessage(playerid, -1, "| INFO | Seu IP esta banido!");
        format(StrInfo, sizeof(StrInfo), "\n{FFFFFF}Seu IP %s esta banido do servidor!\n\n{FF7256}Admin Responsavel: {FFFFFF}%s\n{FF7256}Data: {FFFFFF}%s\n{FF7256}Conta: {FFFFFF}%s\n{FF7256}Motivo: {FFFFFF}%s\n\n{FFFFFF}Em caso de revisao, acesse nosso forum:\n{4682B4}forum.Santa Group .com", GetIP(playerid), DOF2_GetString(String, "AdminResponsavel"), DOF2_GetString(String, "Data"), DOF2_GetString(String, "Conta"), DOF2_GetString(String, "Motivo"));
        ShowPlayerDialog(playerid, 555, DIALOG_STYLE_MSGBOX, "{FF0000}Banido", StrInfo, "Fechar", "");
	    SetTimerEx("Kickar" , 150 , false, "i" , playerid);
	    return 1;
    }
    ShowPlayerDialog(playerid, D_ESCOLHERPLATAFORMA, DIALOG_STYLE_MSGBOX, "{1E90FF}Seja bem vindo ao seu melhor servidor!", "{FFFFFF}Bem vindo(a) ao {FF0000}Santa Group  RP\n\n{FFFFFF} Somos uma das melhores cidade RP atualmente e iremos prova.\nA nossa cidade e totalmente inteligente e a economia foi interamente\n baseada na economia da vida real.\n\n As profissao, organizacoes e corporacoes sao totalmente inteligada,cada\n uma com sua funcao e retorno monetario. Os precos dos veiculo,\n imoveis, empresas, arma e etc, sao totalmente balanceados. Nosso unico\n objetivo e proporcionar a melhor e mais compretar experiencia.\n\n Pronto(a) iniciar sua nova vida?\n\n {FF0000}CONTATOR OFICIAL CARP\n https://discord.gg/gFnDeYgSp4", "ENTRAR", "ENTRAR");
	SetPlayerColor(playerid, 0xFFFFFFFF);
	PlayerPontoCorrida[playerid] = -1;
	NaCorrida[playerid] = -1;
	MapIconCorrida[playerid] = -1;
	SegundosContinuar[playerid] = -1;
	OfereceuReparo[playerid] = -1;
	ArmaAlvo[playerid] = -1;
	VendoSms[playerid] = -1;
	Barraca[playerid] = -1;
	FogoBarraca[playerid] = -1;
	CheckVendedor[playerid] = -1;
	CheckDormir[playerid] = -1;
	InviteLocalizacao[playerid] = -1;
	for(new p; p < 10; p++)
	{
	    PickAssalto[playerid][p] = -1;
	}
	XTapete[playerid] = -1;
	YTapete[playerid] = -1;
	ZTapete[playerid] = -1;
	GzBlitz[playerid] = -1;
	Localizando[playerid] = -1;
	Passageiro[playerid] = -1;
	TimerAbordo[playerid] = -1;
	TimerAbordoAb[playerid] = -1;
	PolicialQueAbordou[playerid] = -1;
	ComboioPetroleiro[playerid] = -1; ComboioCaminhoneiro[playerid] = -1; ComboioMinerador[playerid] = -1; ComboioCF[playerid] = -1; format(LocalCarga[playerid], 50, "-1");
	XD[playerid] = -1.0; YD[playerid] = -1.0, ZD[playerid] = -1.0;
	XMorte[playerid] = -1; YMorte[playerid] = -1; ZMorte[playerid] = -1;
	SangueObjeto[playerid] = -1;
	MatouPlayer[playerid] = -1;
	FoiSocorrido[playerid] = 0;
    IndoRadar[playerid] = -1;
	for(new c; c < 5; c++)
