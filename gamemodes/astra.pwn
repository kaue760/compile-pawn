forward DescarregarMoto(playerid);
public DescarregarMoto(playerid)
{
    CargaMoto[playerid] ++;
    GameTextForPlayer(playerid, "~w~Mercadorias Entregue!", 2500, 4);
    TogglePlayerControllable(playerid, 1);
	if(CargaMoto[playerid] >= 3)
	{
		format(String, sizeof(String), "| TRANSPORTES | Voce entregou as 3 mercadorias e recebeu {228B22}$%d", ReceberMotoboy[playerid]);
        SendClientMessage(playerid, -1, String);
        Money[playerid] += ReceberMotoboy[playerid];
        ReceberMotoboy[playerid] = 0;
        CargaMoto[playerid] = -1;
	}
	else
	{
	    SendClientMessage(playerid, -1, "| TRANSPORTES | Voce entregou e recebeu {228B22}$500{FFFFFF}, siga para a proxima entrega!");
	    Money[playerid] += 500;
	}
	//
	for(new e; e < MAX_EMPRESAS; e++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, eX[e], eY[e], eZ[e]))
 	  	{
			if(!new_strcmp(eDono[e], "Ninguem"))
			{
    			new randomlucro = 20 + random(31);
    			eLucro[e] += randomlucro;
			    new StringG[160];
			    format(StringG, sizeof(StringG), "{6959CD}%s ID %d\n{FFFF00}Dono(a): {FFFFFF}%s\n{FFFF00}Producao: {FFFFFF}%d\n{FFFF00}Lucro: {00FF00}$%d\n{FFFFFF}Use /Info Empresa", eNome[e], e, eDono[e], eProducao[e], eLucro[e]);
				UpdateDynamic3DTextLabelText(TextoEmpresa[e], -1, StringG);
				return 1;
			}
		}
	}
	return 1;
}

forward DescarregarTrem(playerid);
public DescarregarTrem(playerid)
{
    CargaTrem[playerid] ++;
    GameTextForPlayer(playerid, "~w~Descarregado", 2500, 4);
    TogglePlayerControllable(playerid, 1);
    if(CargaTrem[playerid] == 1)
	{
	    SetPlayerRaceCheckpoint(playerid, 2, 1439.0928,2632.2500,12.3495, 1439.0928,2632.2500,12.3495, 10.0);
	    SendClientMessage(playerid, GetPlayerColor(playerid), "| FERROVIARIA | Siga para a estacao Yellow Bell para descarregar");
	}
	else if(CargaTrem[playerid] == 2)
	{
	    SetPlayerRaceCheckpoint(playerid, 2, -1944.0966,138.1126,25.7109, -1944.0966,138.1126,25.7109, 10.0);
	    SendClientMessage(playerid, GetPlayerColor(playerid), "| FERROVIARIA | Siga para a estacao Cramberry para descarregar");
	}
	else if(CargaTrem[playerid] == 3)
	{
	    DisablePlayerRaceCheckpoint(playerid);
	    new valor = 1900 + random(200);
	    Money[playerid] += valor;
	    format(String, sizeof(String), "| FERROVIARIA | Seu trem foi descarregado e voce recebeu {228B22}$%d", valor);
	    SendClientMessage(playerid, -1, String);
	    CargaTrem[playerid] = -1;
	}
	return 1;
}

forward Estacionando(playerid);
public Estacionando(playerid)
{
	if(RotaBus[playerid] < 10)
	{
	    format(String, sizeof(String), "| VIAGEM | Voce completou +1 rota ( %d/10 ), siga para a proxima parada!", RotaBus[playerid]);
	    SendClientMessage(playerid, GetPlayerColor(playerid), String);
	}
	else
	{
	    SendClientMessage(playerid, GetPlayerColor(playerid), "| VIAGEM | Voce completou as 10 rotas da sua viagem, volte para a Rodoviaria de Bahia e digite /FinalizarViagem");
	}
	GameTextForPlayer(playerid, "Passageiros Embarcados", 2500, 3);
	TogglePlayerControllable(playerid, 1);
	return 1;
}

forward EntregarDinFazenda(playerid, valor);
public EntregarDinFazenda(playerid, valor)
{
	TimerFuga[playerid] = 0;
	format(String, sizeof(String), "| INFO | Fuga realizada com sucesso, voce roubou $%d", valor);
	SendClientMessage(playerid, 0x00FF00FF, String);
	Money[playerid] += valor;
	return 1;
}

forward Velocimetro(playerid);
public Velocimetro(playerid)
{
	if(IsPlayerConnected(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
 	{
 	    AttVelocimetro(playerid);
 	    //
 	    if(PROF[playerid] == TAXISTA && Passageiro[playerid] > -1)
 	    {
		    if(IsPlayerInVehicle(Passageiro[playerid], GetPlayerVehicleID(playerid)))
  			{
			    UpTaxi[playerid] ++;
			    if(UpTaxi[playerid] >= 5)
			    {
		        	if(Money[Passageiro[playerid]] > 0)
		        	{
		        	    UpTaxi[playerid] = 0;
				        ValorCorrida[playerid] ++;
				        Money[Passageiro[playerid]] --;
				        Money[playerid] ++;
				        new StrT[30]; format(StrT, sizeof(StrT), "Valor_da_Corrida:_~g~$%d", ValorCorrida[playerid]);
			        	PlayerTextDrawSetString(playerid, TextTaximetroP[playerid][0], StrT);
			        	PlayerTextDrawSetString(Passageiro[playerid], TextTaximetroP[Passageiro[playerid]][0], StrT);
		        	}
		        	else
		        	{
		        	    format(String, sizeof(String), "| CORRIDA | Seu passageiro %s[%d] nao tem dinheiro para continuar a corrida", PlayerName(Passageiro[playerid]), Passageiro[playerid]);
			       		SendClientMessage(playerid, 0xFFFF00FF, String);
			     		SendClientMessage(Passageiro[playerid], 0xFFFF00FF, "| CORRIDA | Voce nao tem dinheiro para pagar o taxista e sua corrida foi cancelada");
					    TextDrawHideForPlayer(playerid, TextTaximetro[0]); TextDrawHideForPlayer(playerid, TextTaximetro[1]); TextDrawHideForPlayer(Passageiro[playerid], TextTaximetro[0]); TextDrawHideForPlayer(Passageiro[playerid], TextTaximetro[1]);
					    PlayerTextDrawHide(playerid, TextTaximetroP[playerid][0]); PlayerTextDrawHide(playerid, TextTaximetroP[playerid][1]); PlayerTextDrawHide(Passageiro[playerid], TextTaximetroP[playerid][0]); PlayerTextDrawHide(Passageiro[playerid], TextTaximetroP[playerid][1]);
					    Passageiro[playerid] = -1;
		        	}
			    }
			}
			else
			{
			    if(IsPlayerConnected(Passageiro[playerid]))
       			{
				    format(String, sizeof(String), "| CORRIDA | Seu passageiro %s[%d] terminou a corrida com voce no valor de $%d", PlayerName(Passageiro[playerid]), Passageiro[playerid], ValorCorrida[playerid]);
		       		SendClientMessage(playerid, 0xFFFF00FF, String);
		       		format(String, sizeof(String), "| CORRIDA | Voce terminou a corrida com o Taxista %s[%d] no valor de $%d", PlayerName(playerid), playerid, ValorCorrida[playerid]);
	     			SendClientMessage(Passageiro[playerid], 0xFFFF00FF, String);
	     			TextDrawHideForPlayer(Passageiro[playerid], TextTaximetro[0]); TextDrawHideForPlayer(Passageiro[playerid], TextTaximetro[1]);
	     			PlayerTextDrawHide(Passageiro[playerid], TextTaximetroP[playerid][0]); PlayerTextDrawHide(Passageiro[playerid], TextTaximetroP[playerid][1]);
	       		}
	       		else
	       		{
                    SendClientMessage(playerid, 0xFFFF00FF, "| CORRIDA | Seu passageiro saiu do servidor e sua corrida foi terminada");
	       		}
			    TextDrawHideForPlayer(playerid, TextTaximetro[0]); TextDrawHideForPlayer(playerid, TextTaximetro[1]);
			    PlayerTextDrawHide(playerid, TextTaximetroP[playerid][0]); PlayerTextDrawHide(playerid, TextTaximetroP[playerid][1]);
			    Passageiro[playerid] = -1;
			}
 	    }
        //
 	    SetTimerEx("Velocimetro", 100, false, "i", playerid);
 	}
 	else
 	{
 	    if(IsPlayerConnected(playerid))
 	    {
	 	    for(new t; t < 16; t++)
	 	    {
	 	        PlayerTextDrawHide(playerid, TextVelo[playerid][t]);
	 	    }
	 	    for(new m; m < 6; m++)
			{
				if(ModeloItem[playerid][m] == CAPACETE1 || ModeloItem[playerid][m] == CAPACETE2 || ModeloItem[playerid][m] == CAPACETE3 || ModeloItem[playerid][m] == CAPACETE4 || ModeloItem[playerid][m] == CAPACETE5)
				{
					RemovePlayerAttachedObject(playerid, m);
					break;
				}
			}
	      	if(PROF[playerid] == TAXISTA && Passageiro[playerid] > -1)
		    {
		    	format(String, sizeof(String), "| CORRIDA | O(A) Taxista %s[%d] terminou a corrida com voce no valor de $%d", PlayerName(playerid), playerid, ValorCorrida[playerid]);
		      	SendClientMessage(Passageiro[playerid], 0xFFFF00FF, String);
		   		format(String, sizeof(String), "| CORRIDA | Voce terminou a corrida com o passageiro %s[%d] no valor de $%d", PlayerName(Passageiro[playerid]), Passageiro[playerid], ValorCorrida[playerid]);
	       		SendClientMessage(playerid, 0xFFFF00FF, String);
	       		TextDrawHideForPlayer(Passageiro[playerid], TextTaximetro[0]); TextDrawHideForPlayer(Passageiro[playerid], TextTaximetro[1]);
	       		PlayerTextDrawHide(Passageiro[playerid], TextTaximetroP[playerid][0]); PlayerTextDrawHide(Passageiro[playerid], TextTaximetroP[playerid][1]);
	       		//
	       		TextDrawHideForPlayer(playerid, TextTaximetro[0]); TextDrawHideForPlayer(playerid, TextTaximetro[1]);
			    PlayerTextDrawHide(playerid, TextTaximetroP[playerid][0]); PlayerTextDrawHide(playerid, TextTaximetroP[playerid][1]);
			    Passageiro[playerid] = -1;
    		}
		}
		else
		{
		    if(Passageiro[playerid] > -1)
		    {
		        SendClientMessage(Passageiro[playerid], 0xFFFF00FF, "| CORRIDA | Seu taxista saiu do servidor e sua corrida foi cancelada!");
		        TextDrawHideForPlayer(Passageiro[playerid], TextTaximetro[0]); TextDrawHideForPlayer(Passageiro[playerid], TextTaximetro[1]);
	       		PlayerTextDrawHide(Passageiro[playerid], TextTaximetroP[playerid][0]); PlayerTextDrawHide(Passageiro[playerid], TextTaximetroP[playerid][1]);
	       		Passageiro[playerid] = -1;
		    }
		}
 	}
	return 1;
}

stock AtualizarBTC(playerid)
{
	new strm[70];
	format(strm, sizeof(strm), "%d", ValorBTC[0]);
 	format(strm, sizeof(strm), "1_BTC_=_$%s", AttNumeroDecimal(strm));
  	TextDrawSetString(TextBTC[3], strm);
   	//
    new mercado = (ValorBTC[0] - ValorBTC[1]) * 100 / ValorBTC[0];
    if(mercado >= 0)
    {
    	format(strm, sizeof(strm), "+%d%s", mercado, "%");
        TextDrawSetString(TextBTC[4], strm);
        TextDrawBoxColor(TextBTC[4], 0x00FF0077);
    }
    else
    {
    	format(strm, sizeof(strm), "%d%s", mercado, "%");
        TextDrawSetString(TextBTC[4], strm);
        TextDrawBoxColor(TextBTC[4], 0xFF000077);
    }
    //
	for(new t; t < 6; t++)
	{
		TextDrawShowForPlayer(playerid, TextBTC[t]);
	}
	format(strm, sizeof(strm), "%02.06f", BTC[playerid]);
	PlayerTextDrawSetString(playerid, TextBTCP[playerid][0], strm);
	new valor = floatround(floatmul(float(ValorBTC[0]), BTC[playerid]), floatround_round);
    format(strm, sizeof(strm), "%d", valor); format(strm, sizeof(strm), "$%s", AttNumeroDecimal(strm));
	PlayerTextDrawSetString(playerid, TextBTCP[playerid][1], strm);
	for(new t; t < 2; t++)
	{
		PlayerTextDrawShow(playerid, TextBTCP[playerid][t]);
	}
}

stock CountIP(const ip[]) // Counts how many connections from one IP.
{
    new b = 0;
    foreach(Player, i) if(IsPlayerConnected(i) && new_strcmp(GetIP(i), ip)) b++;
    return b;
}

stock GetIP(playerid) // Fetches the player IP.
{
    new ip[20];
    GetPlayerIp(playerid,ip,sizeof(ip));
    return ip;
}

stock Conectado(const nick[])
{
	foreach(Player, i)
	{
		if(IsPlayerConnected(i) && Spawnado[i] == true && new_strcmp(PlayerName(i), nick)) return 1;
	}
	return 0;
}

stock MsgAvisoPerm(playerid, const msg[])
{
	PlayerTextDrawSetString(playerid, MsgText[playerid], msg);
	PlayerTextDrawShow(playerid, MsgText[playerid]);
}

stock MsgAviso(playerid, segundos, const msg[])
{
	PlayerTextDrawSetString(playerid, MsgText[playerid], msg);
	PlayerTextDrawShow(playerid, MsgText[playerid]);
	SegundosAviso[playerid] = segundos;
}

stock GetPlayerVoltas(playerid)
{
    new voltas; if(Mochila[playerid] == 0) voltas = 15; else if(Mochila[playerid] == 1) voltas = 30; else if(Mochila[playerid] == 2) voltas = 45;
    return voltas;
}

stock BarracaProxima(playerid)
{
    new Float:P[3], id = -1;
    for(new i; i < 16; i++)
	{
	    GetDynamicObjectPos(Barraquinha[i], P[0], P[1], P[2]);
		if(IsPlayerInRangeOfPoint(playerid, 2.0, P[0], P[1], P[2]))
		{
		    id = i;
			break;
		}
	}
	return id;
}

//comeco itens

stock AtacharItem(playerid, idx, edit, plataforma)
{
	switch(ModeloItem[playerid][idx])
	{
	    case 8:
		{
			SetPlayerAttachedObject(playerid, idx, 339, OssoItem[playerid][idx], PosItem[playerid][idx][0], PosItem[playerid][idx][1], PosItem[playerid][idx][2], PosItem[playerid][idx][3], PosItem[playerid][idx][4], PosItem[playerid][idx][5], PosItem[playerid][idx][6], PosItem[playerid][idx][7], PosItem[playerid][idx][8], -1);
		}
		case 9:
		{
			SetPlayerAttachedObject(playerid, idx, 341, OssoItem[playerid][idx], PosItem[playerid][idx][0], PosItem[playerid][idx][1], PosItem[playerid][idx][2], PosItem[playerid][idx][3], PosItem[playerid][idx][4], PosItem[playerid][idx][5], PosItem[playerid][idx][6], PosItem[playerid][idx][7], PosItem[playerid][idx][8], -1);
		}
