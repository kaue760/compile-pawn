stock GiveProcurado(playerid, pr)
{
	if(NivelProcurado[playerid] + pr <= 20)
	{
		NivelProcurado[playerid] += pr;
	}
	else if(NivelProcurado[playerid] + pr > 20)
	{
		NivelProcurado[playerid] = 20;
	}
	if(NivelProcurado[playerid] > 0)
	{
	    new _str[10];
		format(_str, sizeof(_str), "%d", NivelProcurado[playerid]);
		PlayerTextDrawSetString(playerid, TextEstrelas[playerid][1], _str);
		PlayerTextDrawShow(playerid, TextEstrelas[playerid][0]);
		PlayerTextDrawShow(playerid, TextEstrelas[playerid][1]);
	}
	else
	{
	    PlayerTextDrawSetString(playerid, TextEstrelas[playerid][1], "0");
	    PlayerTextDrawShow(playerid, TextEstrelas[playerid][0]);
		PlayerTextDrawShow(playerid, TextEstrelas[playerid][1]);
	}
	return 1;
}

stock ResetProcurado(playerid)
{
	NivelProcurado[playerid] = 0;
    //PlayerTextDrawHide(playerid, TextPr[playerid]);
    PlayerTextDrawSetString(playerid, TextEstrelas[playerid][1], "0");
    PlayerTextDrawShow(playerid, TextEstrelas[playerid][0]);
	PlayerTextDrawShow(playerid, TextEstrelas[playerid][1]);
	return 1;
}

stock ValorSkinComum(skin)
{
    switch(skin)
    {
        case 129,130,131,132,133,134,135,136,137,157,158,159,160,161,200,201,202,212,213,230: return 1000;
        case 50,51,52,54,72,77,78,79,82,83,84,88,89,94,95,96,101,128,203,222,223,253,258,259,260: return 30000;
		default: return 0;
    }
    return 0;
}
