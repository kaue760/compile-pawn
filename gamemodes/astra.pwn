						vTrancado[VeiculoEventoCart[33-JogadoresEvento]] = true;
						SetVehicleParamsEx(VeiculoEventoCart[33-JogadoresEvento], 1, 1, 0, 0, 0, 0, 0);
						format(vDono[VeiculoEventoCart[33-JogadoresEvento]], 25, "Ninguem");
						Combustivel[VeiculoEventoCart[33-JogadoresEvento]] = 50.099;
			            vIPVA[VeiculoEventoCart[33-JogadoresEvento]] = 0;
			            vPreso[VeiculoEventoCart[33-JogadoresEvento]] = false;
			            vTrancado[VeiculoEventoCart[33-JogadoresEvento]] = false;
						JogadoresEvento --;
						TogglePlayerControllable(playerid, 0);
						NoEvento[playerid] = Evento;
						MudouInterior[playerid] = gettime();
		            }
		            else
		            {
		                return SendClientMessage(playerid, COR_ERRO, "| ERRO | O evento ja atingiu o limite de jogadores");
		            }
		        }
		        else if(Evento == 2)
		        {
		            if(JogadoresEvento > 0)
		            {
		                SetPlayerInterior(playerid, 0);
		                SetPlayerVirtualWorld(playerid, 0);
		                VeiculoEventoMonster[30-JogadoresEvento] = CreateVehicleC(557, EventoMonster[30-JogadoresEvento][0], EventoMonster[30-JogadoresEvento][1], EventoMonster[30-JogadoresEvento][2], EventoMonster[30-JogadoresEvento][3], -1, -1, -1);
