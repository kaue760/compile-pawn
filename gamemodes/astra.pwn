					}
	            }
	            case 2:
	            {
	                if(Eleicao == 2)
	                {
	                    return SendClientMessage(playerid, COR_ERRO, "| ERRO | A votacao esta em processo");
	                }
	                else
	                {
                        new total;
					    new players_Data[10][2], tempVar, i, j, k;
						for(i = 0, j = 10; i < j; ++i)
						{
						    total += VotosCandidato[i];
							players_Data[tempVar][0] = VotosCandidato[i];
							players_Data[tempVar++][1] = i;
						}
						if(total <= 0)
						{
						    total = 1;
						}
						for(i = 0, j = 0; i < tempVar; ++i)
						{
							j = players_Data[i][0];

							for(k = i - 1; k > -1; --k)
							{
								if(j > players_Data[k][0])
								{
									players_Data[k][0] ^= players_Data[k + 1][0], players_Data[k + 1][0] ^= players_Data[k][0], players_Data[k][0] ^= players_Data[k + 1][0];
									players_Data[k][1] ^= players_Data[k + 1][1], players_Data[k + 1][1] ^= players_Data[k][1], players_Data[k][1] ^= players_Data[k + 1][1];
								}
							}
	     				}
						//
					    new gs_Buffer[1000] = EOS;
					    strcat(gs_Buffer, "{0095FF}Posicao\t{FFFFFF}Candidato\t{848484}Porcentagem\t{FFFF00}Votos");
						for(i = 0; i < 10; i++)
						{
							if(tempVar <= i) break;

							format(String, sizeof(String), "\n� {0095FF}%d� Lugar\t{FFFFFF}%s\t{848484}%d%s\t{FFFF00}%d", i+1, Candidato[players_Data[i][1]], players_Data[i][0] * 100 / total, "%", players_Data[i][0]);
							strcat(gs_Buffer, String);
						}
						format(String, sizeof(String), "{FFFFFF}Apuracao dos Votos [ {FFFF00}%d {FFFFFF}]", total);
					    ShowPlayerDialog(playerid, 555, DIALOG_STYLE_TABLIST_HEADERS, String, gs_Buffer, "Fechar", "");
	                }
	            }
			}
		}
