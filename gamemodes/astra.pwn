		return 1;
    }
	return 1;
}



stock PVP_GetNomeMes(mes)
{
    new name[15];
    switch(mes)
    {
        case 1:name = "Jan";
        case 2:name = "Fev";
        case 3:name = "Mar";
        case 4:name = "Abr";
        case 5:name = "Mai";
        case 6:name = "Jun";
        case 7:name = "Jul";
        case 8:name = "Ago";
        case 9:name = "Set";
        case 10:name = "Out";
        case 11:name = "Nov";
        case 12:name = "Dez";
        default:name = "N/A";
    }
    return name;
}

stock PVP_GetDay()
    return ((gettime()+334800)/86400-(gettime()+334800)/86400/7*7);

stock PVP_GetWeekDay()
{
    new WeekDay[20];

    switch(PVP_GetDay())
    {
        case 0: WeekDay = "Domingo";
        case 1: WeekDay = "Segunda";
        case 2: WeekDay = "Terca";
        case 3: WeekDay = "Quarta";
        case 4: WeekDay = "Quinta";
        case 5: WeekDay = "Sexta";
        case 6: WeekDay = "Sabado";
    }
    return WeekDay;
}

stock PVP_OnPlayerUpdate(playerid)
{
	if(PVP_IsPlayerInZonaSafe(playerid)) {
		for(new i; i < sizeof(PVP_Public_AreaSafe); i++)
		{
			TextDrawShowForPlayer(playerid, PVP_Public_AreaSafe[i]);
		}
	} else {
		for(new i; i < sizeof(PVP_Public_AreaSafe); i++)
		{
			TextDrawHideForPlayer(playerid, PVP_Public_AreaSafe[i]);
		}
	}
	
	if(PVP_info[playerid][PVP_IDF] <= 0) {
		PVP_info[playerid][PVP_IDF] = PVP_CriarID();
		
		format(PVP_arquivo, sizeof(PVP_arquivo), "ID/%i.ID", PVP_info[playerid][PVP_IDF]);
        dini_Create(PVP_arquivo);
        dini_Set(PVP_arquivo, "Conta", PVP_PlayerName(playerid));
	}
	
	new year, month, day, hour, minute, second; getdate(year, month, day); gettime(hour, minute, second);
	new ztr[512];
	format(ztr, sizeof(ztr), "%s %02d de %s, %d", PVP_GetWeekDay(), day, PVP_GetNomeMes(month), year);
	PlayerTextDrawSetString(playerid, PVP_Player_Rodape[playerid][2], ztr);
	
	format(ztr, sizeof(ztr), "%d", PVP_info[playerid][PVP_IDF]);
	PlayerTextDrawSetString(playerid, PVP_Player_Rodape[playerid][3], ztr);
	
    if(GetPlayerScore(playerid) > 19) {
	    format(ztr, sizeof(ztr), "{FFFFFF}%i(%i)", PVP_info[playerid][PVP_IDF], playerid);
        UpdateDynamic3DTextLabelText(textTAG[playerid], -1, ztr);
    } else {
        format(ztr, sizeof(ztr), "{FFFF00}Novato\n{FFFFFF}%i(%i)", PVP_info[playerid][PVP_IDF], playerid);
        UpdateDynamic3DTextLabelText(textTAG[playerid], -1, ztr);
    }
    
    if(IsPlayerInAnyVehicle(playerid)) {
		new vehicleid = GetPlayerVehicleID(playerid);
		
		new Float:vida; GetVehicleHealth(vehicleid, vida);
		
		new velocidade = PVP_GetVehicleSpeed(vehicleid);
		
		format(ztr, 512, "%03d", velocidade);
		PlayerTextDrawSetString(playerid, PVP_Player_VeloArcade[playerid][11], ztr);
		
		format(ztr, 512, "%s", PVP_vehicleNames[GetVehicleModel(vehicleid) - 400]);
		PlayerTextDrawSetString(playerid, PVP_Player_VeloArcade[playerid][12], ztr);
		
		new keys, ud, lr;
	    GetPlayerKeys(playerid, keys, ud, lr);
	    if(keys & KEY_JUMP) {
			PlayerTextDrawSetString(playerid, PVP_Player_VeloArcade[playerid][13], "R");
		} else if(velocidade <= 0) {
			PlayerTextDrawSetString(playerid, PVP_Player_VeloArcade[playerid][13], "N");
		} else {
			PlayerTextDrawSetString(playerid, PVP_Player_VeloArcade[playerid][13], "D");
		}
		
		format(ztr, 512, "%.0f%", vida/10.0);
		PlayerTextDrawSetString(playerid, PVP_Player_VeloArcade[playerid][14], ztr);
		
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][0], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][1], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][2], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][3], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][4], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][5], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][6], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][7], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][8], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][9], 538976511);
		PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][10], 538976511);
		
		if(velocidade > 0) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][10], -1);
		if(velocidade > 19) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][9], -1);
		if(velocidade > 39) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][8], -1);
		if(velocidade > 59) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][7], -1);
		if(velocidade > 79) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][6], -1);
		if(velocidade > 99) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][5], -1);
		if(velocidade > 119) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][4], -1);
		if(velocidade > 139) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][3], -1);
		if(velocidade > 159) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][2], -1);
		if(velocidade > 179) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][1], -1);
		if(velocidade > 199) PlayerTextDrawColor(playerid, PVP_Player_VeloArcade[playerid][0], -1);
		
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][0]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][1]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][2]); 
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][3]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][4]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][5]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][6]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][7]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][8]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][9]);
		PlayerTextDrawShow(playerid, PVP_Player_VeloArcade[playerid][10]);
	}
	
	if(PVP_ArenaPlayer[playerid] != -1) {
		format(ztr, sizeof(ztr), "%i / %i", PVP_ArenaKills[playerid], PVP_ArenaMortes[playerid]);
		PlayerTextDrawSetString(playerid, PVP_Player_HudKill[playerid][0], ztr);
		
		format(ztr, sizeof(ztr), "%i", PVP_ArenaKillsS[playerid]);
		PlayerTextDrawSetString(playerid, PVP_Player_HudKill[playerid][1], ztr);
		
		PlayerTextDrawShow(playerid, PVP_Player_HudKill[playerid][0]);
		PlayerTextDrawShow(playerid, PVP_Player_HudKill[playerid][1]);
	} else {
		TextDrawHideForPlayer(playerid, PVP_Public_HudKill[0]);
		TextDrawHideForPlayer(playerid, PVP_Public_HudKill[1]);
		TextDrawHideForPlayer(playerid, PVP_Public_HudKill[2]);
		
		PlayerTextDrawHide(playerid, PVP_Player_HudKill[playerid][0]);
		PlayerTextDrawHide(playerid, PVP_Player_HudKill[playerid][1]);
	}
	
	if(PVP_zerouRank == 1) PVP_info[playerid][PVP_Matou] = 0;
	
	if(PVP_MundoPlayer[playerid] > 0) PVP_SetVW(playerid, PVP_MundoPlayer[playerid]);
	else PVP_SetVW(playerid, 0);
	
	PlayerTextDrawTextSize(playerid, PVP_Player_Rodape[playerid][1], 562.500000+0.485*PVP_info[playerid][PVP_Presente], 45.500000);
	PlayerTextDrawShow(playerid, PVP_Player_Rodape[playerid][1]);
	
	if(PVP_info[playerid][PVP_Matou] > dini_Int("rank.cfg", "kills1")) {
		if(dini_Int("rank.cfg", "pkills1") == PVP_info[playerid][PVP_IDF]) {
			dini_IntSet("rank.cfg", "kills1", PVP_info[playerid][PVP_Matou]);
			PVP_AtualizarRank();
		} else {
			new i, i2;
			i = dini_Int("rank.cfg", "pkills2");
			i2 = dini_Int("rank.cfg", "kills2");
			
			dini_IntSet("rank.cfg", "pkills2", dini_Int("rank.cfg", "pkills1")); 
			dini_IntSet("rank.cfg", "kills2", dini_Int("rank.cfg", "kills1"));
			
			dini_IntSet("rank.cfg", "pkills1", PVP_info[playerid][PVP_IDF]); 
			dini_IntSet("rank.cfg", "kills1", PVP_info[playerid][PVP_Matou]);
			
			if( i != dini_Int("rank.cfg", "pkills1") ) {
				dini_IntSet("rank.cfg", "pkills3", i); 
				dini_IntSet("rank.cfg", "kills3", i2);
			}
			
			PVP_AtualizarRank();
		}
		return 1;
	}
    if(PVP_info[playerid][PVP_Matou] > dini_Int("rank.cfg", "kills2")) {
	    if(dini_Int("rank.cfg", "pkills1") == PVP_info[playerid][PVP_IDF]) return 1;
	
		if(dini_Int("rank.cfg", "pkills2") == PVP_info[playerid][PVP_IDF]) {
			dini_IntSet("rank.cfg", "kills2", PVP_info[playerid][PVP_Matou]);
			PVP_AtualizarRank();
		} else {
			dini_IntSet("rank.cfg", "pkills3", dini_Int("rank.cfg", "pkills2")); 
			dini_IntSet("rank.cfg", "kills3", dini_Int("rank.cfg", "kills2"));
			
			dini_IntSet("rank.cfg", "pkills2", PVP_info[playerid][PVP_IDF]); 
			dini_IntSet("rank.cfg", "kills2", PVP_info[playerid][PVP_Matou]);
			
			PVP_AtualizarRank();
		}
		return 1;
	}
    if(PVP_info[playerid][PVP_Matou] > dini_Int("rank.cfg", "kills3")) {
	    if(dini_Int("rank.cfg", "pkills1") == PVP_info[playerid][PVP_IDF]) return 1;
		if(dini_Int("rank.cfg", "pkills2") == PVP_info[playerid][PVP_IDF]) return 1;
	
		if(dini_Int("rank.cfg", "pkills3") == PVP_info[playerid][PVP_IDF]) {
			dini_IntSet("rank.cfg", "kills3", PVP_info[playerid][PVP_Matou]);
			PVP_AtualizarRank();
		} else {
			dini_IntSet("rank.cfg", "pkills3", PVP_info[playerid][PVP_IDF]); 
			dini_IntSet("rank.cfg", "kills3", PVP_info[playerid][PVP_Matou]);
			
			PVP_AtualizarRank();
		}
		return 1;
	}
	
	return 1;
}

stock PVP_OnPlayerDeath(playerid, killerid, reason)
{
	SetPlayerScore(killerid, GetPlayerScore(killerid)+1);
	
	PVP_info[killerid][PVP_Matou] += 1;
	PVP_info[playerid][PVP_Morreu] += 1;
	
	if(PVP_ArenaPlayer[killerid] >= 1 && PVP_ArenaPlayer[playerid] >= 1) {
		PVP_ArenaKills[killerid] += 1;
		PVP_ArenaKillsS[killerid] += 1;
		
		PVP_ArenaMortes[playerid] += 1;
		
		SetPlayerArmour(killerid, 100.0);
		SetPlayerHealth(killerid, 100.0);
		
		if(PVP_ArenaKillsS[playerid] >= 1) {
			PVP_ArenaKillsS[playerid] = 0;
		}
	}
	
	return 1;
}

stock PVP_GetVehicleSpeed(vehicleid)
{
    new Float:x, Float:y, Float:z;
    GetVehicleVelocity(vehicleid, x, y, z);
    return floatround(floatsqroot(x*x+y*y+z*z)*170);
}









stock PVP_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if(dialogid == PVP_DIALOG_ARENAS) {
		if(response) {
			if(listitem == 1) {
				new MEGAString[9999], string[512];
				MEGAString[0] = EOS;
				
				strcat(MEGAString, "{ffffff}Mapas\t\t\t\tTipo\t\t\t\tPlayers:\n");
				
				format(string, sizeof(string), "{ffffff}[1] Mapa Normal\tLivre\t%i\n", PVP_PlayersM4_Cidade);
				strcat(MEGAString, string);
				
				format(string, sizeof(string), "{ffffff}[2] Mapa Delegacia\tLivre\t%i\n", PVP_PlayersM4_Delegacia);
				strcat(MEGAString, string);
				
				ShowPlayerDialog(playerid, PVP_DIALOG_ARENAS_M4, DIALOG_STYLE_TABLIST_HEADERS, "{ffffff}Arcade: Arenas M4", MEGAString, #Selecionar, #Voltar);
				return 1;
			}
			if(listitem == 2) {
