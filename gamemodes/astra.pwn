GetDia()
{
	new WeekDay[26];
	switch(((gettime()+334800)/86400-(gettime()+334800)/86400/7*7))
	{
		case 0: WeekDay = "deste domingo";
		case 1: WeekDay = "desta segunda-feira";
		case 2: WeekDay = "desta terca-feira";
		case 3: WeekDay = "desta quarta-feira";
		case 4: WeekDay = "desta quinta-feira";
		case 5: WeekDay = "desta sexta-feira";
		case 6: WeekDay = "deste sabado";
	}
	return WeekDay;
}

GetDay()
{
	new WeekDay[15];
	switch(((gettime()+334800)/86400-(gettime()+334800)/86400/7*7))
	{
		case 0: WeekDay = "Domingo";
		case 1: WeekDay = "Segunda-feira";
		case 2: WeekDay = "Terca-feira";
		case 3: WeekDay = "Quarta-feira";
		case 4: WeekDay = "Quinta-feira";
		case 5: WeekDay = "Sexta-feira";
		case 6: WeekDay = "Sabado";
	}
	return WeekDay;
}

GetMes()
{
	new mess[10], d, m, a; getdate(a, m, d);
	switch(m)
	{
	    case 1: mess = "Janeiro";
	    case 2: mess = "Fevereiro";
	    case 3: mess = "Marco";
	    case 4: mess = "Abril";
	    case 5: mess = "Maio";
	    case 6: mess = "Junho";
	    case 7: mess = "Julho";
	    case 8: mess = "Agosto";
	    case 9: mess = "Setembro";
	    case 10: mess = "Outubro";
	    case 11: mess = "Novembro";
	    case 12: mess = "Dezembro";
	}
	return mess;
}

AttBarStatus(playerid)
{
