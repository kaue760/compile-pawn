		          		format(strg, sizeof(strg), "~b~~h~Transportando_para:_~w~%s~n~~b~~h~Distancia:_~w~%0.2fM~n~~b~~h~Frete:_~g~$%d_~w~+_~g~$%d_~w~Bonus~n~~b~~h~Comboio:_~w~%d_pessoas~n~~b~~h~Total_a_receber:_~g~$%d", LocalCarga[i], fDistance, Frete[i], BonusFrete[i], ComboioMineradorList[ComboioMinerador[i]], Frete[i] + BonusFrete[i] + (ComboioMineradorList[ComboioMinerador[i]] * 200));
						PlayerTextDrawSetString(i, TextCargaP[i][0], strg);
