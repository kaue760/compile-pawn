	else if(dialogid == D_PAGARIMPOSTOCASA)
	{
	    if(response)
	    {
	        for(new cc; cc < MAX_CASAS; cc++)
			{
			    if(new_strcmp(cDono[cc], PlayerName(playerid)))
				{
				    if(cImpostos[cc] > 0)
				    {
						new valorimposto = cValor[cc] * 1 / 100 * cImpostos[cc];
						if(Money[playerid] >= valorimposto)
						{
						    new str[180];
						    if(Level[playerid] < LevelImpostoCasa[playerid])
						    {
						        format(str, sizeof(str), "| ERRO | Voce precisa upar mais %d leveis para pagar impostos", LevelImpostoCasa[playerid] - Level[playerid]);
						        return SendClientMessage(playerid, COR_ERRO, str);
						    }
							Money[playerid] -= valorimposto;
							CaixaPref += valorimposto;
							new ValorNaMsg[11]; format(ValorNaMsg, sizeof(ValorNaMsg), "%d", CaixaPref);
							format(String, sizeof(String), "{FFFFFF}Caixa da Prefeitura\n{00FF00}$%s", AttNumeroDecimal(ValorNaMsg));
	                        UpdateDynamic3DTextLabelText(PickCaixaP, -1, String);
						    format(str, sizeof(str), "| IMPOSTO | Voce pagou {FFFF00}%d {FFFFFF}impostos da sua casa id {6A5ACD}%d {FFFFFF}no total de {228B22}$%d", cImpostos[cc], cc, valorimposto);
							SendClientMessage(playerid, -1, str);
							cImpostos[cc] = 0;
							LevelImpostoCasa[playerid] = Level[playerid] + 10;
						}
					    else
					    {
					        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
					    }
					}
					return 1;
				}
			}
