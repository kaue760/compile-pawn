stock HexToInt(const string[])
{
    if(!string[0]) return 0;
    new cur = 1, res = 0;
    for(new i = strlen(string); i > 0; i--)
    {
        res += cur * (string[i - 1] - ((string[i - 1] < 58) ? (48) : (55)));
        cur = cur * 16;
    }
    return res;
}

stock EfectCamSkin(playerid)
{
    if(GetPlayerInterior(playerid) == 15)
    {
    	SetPlayerPos(playerid, 217.5797, -98.5492, 1005.2578); SetPlayerFacingAngle(playerid, 358.5711);
     	InterpolateCameraPos(playerid, 214.072113, -99.076202, 1005.771972, 215.422348, -99.000694, 1005.919311, 10000);
		InterpolateCameraLookAt(playerid, 219.068542, -99.154808, 1005.600341, 220.397079, -99.142913, 1005.437805, 10000);
    }
    else if(GetPlayerInterior(playerid) == 1)
    {
    	SetPlayerPos(playerid, 214.6457, -40.9276, 1002.0234); SetPlayerFacingAngle(playerid, 360.0);
     	InterpolateCameraPos(playerid, 209.318283, -41.713188, 1002.638244, 212.253372, -41.578704, 1002.498657, 10000);
		InterpolateCameraLookAt(playerid, 214.302276, -41.900070, 1002.284790, 217.244354, -41.658863, 1002.209350, 10000);
    }
    else if(GetPlayerInterior(playerid) == 14)
    {
    	SetPlayerPos(playerid, 215.8977,-155.5384,1000.5234); SetPlayerFacingAngle(playerid, 0.0);
     	InterpolateCameraPos(playerid, 212.032608, -156.437530, 1001.159851, 213.633255, -156.424957, 1001.047180, 10000);
		InterpolateCameraLookAt(playerid, 217.024230, -156.442840, 1000.870544, 218.629287, -156.344665, 1000.864807, 10000);
    }
    else if(GetPlayerInterior(playerid) == 3)
    {
    	SetPlayerPos(playerid, 199.2535,-127.3301,1003.5152); SetPlayerFacingAngle(playerid, 90.0);
     	InterpolateCameraPos(playerid, 200.046279, -130.464950, 1004.145996, 199.998214, -129.409408, 1004.077575, 10000);
		InterpolateCameraLookAt(playerid, 199.805145, -125.481117, 1003.824584, 199.820999, -124.418632, 1003.831054, 10000);
    }
    else if(GetPlayerInterior(playerid) == 5)
    {
    	SetPlayerPos(playerid, 207.8346,-5.5455,1005.2109); SetPlayerFacingAngle(playerid, 180.0);
     	InterpolateCameraPos(playerid, 211.631164, -4.781353, 1005.750000, 210.577728, -4.797150, 1005.675354, 10000);
		InterpolateCameraLookAt(playerid, 206.644226, -4.856137, 1005.396545, 205.590789, -4.871933, 1005.321899, 10000);
    }
    new RandomCam = random(3);
    if(RandomCam == 0)
    {
        ApplyAnimation(playerid, "CLOTHES", "CLO_POSE_TORSO", 4.1, 1, 0, 0, 0, 0, 1);
    }
    else if(RandomCam == 1)
    {
        ApplyAnimation(playerid, "CLOTHES", "CLO_POSE_LEGS", 4.1, 1, 0, 0, 0, 0, 1);
    }
    else if(RandomCam == 2)
    {
        ApplyAnimation(playerid, "CLOTHES", "CLO_POSE_LOOP", 4.1, 1, 0, 0, 0, 0, 1);
    }
}

