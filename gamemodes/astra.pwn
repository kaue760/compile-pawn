stock VerificarVeiculoT(playerid, model)
{
	new result; //TERRESTRE
	switch(model)
    {
		case 400, 401, 402, 404, 405, 410, 411, 412, 413, 415, 418, 419, 421, 422, 424, 426, 429, 434, 436, 439, 440, 442,
		444, 445, 451, 455, 457, 458, 459, 461, 462, 463, 466, 467, 468, 471, 474, 475, 477, 478, 479, 480, 481, 482, 483,
		485, 489, 491, 492, 494, 495, 496, 500, 502, 503, 504, 505, 506, 507, 508, 509, 510, 516, 517, 518, 521, 522, 526,
 		527, 529, 533 ,534, 535, 539, 540, 541, 542, 543, 545, 546, 547, 549, 550, 551, 554, 555, 556, 557, 558, 559, 560,
	 	561, 562, 565, 566, 567, 568, 571, 572, 573, 575, 576, 579, 580, 581, 583, 585, 586, 587, 589, 600, 602, 603: result = model;
	 	default: result = 0;
	}
    if(result == 0)
	{
		if(VModel[playerid] > 400 && VModel[playerid] < 603)
		{
		    if(BotaoConce[playerid] == true)
		    {
				VModel[playerid] ++; VerificarVeiculoT(playerid, VModel[playerid]); return 0;
			}
			else
			{
			    VModel[playerid] --; VerificarVeiculoT(playerid, VModel[playerid]); return 0;
			}
		}
  		else
  		{
  		    if(BotaoConce[playerid] == true)
		    {
  		    	VModel[playerid] = 400; VerificarVeiculoT(playerid, VModel[playerid]); return 0;
			}
			else
			{
			    VModel[playerid] = 603; VerificarVeiculoT(playerid, VModel[playerid]); return 0;
			}
  		}
  	}
  	return 0;
}

stock ValorVeiculoModelAE(playerid, model)
{
	//AEREO
	new result;
	switch(model)
    {
		case 417, 447, 469, 476, 487, 511, 512, 513, 519, 563, 593: result = model;
	 	default: result = 0;
	}
    if(result == 0)
	{
		if(VModel[playerid] > 417 && VModel[playerid] < 593)
		{
		    if(BotaoConce[playerid] == true)
		    {
				VModel[playerid] ++; ValorVeiculoModelAE(playerid, VModel[playerid]); return 0;
			}
