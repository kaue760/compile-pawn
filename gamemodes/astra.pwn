	else if(dialogid == D_PREFCOLETARLIXO)
	{
	    if(response)
	    {
	        for(new c; c < MAX_CASAS; c++)
			{
			    if(new_strcmp(cDono[c], PlayerName(playerid)))
			    {
			        if(cLixo[c] > 0)
			        {
			            cLixo[c] = 0;
			            if(IsValidDynamicObject(LixoCasa[c]))
			            {
			                DestroyDynamicObject(LixoCasa[c]);
							LixoCasa[c] = -1;
			            }
			            return SendClientMessage(playerid, -1, "| INFO | Voce enviou os servicos de limpeza publica para coletar os lixos da sua rua");
			        }
			        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Os lixos da sua casa ja foram coletados");
