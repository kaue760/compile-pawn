							    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Jogadores de organizacoes criminosas nao podem se candidatar a prefeito");
							}*/
		                    for(new e; e < 10; e++)
		                    {
		                        if(new_strcmp(Candidato[e], PlayerName(playerid)))
		                        {
		                            return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce ja se candidatou");
		                        }
							}
		                    for(new e; e < 10; e++)
		                    {
		                        if(new_strcmp(Candidato[e], "Ninguem"))
		                        {
		                            Money[playerid] -= 50000;
		                            format(Candidato[e], 25, "%s", PlayerName(playerid));
		                            SkinCandidato[e] = GetPlayerSkin(playerid);
		                            VotosCandidato[e] = 0;
		                            SendClientMessage(playerid, -1, "| INFO | Voce se candidatou a prefeito do servidor, boa sorte!");
									TextDrawSetPreviewModel(TextEleicao[e+1], SkinCandidato[e]);
									TextDrawSetString(TextEleicao[e+11], Candidato[e]);
		                            return 1;
		                        }
		                    }
							return SendClientMessage(playerid, COR_ERRO, "| ERRO | Nao existe mais vagas para candidatos");
		                }
		                else
		                {
		                    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
		                }
					}
					else
					{
					    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem level suficiente");
					}
	            }
	            case 1:
	            {
	                if(GetPlayerScore(playerid) >= 20)
	                {
		                if(COINS[playerid] >= 10000)
		                {
		                    for(new e; e < 10; e++)
		                    {
		                        if(new_strcmp(Candidato[e], PlayerName(playerid)))
		                        {
		                            return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce ja se candidatou");
		                        }
							}
		                    for(new e; e < 10; e++)
		                    {
		                        if(new_strcmp(Candidato[e], "Ninguem"))
		                        {
		                            COINS[playerid] -= 10000;
		                            format(Candidato[e], 25, "%s", PlayerName(playerid));
		                            SkinCandidato[e] = GetPlayerSkin(playerid);
		                            VotosCandidato[e] = 0;
		                            SendClientMessage(playerid, -1, "| INFO | Voce se candidatou a prefeito do servidor, boa sorte!");
									TextDrawSetPreviewModel(TextEleicao[e+1], SkinCandidato[e]);
									TextDrawSetString(TextEleicao[e+11], Candidato[e]);
		                            return 1;
		                        }
		                    }
							return SendClientMessage(playerid, COR_ERRO, "| ERRO | Nao existe mais vagas para candidatos");
