	        SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta procurado(a) pela policia");
	    }
	}
	else if(checkpointid == CheckPref[2])
	{
  		for(new c; c < MAX_CASAS; c++)
		{
		    if(new_strcmp(cDono[c], PlayerName(playerid)))
		    {
		        if(cLixo[c] > 0)
		        {
          			new Strg[180];
		            format(Strg, sizeof(Strg), "\n{FFFFFF}Sua casa tem %d lixo(s) acumulado(s)\n\nDeseja enviar o servico de limpeza publica da prefeitura para sua rua?", cLixo[c]);
		            ShowPlayerDialog(playerid, D_PREFCOLETARLIXO, DIALOG_STYLE_MSGBOX, "{FFFFFF}Coleta lixo casa", Strg, "Sim", "Nao");
		            return 1;
		        }
		        else
		        {
		            return ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{FFFFFF}Coleta lixo casa", "\n{FF0000}Sua casa nao tem lixo acumulado", "Fechar", "");
		        }
		    }
		}
		return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem uma casa");
	}
	else if(checkpointid == CheckGari[playerid])
	{
        if(IsPlayerAttachedObjectSlotUsed(playerid, 7))
        {
            if(Lixinhos[playerid] < 10)
 			{
	            Lixinhos[playerid] ++;
			    ApplyAnimation(playerid, "CARRY", "PUTDWN", 4.1, 0, 0, 0, 0, 0, 1);
				RemovePlayerAttachedObject(playerid, 7);
				new strl[40]; format(strl, sizeof(strl), "~g~LIXO COLETADO! ( ~w~%d / 10 ~g~)", Lixinhos[playerid]);
				GameTextForPlayer(playerid, strl, 2500, 3);
				if(Lixinhos[playerid] == 10)
				{
				    SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Seu caminhao esta cheio de lixo, agora descarregue-o no Lixao de Sao Paulo!");
				}
			}
		}
	}
	else if(checkpointid == CheckADrogas[0] || checkpointid == CheckADrogas[1])
	{
	    if(checkpointid == CheckADrogas[0])
	    {
	        if(DonoFavela[0] != ORG[playerid] && DonoFavela[0] != PROF[playerid])
	        {
