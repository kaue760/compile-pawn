	else if(dialogid == D_COMPRARSKIN)
	{
	    if(response)
		{
		    SlotSS[playerid] = 0;
			switch(listitem)
			{
			    case 0:
			    {
			        SkinSelecionada[playerid] = SkinsComuns[0];
			        ModelSelectSkin[playerid] = 0;
			        ValorSS[playerid] = 0;
			    }
			    case 1:
			    {
			        SkinSelecionada[playerid] = SkinsExclusivas[0];
			        ModelSelectSkin[playerid] = 1;
			        ValorSS[playerid] = 0;
			    }
			    case 2:
			    {
			        SkinSelecionada[playerid] = SkinsSemiRaras[0];
			        ModelSelectSkin[playerid] = 2;
			        ValorSS[playerid] = 0;
			    }
			    case 3:
			    {
			        SkinSelecionada[playerid] = SkinsRaras[0];
			        ModelSelectSkin[playerid] = 3;
			        ValorSS[playerid] = 0;
			    }
			    case 4:
			    {
			        SkinSelecionada[playerid] = SkinsEpicas[0];
			        ModelSelectSkin[playerid] = 4;
			        ValorSS[playerid] = 0;
			    }
			    case 5:
			    {
			        return ShowPlayerDialog(playerid, D_BUSCARSKIN, DIALOG_STYLE_INPUT, "{FFFF00}Buscar Skin", "{FFFFFF}\nDigite o id da skin abaixo:", "Buscar", "Cancelar");
			    }
			}
			SetPlayerSkin(playerid, SkinSelecionada[playerid]);
			new txtidskin[12]; format(txtidskin, sizeof(txtidskin), "%d", SkinSelecionada[playerid]);
			PlayerTextDrawSetString(playerid, TextSkinMenuP[playerid][0], txtidskin);
			
			if(ValorSS[playerid])
			{
				format(txtidskin, sizeof(txtidskin), "~y~%d C", ValorSS[playerid]);
				PlayerTextDrawSetString(playerid, TextSkinMenuP[playerid][1], txtidskin);
			}
			else
			{
				format(txtidskin, sizeof(txtidskin), "~g~$%d", ValorSkinComum(SkinSelecionada[playerid]));
				PlayerTextDrawSetString(playerid, TextSkinMenuP[playerid][1], txtidskin);
			}
			
		    PlayerTextDrawSetPreviewModel(playerid, TextSkinMenuP[playerid][2], SkinSelecionada[playerid]);
			//
		 	EfectCamSkin(playerid);
			for(new t; t < 10; t++)
			{
				TextDrawShowForPlayer(playerid, TextSkinMenu[t]);
			}
			for(new t; t < 3; t++)
			{
				PlayerTextDrawShow(playerid, TextSkinMenuP[playerid][t]);
			}
			SelectTextDraw(playerid, 0xFFFFFF22);
		}
	}
	else if(dialogid == D_BUSCARSKIN)
	{
	    if(response)
	    {
			if(strval(inputtext) >= 0 && strval(inputtext) <= 299)
			{
			    if(strval(inputtext) != 0 && !SkinBloqueada(strval(inputtext)) || IsPlayerAdmin(playerid))
			    {
				    SkinSelecionada[playerid] = strval(inputtext);
				    SetPlayerSkin(playerid, SkinSelecionada[playerid]);
				    
				    new txtidskin[12];
				    
				    ModelSelectSkin[playerid] = 4;
     				ValorSS[playerid] = 100000;
      				format(txtidskin, sizeof(txtidskin), "~y~%d C", ValorSS[playerid]);
					PlayerTextDrawSetString(playerid, TextSkinMenuP[playerid][1], txtidskin);
					//acima esta selecionada a classe de 100k
				    for(new i; i < sizeof(SkinsComuns); i++)
				    {
				        if(strval(inputtext) == SkinsComuns[i])
				        {
				            ModelSelectSkin[playerid] = 0;
			        		ValorSS[playerid] = 0;
			        		format(txtidskin, sizeof(txtidskin), "~g~$%d", ValorSkinComum(SkinSelecionada[playerid]));
							PlayerTextDrawSetString(playerid, TextSkinMenuP[playerid][1], txtidskin);
							break;
				        }
				    }
				    
				    for(new i; i < sizeof(SkinsExclusivas); i++)
				    {
				        if(strval(inputtext) == SkinsExclusivas[i])
				        {
				            ModelSelectSkin[playerid] = 1;
			        		ValorSS[playerid] = 0;
			        		format(txtidskin, sizeof(txtidskin), "~y~%d C", ValorSS[playerid]);
							PlayerTextDrawSetString(playerid, TextSkinMenuP[playerid][1], txtidskin);
							break;
				        }
				    }
				    
				    for(new i; i < sizeof(SkinsSemiRaras); i++)
				    {
				        if(strval(inputtext) == SkinsSemiRaras[i])
				        {
				            ModelSelectSkin[playerid] = 2;
			        		ValorSS[playerid] = 0;
			        		format(txtidskin, sizeof(txtidskin), "~y~%d C", ValorSS[playerid]);
