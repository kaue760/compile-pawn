		    SendClientMessage(playerid, -1, "| INFO | Para entrar na Loterica digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
		else if(pickupid == PickEntrada[0] || pickupid == PickEntrada[27] || pickupid == PickEntrada[28])
