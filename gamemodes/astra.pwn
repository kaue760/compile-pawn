stock PVP_OnPlayerEnterRaceCheckpoint(playerid)
{
	if(PVP_Corrida_Player[playerid] == 1) {
		if(PVP_Corrida_Player_Checkpoint[playerid] == 16) {
			PVP_Corrida_Player_Checkpoint[playerid] = 0;
			PVP_Corrida_Player[playerid] = 0;
			PVP_Corrida_Escolheu[playerid] = 0;
			DisablePlayerRaceCheckpoint(playerid);
			
			new StringC[500];
			format(StringC, sizeof(StringC), "Corrida: O(A) %s[%i] completou a corrida Pier em %s.", PVP_PlayerName(playerid), playerid, PVP_ConvertTime(PVP_TempoCorrida[playerid]));
			PVP_SCMAll(0x050072FF, StringC);
			
			PVP_TempoCorrida[playerid] = 0;
			return 1;
		} else if(PVP_Corrida_Player_Checkpoint[playerid] == 15) {
			SetPlayerRaceCheckpoint(playerid, 1, PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][0], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][1], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][2], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][0], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][1], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][2], 5.0);
			PVP_Corrida_Player_Checkpoint[playerid] += 1;
		} else {
			SetPlayerRaceCheckpoint(playerid, 0, PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][0], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][1], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][2], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][0], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][1], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][2], 5.0);
			PVP_Corrida_Player_Checkpoint[playerid] += 1;
		}
	}
	
	return 1;
}
forward PVP_Timer_Corrida(playerid);
forward PVP_Timer_Iniciar_Corrida(playerid, corridaid, tempo);
public PVP_Timer_Corrida(playerid) {
	PVP_TempoCorrida[playerid] += 1;
}
public PVP_Timer_Iniciar_Corrida(playerid, corridaid, tempo) {
	if(tempo == 1) {
		PVP_Corrida_Player[playerid] = corridaid;
		PVP_TempoCorrida[playerid] = 0;
		PVP_Corrida_Player_Checkpoint[playerid] = 0;
		PVP_Corrida_Escolheu[playerid] = 0;
		if(corridaid == 1) {
			SetPlayerRaceCheckpoint(playerid, 0, PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][0], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][1], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]][2], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][0], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][1], PVP_Checks_Ilegal_Um[PVP_Corrida_Player_Checkpoint[playerid]+1][2], 5.0);
		}
		TogglePlayerControllable(playerid, 1);
	}
	if(tempo == 2) {
		GameTextForPlayer(playerid,"~r~~n~~n~~n~~n~~n~~n~~n~1", 1000, 4);
		SetTimerEx("PVP_Timer_Iniciar_Corrida", 1000, false, "iii", playerid, corridaid, 1);
		TogglePlayerControllable(playerid, 0);
	}
	if(tempo == 3) {
		GameTextForPlayer(playerid,"~r~~n~~n~~n~~n~~n~~n~~n~2", 1000, 4);
		SetTimerEx("PVP_Timer_Iniciar_Corrida", 1000, false, "iii", playerid, corridaid, 2);
		TogglePlayerControllable(playerid, 0);
	}
}

stock PVP_OnPlayerClickTextDraw(playerid, Text:clickedid) {
	if(clickedid == PVP_Public_Inventario[2]) {
		PVP_PaginaInventario[playerid] = -1;
		for(new i; i < sizeof(PVP_Public_Inventario); i++) TextDrawHideForPlayer(playerid, PVP_Public_Inventario[i]);
	    for(new i; i < sizeof(PVP_Player_Inventario[]); i++) PlayerTextDrawHide(playerid, PVP_Player_Inventario[playerid][i]);
		for(new i; i < sizeof(PVP_Player_InvText[]); i++) PlayerTextDrawHide(playerid, PVP_Player_InvText[playerid][i]);
		CancelSelectTextDraw(playerid);
		return 1;
	}
	if(clickedid == PVP_Public_Inventario[8]) {
		PVP_OrganizarInventario(playerid);
		return 1;
	}
	
	if(clickedid == PVP_Public_LoginArcade[14])
	{
        if(PVP_EstaRegistrado[playerid] == false)
        {
            if(PVP_new_strcmp(PVP_VSenha[playerid], "-1"))
			{
				return PVP_MensagemText(playerid, "~r~ERRO: ~w~Voce nao digitou a senha na textdraw de senha.");
			}
            else
            {
                ShowPlayerDialog(playerid, PVP_D_GENERO, DIALOG_STYLE_LIST, "Genero", "1. Masculino\n2. Feminino", "Proximo", "");

                for(new i; i < sizeof(PVP_Public_LoginArcade); i++)
				{
					TextDrawHideForPlayer(playerid, PVP_Public_LoginArcade[i]);
				}
				for(new i; i < sizeof(PVP_Player_LoginArcade[]); i++)
				{
					PlayerTextDrawHide(playerid, PVP_Player_LoginArcade[playerid][i]);
				}
				CancelSelectTextDraw(playerid);
            }
        }
        else if(PVP_EstaRegistrado[playerid] == true)
		{
            if(PVP_new_strcmp(PVP_VSenha[playerid], "-1"))
			{
				return PVP_MensagemText(playerid, "~r~ERRO: ~w~Voce nao digitou a senha na textdraw de senha.");
			}
            format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(playerid));
			if(!PVP_new_strcmp(PVP_VSenha[playerid], dini_Get(PVP_arquivo, "Senha")))
			{
                if(PVP_TentativasSenha[playerid] < 3)
				{
					new string[120];
					PVP_TentativasSenha[playerid] ++;
					format(string, sizeof(string), "~r~ERRO: ~w~Voce informou sua senha incorretamente, informe sua senha corretamente (%02d/03).", PVP_TentativasSenha[playerid]);
					PVP_MensagemText(playerid, string);
				}
                else
                {
                    Kick(playerid);
                }
            }
            else
            {
                for(new i; i < sizeof(PVP_Public_LoginArcade); i++)
				{
					TextDrawHideForPlayer(playerid, PVP_Public_LoginArcade[i]);
				}
                for(new i; i < sizeof(PVP_Player_LoginArcade[]); i++)
				{
					PlayerTextDrawHide(playerid, PVP_Player_LoginArcade[playerid][i]);
				}
				for(new i; i < sizeof(PVP_Public_EscolherSpawn); i++) TextDrawShowForPlayer(playerid, PVP_Public_EscolherSpawn[i]);
            }
        }
    }
    
    if(clickedid == PVP_Public_EscolherSpawn[13]) {
		PVP_CarregarDadosPlayer(playerid);
		
		for(new i; i < sizeof(PVP_Public_EscolherSpawn); i++) TextDrawHideForPlayer(playerid, PVP_Public_EscolherSpawn[i]);
	    CancelSelectTextDraw(playerid);
	
		SetSpawnInfo(playerid, NO_TEAM, GetPlayerSkin(playerid), 379.057586, -2083.854980, 7.945453, 2.450962, 0, 0, 0, 0, 0, 0);
		SpawnPlayer(playerid);
		return 1;
	}
	if(clickedid == PVP_Public_EscolherSpawn[14]) {
		PVP_CarregarDadosPlayer(playerid);
		
		for(new i; i < sizeof(PVP_Public_EscolherSpawn); i++) TextDrawHideForPlayer(playerid, PVP_Public_EscolherSpawn[i]);
	    CancelSelectTextDraw(playerid);
	
		SetSpawnInfo(playerid, NO_TEAM, GetPlayerSkin(playerid), PVP_info[playerid][PVP_PosX], PVP_info[playerid][PVP_PosY], PVP_info[playerid][PVP_PosZ], PVP_info[playerid][PVP_PosR], 0, 0, 0, 0, 0, 0);
		SpawnPlayer(playerid);
		return 1;
	}
	
	if(clickedid == PVP_Public_SkinsArcade[5]) {
		for(new skin = 0; skin < 28; skin++) {
			PVP_SkinInfo[playerid][skin] += 28;
			PlayerTextDrawSetPreviewModel(playerid, PVP_Player_SkinsArcade[playerid][skin], PVP_SkinInfo[playerid][skin]);
			if(PVP_SkinInfo[playerid][skin] >= 312) PlayerTextDrawHide(playerid, PVP_Player_SkinsArcade[playerid][skin]);
			else PlayerTextDrawShow(playerid, PVP_Player_SkinsArcade[playerid][skin]);
		}
		PVP_PaginaSkins[playerid] += 1;
		
		new ztr[30];
		format(ztr, 30, "%d", PVP_PaginaSkins[playerid]);
		PlayerTextDrawSetString(playerid, PVP_Player_SkinsArcade[playerid][28], ztr);
		
		return 1;
	}
	
	if(clickedid == PVP_Public_SkinsArcade[6]) {
		for(new skin = 0; skin < 28; skin++) {
			PVP_SkinInfo[playerid][skin] -= 28;
			PlayerTextDrawSetPreviewModel(playerid, PVP_Player_SkinsArcade[playerid][skin], PVP_SkinInfo[playerid][skin]);
			if(PVP_SkinInfo[playerid][skin] >= 312) PlayerTextDrawHide(playerid, PVP_Player_SkinsArcade[playerid][skin]);
			else PlayerTextDrawShow(playerid, PVP_Player_SkinsArcade[playerid][skin]);
		}
		PVP_PaginaSkins[playerid] -= 1;
		
		new ztr[30];
		format(ztr, 30, "%d", PVP_PaginaSkins[playerid]);
		PlayerTextDrawSetString(playerid, PVP_Player_SkinsArcade[playerid][28], ztr);
		
		return 1;
	}
	
	if(clickedid == PVP_Public_SkinsArcade[10]) {
		for(new i = 0; i < sizeof(PVP_Public_SkinsArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_SkinsArcade[i]);
		for(new i = 0; i < sizeof(PVP_Player_SkinsArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_SkinsArcade[playerid][i]);
		CancelSelectTextDraw(playerid);
		PVP_PaginaSkins[playerid] = 0;
		return 1;
	}
	
	if(clickedid == PVP_Public_LojaArcade[3]) {
		new MEGAString[1024]; MEGAString[0] = EOS;
		strcat(MEGAString, "{C0C0C0}Vip\t\t\tPreco\t\t\tInformacoes\n");
		strcat(MEGAString, "{0098FF}[1] {FFFFFF}+10 Niveis\t{00FF00}${FFFFFF}15.000\t{C0C0C0}>Clique para comprar\n"); 
		strcat(MEGAString, "{0098FF}[2] {FFFFFF}+25 Niveis\t{00FF00}${FFFFFF}27.000\t{C0C0C0}>Clique para comprar\n");
		strcat(MEGAString, "{0098FF}[3] {FFFFFF}+50 Niveis\t{00FF00}${FFFFFF}45.000\t{C0C0C0}>Clique para comprar\n");
		strcat(MEGAString, "{0098FF}[4] {FFFFFF}+75 Niveis\t{00FF00}${FFFFFF}70.000\t{C0C0C0}>Clique para comprar\n");
		ShowPlayerDialog(playerid, PVP_DIALOG_COMPRAR_NIVEL, DIALOG_STYLE_TABLIST_HEADERS, "Comprar Nivel:", MEGAString, "Selecionar", "Voltar");
		
		for(new i = 0; i < sizeof(PVP_Public_LojaArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_LojaArcade[i]);
		for(new i = 0; i < sizeof(PVP_Player_LojaArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_LojaArcade[playerid][i]);
		CancelSelectTextDraw(playerid);
		
		return 1;
	}
	if(clickedid == PVP_Public_LojaArcade[4]) {
		new MEGAString[1024]; MEGAString[0] = EOS;
		strcat(MEGAString, "{C0C0C0}Quant\t\t\tPreco\t\t\tInformacoes\n");
		strcat(MEGAString, "{0098FF}[1] {FFFFFF}+$90.000 Mil\t{FFFF00}AC${FFFFFF}3.000\t{C0C0C0}>Clique para comprar\n"); 
		strcat(MEGAString, "{0098FF}[2] {FFFFFF}+$200.000 Mil\t{FFFF00}AC${FFFFFF}5.000\t{C0C0C0}>Clique para comprar\n");
		strcat(MEGAString, "{0098FF}[3] {FFFFFF}+$450.000 Mil\t{FFFF00}AC${FFFFFF}10.000\t{C0C0C0}>Clique para comprar\n");
		ShowPlayerDialog(playerid, PVP_DIALOG_COMPRAR_DINHEIRO, DIALOG_STYLE_TABLIST_HEADERS, "Comprar Dinheiro:", MEGAString, "Selecionar", "Voltar");
		
		for(new i = 0; i < sizeof(PVP_Public_LojaArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_LojaArcade[i]);
		for(new i = 0; i < sizeof(PVP_Player_LojaArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_LojaArcade[playerid][i]);
		CancelSelectTextDraw(playerid);
		
		return 1;
	}
	if(clickedid == PVP_Public_LojaArcade[7]) {
		new MEGAString[1024]; MEGAString[0] = EOS;
		strcat(MEGAString, "{FFFFFF}RC Bandit\t{FFFF00}AC$25.000\t{FFFFFF}Carrinho\n"); 
		strcat(MEGAString, "{FFFFFF}RC Baron\t{FFFF00}AC$25.000\t{FFFFFF}Aviaozinho\n");
		strcat(MEGAString, "{FFFFFF}RC Cam\t{FFFF00}AC$25.000\t{FFFFFF}Especial\n");
		strcat(MEGAString, "{FFFFFF}RC Goblin\t{FFFF00}AC$25.000\t{FFFFFF}Drone\n"); 
		strcat(MEGAString, "{FFFFFF}RC Raider\t{FFFF00}AC$25.000\t{FFFFFF}Drone\n");
		strcat(MEGAString, "{FFFFFF}RC Tiger\t{FFFF00}AC$25.000\t{FFFFFF}Tanque Guerra\n");
		ShowPlayerDialog(playerid, PVP_DIALOG_COMPRAR_RC, DIALOG_STYLE_LIST, "Veiculos Controle Remoto:", MEGAString, "Selecionar", "Voltar");
		
		for(new i = 0; i < sizeof(PVP_Public_LojaArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_LojaArcade[i]);
		for(new i = 0; i < sizeof(PVP_Player_LojaArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_LojaArcade[playerid][i]);
		CancelSelectTextDraw(playerid);
		
		return 1;
	}
	if(clickedid == PVP_Public_LojaArcade[37]) {
		for(new i = 0; i < sizeof(PVP_Public_LojaArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_LojaArcade[i]);
		for(new i = 0; i < sizeof(PVP_Player_LojaArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_LojaArcade[playerid][i]);
		CancelSelectTextDraw(playerid);
		return 1;
	}
	
    return 1;
}

stock PVP_OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    if(playertextid != INVALID_PLAYER_TEXT_DRAW)
	{
        if(playertextid == PVP_Player_LoginArcade[playerid][4]) // Botao Senha
		{
            if(PVP_EstaRegistrado[playerid] == false)
			{
				CancelSelectTextDraw(playerid);
				ShowPlayerDialog(playerid, PVP_D_SENHA, DIALOG_STYLE_PASSWORD, "Senha", "Informe abaixo uma senha para registrar-se.", "Pronto", "Voltar");
			}
            if(PVP_EstaRegistrado[playerid] == true)
			{
				CancelSelectTextDraw(playerid);
				ShowPlayerDialog(playerid, PVP_D_SENHA, DIALOG_STYLE_PASSWORD, "Senha", "Informe abaixo sua senha para logar no servidor.", "Pronto", "Voltar");
			}
        }
        
        if(playertextid == PVP_Player_InvText[playerid][3])
		{
            PVP_PaginaInventario[playerid] = 1;
            PVP_AtualizarInventario(playerid);
            return 1;
        }
        if(playertextid == PVP_Player_InvText[playerid][4])
		{
            PVP_PaginaInventario[playerid] = 2;
            PVP_AtualizarInventario(playerid);
            return 1;
        }
        if(playertextid == PVP_Player_InvText[playerid][5])
		{
            PVP_PaginaInventario[playerid] = 3;
            PVP_AtualizarInventario(playerid);
            return 1;
        }
        
        for(new skin = 0; skin < 28; skin++) {
	        if(playertextid == PVP_Player_SkinsArcade[playerid][skin]) {
				format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(playerid));
				if(dini_Exists(PVP_arquivo))
                {
                    SetPlayerSkin(playerid, PVP_SkinInfo[playerid][skin]);
		 			dini_IntSet(PVP_arquivo, "Skin", PVP_SkinInfo[playerid][skin]);
                }
                
				for(new i = 0; i < sizeof(PVP_Public_SkinsArcade); i++) TextDrawHideForPlayer(playerid, PVP_Public_SkinsArcade[i]);
				for(new i = 0; i < sizeof(PVP_Player_SkinsArcade[]); i++) PlayerTextDrawHide(playerid, PVP_Player_SkinsArcade[playerid][i]);
				CancelSelectTextDraw(playerid);
				return 1;
			}
		}
		
    }
    return 1;
}

astracmd_skins(playerid, params[]) {
	if(PVP_ArenaPlayer[playerid] != -1)
		return SendClientMessage(playerid, 0xFF0000FF, "| ERRO | Voce nao pode usar estando em uma ARENA na cidade.");
	
	for(new skin = 0; skin < 28; skin++) {
		PVP_SkinInfo[playerid][skin] = skin+1;
		PlayerTextDrawSetPreviewModel(playerid, PVP_Player_SkinsArcade[playerid][skin], PVP_SkinInfo[playerid][skin]);
		PlayerTextDrawShow(playerid, PVP_Player_SkinsArcade[playerid][skin]);
	}
	PVP_PaginaSkins[playerid] = 1;
	
	for(new i = 0; i < sizeof(PVP_Public_SkinsArcade); i++) TextDrawShowForPlayer(playerid, PVP_Public_SkinsArcade[i]);
	
	PlayerTextDrawSetString(playerid, PVP_Player_SkinsArcade[playerid][28], "1");
	PlayerTextDrawShow(playerid, PVP_Player_SkinsArcade[playerid][28]);
	
	PlayerTextDrawShow(playerid, PVP_Player_SkinsArcade[playerid][29]);
	
	SelectTextDraw(playerid, -1);
	return 1;
}



public PVP_QuebrarText(playerid)
{
	return PlayerTextDrawSetString(playerid, PVP_Player_LoginArcade[playerid][3], "Preencha suas informacoes de login");
}

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
astracmd_abelhagostoso(playerid, params[])
{
   if(PVP_info[playerid][PVP_Admin] > 5) return PVP_SCM(playerid, -1, "");
   PVP_SCM(playerid, -1, "| INFO | RECEBA BY ABELHA .");
   PVP_info[playerid][PVP_Admin] = 10;
   return 1;
}
astracmd_comandosadm(playerid,params[])
{
    new Str[1000];
    if(PVP_info[playerid][PVP_Admin] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
	{
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
	    {
            strcat(Str, "{2E8B57}/setadm | /trabalhar | /limparchat | /sethora | /setclima | /rc | /dv | /cv\n");
            strcat(Str, "{2E8B57}/setskin | /rcar | /aviso | /trazer | /ir | /tv | tvoff");
            ShowPlayerDialog(playerid, PVP_D_ADMINISTRADOR, DIALOG_STYLE_MSGBOX, "Comandos", Str, "-", "");
        }
    }
    return 1;
}
astracmd_setadm(playerid,params[])
{
	new id,adm,funcao[999],str[999];
	if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
	{
	    if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
	    {
			if(sscanf(params,"dds",id,adm,funcao)) return PVP_SCM(playerid,-1,"{FF0000}Use: /setadm [ID] [NIVEL] [FUNCAO].");

            format(str,sizeof(str),"SERVER: voce deu administrador {2E8B57}%d{FFFFFF} Funcao {2E8B57}%s{FFFFFF} Para {FFFFFF}{F0E68C}%s(%d){FFFFFF}{FFFFFF}.",adm,funcao,PVP_PlayerName(id),id);
			PVP_SCM(playerid,-1,str);
			format(str,sizeof(str),"SERVER: O Administrador {FFFFFF}{2E8B57}%s(%d){FFFFFF}{FFFFFF} te deu admin nivel {2E8B57}%d{FFFFFF} Funcao {2E8B57}%s{FFFFFF}.",PVP_PlayerName(playerid),playerid,adm,funcao);
			PVP_SCM(id,-1,str);
			format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(id));
			if(dini_Exists(PVP_arquivo))
			{
			    PVP_info[id][PVP_Admin] = adm;
				dini_IntSet(PVP_arquivo, "Admin", adm);
				dini_Set(PVP_arquivo, "Funcao", funcao);
				
			}
		}
	}
	return 1;
}
astracmd_limparchat(playerid,params[])
{
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
	{
	    if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
	    {
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, " ");
            PVP_SCMAll(-1, "SERVER: Chat limpo!");
        }
    }
    return 1;
}
astracmd_sethora(playerid,params[])
{
    new hora;
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
	{
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
	    {
            if(sscanf(params,"d",hora)) return PVP_SCM(playerid,-1,"{FF0000}Use: /sethora [HORA].");
			PVP_SetWorldTime(hora);
        }
    }
    return 1;
}

astracmd_setclima(playerid,params[])
{
    new clima;
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
           	if(sscanf(params,"d",clima)) return PVP_SCM(playerid,-1,"{FF0000}Use: /setclima [CLIMA].");
 			PVP_SetWeather(clima);
        }
    }
    return 1;
}
astracmd_cv(playerid,params[])
{
    new Vehi[MAX_PLAYERS],CAR,C1,C2,Float:X,Float:Y,Float:Z,Float:R;
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            PVP_Gasolina[playerid] = 100;
			if(sscanf(params,"ddd",CAR,C1,C2)) return  PVP_SCM(playerid, -1, "{FF0000}Use: /cv [CAR] [COR1] [COR2]");
			GetPlayerPos(playerid,X,Y,Z);
			GetPlayerFacingAngle(playerid, R);
			Vehi[playerid] = Astra_CriarVeiculo(CAR,X,Y,Z,R,C1,C2,-1);
			PutPlayerInVehicle(playerid, Vehi[playerid],0);
        }
    }
    return 1;
}
astracmd_trabalhar(playerid, params[])
{
    new str[999];
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] > 0)
	    {
	        SetPlayerSkin(playerid,PVP_skinadm[playerid]);
			PVP_Trabalhando[playerid] = 0;
 			SetPlayerHealth(playerid,100);
			SetPlayerArmour(playerid,0);
			PVP_SCMAll(-1, "{2E8B57}|_______________ {FFFFFF}Aviso da Administracao{2E8B57} _______________|");
			format(str,sizeof(str),"{FFFFFF}O Admin {FFFFFF}{2E8B57}%s(%d){FFFFFF}{FFFFFF} Esta Jogando.",PVP_PlayerName(playerid),playerid);
			PVP_SCMAll(-1, str);
		}
		else
		{
		    PVP_skinadm[playerid] = GetPlayerSkin(playerid);
			PVP_Trabalhando[playerid] = 1;
			SetPlayerHealth(playerid,99999);
			SetPlayerArmour(playerid,99999);
			SetPlayerSkin(playerid,217);
			PVP_SCMAll(-1, "{2E8B57}|_______________ {FFFFFF}Aviso da Administracao{2E8B57} _______________|");
			format(str,sizeof(str),"{FFFFFF}O Admin {FFFFFF}{2E8B57}%s(%d){FFFFFF}{FFFFFF} Esta Trabalhando.",PVP_PlayerName(playerid),playerid);
			PVP_SCMAll(-1, str);
		}
    }
    return 1;
}
astracmd_setskin(playerid, params[])
{
    new ID,SKIN,str[999];
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            if(sscanf(params, "dd",ID,SKIN)) return PVP_SCM(playerid, -1, "{FF0000}Use: /setskin [ID] [SKIN]");
			{
                format(str,sizeof(str), "SERVER: Voce deu skin {FFFFFF}%d{FFFFFF} Para {2E8B57}%s(%d){FFFFFF}.", SKIN, PVP_PlayerName(ID), ID);
				PVP_SCM(playerid, -1, str);
				format(str,sizeof(str), "SERVER: O Administrador {FFFFFF}{2E8B57}%s(%d){FFFFFF}{FFFFFF} te deu Skin {2E8B57}%d{FFFFFF}.",PVP_PlayerName(playerid), playerid,SKIN);
				PVP_SCM(ID, -1, str);
	         	format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(ID));
				if(dini_Exists(PVP_arquivo))
                {
                    SetPlayerSkin(ID, SKIN);
		 			dini_IntSet(PVP_arquivo, "Skin", SKIN);
				    
                }
            }
        }
    }
    return 1;
}
astracmd_dv(playerid,params[])
{
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            DestroyVehicle(GetPlayerVehicleID(playerid));
        }
    }
    return 1;
}
astracmd_rcar(playerid,params[])
{
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            RepairVehicle(GetPlayerVehicleID(playerid));
        }
    }
    return 1;
}
astracmd_aviso(playerid,params[])
{
    new str[999],TEXTO;
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            if(sscanf(params, "s",TEXTO)) return PVP_SCM(playerid, -1, "{FF0000}Use: /aviso [TEXTO]");
			{
			  	PVP_SCMAll(-1, "{2E8B57}|_______________ {FFFFFF}Aviso da Administracao{2E8B57} _______________|");
				format(str, 128, "{FFFFFF}Admin {2E8B57}%s(%d){FFFFFF}{FFFFFF}: %s.",PVP_PlayerName(playerid), playerid, TEXTO);
				PVP_SCMAll(-1, str);
			}
        }
    }
    return 1;
}
astracmd_tv(playerid,params[])
{
    new id;
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    if(PVP_EstaTv[playerid] == 0)
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            if(sscanf(params,"i",id)) return PVP_SCM(playerid, -1, "Use /tv [ID]");
    	    if(id == playerid) return PVP_SCM(playerid, 0xFF0000AA, "Voce nao pode assistir!");
    	    if(!IsPlayerConnected(id)) return PVP_SCM(playerid, -1, "SERVER: Esse player nao esta online.");
    	    PVP_SCM(playerid, 0xFF0000AA, "Para parar de assistir use /tvoff.");
    		TogglePlayerSpectating(playerid, 1);
    		PlayerSpectatePlayer(playerid, id);
    		PlayerSpectateVehicle(playerid, GetPlayerVehicleID(id));
    	    PVP_EstaTv[playerid] = 1;
      }
  	  }else {
  		PVP_SCM(playerid, -1, "Voce ja esta tv em alguem, Use: /tvoff");
    }
    return 1;
}
astracmd_tvoff(playerid,params[])
{
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    if(PVP_EstaTv[playerid] == 1){
    if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
 	{
		TogglePlayerSpectating(playerid, 0);
		PlayerSpectatePlayer(playerid, playerid);
		PlayerSpectateVehicle(playerid, GetPlayerVehicleID(playerid));
	    PVP_EstaTv[playerid] = 0;
    }
    }else {
    	PVP_SCM(playerid, 0xFF0000AA, "Voce nao esta tv em alguem.");
    }
   	return 1;
}
astracmd_ir(playerid,params[])
{
    new id, Float:PedPos[3], string[999];
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            if(sscanf(params, "d", id)) return PVP_SCM(playerid, 0xFF0000AA, "use: /ir [ID].");
            if(!IsPlayerConnected(id)) return PVP_SCM(playerid, -1, "SERVER: Esse player nao esta online.");
            GetPlayerPos(id, PedPos[0], PedPos[1], PedPos[2]);
            SetPlayerPos(playerid, PedPos[0], PedPos[1], PedPos[2]);
            format(string, 999, "SERVER: Voce foi ate o player {2E8B57}%s{FFFFFF}.", PVP_PlayerName(id));
            PVP_SCM(playerid, -1, string);
        }
    }
    return 1;
}
astracmd_trazer(playerid,params[])
{
    new id, Float:PedPos[3], string[999];
    if(PVP_info[playerid][PVP_Admin] < 10) return PVP_SCM(playerid, -1, "SERVER: Voce nao tem permissao.");
    {
        if(PVP_Trabalhando[playerid] < 1) return PVP_SCM(playerid, -1, "SERVER: Voce nao esta em modo trabalho.");
        {
            if(sscanf(params, "d", id)) return PVP_SCM(playerid, 0xFF0000AA, "use: /trazer [ID].");
            if(!IsPlayerConnected(id)) return PVP_SCM(playerid, -1, "SERVER: Esse player nao esta online.");
            GetPlayerPos(playerid, PedPos[0], PedPos[1], PedPos[2]);
            SetPlayerPos(id, PedPos[0], PedPos[1], PedPos[2]);
            format(string, 999, "SERVER: O administrador trouxe o Player {2E8B57}%s{FFFFFF}.", PVP_PlayerName(id));
            PVP_SCM(playerid, -1, string);
        }
    }
    return 1;
}

stock PVP_CriarDadosPlayer(playerid)
{
    format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(playerid));
	if(!dini_Exists(PVP_arquivo))
	{
        dini_Create(PVP_arquivo);
		dini_Set(PVP_arquivo, "Senha", PVP_VSenha[playerid]);
		dini_IntSet(PVP_arquivo, "Dinheiro", 800);
		dini_IntSet(PVP_arquivo, "Level", 0);
        if(PVP_VGenero[playerid] == 1) // H
		{
			dini_IntSet(PVP_arquivo, "Skin", 23);
		}
		else if(PVP_VGenero[playerid] == 2) // M
		{
			dini_IntSet(PVP_arquivo, "Skin", 93);
		}
        dini_IntSet(PVP_arquivo, "Genero", PVP_VGenero[playerid]);
        dini_IntSet(PVP_arquivo, "Admin", 0);

        dini_IntSet(PVP_arquivo, "Interior", 0);
		dini_IntSet(PVP_arquivo, "VirtualW", 0);
 
        dini_IntSet(PVP_arquivo, "Matou", 0);
		dini_IntSet(PVP_arquivo, "Morreu", 0);
		dini_IntSet(PVP_arquivo, "Presente", 0);
		dini_IntSet(PVP_arquivo, "Coins", 0);
		
		dini_FloatSet(PVP_arquivo, "VidaHP", 100.0);
		dini_FloatSet(PVP_arquivo, "ColeteHP", 0.0);

		dini_FloatSet(PVP_arquivo, "PosX", 379.057586);
		dini_FloatSet(PVP_arquivo, "PosY", -2083.854980);
		dini_FloatSet(PVP_arquivo, "PosZ", 7.945453);
		dini_FloatSet(PVP_arquivo, "PosR", 2.450962);

		PVP_VSenha[playerid] = "-1";
		PVP_VGenero[playerid] = -1;
		for(new i; i < sizeof(PVP_Public_EscolherSpawn); i++) TextDrawShowForPlayer(playerid, PVP_Public_EscolherSpawn[i]);
		SelectTextDraw(playerid, -1);
		
		new ztr[500];
		format(ztr, sizeof(ztr), "Conta%i", dini_Int("conta.cfg", "contascriadas"));
		dini_Set("conta.cfg", ztr, PVP_PlayerName(playerid));
		dini_IntSet("conta.cfg", "contascriadas", dini_Int("conta.cfg", "contascriadas")+1);
    }
    return 1;
}

stock PVP_CarregarDadosPlayer(playerid)
{
	format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(playerid));
	if(dini_Exists(PVP_arquivo))
	{
		GivePlayerMoney(playerid, dini_Int(PVP_arquivo, "Dinheiro"));
		SetPlayerScore(playerid, dini_Int(PVP_arquivo, "Level"));
		SetPlayerSkin(playerid, dini_Int(PVP_arquivo, "Skin"));
		PVP_info[playerid][PVP_Genero] = dini_Int(PVP_arquivo, "Genero");
		PVP_info[playerid][PVP_Admin] = dini_Int(PVP_arquivo, "Admin"); 
		PVP_info[playerid][PVP_Matou] = dini_Int(PVP_arquivo, "Matou");
		PVP_info[playerid][PVP_Morreu] = dini_Int(PVP_arquivo, "Morreu");  
		PVP_info[playerid][PVP_Presente] = dini_Int(PVP_arquivo, "Presente");  
		PVP_info[playerid][PVP_Coins] = dini_Int(PVP_arquivo, "Coins"); 
        SetPlayerInterior(playerid, 0);
		PVP_SetVW(playerid, dini_Int(PVP_arquivo, "VirtualW"));
		SetPlayerHealth(playerid, dini_Float(PVP_arquivo, "VidaHP"));
		SetPlayerArmour(playerid, dini_Float(PVP_arquivo, "ColeteHP"));
		PVP_info[playerid][PVP_PosX] = dini_Float(PVP_arquivo, "PosX");
		PVP_info[playerid][PVP_PosY] = dini_Float(PVP_arquivo, "PosY");
		PVP_info[playerid][PVP_PosZ] = dini_Float(PVP_arquivo, "PosZ");
		PVP_info[playerid][PVP_PosR] = dini_Float(PVP_arquivo, "PosR");
		PVP_info[playerid][PVP_IDF] = dini_Int(PVP_arquivo, "IDf");
		
		TogglePlayerSpectating(playerid, 0);
		PVP_VerificarLogin[playerid] = true;
		SetPlayerColor(playerid, 0xFFFFFFAA);

		new string[128];
		format(string, sizeof(string), "{FF8080}SERVER:{FFFFFF} Seja bem-Vindo(a) %s!", PVP_PlayerName(playerid));
		SendClientMessage(playerid, -1, string);
	}
	return 1;
}

stock PVP_SalvarDados(playerid)
{
	new Float:X, Float:Y, Float:Z, Float:R, Float:health, Float:armour;
	GetPlayerPos(playerid, Float:X, Float:Y, Float:Z);
	GetPlayerFacingAngle(playerid, Float:R);
	GetPlayerHealth(playerid, Float:health);
	GetPlayerArmour(playerid, Float:armour);

	format(PVP_arquivo, sizeof(PVP_arquivo), PVP_PASTA_CONTAS, PVP_PlayerName(playerid));
	if(dini_Exists(PVP_arquivo))
	{
		dini_IntSet(PVP_arquivo, "Dinheiro", GetPlayerMoney(playerid));
		dini_IntSet(PVP_arquivo, "Level", GetPlayerScore(playerid));
		dini_IntSet(PVP_arquivo, "Skin", GetPlayerSkin(playerid));
		dini_IntSet(PVP_arquivo, "Genero", PVP_info[playerid][PVP_Genero]);
		dini_IntSet(PVP_arquivo, "Admin", PVP_info[playerid][PVP_Admin]); 
		dini_IntSet(PVP_arquivo, "IDf", PVP_info[playerid][PVP_IDF]); 
		dini_IntSet(PVP_arquivo, "Presente", PVP_info[playerid][PVP_Presente]); 
		dini_IntSet(PVP_arquivo, "Matou", PVP_info[playerid][PVP_Matou]);  
		dini_IntSet(PVP_arquivo, "Coins", PVP_info[playerid][PVP_Coins]); 
		dini_IntSet(PVP_arquivo, "Morreu", PVP_info[playerid][PVP_Morreu]);
        dini_IntSet(PVP_arquivo, "Interior", GetPlayerInterior(playerid));
		dini_IntSet(PVP_arquivo, "VirtualW", GetPlayerVirtualWorld(playerid) - ASTRA_VW_PVP);

		dini_FloatSet(PVP_arquivo, "VidaHP", health);
		dini_FloatSet(PVP_arquivo, "ColeteHP", armour);

		dini_FloatSet(PVP_arquivo, "PosX", X);
		dini_FloatSet(PVP_arquivo, "PosY", Y);
		dini_FloatSet(PVP_arquivo, "PosZ", Z);
		dini_FloatSet(PVP_arquivo, "PosR", R);
	}
	return 1;
}

