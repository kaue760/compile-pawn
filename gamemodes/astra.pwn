	RemoveBuildingForPlayer(playerid, 3673, 247.9297, 1461.8594, 33.4141, 0.25);
	RemoveBuildingForPlayer(playerid, 3675, 254.6797, 1464.6328, 22.4688, 0.25);
	RemoveBuildingForPlayer(playerid, 3674, 247.5547, 1471.0938, 35.8984, 0.25);
	RemoveBuildingForPlayer(playerid, 3675, 255.5313, 1472.9766, 19.7578, 0.25);
	RemoveBuildingForPlayer(playerid, 3675, 252.8125, 1473.8281, 11.4063, 0.25);
	RemoveBuildingForPlayer(playerid, 3675, 252.1250, 1473.8906, 16.2969, 0.25);
	RemoveBuildingForPlayer(playerid, 16089, 342.1250, 1431.0938, 5.2734, 0.25);
	RemoveBuildingForPlayer(playerid, 16090, 315.7734, 1431.0938, 5.2734, 0.25);
	RemoveBuildingForPlayer(playerid, 16091, 289.7422, 1431.0938, 5.2734, 0.25);
	return 1;
}

public OnPlayerDisconnect(playerid, reason)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) PVP_OnPlayerDisconnect(playerid, reason);
	AstraModo[playerid] = ASTRA_MODO_NENHUM;

	new path[50],xNome[32]; GetPlayerName(playerid,xNome,sizeof(xNome));
	format(path,sizeof(path),"%s/%s.ini",PATH,xNome);
	if(!DOF2_FileExists(path)) DOF2_CreateFile(path);
	DOF2_SetInt(path,"BuyRadio",BuyRadio[playerid]);
	DOF2_SaveFile();
    
	if(playerid < MAX_PLAYERS){
	    Na_Mala[playerid] = 0;
	    for(new V = 1; V < MAX_VEHICLES; V++) if(PlayerNoVeiculo[V] == playerid+1){ PlayerNoVeiculo[V] = 0; break; }
    }
    for(new i = 0; i < 4; i++) PorCofr_Plys[i][playerid] = 0;
	FrequenciaConectada[playerid] = -1;
	if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) RemovePlayerAttachedObject(playerid, 9);
	if(TempoAbrindo[playerid] > 0)
	{
	    AbrindoCarro[playerid] = 0;
	    KillTimer(TempoAbrindo[playerid]);
	}
	kPegoRad[playerid] =0 ;
    JogadoresConectados --;
	if(Spawnado[playerid] == true && AcertouAsenha[playerid] == true)
	{
	    Spawnado[playerid] = false;
        AdminEspiando[playerid] = 0;
        if(EntrouPVP[playerid] == 1)
	    {
	        DOF2_SetFloat(String, "PosX", -2281.6362);
			DOF2_SetFloat(String, "PosY", 2288.4131);
			DOF2_SetFloat(String, "PosZ", 4.9698);
			DOF2_SetInt(String, "UltimoInterior", 0);
			DOF2_SetInt(String, "UltimoMundo", 0);
	    }
		EntrouPVP[playerid] = 0;
	    if(TimerFuga[playerid])
	    {
			KillTimer(TimerFuga[playerid]); TimerFuga[playerid] = 0;
	    }
        new string[75], Float:QuitPos[3], motivo[][] =
		{
 	       "Timeout/Crash",
 	       "Quit",
           "Kick/Ban"
	    };
  	    format(string, sizeof string, "{FF0000}Quit\n{FFFFFF}Nick: %s\nMotivo: %s", PlayerName(playerid), motivo[reason]);//format
	    GetPlayerPos(playerid, QuitPos[0], QuitPos[1], QuitPos[2]);//Getar posição dp player
  	    Label = Create3DTextLabel(string,-1,QuitPos[0],QuitPos[1],QuitPos[2],9.0,0,0);//criar 3dtextlabel com ultima posição + motivo do quit
        if(BlockPlayerDisconnect[playerid] >= 1)
	    {
	        if(reason == 1)
	        {
	        
	            format(String, sizeof(String), "BansPermanentes/%s.ini", PlayerName(playerid));
	            if(!DOF2_FileExists(String))
	            {
					DOF2_CreateFile(String);
	            }
	           	new STRDATA[30], Hora, Minuto, Dia, Mes, Ano; gettime(Hora, Minuto); getdate(Dia, Mes, Ano);
	            format(STRDATA, sizeof(STRDATA), "%02d/%02d/%02d - %02d:%02d", Ano, Mes, Dia, Hora, Minuto);
				new IP[20]; GetPlayerIp(playerid, IP, sizeof(IP));
				
				DOF2_SetString(String, "AdminResponsavel", "Malvadao");
				DOF2_SetString(String, "Data", STRDATA);
				DOF2_SetString(String, "IP", IP);
				DOF2_SetString(String, "Motivo", "Temporario");
				DOF2_SaveFile();
				
	            format(String, sizeof(String), "| BP-Admin | Malvadao baniu o(a) jogador(a) %s ( Motivo: Temporario )", PlayerName(playerid));
	            SendClientMessageToAll(0xFF0000FF, String);
	            
	        }
	    }

	    if(Algemado[playerid] > 0)
	    {
	    	if(reason == 1)
	        {
	     		format(String, sizeof(String), "| ANTI-RP | O(A) Jogador(a) %s(%d) saiu do servidor algemado e foi preso por 20 minutos", PlayerName(playerid), playerid);
			    SendClientMessageToAll(0x84FF00AA, String);
		        MinutosMorte[playerid] = 0; SegundosMorte[playerid] = 0;
		        MinutosPreso[playerid] += 20; SegundosPreso[playerid] = 1;
		        format(MotivoPrisaoAdmin[playerid], 30, "Desconectou Algemado");
			}
		}
		else if(TimerAbordo[playerid] > 0 || SegundosPerseguidoCorp[playerid] > 0)
	    {
	        if(reason == 1)
	        {
	     		format(String, sizeof(String), "| ANTI-RP | O(A) Jogador(a) %s(%d) saiu do servidor em perseguicao e foi preso por 30 minutos", PlayerName(playerid), playerid);
			    SendClientMessageToAll(0x84FF00AA, String);
		        MinutosMorte[playerid] = 0; SegundosMorte[playerid] = 0;
		        MinutosPreso[playerid] += 30; SegundosPreso[playerid] = 1;
		        format(MotivoPrisaoAdmin[playerid], 30, "Desconectou em Perseguicao");
			}
		}

		else if(SegundosSequestrado[playerid] > 0 || SegundosAmarrado[playerid] > 0)
		{
		    if(reason == 1)
		    {
		        format(String, sizeof(String), "| ANTI-RP | O(A) Jogador(a) %s(%d) saiu do servidor em sequestro e foi preso 40 minutos", PlayerName(playerid), playerid);
				SendClientMessageToAll(0x84FF00AA, String);
				MinutosMorte[playerid] = 0; SegundosMorte[playerid] = 0;
				MinutosPreso[playerid] += 40; SegundosPreso[playerid] = 1;
				format(MotivoPrisaoAdmin[playerid], 30, "Desconectou em Sequestro");
			}
		}
		
		//VOIP
		if (lstream[playerid])
		{
			SvDeleteStream(lstream[playerid]);
			lstream[playerid] = SV_NULL;
		}
		SalvarPlayer(playerid);
		//
		DestroyDynamic3DTextLabel(TextStaff[playerid][0]);
		DestroyDynamic3DTextLabel(TextStaff[playerid][1]);
		//
  	  	DestroyDynamic3DTextLabel(TextoMaleta[playerid]);
    	DestroyDynamic3DTextLabel(pMaterial[playerid]);
    	DestroyDynamic3DTextLabel(TextoBarreira[playerid]);
    	DestroyDynamic3DTextLabel(TextoTapete[playerid]);
    	DestroyDynamic3DTextLabel(TextoBarraca[playerid]);
    	for(new t; t < 12; t++)
	    {
	        TextDrawHideForPlayer(playerid, Status[t]);
	    }
	    //
	    new PastaVeiculos[40], KeyV[25], bool:salvar;
	    format(PastaVeiculos, sizeof(PastaVeiculos), "Veiculos/%s.ini", PlayerName(playerid));
		if(DOF2_FileExists(PastaVeiculos))
		{
	     	for(new v; v < 5; v++)
		    {
		        if(pVeiculoInv[playerid][v] > 0 && IsValidVehicle(pVeiculoInv[playerid][v]))
		        {
		            format(KeyV, sizeof(KeyV), "VeiculoVida%d", v);
					new Float:Vida; GetVehicleHealth(pVeiculoInv[playerid][v], Vida);
					DOF2_SetFloat(PastaVeiculos, KeyV, Vida);
	                format(KeyV, sizeof(KeyV), "VeiculoCombustivel%d", v);
	    			DOF2_SetFloat(PastaVeiculos, KeyV, Combustivel[pVeiculoInv[playerid][v]]);
	    			format(KeyV, sizeof(KeyV), "VeiculoIPVA%d", v);
	    			DOF2_SetInt(PastaVeiculos, KeyV, vIPVA[pVeiculoInv[playerid][v]]);
					salvar = true;
		            DestroyVehicleC(pVeiculoInv[playerid][v]);
		            pVeiculoInv[playerid][v] = 0;
		        }
		    }
		    if(salvar == true)
		    {
		        DOF2_SaveFile();
		    }
		}
		if(JBL[playerid] > 0)
		{
		    new Float:X, Float:Y, Float:Z; GetDynamicObjectPos(JBL[playerid], X, Y, Z);
		    foreach(Player, i)
		    {
	    		if(IsPlayerConnected(i) && Spawnado[i] == true && IsPlayerInRangeOfPoint(i, VolumeMusica[playerid], X, Y, Z))
       			{
					StopAudioStreamForPlayer(i);
        		}
		    }
		    DestroyDynamicObject(JBL[playerid]);
		    DestroyDynamic3DTextLabel(TextJBL[playerid]);
		    JBL[playerid] = 0;
		}
	    if(IsValidDynamicMapIcon(MapIconCorrida[playerid]))
	    {
	        DestroyDynamicMapIcon(MapIconCorrida[playerid]);
	    }
	    if(Balao[playerid] > 0)
		{
			DestroyDynamicObject(Balao[playerid]);
			Balao[playerid] = 0;
			DestroyDynamicObject(BalaoMadeira[playerid]);
			BalaoMadeira[playerid] = 0;
			DestroyDynamicObject(BalaoFogo[playerid]);
			BalaoFogo[playerid] = 0;
			Delete3DTextLabel(TextBalao[playerid]);
		}
	    if(VeiculoConce[playerid] > 0)
	    {
	        DestroyVehicleC(VeiculoConce[playerid]);
	        VeiculoConce[playerid] = 0;
	    }
		if(VeiculoCNH[playerid] > 0)
		{
		    DestroyVehicleC(VeiculoCNH[playerid]);
		    VeiculoCNH[playerid] = 0;
		}
    	if(SangueObjeto[playerid] > -1)
   		{
    		DestroyObject(SangueObjeto[playerid]);
    		SangueObjeto[playerid] = -1;
		}
    	if(Barraca[playerid] > -1)
	   	{
	    	DestroyDynamicObject(Barraca[playerid]);
	    	Barraca[playerid] = -1;
	    }
	    if(FogoBarraca[playerid] > -1)
	    {
	    	DestroyDynamicObject(FogoBarraca[playerid]);
	    	FogoBarraca[playerid] = -1;
	    }
	    if(CheckVendedor[playerid] > -1)
	    {
	    	DestroyDynamicCP(CheckVendedor[playerid]);
	    	CheckVendedor[playerid] = -1;
	    }
	    if(CheckSAMU[playerid] > -1)
	    {
	        DestroyDynamicCP(CheckSAMU[playerid]);
      		CheckSAMU[playerid] = -1;
	    }
	    if(CheckArvore[playerid] > -1)
	    {
	    	DestroyDynamicCP(CheckArvore[playerid]);
      		CheckArvore[playerid] = -1;
		}
		if(Arvore[playerid] > -1)
		{
		    DestroyDynamicObject(Arvore[playerid]);
		    Arvore[playerid] = -1;
		}
		if(CheckGari[playerid] > -1)
		{
		    DestroyDynamicCP(CheckGari[playerid]);
      		CheckGari[playerid] = -1;
		}
		if(CheckJornal[playerid] > -1)
		{
		    DestroyDynamicCP(CheckJornal[playerid]);
		    CheckJornal[playerid] = -1;
		}
		if(CheckDormir[playerid] > -1)
		{
		    DestroyDynamicCP(CheckDormir[playerid]);
		    CheckDormir[playerid] = -1;
		}
    	if(TempoProduzindoMaterial[playerid] > -1)
    	{
    	    TempoProduzindoMaterial[playerid] = -1;
			DestroyDynamicObject(Material[playerid]);
	        DestroyDynamicObject(Materiall[playerid]);
	        Material[playerid] = -1;
			Materiall[playerid] = -1;
    	}
		if(CheckPrimeiroPasso[playerid] > 0)
  		{
	        DestroyDynamicCP(CheckPrimeiroPasso[playerid]);
	        CheckPrimeiroPasso[playerid] = 0;
	    }
	    if(PRODUZINDOARMA[playerid] > -1)
	    {
	        PRODUZINDOARMA[playerid] = -1;
		    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
		    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
		    PRODUZINDOARMA[playerid] = -1;
	    	TogglePlayerControllable(playerid, 1);
	    	ClearAnimations(playerid, 1);
	    }
	    if(ConsertandoVeiculo[playerid] > -1)
	    {
	        ConsertandoVeiculo[playerid] = -1;
		    HidePlayerProgressBar(playerid, barfabarmas[playerid]);
		    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
	    	TogglePlayerControllable(playerid, 1);
	    	ClearAnimations(playerid, 1);
	    }
	    if(TimerAssalto[playerid][0] > -1)
	    {
	        KillTimer(TimerAssalto[playerid][0]);
	        DestroyDynamicObject(Explosivos[playerid][0]);
	        Explosivos[playerid][0] = -1;
        	TimerAssalto[playerid][0] = -1;
	    }
	    if(TimerAssalto[playerid][1] > -1)
	    {
	        KillTimer(TimerAssalto[playerid][1]);
	        DestroyDynamicObject(Explosivos[playerid][1]);
	        Explosivos[playerid][1] = -1;
	        TimerAssalto[playerid][1] = -1;
	    }
	    if(TimerAbordo[playerid] >= 0)
	    {
	        KillTimer(TimerAbordo[playerid]);
	        TextDrawHideForPlayer(playerid, TextAbordagem[0]); TextDrawHideForPlayer(playerid, TextAbordagem[1]);
	    }
	    if(TimerAbordoAb[playerid] >= 0)
	    {
	        KillTimer(TimerAbordoAb[playerid]);
	        TextDrawHideForPlayer(playerid, TextAbordagem[0]); TextDrawHideForPlayer(playerid, TextAbordagemAb);
	    }
	    if(TimerDesmanchando[playerid] >= 0)
	    {
	        KillTimer(TimerDesmanchando[playerid]);
	        EstaDesmanchando[playerid] = 0;
	    }
	    if(TimerLavagem[playerid] >= 0)
	    {
	        KillTimer(TimerLavagem[playerid]);
	        EstaLavando[playerid] = 0;
	        ContagemLavagem[playerid] = 0;
	    }
	    for(new p; p < 10; p++)
		{
  			if(PickAssalto[playerid][p] > -1)
	    	{
				DestroyDynamicPickup(PickAssalto[playerid][p]);
      			PickAssalto[playerid][p] = -1;
		    }
		}
		new incall, strm[128];
  		format(strm, sizeof(strm), "| WPP | O(A) Jogador(a) %s[%d] saiu do grupo ( Desconectou-se )", PlayerName(playerid), playerid);
	    foreach(Player, i)
	    {
	        if(gstream[playerid] && playerid != i && gstream[playerid] == gstream[i])
	    	{
	    	    if(NivelAdmin[playerid] < 3 && !IsPlayerAdmin(playerid))
	    	    {
		    	    SendClientMessage(i, 0x01DF01FF, strm);
		    	    PlayerPlaySound(i, 1084, 0, 0, 0);
				}
	    	    incall ++;
		   	}
		   	if(Atendendo[i] == playerid)
		   	{
		   	    Atendendo[i] = -1;
          		Atendendo[playerid] = -1;
		   	    AdminAtendimento[i] = -1;
          		AdminAtendimento[playerid] = -1;
		   	    SendClientMessage(i, COR_ERRO, "| ERRO | Seu atendimento foi encerrado!");
		   	}
			if(VendedorDaMaconha[i] == playerid)
			{
			    VendedorDaMaconha[i] = -1;
			    OfereceuMaconha[i] = -1;
				QuantidadeMaconhaOferecida[i] = 0;
				ValorMaconhaOferecido[i] = 0;
			    SendClientMessage(i, COR_ERRO, "| ERRO | O Traficante que te ofereceu os cigarros de maconha saiu do servidor");
			}
			if(TraficanteDoCliente[i] == playerid)
			{
			    ArmaOferecida[i] = -1;
	   			MunicaoArmaOferecida[i] = -1;
	   			ValorArmaOferecida[i] = -1;
				TraficanteDoCliente[i] = -1;
				SegundosPropostaArma[i] = -1;
				SendClientMessage(i, COR_ERRO, "| ERRO | O Traficante que te ofereceu a arma saiu do servidor");
			}
			if(Localizando[i] == playerid)
			{
			    SendClientMessage(i, 0x228B22FF, "| GPS | O(A) Jogador(a) localizado saiu do servidor");
				Localizando[i] = -1;
				DisablePlayerCheckpoint(i);
				if(CheckSAMU[i] > -1)
				{
		  			DestroyDynamicCP(CheckSAMU[i]);
		  			CheckSAMU[i] = -1;
				}
			}
			if(InviteLocalizacao[i] == playerid)
			{
			    InviteLocalizacao[i] = -1;
			    SendClientMessage(i, 0x228B22FF, "| MAPPS | O(A) Jogador(a) localizado saiu do servidor");
				DisablePlayerCheckpoint(i);
			}
	    }
	    if(gstream[playerid])
	    {
	        SvDetachListenerFromStream(gstream[playerid], playerid);
	        if(incall == 0)
	        {
		        for(new d; d < MAX_CALL; d++)
		        {
		            if(gstream[playerid] == dcstream[d])
		            {
		                format(NomeSala[d], 30, "");
		                format(SenhaSala[d], 30, "");
		                SvDeleteStream(gstream[playerid]);
	      				dcstream[d] = SV_NULL;
						break;
		            }
		        }
			}
	        gstream[playerid] = SV_NULL;
	    }
     	HidePlayerProgressBar(playerid, barfome[playerid]);
		HidePlayerProgressBar(playerid, barsede[playerid]);
		HidePlayerProgressBar(playerid, barsono[playerid]);
		//
	    if(FardaList[playerid] > -1)
	    {
		    for(new t; t < 5; t++)
	    	{
				TextDrawHideForPlayer(playerid, TextSkin[t]);
			}
		   	PlayerTextDrawHide(playerid, TextSkinP[playerid][0]);
		   	PlayerTextDrawHide(playerid, TextSkinP[playerid][1]);
		   	FardaList[playerid] = -1;
		}
		if(Barreira[playerid] > -1)
		{
		    DestroyDynamicObject(Barreira[playerid]);
		    Barreira[playerid] = -1;
		}
		if(XTapete[playerid] > -1 || YTapete[playerid] > -1 || ZTapete[playerid] > -1)
  		{
    		DeleteClosestStrip(XTapete[playerid], YTapete[playerid], ZTapete[playerid]);
    		XTapete[playerid] = -1; YTapete[playerid] = -1; ZTapete[playerid] = -1;
	    }
	    if(GzBlitz[playerid] > -1)
		{
		 	GangZoneDestroy(GzBlitz[playerid]);
		 	GzBlitz[playerid] = -1;
		}
		for(new m; m < 8; m++)
		{
			if(ObjetoAlvo[playerid][m] > 0)
			{
			    DestroyDynamicObject(ObjetoAlvo[playerid][m]);
			    ObjetoAlvo[playerid][m] = 0;
			}
		}
		for(new c; c < 5; c++)
  		{
    		if(Cone[playerid][c] > -1)
      		{
      		    DestroyDynamicObject(Cone[playerid][c]);
      		    Cone[playerid][c] = -1;
      		}
		}
		if(Carregado[playerid] == true)
	 	{
	  		Carregado[playerid] = false;
		  	PlayerTextDrawHide(playerid, TextCargaP[playerid][0]);
	  		PlayerTextDrawHide(playerid, TextCargaP[playerid][1]);
			TextDrawHideForPlayer(playerid, TextCarga);
		  	DisablePlayerRaceCheckpoint(playerid);
	  	}
	  	if(ComboioPetroleiro[playerid] > -1)
		{
			ComboioPetroleiroList[ComboioPetroleiro[playerid]] --;
 			ComboioPetroleiro[playerid] = -1;
  		}
  		if(ComboioCaminhoneiro[playerid] > -1)
		{
			ComboioCaminhoneiroList[ComboioCaminhoneiro[playerid]] --;
 			ComboioCaminhoneiro[playerid] = -1;
  		}
  		if(ComboioMinerador[playerid] > -1)
		{
			ComboioMineradorList[ComboioMinerador[playerid]] --;
 			ComboioMinerador[playerid] = -1;
  		}
  		if(ComboioCF[playerid] > -1)
		{
			ComboioCFList[ComboioCF[playerid]] --;
 			ComboioCF[playerid] = -1;
  		}
  		//
	  	if(CargaMoto[playerid] > -1)
	  	{
	  	    CargaMoto[playerid] = -1;
	  	    for(new c; c < 3; c++)
	  	    {
			   if(CheckC[playerid][c] > -1)
			   {
					DestroyDynamicCP(CheckC[playerid][c]);
					CheckC[playerid][c] = -1;
			   }
			   if(MapC[playerid][c] > -1)
			   {
					DestroyDynamicMapIcon(MapC[playerid][c]);
					MapC[playerid][c] = -1;
			   }
	  	    }
	  	}
	}
	AcertouAsenha[playerid] = false;
	DestroyPlayerProgressBar(playerid, barfome[playerid]);
    DestroyPlayerProgressBar(playerid, barsede[playerid]);
    DestroyPlayerProgressBar(playerid, barsono[playerid]);
    DestroyPlayerProgressBar(playerid, barfabarmas[playerid]);
    //
    for(new t; t < 46; t++)
    {
	    PlayerTextDrawHide(playerid, TextInvP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextInvP[playerid][t]);
    }
    for(new t; t < 10; t++)
    {
	    PlayerTextDrawHide(playerid, TextColetarItemP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextColetarItemP[playerid][t]);
    }
    for(new t; t < 5; t++)
    {
	    PlayerTextDrawHide(playerid, TextPresente[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextPresente[playerid][t]);
    }
    for(new t; t < 2; t++)
    {
	    PlayerTextDrawHide(playerid, TextTaximetroP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextTaximetroP[playerid][t]);
	    PlayerTextDrawHide(playerid, TextCargaP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextCargaP[playerid][t]);
	    PlayerTextDrawHide(playerid, TextSkinP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextSkinP[playerid][t]);
	    PlayerTextDrawHide(playerid, TextBTCP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextBTCP[playerid][t]);
    }
    for(new t; t < 22; t++)
    {
	    PlayerTextDrawHide(playerid, TextLoginP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextLoginP[playerid][t]);
    }
    for(new t; t < 3; t++)
    {
	    PlayerTextDrawHide(playerid, TextAbastecerP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextAbastecerP[playerid][t]);
    }
    for(new t; t < 11; t++)
    {
        PlayerTextDrawHide(playerid, TextImobiliaria[playerid][t]);
        PlayerTextDrawDestroy(playerid, TextImobiliaria[playerid][t]);
    }
    
    PlayerTextDrawHide(playerid, TextPresoP[playerid]);
    PlayerTextDrawDestroy(playerid, TextPresoP[playerid]);
    
    PlayerTextDrawHide(playerid, TextProduzirArma[playerid]);
    PlayerTextDrawDestroy(playerid, TextProduzirArma[playerid]);
    
    PlayerTextDrawHide(playerid, MsgText[playerid]);
    PlayerTextDrawDestroy(playerid, MsgText[playerid]);
    for(new t; t < 4; t++)
    {
	    PlayerTextDrawHide(playerid, TextSniperInfoP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextSniperInfoP[playerid][t]);
    }for(new s=0; s<50; s++) uQBSWeaponID[playerid][s] = 0, uQBSWeaponAmmo[playerid][s] = 0;
    ResetPlayerWeapons(playerid);
    for(new t; t < 3; t++)
    {
	    PlayerTextDrawHide(playerid, TextSkinMenuP[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextSkinMenuP[playerid][t]);
    }
    for(new t; t < 43; t++)
    {
	    PlayerTextDrawHide(playerid, TextMegaSena[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextMegaSena[playerid][t]);
    }
    for(new t; t < 46; t++)
    {
	    PlayerTextDrawHide(playerid, TextLojaItens[playerid][t]);
	    PlayerTextDrawDestroy(playerid, TextLojaItens[playerid][t]);
    }
    for(new t; t < 7; t++)
    {
	   PlayerTextDrawHide(playerid, TextCellP[playerid][t]); PlayerTextDrawDestroy(playerid, TextCellP[playerid][t]);//TextCellP
    }

    //
    PlayerTextDrawHide(playerid, TextTelaPreta[playerid]);
    PlayerTextDrawHide(playerid, TextTelaPreta[playerid]);
    //
	PlayerTextDrawHide(playerid, BoxText[playerid][0]);
	PlayerTextDrawDestroy(playerid, BoxText[playerid][0]);
    //
    TextDrawShowForPlayer(playerid, Textdraw0);
	TextDrawShowForPlayer(playerid, Textdraw1);
	TextDrawShowForPlayer(playerid, Textdraw2);
	TextDrawShowForPlayer(playerid, Textdraw3);
	TextDrawShowForPlayer(playerid, Textdraw4);
	TextDrawShowForPlayer(playerid, Textdraw5);
	//
    //PlayerTextDrawHide(playerid, TextPr[playerid]);
    //PlayerTextDrawDestroy(playerid, TextPr[playerid]);
    PlayerTextDrawHide(playerid, TextEstrelas[playerid][0]);
    PlayerTextDrawHide(playerid, TextEstrelas[playerid][0]);
    PlayerTextDrawDestroy(playerid, TextEstrelas[playerid][0]);
	PlayerTextDrawDestroy(playerid, TextEstrelas[playerid][1]);
	//

    //
    PlayerTextDrawDestroy(playerid, TextConceP[playerid][0]);
    PlayerTextDrawDestroy(playerid, TextConceP[playerid][1]);
    PlayerTextDrawDestroy(playerid, TextConceP[playerid][2]);
    //
    SegundosAtendimento[playerid] = 0;
    CheckoutValor[playerid] = 0;
    CheckoutBTC[playerid] = 0.0;
    id_fixo[playerid] = 0;
    ORG[playerid] = -1;
    Estagiario[playerid] = 0;
    NivelAdmin[playerid] = 0;
   	MinutosMorte[playerid] = 0;
	SegundosMorte[playerid] = 0;
	VezesMorreu[playerid] = 0;
	NivelProcurado[playerid] = 0;
	CidadeNascimento[playerid] = 0;
	AttAfk[playerid] = 0;
	TempoDuvida[playerid] = gettime();
	PassouRadar[playerid] = 0;
	SegundosServicos[playerid] = 0;
	ValorReparo[playerid] = 0;
	SegundosReparo[playerid] = 0;
	SegundosAviso[playerid] = 0;
	SegundosComecar[playerid] = 0;
	InPedagioSP[playerid] = 0;
	EntrouHosp[playerid] = 0;
	EntrouDP[playerid] = 0;
	EntrouBanco[playerid] = 0;
	EntrouPref[playerid] = 0;
	EntrouAutoEscola[playerid] = 0;
	EntrouDetran[playerid] = 0;
	EntrouAgencia[playerid] = 0;
	ENCAMINHAMENTO[playerid] = 0;
	ValorIncendio[playerid] = 0;
	NoEvento[playerid] = 0;
	ValorAssaltoReceber[playerid] = 0;
	SegundosTapete[playerid] = 0;
	PegouDinheiro[playerid] = 0;
	MudouInterior[playerid] = 0;
	PediuMecanico[playerid] = 0;
	PediuTaxi[playerid] = 0;
	ChamouPolicia[playerid] = 0;
	UpTaxi[playerid] = 0;
	ValorCorrida[playerid] = 0;
	Algemado[playerid] = 0;
	SegundosPerseguidoCorp[playerid] = 0;
	SegundosPerseguidoOrg[playerid] = 0;
	RecebeuMulta[playerid] = 0;
	LixosColetados[playerid] = 0;
	Lixinhos[playerid] = 0;
	ValorPorLitro[playerid] = 0;
	LitrosAbastecidos[playerid] = 0.0;
	ValorGasto[playerid] = 0;
	Frete[playerid] = 0;
	BonusFrete[playerid] = 0;
	SegundosVoltarVeiculo[playerid] = 0;
	ValorEmpresa[playerid] = 0;
	SegundosCone[playerid] = 0;
	SegundosBarreira[playerid] = 0;
	PegouJornal[playerid] = 0;
	QuantidadeMaconhaOferecida[playerid] = 0;
	ValorMaconhaOferecido[playerid] = 0;
	BlokPlayerSequestro[playerid] = 0;
	BlockPlayerLocalizar[playerid] = 0;
	BlockPlayerDisconnect[playerid] = 0;
	CargaPiloto[playerid] = 0;
	SegurandoMao[playerid] = 0;
	ReceberMotoboy[playerid] = 0;
	PickupStatus[playerid] = 0;
	Flooder[playerid] = 0;
	SegundosImobiliaria[playerid] = 0;
	PaginaLoja[playerid] = 0;
    MinItensList[playerid] = 0;
	if(VAdmin[playerid] > 0)
	{
   		DestroyVehicleC(VAdmin[playerid]);
  		VAdmin[playerid] = 0;
    }
    for(new v; v < 50; v++)
	{
		if(VOwner[playerid][v] && IsValidVehicle(VOwner[playerid][v]))
  		{
			DestroyVehicleC(VOwner[playerid][v]); VOwner[playerid][v] = 0;
		}
	}
	for(new h; h < 7; h++)
	{
	    TirandoCNH[playerid][h] = 0;
	}
	HQ[playerid] = false;
    Carregado[playerid] = false;
    Pescando[playerid] = false;
	Dormindo[playerid] = false;
	GodMode[playerid] = false;
	LocalizandoVeiculo[playerid] = false;
	smsbloqueado[playerid] = false;
	ligacaobloqueada[playerid] = false;
	Abastecendo[playerid] = false;
	MinerandoBTC[playerid] = 0;
	for(new p; p < 50; p++)
	{
	    ConviteProf[playerid][p] = false;
	}
    hidetext[playerid] = false;
    TimeKill[playerid] = 0;
    format(SenhaCall[playerid], 30, "");

	return 1;
}
public OnPlayerSpawn(playerid)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerSpawn(playerid);
    StopAudioStreamForPlayer(playerid);

    SetTimerEx("Wk_ChecWL", 1000, false,"i",playerid);

    GetPlayerPos(playerid, XATT[playerid], YATT[playerid], ZATT[playerid]);
    if(Spawnado[playerid] == false && AcertouAsenha[playerid] == true)
    {
        Spawnado[playerid] = true;
        LimparChat(playerid, 20);
		StopAudioStreamForPlayer(playerid);
		
		SENHASECUNDARIA[playerid] = "162005";
	 	
		SetarCor(playerid);
		SetPlayerScore(playerid, Level[playerid]);
		SetPlayerHealth(playerid, Vidap[playerid]);
		SetPlayerArmour(playerid, Coletep[playerid]);

		if(VIP[playerid] > 0 && TIPOVIP[playerid] == 2)
		{
	 		new Str[70]; format(Str, sizeof(Str), "~w~%s ~g~ON", PlayerName(playerid));
	      	GameTextForAll(Str, 5000, 1);
	   		format(Str, sizeof(Str), "| INFO | O Vip Diamante %s acaba de entrar na cidade", PlayerName(playerid));
	      	SendClientMessageToAll(0x088A85FF, Str);
		}
		else if(VIP[playerid] > 0 && TIPOVIP[playerid] == 1)
		{
	    	new Str[70]; format(Str, sizeof(Str), "~w~%s ~g~ON", PlayerName(playerid));
	      	GameTextForAll(Str, 5000, 1);
	      	format(Str, sizeof(Str), "| INFO | O Vip Ouro %s acaba de entrar na cidade", PlayerName(playerid));
	      	SendClientMessageToAll(0xFFD700FF, Str);
		}

		format(String, sizeof(String), "Contas/%s.ini", PlayerName(playerid));
		
		GiveProcurado(playerid, DOF2_GetInt(String, "Procurado"));
		
		new Arma1[10], Bala1[10];
		for(new i = 0; i < 13; i++)
		{
			format(Arma1, 10, "Arma%d", i); format(Bala1, 10, "Municao%d", i);
	  		if(DOF2_GetInt(String, Arma1) > 0)
			{
				GivePlayerWeaponExC(playerid, DOF2_GetInt(String, Arma1), DOF2_GetInt(String, Bala1));
			}
		}
		
		new bool:CheckIPVA, DiaIPVA = DOF2_GetInt(String, "getdate");
		if((getdate() - DiaIPVA) >= 1)
		{
			DOF2_SetInt(String, "getdate", getdate());
			CheckIPVA = true;
			LoginsHoje ++;
			CallLocalFunction("OnPlayerCommandText", "is", playerid, "/MagicBox");
		}
		new GetPasta[40], MT[40]; format(GetPasta, sizeof(GetPasta), "Veiculos/%s.ini", PlayerName(playerid));
		if(DOF2_FileExists(GetPasta))
		{
			for(new v; v < 5; v++)
			{
				format(MT, sizeof(MT), "Veiculo%d", v);
	   			ModeloVeiculoInv[playerid][v] = DOF2_GetInt(GetPasta, MT);
			    //
			    if(CheckIPVA == true)
				{
					if(ModeloVeiculoInv[playerid][v] > 0 && ModeloVeiculoInv[playerid][v] != 510 && ModeloVeiculoInv[playerid][v] != 481 && ModeloVeiculoInv[playerid][v] != 509)
					{
						format(MT, sizeof(MT), "VeiculoIPVA%d", v);
						DOF2_SetInt(GetPasta, MT, DOF2_GetInt(GetPasta, MT) + 1);
						//DOF2_SaveFile();
					}
				}
			}
		}
		else
		{
	 		DOF2_CreateFile(GetPasta);
	 		DOF2_SaveFile();
		}

		format(GetPasta, sizeof(GetPasta), "Acessorios/%s.ini", PlayerName(playerid));
	 	if(DOF2_FileExists(GetPasta))
	  	{
			for(new m; m < 6; m++)
			{
				format(MT, sizeof(MT), "ModeloItem%d", m);
				ModeloItem[playerid][m] = DOF2_GetInt(GetPasta, MT);

				format(MT, sizeof(MT), "OssoItem%d", m);
				OssoItem[playerid][m] = DOF2_GetInt(GetPasta, MT);

				for(new o; o < 9; o++)
				{
					format(MT, sizeof(MT), "PosItem%d%d", m, o);
					PosItem[playerid][m][o] = DOF2_GetFloat(GetPasta, MT);
				}
			}
			for(new m; m < 30; m++)
			{
				format(MT, sizeof(MT), "contatoplayer%d", m);
				format(ContatoPlayer[playerid][m], 25, "%s", DOF2_GetString(GetPasta, MT));
				format(MT, sizeof(MT), "numerocontatoplayer%d", m);
				NumeroContatoPlayer[playerid][m] = DOF2_GetInt(GetPasta, MT);
			}
		}
		else
		{
			DOF2_CreateFile(GetPasta);
			DOF2_SaveFile();
			for(new m; m < 6; m++)
			{
				ModeloItem[playerid][m] = 0;
				OssoItem[playerid][m] = 0;

				for(new o; o < 9; o++)
				{
					PosItem[playerid][m][o] = 0.0;
				}
			}
  		}
		
		if(DOF2_GetInt(String, "UltimoLogin1") > 365)
		{
		    new MsgLogin[150]; format(MsgLogin, sizeof(MsgLogin), "| INFO | Seja bem-vindo(a) {6B54B6}%s{FFFFFF}, seu ultimo login foi feito ha {6B54B6}%s", PlayerName(playerid), UltimoLogin(DOF2_GetInt(String, "UltimoLogin1")));
		    SendClientMessage(playerid, -1, MsgLogin);
		}

	   	new StrT[100]; format(StrT, sizeof(StrT), "{FFFFFF}Oi %s, tudo bem?\nEstou aqui para te ajudar, digite /Ajuda", PlayerName(playerid));
		TextStaff[playerid][0] = CreateDynamic3DTextLabel(StrT, 0xFFFFFFFF, 1680.2313,-2309.7312,13+1.0, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1, playerid);
		TextStaff[playerid][1] = CreateDynamic3DTextLabel(StrT, 0xFFFFFFFF, -1995.6298,129.7266,28.0, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1, playerid);

		if(DOF2_GetInt(String, "VendeuPosto") > 0)
		{
	 		new valor = DOF2_GetInt(String, "VendeuPosto");
	   		Money[playerid] += valor;
		    DOF2_SetInt(String, "VendeuPosto", 0);
		    //DOF2_SaveFile();
		    new Stringer[128];
		    format(Stringer, sizeof(Stringer), "| POSTO | Seu posto foi vendido enquanto voce estava offline e voce recebeu $%d", valor);
			SendClientMessage(playerid, 0x708090FF, Stringer);
		}
		if(DOF2_GetInt(String, "VendeuEmpresa") > 0)
		{
	 		new valor = DOF2_GetInt(String, "VendeuEmpresa");
			Money[playerid] += valor;
			DOF2_SetInt(String, "VendeuEmpresa", 0);
			//DOF2_SaveFile();
			new Stringer[128];
			format(Stringer, sizeof(Stringer), "| EMPRESA | Sua empresa foi vendida enquanto voce estava offline e voce recebeu $%d", valor);
			SendClientMessage(playerid, COR_EMPRESA, Stringer);
		}
		if(DOF2_GetInt(String, "EmpresaLucro") > 0)
		{
			new valor1 = DOF2_GetInt(String, "EmpresaLucro");
			Money[playerid] += valor1;
			DOF2_SetInt(String, "EmpresaLucro", 0);
			//DOF2_SaveFile();
			new Stringer[128];
			format(Stringer, sizeof(Stringer), "| INFO | Voce tambem recebeu {228B22}$%d {FFFFFF}que tinha de lucro", valor1);
			SendClientMessage(playerid, -1, Stringer);
		}
		if(DOF2_GetInt(String, "VendeuCasa") > 0)
		{
			new valor = DOF2_GetInt(String, "VendeuCasa");
			Money[playerid] += valor;
			DOF2_SetInt(String, "VendeuCasa", 0);
			//DOF2_SaveFile();
			new Stringer[128];
			format(Stringer, sizeof(Stringer), "| CASA | Sua casa foi vendida enquanto voce estava offline e voce recebeu $%d", valor);
			SendClientMessage(playerid, COR_CASA, Stringer);
		}
		if(DOF2_GetInt(String, "MultaCasa") > 0)
		{
			new valor = DOF2_GetInt(String, "MultaCasa");
			if(SaldoBancario[playerid] > -999999)
	  		{
	       		SaldoBancario[playerid] -= valor;
			}
	  		DOF2_SetInt(String, "MultaCasa", 0);
			//DOF2_SaveFile();
			new Stringer[128];
			format(Stringer, sizeof(Stringer), "| MULTA | Voce recebeu uma multa de $%d por deixar acumular lixos na sua casa", valor);
			SendClientMessage(playerid, COR_CASA, Stringer);
		}
		//
		if(VIP[playerid] > 0)
		{
			if(VerifyExpiredDays(VIP[playerid]))
			{
				VIP[playerid] = 0;
				SendClientMessage(playerid, 0xFFFF00FF, "| VIP | Seu VIP expirou... Ative outro agora mesmo com o comando /Loja");
			}
			else
			{
				SendClientMessage(playerid, 0xFFFF00FF, "| VIP | Voce e um(a) jogador(a) VIP, Aproveite...");
			}
		}
		
		if(!SvGetVersion(playerid))
		{
	 		MsgAviso(playerid, 5, "~w~Seu ~r~VOIP ~w~nao foi encontrado");
	 		pVoip[playerid] = 0;
		}
		else if(!SvHasMicro(playerid))
		{
			MsgAviso(playerid, 5, "~b~VOIP: ~w~Seu ~r~Microfone ~w~nao foi carregado");
			pVoip[playerid] = 0;
		}
		else
		{
			lstream[playerid] = SvCreateDLStreamAtPlayer(40.0, SV_INFINITY, playerid, 0xFF0000FF, "L");
			MsgAviso(playerid, 5, "~w~Seu ~g~VOIP ~w~foi carregado com sucesso");
			//SvAddKey(playerid, 0x5A);
			SvAddKey(playerid, 0x42);
			pVoip[playerid] = 1;
		}

		AttBarStatus(playerid);

	 	for(new t; t < 10; t++)
		{
			TextDrawShowForPlayer(playerid, Status[t]);
		}
		PlayerTextDrawShow(playerid, StatusP[playerid][0]);
	 	//
		TextoMaleta[playerid] = CreateDynamic3DTextLabel(".", -1, 11.11,22.22,-999.123, 1.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1, playerid, STREAMER_3D_TEXT_LABEL_SD, -1, 0);
		pMaterial[playerid] = CreateDynamic3DTextLabel(".", -1, 11.11,22.22,-999.123, 2.0);
		TextoBarreira[playerid] = CreateDynamic3DTextLabel(".", -1, 11.11,22.22,-999.123, 10.0);
		TextoTapete[playerid] = CreateDynamic3DTextLabel(".", -1, 11.11,22.22,-999.123, 10.0);
		TextoBarraca[playerid] = CreateDynamic3DTextLabel(".", -1, 11.11,22.22,-999.123, 10.0);
		//
		new Float:X, Float:Y, Float:Z, Float:R;
		GetPlayerPos(playerid, X, Y, Z);
		GetPlayerFacingAngle(playerid, R);
		if(IsPlayerInRangeOfPoint(playerid, 1.0, 1755.0210,-1894.1105,13.5568) && GetPlayerScore(playerid) <= 0)
		{
		    SetPlayerVirtualWorld(playerid, 0);
	 		SegundosComecar[playerid] = 13;
			InterpolateCameraPos(playerid, 1834.527709, -1894.610351, 22.268999, 1763.249877, -1894.184204, 14.865082, 10000);
			InterpolateCameraLookAt(playerid, 1829.554565, -1894.580688, 21.752412, 1758.276733, -1894.154541, 14.348496, 10000);
			format(String, sizeof(String), "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ {FFFFFF}Bem-Vindo(a) {00FF00}]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
			SendClientMessage(playerid, 0x00FF00FF, String);
			format(String, sizeof(String), "~> {FFFFFF}Ola %s, te desejamos boas vindas a cidade e uma boa diversao!", PlayerName(playerid));
			SendClientMessage(playerid, 0x00FF00FF, String);
			format(String, sizeof(String), "~> {FFFFFF}Iremos te guia-lo ate a Agencia de Empregos para voce dar seus primeiros passos");
			SendClientMessage(playerid, 0x00FF00FF, String);
			format(String, sizeof(String), "~> {FFFFFF}Caso precise da ajuda de algum admin, digita /Duvida e descreva sua duvida");
			SendClientMessage(playerid, 0x00FF00FF, String);
			format(String, sizeof(String), "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ {FFFFFF}Bem-Vindo(a) {00FF00}]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
			SendClientMessage(playerid, 0x00FF00FF, String);
			
		}
		else if(HorasPreso[playerid] > 0 || MinutosPreso[playerid] > 0 || SegundosPreso[playerid] > 0)
		{
			if(EntrouDP[playerid] < 8 && new_strcmp(MotivoPrisaoAdmin[playerid], "Procurado(a)"))
			{
				SendClientMessage(playerid, 0x1E90FFFF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
				SendClientMessage(playerid, 0x1E90FFFF, "~> {FFFFFF}Voce cometeu algum crime e foi preso pela Policia");
				SendClientMessage(playerid, 0x1E90FFFF, "~> {FFFFFF}Cumpra sua pena ou contrate um advogado para ser solto imediatamente");
				SendClientMessage(playerid, 0x1E90FFFF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
				SetPlayerInterior(playerid, 6);
				SetPlayerVirtualWorld(playerid, 0);
				SetTimerEx("CarregarInterior", 7000, false, "i", playerid);
				TogglePlayerControllable(playerid, 0);
				GameTextForPlayer(playerid, "~r~Carregando...", 6000, 3);
			}
			else
			{
			   	SetTimerEx("CarregarInterior", 7000, false, "i", playerid);
				TogglePlayerControllable(playerid, 0);
				GameTextForPlayer(playerid, "~r~Carregando...", 6000, 3);
				SendClientMessage(playerid, 0x1E90FFFF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
				format(String, sizeof(String), "~> {FFFFFF}Voce foi preso pela Administracao ( Motivo: %s )", MotivoPrisaoAdmin[playerid]);
	   			SendClientMessage(playerid, 0x1E90FFFF, String);
				SendClientMessage(playerid, 0x1E90FFFF, "~> {FFFFFF}Cumpra sua punicao e leia as regras para nao ser punido(a) novamente");
				SendClientMessage(playerid, 0x1E90FFFF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
				SetPlayerInterior(playerid, 1);
				SetPlayerVirtualWorld(playerid, 1);
			}
			ResetProcurado(playerid);
			SetPlayerHealth(playerid, 100000);
			SetPlayerArmour(playerid, 0);
			GameTextForPlayer(playerid, "~w~Preso!", 1500, 0);
			new StrPreso[35]; format(StrPreso, sizeof(StrPreso), "~g~~h~PRESO: ~w~%02d:%02d:%02d", HorasPreso[playerid], MinutosPreso[playerid], SegundosPreso[playerid]);
			PlayerTextDrawSetString(playerid, TextPresoP[playerid], StrPreso);
			PlayerTextDrawShow(playerid, TextPresoP[playerid]);
			TextDrawShowForPlayer(playerid, TextPreso);
		}
		else if(MinhaCasa[playerid] == -1)
		{
		    SetTimerEx("CarregarInterior", 7000, false, "i", playerid);
			TogglePlayerControllable(playerid, 0);
			GameTextForPlayer(playerid, "~r~Carregando...", 6000, 3);
			
			SetPlayerInterior(playerid, UltimoInterior[playerid]);
			SetPlayerVirtualWorld(playerid, UltimoMundo[playerid]);
			if(UltimoInterior[playerid] != 0 || IsPointInRangeOfPoint(1174.5527,-1325.9724,-44.2836, DOF2_GetFloat(String, "PosX"), DOF2_GetFloat(String, "PosY"), DOF2_GetFloat(String, "PosZ"), 50.0) || IsPointInRangeOfPoint(1482.2988,-1724.2445,13.3689, DOF2_GetFloat(String, "PosX"), DOF2_GetFloat(String, "PosY"), DOF2_GetFloat(String, "PosZ"), 50.0))
			{
				SetTimerEx("CarregarInterior", 7000, false, "i", playerid);
				TogglePlayerControllable(playerid, 0);
				GameTextForPlayer(playerid, "~r~Carregando...", 6000, 3);
			}
		}
		else if(MinhaCasa[playerid] >= 0)
		{
		    if(cCoins[MinhaCasa[playerid]] > 0)
		    {
		        SetTimerEx("CarregarInterior", 7000, false, "i", playerid);
				TogglePlayerControllable(playerid, 0);
				GameTextForPlayer(playerid, "~r~Carregando...", 3000, 3);
		    }
		    SetTimerEx("CarregarInterior", 7000, false, "i", playerid);
			TogglePlayerControllable(playerid, 0);
			GameTextForPlayer(playerid, "~r~Carregando...", 6000, 3);
	 		SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);
			new strc[128]; format(strc, sizeof(strc), "{FFFFFF}Voce spawnou na sua casa id {4682B4}%d{FFFFFF}!", MinhaCasa[playerid]);
			SendClientMessage(playerid, 0x32CD32FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
		   	SendClientMessage(playerid, 0x32CD32FF, strc);
	     	SendClientMessage(playerid, 0x32CD32FF, "{FFFFFF}Para voltar para sua ultima posicao use /Continuar em ate 20 segundos!");
	      	SendClientMessage(playerid, 0x32CD32FF, "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
		}
		
		new cor[11];
		switch(DonoFavela[0])
		{
		    case 0..11: format(cor, sizeof(cor), "0x%s99", gCor[DonoFavela[0]]), GangZoneShowForPlayer(playerid, GZ_Favela[0], HexToInt(cor));
		    case ROTA,CHOQUE,ROTAM,BOPE,EXERCITO: GangZoneShowForPlayer(playerid, GZ_Favela[0], 0x0040FF99);
		}
		switch(DonoFavela[1])
		{
		    case 0..11: format(cor, sizeof(cor), "0x%s99", gCor[DonoFavela[1]]), GangZoneShowForPlayer(playerid, GZ_Favela[1], HexToInt(cor));
		    case ROTA,CHOQUE,ROTAM,BOPE,EXERCITO: GangZoneShowForPlayer(playerid, GZ_Favela[1], 0x0040FF99);
		}
		switch(DonoFavela[2])
		{
		    case 0..11: format(cor, sizeof(cor), "0x%s99", gCor[DonoFavela[2]]), GangZoneShowForPlayer(playerid, GZ_Favela[2], HexToInt(cor));
		    case ROTA,CHOQUE,ROTAM,BOPE,EXERCITO: GangZoneShowForPlayer(playerid, GZ_Favela[2], 0x0040FF99);
		}
		
		CheckCaseSensitivity(PlayerName(playerid));
    }
    else if(AcertouAsenha[playerid] == false)
    {
        SendClientMessage(playerid, 0xFF0000FF, "| SERVER | O servidor nao detectou seu login e por isso voce foi kickado");
        GameTextForPlayer(playerid, "~r~Kickado!", 3000, 0);
        SetTimerEx("Kickar" , 150 , false, "i" , playerid);
    }
  	new Float:X, Float:Y, Float:Z;
	GetPlayerPos(playerid, X, Y, Z);
	if(IsPointInRangeOfPoint(X, Y, Z, XMorte[playerid], YMorte[playerid], ZMorte[playerid], 0.5))
	{
	    //TogglePlayerControllable(playerid, 0);
	    SetPlayerInterior(playerid, InteriorMorte[playerid]);
	    ApplyAnimation(playerid, "CRACK", "CRCKIDLE4", 4.1, 1, 0, 0, 0, 0, 1);
	    GameTextForPlayer(playerid, "~r~FERIDO", 4000, 5);
	    SendClientMessage(playerid, COR_PARAMEDICO, "| FERIDO | Voce esta ferido, resista ate a chegada do SAMU ou digite /Hospital para ser encaminhado para o hospital");
	}
	//
	if(EntrouPVP[playerid] == 0)
	{
		if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
	    {
	    	//TogglePlayerControllable(playerid, 0);
	        ApplyAnimation(playerid, "CRACK", "CRCKIDLE4", 4.1, 1, 0, 0, 0, 0, 1);
		}
	}
	else if(EntrouPVP[playerid] == 1)
	{
	    TogglePlayerControllable(playerid, 1);
	    
	    MinutosMorte[playerid] = 0; SegundosMorte[playerid] = 0;
	}
	
	AttTag(playerid);
	for(new m; m < 6; m++)
	{
		if(ModeloItem[playerid][m] > 0)
		{
			AtacharItem(playerid, m, 0, -1);
		}		    
	}
	return 1;
}

public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return 1;
	PosItem[playerid][index][0] = fOffsetX;
   	PosItem[playerid][index][1] = fOffsetY;
   	PosItem[playerid][index][2] = fOffsetZ;
   	PosItem[playerid][index][3] = fRotX;
   	PosItem[playerid][index][4] = fRotY;
   	PosItem[playerid][index][5] = fRotZ;
   	PosItem[playerid][index][6] = fScaleX;
   	PosItem[playerid][index][7] = fScaleY;
   	PosItem[playerid][index][8] = fScaleZ;
   	AtacharItem(playerid, index, 0, -1);
   	return 1;
}

public OnPlayerDeath(playerid, killerid, reason)
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerDeath(playerid, killerid, reason);

	new weaponid,ammo;
	for (new i=0; i<13; i++){
		GetPlayerWeaponData(playerid,i,weaponid,ammo);
		if(weaponid != 0){
			new BsADD = -1;
			for(new s = 0; s < Qnt_Bolsas_Limt; s++)
			    if(BSArmas[s] == 0){
			        BsADD = s;
			        break;
			    }
			if(BsADD == -1){
				for(new s = 0; s < Qnt_Bolsas_Limt; s++)
					if(BSArmas[s] != 0){
					    uQ_ResetDrop(s);

					}
				BsADD = 0;
			}
			GetPlayerName(playerid, BSDeQuem[BsADD], 32);
			GetPlayerPos(playerid,BSPos[0][BsADD],BSPos[1][BsADD],BSPos[2][BsADD]);
			BSPos[0][BsADD] += RnxPosAlt[random(sizeof(RnxPosAlt))];
			BSPos[1][BsADD] += RnxPosAlt[random(sizeof(RnxPosAlt))];
			BSDefObj[BsADD] = CreateDynamicObject(oQ_ConvARmas[weaponid][1], BSPos[0][BsADD],BSPos[1][BsADD],BSPos[2][BsADD]-0.95, 	90.0, 0.0,random(360));
			new NomeArm[32];
			GetWeaponName(weaponid, NomeArm, sizeof(NomeArm));
			/*if(weaponid < 15) format(string, sizeof(string),"Voc� dropou a {FF6600}%s(%i)",NomeArm,weaponid);
			else format(string, sizeof(string),"Voc� dropou a arma {FF6600}%s(%i){FFFFFF} com {FF6600}%i{FFFFFF} muni��es!",NomeArm,weaponid,ammo);
			SendClientMessage(playerid, 0xFFFFFFFF, string);*/
			BSArmas[BsADD] = weaponid;
			BSQntMunc[BsADD] = ammo;

			BS_TimeDrp[BsADD] = gettime()+60*20;
			GivePlayerWeaponExC(playerid, weaponid, -ammo);
		}
	}

	{
	    EntrouHosp[playerid] = GetPlayerHospital(playerid); InteriorMorte[playerid] = GetPlayerInterior(playerid);
		GetPlayerPos(playerid, XMorte[playerid], YMorte[playerid], ZMorte[playerid]); new Float:R; GetPlayerFacingAngle(playerid, R);
		SetSpawnInfo(playerid, -1, GetPlayerSkin(playerid) , XMorte[playerid], YMorte[playerid], ZMorte[playerid], R, 0 , 0 , 0 , 0 , 0 , 0  ) ;
		MinutosMorte[playerid] = 4; SegundosMorte[playerid] = 60;
		SetPlayerHealth(playerid, 1000000.0);
		SpawnPlayer(playerid);
		
		if(ORG[playerid] >= 0)
	 	{
			for(new id; id < MAX_ORG; id++)
			{
			    if(IsPlayerInRangeOfPoint(playerid, 200.0, xxOrg[id], yyOrg[id], zzOrg[id]))
			    {
	      			if(!VerifyExpiredDays(gTimer[id]))
		            {
	             		new mins = (gTimer[id] - gettime()) / 60;
		                if(mins > 60)
		                {
	                 		mins = 60;
		                }
	                 	MinutosMorte[playerid] = mins; SegundosMorte[playerid] = 1;
	           		}
		            break;
				}
			}
	    }
	    if(killerid != INVALID_PLAYER_ID && Spawnado[killerid] == true && !IsPlayerNPC(killerid))//Alguem Matou
	    {
	        if(Spawnado[playerid] == false)
	        {
				Ban(playerid);
				return 1;
	        }
	        if((gettime() - TimeKill[playerid]) <= 3 && !IsPlayerInRangeOfPoint(killerid, 300.0, XMorte[playerid], YMorte[playerid], ZMorte[playerid]))
			{
	            VezesMorreu[playerid] ++;
	            TimeKill[playerid] = gettime();
	            if(VezesMorreu[playerid] >= 3)
	            {
	                format(String, sizeof(String), "| CARP-Admin | Malvadao baniu o(a) jogador(a) %s ( Motivo: Fake Kill 1 )", PlayerName(playerid));
		            FileLog("FakeKill", String);
		            VezesMorreu[playerid] = 0;
		            Ban(playerid);
	            	return 1;
	            }
	        }
	        else
	        {
	            TimeKill[playerid] = gettime();
	            VezesMorreu[playerid] = 1;
	        }
	        if(reason == 50)
		    {
	     	   	GetXYInFrontOfPlayer(playerid, XMorte[playerid], YMorte[playerid], 3.0);
		        SetPlayerPos(playerid, XMorte[playerid], YMorte[playerid], ZMorte[playerid]);
			}
	        SendDeathMessage(killerid, playerid, reason);
	        MatouPlayer[killerid] = playerid;
	        if(TimerFuga[playerid])
		 	{
				KillTimer(TimerFuga[playerid]); TimerFuga[playerid] = 0;
				SendClientMessage(killerid, -1, "| INFO | Voce matou um(a) mafioso(a) que roubou uma fazenda e recebeu $3000");
				Money[killerid] += 3000;
		   	}
	        if(ORG[killerid] >= 0)
	        {
	            GiveProcurado(killerid, 1);
	            if(EmContrato[playerid] > 0 && ORG[playerid] != ORG[killerid])
	            {
	            	format(String, sizeof(String), "| CONTRATO | O(A) Assassino(a) %s[%d] matou o(a) jogador(a) %s[%d] que estava em contrato de morte", PlayerName(killerid), killerid, PlayerName(playerid), playerid);
					SendClientMessageToAll(0x8FBC8FFF, String);
					format(String, sizeof(String), "| CONTRATO | Voce recebeu {00CD66}$%d {FFFFFF}por matar esse jogador(a)", EmContrato[playerid]);
					SendClientMessage(killerid, -1, String);
					Money[killerid] += EmContrato[playerid];
					EmContrato[playerid] = 0;
					if(Localizando[killerid] > -1)
					{
					    Localizando[killerid] = -1;
						DisablePlayerCheckpoint(killerid);
					}
	            }
	            else if(ORG[playerid] < 0)
	            {
	                if(SegundosPerseguidoOrg[playerid] > 0)
	                {
	                    if(Money[playerid] >= 5000)
	                    {
	                        Money[playerid] -= 5000;
	                        Money[killerid] += 5000;
	                        format(String, sizeof(String), "| ASSALTO | O(A) Assaltante %s[%d] te matou e levou {00CD66}$5000 {FFFFFF}de Voce!", PlayerName(killerid), killerid);
	                        SendClientMessage(playerid, -1, String);
	                        format(String, sizeof(String), "| ASSALTO | Voce matou o(a) jogador(a) %s[%d] que estava abordado e roubou {00CD66}$5000 {FFFFFF}dele!", PlayerName(playerid), playerid);
	                        SendClientMessage(killerid, -1, String);
	                    }
	                    else
						{
						    format(String, sizeof(String), "| ASSALTO | O(A) Assaltante %s[%d] te matou e levou {00CD66}$%d {FFFFFF}de Voce!", PlayerName(killerid), killerid, Money[playerid]);
	                        SendClientMessage(playerid, -1, String);
	                        format(String, sizeof(String), "| ASSALTO | Voce matou o(a) jogador(a) %s[%d] que estava abordado e levou {00CD66}$%d {FFFFFF}dele!", PlayerName(playerid), playerid, Money[playerid]);
	                        SendClientMessage(killerid, -1, String);
	                        Money[killerid] += Money[playerid];
						    Money[playerid] = 0;
						}
	                }
					else if(GetPlayerSkin(playerid) == SkinPlayer[playerid] || PROF[playerid] == PARAMEDICO)
					{
					    format(String, sizeof(String), "| ANTI-DM | O(A) Mafioso %s[%d] matou um inocente %s[%d], de olho nele!", PlayerName(killerid), killerid, PlayerName(playerid), playerid);
						foreach(Player, i)
	                    {
	                        if(IsPlayerConnected(i) && Spawnado[i] == true && NivelAdmin[i] > 0)
	                        {
	                            SendClientMessage(i, 0xFF0000FF, String);
	                        }
	                    }
					}
	            }
	        }
			else if(PROF[killerid] == PM || PROF[killerid] == ROTA || PROF[killerid] == CHOQUE || PROF[killerid] == ROTAM || PROF[killerid] == BOPE || PROF[killerid] == PC || PROF[killerid] == PF || PROF[killerid] == EXERCITO)
			{
			    if(SegundosPerseguidoCorp[playerid] <= 0 && NivelProcurado[playerid] <= 0 && ORG[playerid] < 0)
			    {
			        GiveProcurado(killerid, 0);
				    format(String, sizeof(String), "| ANTI-DM | O(A) Policial %s[%d] matou um inocente %s[%d], de olho nele!", PlayerName(killerid), killerid, PlayerName(playerid), playerid);
		            foreach(Player, i)
		            {
		            	if(IsPlayerConnected(i) && Spawnado[i] == true && NivelAdmin[i] > 0)
		                {
		                	SendClientMessage(i, 0xFF0000FF, String);
		                }
		            }
				}
			}
			else if(SegundosPerseguidoCorp[killerid] <= 0 && SegundosPerseguidoOrg[killerid] <= 0)
			{
			    GiveProcurado(killerid, 1);
			    format(String, sizeof(String), "| ANTI-DM | O(A) Jogador(a) %s[%d] matou um inocente %s[%d], de olho nele!", PlayerName(killerid), killerid, PlayerName(playerid), playerid);
	            foreach(Player, i)
	            {
	            	if(IsPlayerConnected(i) && Spawnado[i] == true && NivelAdmin[i] > 0)
	                {
	                	SendClientMessage(i, 0xFF0000FF, String);
	                }
	            }
			}
	    }
	    else if(killerid == INVALID_PLAYER_ID && Spawnado[playerid] == true && !IsPlayerNPC(playerid))//Morreu Sozinho
	    {
	        SendDeathMessage(INVALID_PLAYER_ID, playerid, reason);
	    }
	    if(NoEvento[playerid] > 0)
	    {
	        NoEvento[playerid] = 0;
	    }
	    //////////////////////////////////////////////////////////////////////
	    if(FardaList[playerid] > -1)
	   	{
		    for(new t; t < 5; t++)
		   	{
				TextDrawHideForPlayer(playerid, TextSkin[t]);
			}
		   	PlayerTextDrawHide(playerid, TextSkinP[playerid][0]);
		   	PlayerTextDrawHide(playerid, TextSkinP[playerid][1]);
		   	SetCameraBehindPlayer(playerid);
		   	SetPlayerVirtualWorld(playerid, 0);
		   	FardaList[playerid] = -1;
		}
		if(Carregado[playerid] == true)
	 	{
	  		Carregado[playerid] = false;
		  	PlayerTextDrawHide(playerid, TextCargaP[playerid][0]);
	  		PlayerTextDrawHide(playerid, TextCargaP[playerid][1]);
			TextDrawHideForPlayer(playerid, TextCarga);
		  	DisablePlayerRaceCheckpoint(playerid);
	    	if(ComboioPetroleiro[playerid] > -1)
			{
				ComboioPetroleiroList[ComboioPetroleiro[playerid]] --;
	 			ComboioPetroleiro[playerid] = -1;
	  		}
	  		if(ComboioCaminhoneiro[playerid] > -1)
			{
				ComboioCaminhoneiroList[ComboioCaminhoneiro[playerid]] --;
	 			ComboioCaminhoneiro[playerid] = -1;
	  		}
	  		if(ComboioMinerador[playerid] > -1)
			{
				ComboioMineradorList[ComboioMinerador[playerid]] --;
	 			ComboioMinerador[playerid] = -1;
	  		}
	  		if(ComboioCF[playerid] > -1)
			{
				ComboioCFList[ComboioCF[playerid]] --;
	 			ComboioCF[playerid] = -1;
	  		}
	  	}
	  	if(CargaTrem[playerid] > -1 || RotaBus[playerid] > -1 || CargaPiloto[playerid] > 0)
	  	{
	  	    CargaTrem[playerid] = -1;
	  	    RotaBus[playerid] = -1;
	  	    CargaPiloto[playerid] = 0;
	  	    DisablePlayerRaceCheckpoint(playerid);
	  	}
	  	if(CargaMoto[playerid] > -1)
	  	{
	  	    CargaMoto[playerid] = -1;
	  	    for(new c; c < 3; c++)
	  	    {
			   if(CheckC[playerid][c] > -1)
			   {
					DestroyDynamicCP(CheckC[playerid][c]);
					CheckC[playerid][c] = -1;
			   }
			   if(MapC[playerid][c] > -1)
			   {
					DestroyDynamicMapIcon(MapC[playerid][c]);
					MapC[playerid][c] = -1;
			   }
	  	    }
	  	}
	  	if(TimerDesmanchando[playerid] >= 0)
	    {
	        KillTimer(TimerDesmanchando[playerid]);
	        EstaDesmanchando[playerid] = 0;
	    }
     	if(TimerLavagem[playerid] >= 0)
	    {
	        KillTimer(TimerLavagem[playerid]);
	        EstaLavando[playerid] = 0;
	        ContagemLavagem[playerid] = 0;
	    }
	  	if(IndoRadar[playerid] > -1)
		{
		    IndoRadar[playerid] = -1;
		    DisablePlayerRaceCheckpoint(playerid);
		}
		if(SegundosImobiliaria[playerid] > 0)
		{
		    SegundosImobiliaria[playerid] = 0;
			for(new t; t < 11; t++)
	  		{
	    		PlayerTextDrawHide(playerid, TextImobiliaria[playerid][t]);
	    	}
	    	SetPlayerVirtualWorld(playerid, 0);
		}
	  	PescouPeixe[playerid] = -1;
	  	Pescando[playerid] = false;
	  	foreach(Player, i)
	    {
	        if(IsPlayerConnected(i) && Spawnado[i] == true && PROF[i] == PARAMEDICO && i != playerid)
	        {
	            format(String, sizeof(String), "| SAMU | O(A) Jogador(a) %s[%d] acaba de se ferir e precisa de socorro!", PlayerName(playerid), playerid);
	            SendClientMessage(i, COR_PARAMEDICO, String);
	        }
	    }
	}
	if(TempoAbrindo[playerid] > 0)
	{
	    AbrindoCarro[playerid] = 0;
	    KillTimer(TempoAbrindo[playerid]);
	}
	return 1;
}


public OnVehicleSpawn(vehicleid)
{
    if(PlayerNoVeiculo[vehicleid] != 0){
        new xPlayer = PlayerNoVeiculo[vehicleid]-1;
        SetPlayerHealth(xPlayer,0);
        SendClientMessage(xPlayer, 0xFFFFFFFF, "Veiculo foi spawnado! Voc� foi morto");
        PlayerNoVeiculo[vehicleid] = 0;
        Na_Mala[xPlayer] = 0;
    }
 	if(VidaVehEx[vehicleid] <= 300.0)
	{
	    VidaVehEx[vehicleid] = 300.1;
	}
	SetVehicleHealth(vehicleid, VidaVehEx[vehicleid]);
 	UpdateVehicleDamageStatus(vehicleid, Paineis[vehicleid], Portas[vehicleid], Luzes[vehicleid], Pneus[vehicleid]);
	//
    if(GetVehicleModel(vehicleid) != 481 && GetVehicleModel(vehicleid) != 509 && GetVehicleModel(vehicleid) != 510)
    {
	    new motor, farol, alarme, portas, capo, portamalas, objetivo;
	    GetVehicleParamsEx(vehicleid, motor, farol, alarme, portas, capo, portamalas, objetivo);
	    SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_OFF, 0, alarme, portas, capo, portamalas, objetivo);
	}
	if(Neon1[vehicleid] > 0)
	{
	    DestroyDynamicObject(Neon1[vehicleid]);
	}
	if(Neon2[vehicleid] > 0)
	{
	    DestroyDynamicObject(Neon2[vehicleid]);
	}
	Neon1[vehicleid] = 0;
	Neon2[vehicleid] = 0;
	return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
    GetVehicleHealth(vehicleid, VidaVehEx[vehicleid]);
    GetVehicleDamageStatus(vehicleid, Paineis[vehicleid], Portas[vehicleid], Luzes[vehicleid], Pneus[vehicleid]);
	//
 	new Float:X, Float:Y, Float:Z; GetVehiclePos(vehicleid, X, Y, Z);
 	if(Z > 1.0)
	{
		SetTimerEx("CriarIncendio", 2000, false, "fff", X, Y, Z);
	}

    if(PlayerNoVeiculo[vehicleid] != 0){
        new Float:Hpv;  GetVehicleHealth(vehicleid, Hpv);
        if(Hpv < 400){
	        new xPlayer = PlayerNoVeiculo[vehicleid]-1;
	        SetPlayerHealth(xPlayer,0);
	        SendClientMessage(xPlayer, 0xFFFFFFFF, "Veiculo explodiu e voc� foi morto!");
	        PlayerNoVeiculo[vehicleid] = 0;
	        Na_Mala[xPlayer] = 0;
        }
    }
	return 1;
}

forward LavandoGrana(playerid);
public LavandoGrana(playerid)
{
	if(ContagemLavagem[playerid] >= 0)
	{
	    new string[128];
	    ApplyAnimation(playerid, "INT_HOUSE", "WASH_UP", 4.1, 1, 0, 0, 0, 60000, 1);
	    ContagemLavagem[playerid] --;
	    format(string, sizeof(string), "~g~LAVANDO AGUARDE\n%d SEGUNDOS", ContagemLavagem[playerid]);
	    GameTextForPlayer(playerid, string, 1000,3);
	}
	if(ContagemLavagem[playerid] <= 0)
	{
		ClearAnimations(playerid);
		ClearAnimations(playerid);
	    KillTimer(TimerLavagem[playerid]);
	    ContagemLavagem[playerid] = 0;
	    EstaLavando[playerid] = 0;
		DinheiroSujo[playerid] -= GetPVarInt(playerid, "ValorLavandoDS");
		Money[playerid] += floatround(GetPVarInt(playerid, "ValorLavandoDS")*0.7);
		SendClientMessage(playerid, COR_VERDE, "| LAVAGEM | Dinheiro lavado com susseco");
		TogglePlayerControllable(playerid, 1);
	}
	return 1;
}

forward CriarIncendio(Float:X, Float:Y, Float:Z);
public CriarIncendio(Float:X, Float:Y, Float:Z)
{
	if(Z > 1.0)
	{
	    for(new i; i < 40; i++)
	    {
			if(Incendio[i] == -1)
			{
			    new id = 18689 + random(3);
				Incendio[i] = CreateDynamicObject(id, X, Y, Z-2.0, 0, 0, 0);
				FogoIncendio[i] = 1000;
				DestroyDynamic3DTextLabel(TextoIncendio[i]);
 				new strp[70]; format(strp, sizeof(strp), "{FF0000}Incendio {FFFFFF}ID %d\nFogo [%d/1000]", i, FogoIncendio[i]);
  				TextoIncendio[i] = CreateDynamic3DTextLabel(strp, -1, X, Y, Z, 10.0);
      			return 1;
			}
		}
	}
	return 1;
}

public OnPlayerText(playerid, text[])
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return PVP_OnPlayerText(playerid, text);
    new tmp[128];
    if(Spawnado[playerid] == true && AcertouAsenha[playerid] == true)
	{
	    if(AdminEspiando[playerid] <= 0)
	    {
		    if(HorasPreso[playerid] <= 0 && MinutosPreso[playerid] <= 0 && SegundosPreso[playerid] <= 0)
			{ 
			    if(MinutosMorte[playerid] <= 0 && SegundosMorte[playerid] <= 0)
			    {
			    	strmid(tmp, text,0,strlen(text));
				    if(strfind(text,"server lixo",true) != -1 || strfind(text,"fdp",true) != -1 || strfind(text,"7777",true) != -1)
					{
					    new strsuspeito[128];
						format(strsuspeito, sizeof(strsuspeito), "| ALERTA | %s[%d] digitou: %s", PlayerName(playerid), playerid, text);
						for (new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
						{
						    if(IsPlayerConnected(p) && Spawnado[p] == true)
						    {
							    if(IsPlayerAdmin(p) || NivelAdmin[p] > 0)
							    {
				       				SendClientMessage(p, 0xFF0000FF, strsuspeito);
				   				}
							}
						}
						SendClientMessage(playerid, 0xFF0000FF, "****");
						return 0;
					}
					else if(strlen(text) > 100)
					{
						SendClientMessage(playerid, COR_ERRO, "| ERRO | Mensagem muito grande");
						return 0;
					}
					else
					{
					    new cstring[150], Float:chatX, Float:chatY, Float:chatZ;
					    if(Atendendo[playerid] >= 0 && IsPlayerConnected(Atendendo[playerid]))
					    {
					        format(cstring, sizeof(cstring), "| CHAT-ATENDIMENTO | %s[%d] diz: %s", PlayerName(playerid), playerid, text);
							SendClientMessage(Atendendo[playerid], COR_ADM, cstring);
							SendClientMessage(playerid, COR_ADM, cstring);
					    }
					    else
					    {
						    GetPlayerPos(playerid, chatX, chatY, chatZ);
						    foreach(Player, i)
							{
					 			if(IsPlayerInRangeOfPoint(i, 30.0, chatX, chatY, chatZ))
								{
								    if(Spawnado[i] == true)
								    {
								        if(GetPlayerInterior(playerid) == GetPlayerInterior(i))
								        {
								            if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
								        	{
								        	    if(Estagiario[playerid] >= 1)
								        	    {
													format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}[{73ACDF}ajudante{FFFFFF}] %s", PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
								        	    else if(NivelAdmin[playerid] == 1)
								        	    {
													format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}[{00B5B0}helper{FFFFFF}] %s", PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
												else if(NivelAdmin[playerid] == 2)
								        	    {
													format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}[{5C57FF}Moderador{FFFFFF}] %s", PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
												else if(NivelAdmin[playerid] == 3)
								        	    {
													format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}[{7EFFC7}Administrador{FFFFFF}] %s", PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
												else if(NivelAdmin[playerid] == 4)
								        	    {
													format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}[{E20D1E}Diretor{FFFFFF}] %s", PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
												else if(NivelAdmin[playerid] == 5)
								        	    {
													format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}[{37FFE9}Dono{FFFFFF}] %s", PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
												else if(NivelAdmin[playerid] == 6)
								        	    {
													format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}: [{00899B}Owner{FFFFFF}] %s", PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
												else if(VIP[playerid] > 0)
												{
			             							new TagV[7];
												    for(new t; t < 6; t++)
												    {
												        TagV[t] = CORTAGVIP[playerid][t+2];
												    }
												    if(ORG[playerid] >= 0)
												    {
												        format(cstring, sizeof(cstring), "[%s]%s[%d]: {FFFFFF}[{%s}VIP{FFFFFF}] %s", gNome[ORG[playerid]], PlayerName(playerid), playerid, TagV, text);
												        SendClientMessage(i, GetPlayerColor(playerid), cstring);
												    }
												    else
												    {
													    format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}: {FFFFFF}[{%s}VIP{FFFFFF}] %s", PlayerName(playerid), playerid, TagV, text);
														SendClientMessage(i, GetPlayerColor(playerid), cstring);
													}
												}
                                                else if(ORG[playerid] >= 0)
												{
													format(cstring, sizeof(cstring), "[%s]%s[%d]: %s", gNome[ORG[playerid]], PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
												else
												{
												    format(cstring, sizeof(cstring), "%s[%d]{FFFFFF}: %s", PlayerName(playerid), playerid, text);
													SendClientMessage(i, GetPlayerColor(playerid), cstring);
												}
												//if(!IsPlayerInAnyVehicle(playerid) && Algemado[playerid] == 0 && SegundosAmarrado[playerid] == -1) ApplyAnimation(playerid, "PED","IDLE_CHAT", 4.1, 0, 0, 0, 0, strlen(text)*100, 1);
											}
										}
									}
								}
							}
						}
					}
	     		}
				else
				{
		   			SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce esta ferido e nao pode falar no chat");
		   			return 0;
				}
			}
			else
			{
	   			SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce esta preso e nao pode falar no chat");
	   			return 0;
			}
		}
		else
		{
		    SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce esta espiando e nao pode falar no chat");
		}
	}
	else
	{
 		SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao pode falar no chat pois nao esta logado");
		return 0;
	}
	return 0;
}








public OnPlayerCommandText(playerid, cmdtext[])
{
	if(AstraModo[playerid] == ASTRA_MODO_PVP) return Astra_PVPComando(playerid, cmdtext);
	new _cmdtext [50], params [200];
	sscanf(cmdtext,"s[50]s[200]",_cmdtext,params );
    if(Spawnado[playerid] == true && AcertouAsenha[playerid] == true)
	{

	    if(Algemado[playerid] == 0)
	    {
	        new cmd[128], tmp[128];
		  	new idx;
		   	cmd = strtok(cmdtext,idx);
		   	if((gettime() - FloodCMD[playerid]) < 2 && NivelAdmin[playerid] <= 1)
			{
			    return SendClientMessage(playerid, 0x088A4BFF, "| ANTI-FLOOD | Evite flood de comandos");
			}
			FloodCMD[playerid] = gettime();
	        if(HorasPreso[playerid] > 0 || MinutosPreso[playerid] > 0 || SegundosPreso[playerid] > 0)
	        {
	            if(strcmp(cmd,"/Aceitar", true) != 0 && strcmp(cmd,"/Recusar", true) != 0 && strcmp(cmd,"/Advogados", true) != 0 && strcmp(cmd,"/sms", true) != 0 && strcmp(cmd,"/inv", true) != 0)
	        	{
	        	    if(!IsPlayerAdmin(playerid))
	        	    {
	            		return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce esta preso e nao pode usar comandos");
					}
				}
			}
			if (strcmp("/gradio", cmdtext, true) == 0){
			    if(kPegoRad[playerid] == 0) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o est� com um Radio em m�os!");
			    kPegoRad[playerid] = 0;
			    for(new i = 0; i < sizeof (RadioTexFDaw); i++) TextDrawHideForPlayer(playerid, RadioTexFDaw[i]);
			    PlayerTextDrawHide(playerid, RadioTexFDawP[playerid][0]);
				return 1;
			}

			
            if(!strcmp (_cmdtext , "/pmala" )){
					new EscolherOP[20],xPlayer,string[128];
				    if(sscanf(params, "s[20]", EscolherOP)){
				        new StrpnMalaG[500];
				        strcat(StrpnMalaG, "{FFFFFF}Digite: /pmala {FFFF00}[OP��O] {FF0000}EX:{FFFFFF} /pmala sair\n");
				        strcat(StrpnMalaG, "{FFFF00}[sair ou s] {FF0000}={FFFFFF} O jogador sai automaticamento do portamalas\n");
				        strcat(StrpnMalaG, "{FFFF00}[entrar ou e] {FF0000}={FFFFFF} o Jogador entra automaticamente no portamalas\n");
				        strcat(StrpnMalaG, "{FFFF00}[colocar ou c] {FF0000}={FFFFFF} Colocar algum jogador dentro do portamalas\n");
				        strcat(StrpnMalaG, "{FFFF00}[tirar ou t] {FF0000}={FFFFFF} Tirar algum jogador de dentro do portamalas\n");
						return ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_TABLIST, "{FFFFFF}[Porta Malas]", StrpnMalaG, "Ok", "");
					}
					if(!strcmp(EscolherOP, "sair", true,4) || !strcmp(EscolherOP, "s", true,1)){
						if(Na_Mala[playerid] == 0) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o est� na mala!");
						if(FoiColocado[playerid] == 2) return SendClientMessage(playerid, 0xFF0000FF, "Voc� foi colocado na mala por alguem! Voc� n�o pode sair!");
						pMala_SalvarArmas(playerid,Na_Mala[playerid]-1,2,-1);
						FoiColocado[playerid] = 0;
						return SendClientMessage(playerid, 0xFFFFFFFF, "Voc� saiu do porta malas!");
					}else if(!strcmp(EscolherOP, "entrar", true,6) || !strcmp(EscolherOP, "e", true,1)){
					    new vehid = CarMaisProximo(playerid);
					    if(vehid == -1) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o est� proximo a nenhum veiculo!");
					    if(vehid == -2) return SendClientMessage(playerid, 0xFF0000FF, "Este veiculo n�o possui porta malas!");
				        if(Na_Mala[playerid] != 0) return SendClientMessage(playerid, 0xFF0000FF, "Voc� j� est� dentro do porta malas!");
				        if(PlayerNoVeiculo[vehid] != 0) return SendClientMessage(playerid, 0xFF0000FF, "J� possui alguem no porta malas!");
					    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o pode usar este comando dentro de um veiculo!");
					    pMala_SalvarArmas(playerid,vehid,1,-1);
					    FoiColocado[playerid] = 1;
						return SendClientMessage(playerid, 0xFFFFFFFF, "Voc� entrou no porta malas!");
					}else if(!strcmp(EscolherOP, "colocar", true,7) || !strcmp(EscolherOP, "c", true,1)){
			            if(sscanf(params, "s[20]i", EscolherOP,xPlayer)) return SendClientMessage(playerid, 0xFFFFFFFF, "Digite: /pmala [colocar][playerid]");
					    new vehid = CarMaisProximo(playerid);
					    if(vehid == -1) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o est� proximo a nenhum veiculo!");
					    if(vehid == -2) return SendClientMessage(playerid, 0xFF0000FF, "Este veiculo n�o possui porta malas!");
				        if(Na_Mala[xPlayer] != 0) return SendClientMessage(playerid, 0xFF0000FF, "Este jogador j� esta no porta malas!");
				        if(PlayerNoVeiculo[vehid] != 0) return SendClientMessage(playerid, 0xFF0000FF, "J� possui alguem no porta malas!");
					    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o pode usar este comando dentro de um veiculo!");
					    new Float:PosP[3]; GetPlayerPos(playerid,PosP[0],PosP[1],PosP[2]);
					    if(!IsPlayerInRangeOfPoint(xPlayer,2.0, PosP[0],PosP[1],PosP[2])) return SendClientMessage(playerid, 0xFF0000FF, "Este jogador n�o est� proximo de voc�!");
				        pMala_SalvarArmas(xPlayer,vehid,1,-1);
						format(string, sizeof(string), "Voc� colocou o jogador %s(%i) no porta malas!",pPegarNome(xPlayer),xPlayer);
						SendClientMessage(playerid, 0xFFFFFFFF, string);
						format(string, sizeof(string), "jogador %s(%i) te colocou no porta malas!",pPegarNome(playerid),playerid);
						FoiColocado[playerid] = 2;
						return SendClientMessage(xPlayer, 0xFFFFFFFF, string);
					}else if(!strcmp(EscolherOP, "tirar", true,5) || !strcmp(EscolherOP, "t", true,1)){
			            if(sscanf(params, "s[20]i", EscolherOP,xPlayer)) return SendClientMessage(playerid, 0xFFFFFFFF, "Digite: /pmala [tirar][playerid]");
					    new vehid = CarMaisProximo(playerid);
					    if(vehid == -1) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o est� proximo a nenhum veiculo!");
					    if(vehid == -2) return SendClientMessage(playerid, 0xFF0000FF, "Este veiculo n�o possui porta malas!");
					    if(PlayerNoVeiculo[vehid] == 0) return SendClientMessage(playerid, 0xFF0000FF, "N�o possui nenhum jogador na mala deste veiculo!");
					    if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o pode usar este comando dentro de um veiculo!");
					    xPlayer = PlayerNoVeiculo[vehid]-1;
				        pMala_SalvarArmas(xPlayer,vehid,2,playerid);
						format(string, sizeof(string), "Voc� tirou o jogador %s(%i) do porta malas!",pPegarNome(xPlayer),xPlayer);
						SendClientMessage(playerid, 0xFFFFFFFF, string);
						format(string, sizeof(string), "jogador %s(%i) te tirou do porta malas!",pPegarNome(playerid),playerid);
						FoiColocado[playerid] = 0;
						return SendClientMessage(xPlayer, 0xFFFFFFFF, string);
					}
					return 1;
			}
			
			
			
			
			if(MinutosMorte[playerid] > 0 || SegundosMorte[playerid] > 0)
			{
			    if(strcmp(cmd,"/192", true) != 0 && strcmp(cmd,"/Hospital", true) != 0 && strcmp(cmd,"/Relatorio", true) != 0 && strcmp(cmd,"/Duvida", true) != 0)
	        	{
	        	    if(!IsPlayerAdmin(playerid) && NivelAdmin[playerid] == 0)
	        	    {
	            		return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce esta ferido e so pode usar o comando /Hospital ou /192");
					}
				}
			}
			if(SegundosImobiliaria[playerid] > 0)
			{
			    if(strcmp(cmd,"/CancelarPreview", true) != 0)
	        	{
	        	    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce esta em modo preview e nao pode usar comandos");
				}
			}if (strcmp("/delcofre", cmdtext, true) == 0){
				if(NivelAdmin[playerid] < 1) return SendClientMessage(playerid, 0xFF0000FF, "Sem permiss�o!");
				new string[128];
			    for(new i = 0; i < Cof_MaxCofres; i++)
				    if(IsPlayerInRangeOfPoint(playerid, 3.0, Cr_PosCofres[i][0],Cr_PosCofres[i][1],Cr_PosCofres[i][2])){
			            DestroyDynamicObject(Cr_pObjCofre[i]);
			            DestroyDynamic3DTextLabel(Cr_TxtLbcofre[i]);
			            Cr_CofreCriado[i] = 0;
			            Cr_PosCofres[i][0] = 0.0;
						Cr_PosCofres[i][1] = 0.0;
						Cr_PosCofres[i][2] = 0.0;

						new StrLoc[64];
						format(StrLoc, sizeof(StrLoc), "Cofres/%i.ini",i);
			            DOF2_SetFloat(StrLoc,"Pos_X",Cr_PosCofres[i][0]);
			            DOF2_SetFloat(StrLoc,"Pos_Y",Cr_PosCofres[i][1]);
			            DOF2_SetFloat(StrLoc,"Pos_Z",Cr_PosCofres[i][2]);
			            DOF2_SetFloat(StrLoc,"Pos_A",Cr_PosCofres[i][3]);
			            DOF2_SetInt(StrLoc,"Orgid",Cr_CofreCriado[i]);
						DOF2_SaveFile();

			            format(string, sizeof(string), "Cofre N�mero [%i] foi deletado!", i);
			            SendClientMessage(playerid, 0xFFFFFFFF, string);
						return 1;
				    }
				SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o est� pr�ximo o suficiente de nenhum cofre!");
				return 1;
			}
			if (strcmp("/pradio", cmdtext, true) == 0){
				if(kPegoRad[playerid] == 1) return SendClientMessage(playerid, 0xFF0000FF, "Voc� j� est� com o Radio em m�os! use /gradio para guarda-lo!");
				if(BuyRadio[playerid] == 0) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o comprou um radio! V� at� o mercado compra-lo!");
				kPegoRad[playerid] = 1;
				new string[128];
				format(string, sizeof (string), "%i",0);
				PlayerTextDrawSetString(playerid, RadioTexFDawP[playerid][0], string);
			    for(new i = 0; i < sizeof (RadioTexFDaw); i++) TextDrawShowForPlayer(playerid, RadioTexFDaw[i]);
			    PlayerTextDrawShow(playerid, RadioTexFDawP[playerid][0]);
				return 1;
			}
			if(strcmp(cmd, "/RepararCofre", true) == 0)
			{
			    if(IsPlayerInRangeOfPoint(playerid, 1.5, -31.381217, -26.194713, 1261.542236))
			    {
			        new i = GetPlayerVirtualWorld(playerid);
			        if(f_info[i][f_cofre] < 0)
			        {
		 				if(SegurandoMao[playerid] == FERRAMENTAS)
			    		{
							if(IsPlayerAttachedObjectSlotUsed(playerid, 5))
					        {
					            if(PRODUZINDOARMA[playerid] >= 0) return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce ja esta reparando");
					            PRODUZINDOARMA[playerid] = 0;
					            SegurandoMao[playerid] = 0;
       							RemovePlayerAttachedObject(playerid, 5);
								TogglePlayerControllable(playerid, 0);
			          			new StrT[35]; format(StrT, sizeof(StrT), "Reparando_~y~cofre:_%d%", PRODUZINDOARMA[playerid]);
			            		PlayerTextDrawSetString(playerid, TextProduzirArma[playerid], StrT);
								PlayerTextDrawShow(playerid, TextProduzirArma[playerid]);
				            	SetPlayerProgressBarMaxValue(playerid, barfabarmas[playerid], 100.0);
								SetPlayerProgressBarValue(playerid, barfabarmas[playerid], PRODUZINDOARMA[playerid]);
								ShowPlayerProgressBar(playerid, barfabarmas[playerid]);
								TempoProducaoArma[playerid] = SetTimerEx("ReparandoCofre", 200, false, "i", playerid);
								SendClientMessage(playerid, GetPlayerColor(playerid), "| INFO | Reparando cofre, aguarde...");
								GameTextForPlayer(playerid, "~b~Reparando...", 3000, 3);
					        }
							else
					   	 	{
								return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta segurando uma caixa de ferramentas");
							}
						}
						else
						{
							return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta segurando uma caixa de ferramentas");
						}
					}
                    else
					{
						return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse cofre nao esta danificado");
					}
				}
				else
				{
				    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao esta proximo a um cofre de fazenda");
				}
	    		return 1;
			}
			if (strcmp("/repcofre", cmdtext, true) == 0){
			    for(new i = 0; i < Cof_MaxCofres; i++)
				    if(IsPlayerInRangeOfPoint(playerid, 3.0, Cr_PosCofres[i][0],Cr_PosCofres[i][1],Cr_PosCofres[i][2])){
						if(cT_AddRoubCofre[playerid] > 0) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o pode usar este comando no momento!");
						if(Cr_StCofres[i] == 0) return SendClientMessage(playerid, 0xFF0000FF, "Este cofre n�o est� explodido!");
						cT_xTKillROUBcOF[playerid] = SetTimerEx("xTLoopRoubo", 1000, true,"iii",playerid,i,2);
						cT_AddRoubCofre[playerid] = 1;
						ApplyAnimation(playerid, "BOMBER","BOM_Plant_Loop",4.0,1,0,0,1,0);
						SendClientMessage(playerid, 0xFFFF00FF, "Voc� est� reparando o Cofre");
						return 1;
					}
				SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o est� proximo a nenhum cofre!");
				return 1;
			}
			if(!strcmp (_cmdtext , "/vradio" )){
			    if(kPegoRad[playerid] == 0) return SendClientMessage(playerid, 0xFF0000FF, "Voc� n�o est� com um Radio em m�os!");
				new freq;
				if(sscanf(params, "d", freq)) return SendClientMessage(playerid, -1,"Uso: /vradio [FREQ. 0-50 (-1 Desligar)]");
				if(freq <= -1){
					SendClientMessage(playerid, 0xFF0000FF, "WalkieTalkie Desligado!");
					SvDetachListenerFromStream(Frequencia[FrequenciaConectada[playerid]], playerid);
					FrequenciaConectada[playerid] = -1;
				    return 1;
				}
				if(freq < 30 && freq != ORG[playerid]) return SendClientMessage(playerid, -1,"Frequencia abaixo de 30 s�o de Orgs p/ cada org, 30+ livres!");
				if(freq > 50) return SendClientMessage(playerid, 0xFF0000FF, "Frequencia Invalida!");
				if(freq == -1){
					SendClientMessage(playerid, 0xFF0000FF, "WalkieTalkie Desligado!");
					SvDetachListenerFromStream(Frequencia[FrequenciaConectada[playerid]], playerid);
					FrequenciaConectada[playerid] = -1;
				} else {
					new string[128];
					format(string, 128, "[WalkieTalkie] Frequencia conectada: (%d).", freq);
					SendClientMessage(playerid, 0x00AE00FF, string);

					format(string, 128, "[WalkieTalkie] %s saiu da frequencia(%d)", VoipNomer(playerid), FrequenciaConectada[playerid]);
					MsgFrequencia(FrequenciaConectada[playerid], 0xBF0000FF, string);
					format(string, 128, "[WalkieTalkie] %s conectou na frequencia(%d)", VoipNomer(playerid), freq);
					MsgFrequencia(freq, 0xFF6C00FF, string);

					SetTimerEx("ConectarNaFrequencia", 100, false, "id", playerid, freq);
				}
				return 1;
			}
			if(!strcmp (_cmdtext , "/addcofre" )){
			    if(NivelAdmin[playerid] < 1) return SendClientMessage(playerid, 0xFF0000FF, "Sem permiss�o!");
				new xOrgid,string[128];
			    if(sscanf(params, "i", xOrgid)) return SendClientMessage(playerid, 0xFF0000FF, "/addcofre [orgid] ou [locaid+1000]");
			    if(xOrgid <= 0) return SendClientMessage(playerid, 0xFF0000FF, "Use apenas numeros igual ou maior que 1!");
			    for(new i = 0; i < Cof_MaxCofres; i++)
			        if(Cr_CofreCriado[i] == 0){
