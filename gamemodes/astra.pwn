					    				return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
									}
								}
								else
								{
					                for(new m; m < GetPlayerVoltas(playerid); m++)
									{
						        		if(SlotMochila[playerid][m] == 0)
										{
											if(Money[playerid] >= 100)
           									{
												SlotMochila[playerid][m] = GALAO;
												QuantidadeSlotMochila[playerid][m] = 1;
												Money[playerid] -= 100;
												SendClientMessage(playerid, 0xFFFF00FF, "| GALAO | Voce pegou um galao de 10L");
												pLitros[p] -= 10;
								    			if(!new_strcmp(pDono[p], "Ninguem"))
												{
													pLucro[p] += 100;
												}
								    			format(String, sizeof(String), "{708090}Posto ID %d\n{FF6347}Dono(a): {FFFFFF}%s\n{FF6347}Combustivel: {FFFFFF}%dL\n{FF6347}Lucro: {00FF00}$%d", p, pDono[p], pLitros[p], pLucro[p]);
					    						UpdateDynamic3DTextLabelText(TextoPosto[p], -1, String);
									    		return 1;
											}
											else
											{
												return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
											}
										}
									}
									return SendClientMessage(playerid, COR_ERRO, "| ERRO | Seu inventario esta cheio");
								}
							}
							else
							{
							    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse posto esta sem combustivel");
							}
						}
			            case 1:
			            {
			                Flooder[playerid] = gettime() - 5;
			                if(new_strcmp(pDono[p], "Ninguem"))//sem dono
							{
							    if(GetPlayerScore(playerid) < 100)
		    				    {
		    				        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce so pode comprar um posto a partir do level 100");
		    				    }
							    if(Money[playerid] >= pValor[p])
							    {
							        Money[playerid] -= pValor[p];
							        format(pDono[p], 25, "%s", PlayerName(playerid));
							        pLucro[p] = 0;
							        pImpostos[p] = 0;
							        pAvenda[p] = 0;
							        new zone[MAX_ZONE_NAME]; GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
							        format(String, sizeof(String), "| POSTO | O(A) Jogador(a) %s comprou um posto de combustivel localizado em %s", PlayerName(playerid), zone);
							        SendClientMessageToAll(0x708090FF, String);
							        FileLog("Posto", String);
							        format(String, sizeof(String), "{708090}Posto ID %d\n{FF6347}Dono(a): {FFFFFF}%s\n{FF6347}Combustivel: {FFFFFF}%dL\n{FF6347}Lucro: {00FF00}$%d", p, pDono[p], pLitros[p], pLucro[p]);
   									UpdateDynamic3DTextLabelText(TextoPosto[p], -1, String);
   									PostosLiberados --;
   									PostosComDono ++;
							        return 1;
							    }
							    else
							    {
							    	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
							    }
							}
							else if(pAvenda[p] > 0)
							{
							    if(!new_strcmp(pDono[p], PlayerName(playerid)))
								{
								    if(GetPlayerScore(playerid) < 100)
			    				    {
			    				        return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce so pode comprar um posto a partir do level 100");
			    				    }
								    if(Money[playerid] >= pAvenda[p])
								    {
								        new donoantigo[MAX_PLAYER_NAME]; format(donoantigo, sizeof(donoantigo), "%s", pDono[p]);
								        new valor = pAvenda[p];
								        new vlucro = pLucro[p];
								        //
								        Money[playerid] -= pAvenda[p];
								        format(pDono[p], 25, "%s", PlayerName(playerid));
								        pValor[p] = pAvenda[p];
								        pLucro[p] = 0;
								        pImpostos[p] = 0;
								        pAvenda[p] = 0;
								        new zone[MAX_ZONE_NAME]; GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
								        format(String, sizeof(String), "| POSTO | O(A) Jogador(a) %s comprou um posto de Combustivel localizado em %s", PlayerName(playerid), zone);
								        SendClientMessageToAll(0x708090FF, String);
								        FileLog("Posto", String);
								        format(String, sizeof(String), "{708090}Posto ID %d\n{FF6347}Dono(a): {FFFFFF}%s\n{FF6347}Combustivel: {FFFFFF}%dL\n{FF6347}Lucro: {00FF00}$%d", p, pDono[p], pLitros[p], pLucro[p]);
	   									UpdateDynamic3DTextLabelText(TextoPosto[p], -1, String);
	   									//
	   									foreach(Player, i)
								        {
								            if(new_strcmp(donoantigo, PlayerName(i)))
								            {
								                if(IsPlayerConnected(i) && Spawnado[i] == true)
								                {
								                    format(String, sizeof(String), "| POSTO | Seu posto acaba de ser vendido e voce recebeu $%d", valor);
													SendClientMessage(i, 0x708090FF, String);
													new total = valor + vlucro;
													Money[i] += total;
								                    return 1;
								                }
								            }
								        }
								        format(String, sizeof(String), "Contas/%s.ini", donoantigo);
								        if(DOF2_FileExists(String))
								        {
								            DOF2_SetInt(String, "VendeuPosto", valor + vlucro);
								            DOF2_SaveFile();
								        }
								        return 1;
								    }
								    else
								    {
								    	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao tem dinheiro suficiente");
								    }
								}
								else
								{
									return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce ja e dono(a) desse posto");
				    			}
							}
							else
							{
							    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse posto nao esta a venda");
							}
			            }
			            case 2:
			            {
			                Flooder[playerid] = gettime() - 5;
			                if(new_strcmp(pDono[p], PlayerName(playerid)))//ele e dono
							{
							    if(pImpostos[p] <= 0)
							    {
							        Money[playerid] += pValor[p] * 99 / 100;
							        Money[playerid] += pLucro[p];
							        format(pDono[p], 25, "Ninguem");
							        pValor[p] = pValor[p] * 99 / 100;
                                    pLucro[p] = 0;
							        DOF2_SaveFile();
							        new zone[MAX_ZONE_NAME]; GetPlayer2DZone(playerid, zone, MAX_ZONE_NAME);
							        format(String, sizeof(String), "| POSTO | O(A) Jogador(a) %s vendeu seu posto de Combustivel localizado em %s", PlayerName(playerid), zone);
							        SendClientMessageToAll(0x708090FF, String);
							        FileLog("Posto", String);
							        format(String, sizeof(String), "{708090}Posto ID %d\n{FF6347}Dono(a): {FFFFFF}%s\n{FF6347}Combustivel: {FFFFFF}%dL\n{FF6347}Lucro: {00FF00}$%d", p, pDono[p], pLitros[p], pLucro[p]);
   									UpdateDynamic3DTextLabelText(TextoPosto[p], -1, String);
   									PostosLiberados ++;
   									PostosComDono --;
							        return 1;
							    }
							    else
							    {
							    	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce precisa pagar os impostos desse posto antes de vende-lo");
							    }
							}
							else
							{
							    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao e dono(a) desse posto");
							}
			            }
			            case 3:
			            {
			                if(new_strcmp(pDono[p], PlayerName(playerid)))//ele e dono
							{
							    if(pImpostos[p] <= 0)
							    {
							        new strgrange[150];
									format(strgrange, sizeof(strgrange), "\n{FFFFFF}Digite o valor entre {00FF00}$%d {FFFFFF}a {00FF00}$%d {FFFFFF}que deseja colocar a venda\n\nCaso queira cancelar a venda digite {00FF00}0", pValor[p] * 70 / 100, pValor[p] * 120 / 100);
							        ShowPlayerDialog(playerid, D_POSTOAVENDA, DIALOG_STYLE_INPUT, "{FFFFFF}Vender Posto p/ Jogador", strgrange, "Vender", "Cancelar");
							        return 1;
							    }
							    else
							    {
							        Flooder[playerid] = gettime() - 5;
							    	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce precisa pagar os impostos desse posto antes de colocar a venda");
							    }
							}
							else
							{
							    Flooder[playerid] = gettime() - 5;
							    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao e dono(a) desse posto");
							}
			            }
			            case 4:
			            {
			                Flooder[playerid] = gettime() - 5;
			                if(new_strcmp(pDono[p], PlayerName(playerid)))//ele e dono
							{
							    if(pLucro[p] > 0)
							    {
							        Money[playerid] += pLucro[p];
							        format(String, sizeof(String), "| INFO | Voce sacou {00CD66}$%d {FFFFFF}de lucro desse posto", pLucro[p]);
							        SendClientMessage(playerid, -1, String);
							        pLucro[p] = 0;
							        format(String, sizeof(String), "{708090}Posto ID %d\n{FF6347}Dono(a): {FFFFFF}%s\n{FF6347}Combustivel: {FFFFFF}%dL\n{FF6347}Lucro: {00FF00}$%d", p, pDono[p], pLitros[p], pLucro[p]);
   									UpdateDynamic3DTextLabelText(TextoPosto[p], -1, String);
							        return 1;
							    }
							    else
							    {
							    	return SendClientMessage(playerid, COR_ERRO, "| ERRO | Esse posto ainda nao gerou lucro");
							    }
							}
							else
							{
							    return SendClientMessage(playerid, COR_ERRO, "| ERRO | Voce nao e dono(a) desse posto");
							}
			            }
					}
				}
			}
		}
		else
		{
		    Flooder[playerid] = gettime() - 5;
		}
	}
