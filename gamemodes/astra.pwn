								        SendClientMessageToAll(COR_EMPRESA, String);
								        FileLog("Empresa", String);
								        if(lucro > 0)
								        {
								            Money[i] += lucro;
								            format(String, sizeof(String), "| INFO | Sua empresa {6959CD}%s {FFFFFF}foi vendida e voce recebeu {228B22}$%d {FFFFFF}+ {228B22}$%d {FFFFFF}de lucro", eNome[e], valor, lucro);
								            SendClientMessage(i, -1, String);
								        }
								        else
								        {
								            format(String, sizeof(String), "| INFO | Sua empresa {6959CD}%s {FFFFFF}foi vendida e voce recebeu {228B22}$%d", eNome[e], valor);
