		else if(pickupid == PickEntrada[2] || pickupid == PickEntrada[8] || pickupid == PickEntrada[9] || pickupid == PickEntrada[10] || pickupid == PickEntrada[11] || pickupid == PickEntrada[12] || pickupid == PickEntrada[13] || pickupid == PickEntrada[14])
		{
		    SendClientMessage(playerid, -1, "| INFO | Para entrar no Departamento de Policia digite '{B5B5B5}/Entrar{FFFFFF}' ou pressione a tecla '{B5B5B5}F{FFFFFF}'");
		}
